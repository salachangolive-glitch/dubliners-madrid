---
import { SITE } from '../site';

const measurementId = SITE.ga4MeasurementId.trim();
const emailTrackingEnabled = Boolean(SITE.publicEmail.trim());
---

{measurementId && (
  <>
    <script define:vars={{ measurementId, emailTrackingEnabled }}>
      // Consent first (Spain/LSSI): no analytics cookies until the visitor accepts.
      // gtag.js is only loaded after an explicit "Accept"; default state is denied.
      window.dataLayer = window.dataLayer || [];
      window.gtag = window.gtag || function () {
        window.dataLayer.push(arguments);
      };
      window.gtag('consent', 'default', {
        analytics_storage: 'denied',
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
      });

      const CONSENT_KEY = 'dubliners_cookie_consent_v1';
      const readConsent = () => {
        try {
          return window.localStorage.getItem(CONSENT_KEY);
        } catch {
          return null;
        }
      };
      let gaLoaded = false;
      const analyticsAllowed = () => readConsent() === 'granted';
      const loadGa = () => {
        if (gaLoaded) return;
        gaLoaded = true;
        window.gtag('consent', 'update', { analytics_storage: 'granted' });
        window.gtag('js', new Date());
        const s = document.createElement('script');
        s.async = true;
        s.src = `https://www.googletagmanager.com/gtag/js?id=${measurementId}`;
        document.head.appendChild(s);
        const debugMode =
          typeof window !== 'undefined' &&
          new URLSearchParams(window.location.search).get('debug_mode') === 'true';
        window.gtag('config', measurementId, debugMode ? { debug_mode: true } : {});
      };
      if (analyticsAllowed()) loadGa();
      document.addEventListener('dubliners:consent', (event) => {
        const value = event instanceof CustomEvent ? event.detail : null;
        if (value === 'granted') loadGa();
      });

      const normalizePath = (path) => {
        const withoutTrailingSlash = path.replace(/\/+$/, '');
        return withoutTrailingSlash ? `${withoutTrailingSlash}/` : '/';
      };

      const track = (eventName, params) => {
        if (!gaLoaded) return; // no measurement without consent
        window.gtag('event', eventName, {
          ...params,
          transport_type: 'beacon',
        });
      };

      const getLocation = (link) =>
        link.dataset.trackLocation ||
        link.closest('[data-track-location]')?.dataset.trackLocation ||
        'content';

      document.addEventListener(
        'click',
        (event) => {
          const target = event.target;
          if (!(target instanceof Element)) return;

          const link = target.closest('a');
          if (!(link instanceof HTMLAnchorElement)) return;

          const url = new URL(link.href, window.location.href);
          const pagePath = window.location.pathname;
          const language = document.documentElement.lang.startsWith('es') ? 'es' : 'en';
          const location = getLocation(link);

          const host = url.hostname;
          const isGoogleHost =
            host === 'google.com' ||
            host.endsWith('.google.com') ||
            host === 'google.es' ||
            host.endsWith('.google.es');
          const isMapsPath =
            url.pathname.includes('/maps') ||
            url.searchParams.has('maps') ||
            /(?:^|[?&])maps(?:=|&|$)/.test(url.search);
          const isGoogleMaps = isGoogleHost && isMapsPath;
          if (isGoogleMaps) {
            track('directions_click', {
              cta_location: location,
              language,
              page_path: pagePath,
              destination_host: 'google.com',
            });
            return;
          }

          const isInstagram =
            url.hostname === 'instagram.com' || url.hostname.endsWith('.instagram.com');
          if (isInstagram) {
            track('instagram_click', {
              link_location: location,
              language,
              page_path: pagePath,
              destination_host: 'instagram.com',
            });
            return;
          }

          if (url.protocol === 'mailto:' && emailTrackingEnabled) {
            track('email_click', {
              link_location: location,
              language,
              page_path: pagePath,
              destination_type: 'mailto',
            });
            return;
          }

          const whatsOnPaths = ['/whats-on/', '/es/partidos/'];
          const destinationPath = normalizePath(url.pathname);
          const currentPath = normalizePath(window.location.pathname);
          if (
            url.origin === window.location.origin &&
            whatsOnPaths.includes(destinationPath) &&
            destinationPath !== currentPath
          ) {
            track('whats_on_cta_click', {
              language,
              page_path: pagePath,
              cta_location: location,
            });
          }
        },
        { capture: true },
      );

      // Contact form success only (no PII). Fired by contact pages after FormSubmit OK.
      document.addEventListener('dubliners:contact_submit', (event) => {
        const detail = event instanceof CustomEvent ? event.detail || {} : {};
        const language =
          detail.language ||
          (document.documentElement.lang.startsWith('es') ? 'es' : 'en');
        const page_path = detail.page_path || window.location.pathname;
        track('contact_submit', { language, page_path });
      });
    </script>
  </>
)}
