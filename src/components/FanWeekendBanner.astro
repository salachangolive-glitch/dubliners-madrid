---
/**
 * Site-wide campaign strip — 4 BARS. ONE FAN WEEKEND. Hide after Sun 8 Nov.
 */
import { withBase } from '../site';
import {
  FAN_WEEKEND_HUB,
  FOUR_BARS_MAPS,
  SHOW_UNTIL_FAN_WEEKEND,
  madridYmd,
} from '../data/fourBars';

interface Props {
  lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const hub = FAN_WEEKEND_HUB[lang];
const showSaturdayTonight = madridYmd() <= '2026-11-07';
---

<div class="fan-weekend-banner" data-show-until={SHOW_UNTIL_FAN_WEEKEND} data-track-location="fan-weekend-banner">
  <p class="fan-weekend-banner__slogan">4 BARS. ONE FAN WEEKEND.</p>
  {showSaturdayTonight && (
    <p class="fan-weekend-banner__sub" data-show-until="2026-11-07">
      {es
        ? 'Esta noche 18:00–19:00: O’Reilly’s, Dubliners y O’Connell’s. Four Corner no abre hoy.'
        : 'Tonight 18:00–19:00: O’Reilly’s, Dubliners and O’Connell’s. Four Corner is not open tonight.'}
    </p>
  )}
  <p class="fan-weekend-banner__sub">
    {es
      ? 'Domingo 8 nov: las cuatro puertas abiertas. Four Corner está abierto desde las 14:00 (pantallas de deporte). NFL tarde/noche · Atlético–Barcelona 21:00.'
      : 'Sunday 8 Nov: all four doors open. Four Corner is open from 14:00 (sports screens). NFL afternoon/evening · Atlético–Barcelona 21:00.'}
  </p>
  <div class="fan-weekend-banner__ctas">
    <a class="btn btn-primary" href={withBase(hub)}>{es ? 'VER LOS CUATRO BARES' : 'MEET US NEAR SOL'}</a>
    <a class="btn btn-secondary" data-track-event="directions_click" href={FOUR_BARS_MAPS.dubliners} rel="noopener noreferrer" target="_blank">{es ? 'CÓMO LLEGAR' : 'GET DIRECTIONS'}</a>
  </div>
</div>

<style>
  .fan-weekend-banner {
    background: var(--accent-2);
    color: #1a1405;
    text-align: center;
    padding: 0.55rem 1rem 0.7rem;
    border-bottom: 1px solid rgba(26, 20, 5, 0.15);
  }
  .fan-weekend-banner__slogan {
    margin: 0;
    color: #1a1405;
    font-weight: 800;
    letter-spacing: 0.08em;
    font-size: clamp(0.95rem, 2.8vw, 1.2rem);
  }
  .fan-weekend-banner__sub {
    margin: 0.15rem 0 0.45rem;
    color: #1a1405;
    font-size: 0.88rem;
  }
  .fan-weekend-banner__ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.45rem;
  }
  .fan-weekend-banner__ctas .btn-secondary {
    background: #1a1405;
    color: var(--accent-2);
    border-color: #1a1405;
  }
  .fan-weekend-banner__ctas .btn-secondary:hover {
    background: #2a2412;
    color: #f3efe6;
  }
  .fan-weekend-banner__ctas .btn {
    min-height: 44px;
    padding: 0.45rem 0.9rem;
    font-size: 0.82rem;
  }
</style>
