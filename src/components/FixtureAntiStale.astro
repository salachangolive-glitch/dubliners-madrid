---
/**
 * Client-side agenda refresh — same rule as agendaAt() in src/data/fixtures.ts:
 * - finished (now >= data-end-ms) → hidden
 * - Today: Madrid date of kickoff === today's Madrid date, or started and not finished
 * - Upcoming: kickoff on a later Madrid date
 * Rows are moved between the two lists, so a static build never shows
 * “nothing today” while today’s games sit under Upcoming.
 * Also hides any [data-show-until="YYYY-MM-DD"] block after that Madrid date.
 * Without JS, the build-time HTML (same rule at build time) is shown.
 */
---
<script is:inline>
(function () {
  function madridTodayYmd(now) {
    try {
      return new Intl.DateTimeFormat('en-CA', {
        timeZone: 'Europe/Madrid', year: 'numeric', month: '2-digit', day: '2-digit',
      }).format(now);
    } catch (e) { return null; }
  }
  function startOf(li) { return Number(li.getAttribute('data-start-ms')); }
  function endOf(li) { return Number(li.getAttribute('data-end-ms')); }
  function sortKey(li) {
    return (li.getAttribute('data-date-key') || '') + 'T' + (li.getAttribute('data-madrid-time') || '');
  }
  function refreshBoard(board, now, todayYmd) {
    var todayCol = board.querySelector('[data-fixture-slot="today"]');
    var weekCol = board.querySelector('[data-fixture-slot="week"]');
    if (!todayCol || !weekCol) return;
    var todayList = todayCol.querySelector('ul.fixture-list');
    var weekList = weekCol.querySelector('ul.fixture-list');
    if (!todayList || !weekList) return;
    var rows = Array.prototype.slice.call(board.querySelectorAll('li[data-date-key]'));
    rows.sort(function (a, b) { var x = sortKey(a), y = sortKey(b); return x < y ? -1 : x > y ? 1 : 0; });
    var t = now.getTime();
    var nToday = 0, nWeek = 0;
    for (var i = 0; i < rows.length; i++) {
      var li = rows[i];
      var key = li.getAttribute('data-date-key');
      var s = startOf(li), e = endOf(li);
      var valid = todayYmd && key && isFinite(s) && isFinite(e);
      var finished = !valid || t >= e;
      if (finished) { li.hidden = true; li.setAttribute('aria-hidden', 'true'); continue; }
      li.hidden = false; li.removeAttribute('aria-hidden');
      if (key === todayYmd || (key < todayYmd && s <= t)) { todayList.appendChild(li); nToday++; }
      else { weekList.appendChild(li); nWeek++; }
    }
    todayList.hidden = nToday === 0;
    weekList.hidden = nWeek === 0;
    var te = todayCol.querySelector('[data-fixture-empty]'); if (te) te.hidden = nToday > 0;
    var we = weekCol.querySelector('[data-fixture-empty]'); if (we) we.hidden = nWeek > 0;
  }
  function run() {
    var now = new Date();
    var todayYmd = madridTodayYmd(now);
    var boards = document.querySelectorAll('[data-fixture-board]');
    for (var b = 0; b < boards.length; b++) refreshBoard(boards[b], now, todayYmd);
    var timed = document.querySelectorAll('[data-show-until]');
    for (var k = 0; k < timed.length; k++) {
      var until = timed[k].getAttribute('data-show-until');
      timed[k].hidden = !todayYmd || todayYmd > until;
    }
  }
  window.__dublinersAgendaRefresh = run;
  run();
  setInterval(run, 60 * 1000);
  document.addEventListener('visibilitychange', function () { if (document.visibilityState === 'visible') run(); });
  window.addEventListener('pageshow', run);
})();
</script>
