---
/**
 * Shared What’s On / Partidos board. EN and ES render the SAME rows from
 * src/data/fixtures.ts via agendaAt() — only labels differ.
 * Each row carries absolute start/end (epoch ms) so the client script can
 * re-slot Today/Upcoming with the real Madrid time and drop finished games.
 */
import type { Fixture } from '../data/fixtures';
import { fixtureStartMs, fixtureEndMs, sportLabel, sportLabelEs } from '../data/fixtures';
import { whenLabelEs } from '../i18n';
import FixtureAntiStale from './FixtureAntiStale.astro';

interface Props {
  lang?: 'en' | 'es';
  today: Fixture[];
  upcoming: Fixture[];
}
const { lang = 'en', today, upcoming } = Astro.props;
const es = lang === 'es';
const L = es
  ? {
      today: 'Hoy cerca de Sol',
      todayEmpty: 'Nada listado para hoy — pregunta en barra qué hay en pantallas.',
      upcoming: 'Próximos esta semana cerca de Sol',
      upcomingEmpty: 'La agenda de próximos partidos aparecerá aquí cuando estén listos.',
      confirmed: 'Confirmado',
    }
  : {
      today: 'Today near Sol',
      todayEmpty: 'Nothing listed for today — ask at the bar what’s on the screens.',
      upcoming: 'Upcoming this week near Sol',
      upcomingEmpty: 'This week’s upcoming list will appear here when fixtures are ready.',
      confirmed: 'Confirmed',
    };
const sport = (f: Fixture) => (es ? sportLabelEs(f.competition) : sportLabel(f.competition));
const day = (f: Fixture) => (es ? whenLabelEs(f.dateKey) : f.whenLabel);
const slots = [
  { kind: 'today', title: L.today, empty: L.todayEmpty, rows: today },
  { kind: 'week', title: L.upcoming, empty: L.upcomingEmpty, rows: upcoming },
];
---

<div class="fixture-board" data-fixture-board>
  {slots.map((s) => (
    <div class="fixture-col" data-fixture-slot={s.kind}>
      <h2>{s.title}</h2>
      <p class="empty-slot" data-fixture-empty hidden={s.rows.length > 0}>{s.empty}</p>
      <ul class="fixture-list" hidden={s.rows.length === 0}>
        {s.rows.map((f) => (
          <li
            data-date-key={f.dateKey}
            data-madrid-time={f.madridTime}
            data-start-ms={String(fixtureStartMs(f))}
            data-end-ms={String(fixtureEndMs(f))}
          >
            <span class="fx-day">{day(f)}</span>
            <span class="fx-time">{f.madridTime}</span>
            <span class="fx-body">
              <strong>{f.teams}</strong>
              <em>{sport(f)} · {f.competition}</em>
              {f.confirmedOnScreens && <span class="fx-status fx-status-confirmed">{L.confirmed}</span>}
            </span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>
<FixtureAntiStale />
