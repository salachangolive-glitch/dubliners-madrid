---
import { SITE, HOURS, withBase } from '../site';
import { type Lang, t, HOURS_ES } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const copy = t(lang);
const hours = lang === 'es' ? HOURS_ES : HOURS;
const explore =
  lang === 'es'
    ? [
        { href: '/es/partidos/', label: copy.whatsOn },
        { href: '/es/visitar/', label: copy.directions },
        { href: '/es/contacto/', label: copy.contact },
        { href: '/es/sobre-dubliners/', label: copy.about },
        { href: '/es/privacidad/', label: copy.privacy },
      ]
    : [
        { href: '/whats-on/', label: copy.whatsOn },
        { href: '/visit/', label: copy.directions },
        { href: '/contact/', label: copy.contact },
        { href: '/about/', label: copy.about },
        { href: '/privacy/', label: copy.privacy },
      ];
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div>
      <h3>{SITE.name}</h3>
      <p>
        Dubliners Madrid<br />
        {SITE.address}<br />
        {SITE.postal}
      </p>
      <p>
        <a href={SITE.instagram} rel="noopener noreferrer" target="_blank">{SITE.instagramHandle}</a>
      </p>
    </div>
    <div>
      <h3>{copy.explore}</h3>
      {explore.map((l) => (
        <a href={withBase(l.href)}>{l.label}</a>
      ))}
    </div>
    <div id="hours" class="hours-block">
      <h3>{copy.hours}</h3>
      {hours.map((h) => (
        <p style="margin:0 0 0.25rem">{h.day}: {h.hours}</p>
      ))}
    </div>
  </div>
  <div class="container fineprint">
    {copy.fineprint}
  </div>
</footer>
