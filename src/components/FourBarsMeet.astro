---
/**
 * Four names + addresses + individual Maps links + confirmed hours.
 * Sunday hours advertised from Saturday. Four Corner Sunday from 14:00 only.
 */
import { withBase } from '../site';
import {
  FAN_WEEKEND_FOUR_CORNER,
  FAN_WEEKEND_HUB,
  FAN_WEEKEND_NFL_GUIDE,
  FAN_WEEKEND_SATURDAY,
  FAN_WEEKEND_SATURDAY_TONIGHT,
  FAN_WEEKEND_SUNDAY,
  FOUR_BARS,
  ORIGINAL_WEEKEND_ARTICLES,
  SHOW_UNTIL_FAN_WEEKEND,
  SISTER_SITES,
} from '../data/fourBars';

interface Props {
  lang?: 'en' | 'es';
  heading?: 'h1' | 'h2';
  /** Hide the self-link when this block already sits on the hub. */
  compact?: boolean;
}
const { lang = 'en', heading = 'h2', compact = false } = Astro.props;
const es = lang === 'es';
const H = heading;
---

<section class="section band-gold four-bars-meet" id={es ? 'punto-de-encuentro-sol' : 'meet-us-near-sol'} data-show-until={SHOW_UNTIL_FAN_WEEKEND}>
  <div class="container">
    <p class="four-bars-meet__kicker">4 BARS. ONE FAN WEEKEND.</p>
    <H class="four-bars-meet__title">{es ? 'Cuatro bares junto a Sol — sábado 7 y domingo 8 nov' : 'Four bars near Sol — Saturday 7 & Sunday 8 Nov'}</H>
    <p class="four-bars-meet__tonight" data-show-until="2026-11-07">
      {es
        ? 'Esta noche 18:00–19:00: quedada en O’Reilly’s (Pasaje de Matheu 4), Dubliners y O’Connell’s (Espoz y Mina 7). Four Corner no abre hoy. Hoy no hay NFL. Valencia–Real Madrid 21:00 EN DIRECTO solo en Dubliners.'
        : 'Tonight 18:00–19:00: meetup at O’Reilly’s (Pasaje de Matheu 4), Dubliners and O’Connell’s (Espoz y Mina 7). Four Corner is not open tonight. No official NFL game Saturday. Valencia vs Real Madrid 21:00 LIVE at Dubliners only.'}
    </p>
    <p>
      {es
        ? 'Domingo 8 nov: las cuatro puertas están abiertas. Dubliners desde las 12:00 · Four Corner está abierto desde las 14:00 (pantallas de deporte). El domingo se anuncia ya el sábado. No es un evento oficial de la NFL.'
        : 'Sunday 8 Nov: all four doors are open. Dubliners from 12:00 · Four Corner is open from 14:00 (sports screens). Sunday is advertised from Saturday. Not an official NFL event.'}
    </p>
    <div class="card-grid cols-4">
      {FOUR_BARS.map((bar) => (
        <article class="card four-bars-meet__card">
          <h3>{bar.name}</h3>
          <p class="four-bars-meet__addr">{bar.address}</p>
          <p class="four-bars-meet__hours">{es ? bar.hoursEs : bar.hoursEn}</p>
          <a class="btn btn-gold" data-track-event="directions_click" href={bar.maps} rel="noopener noreferrer" target="_blank">
            {es ? 'CÓMO LLEGAR' : 'GET DIRECTIONS'}
          </a>
          {bar.id === 'oreillys' && (
            <p class="four-bars-meet__site">
              <a href={SISTER_SITES.oreillys} rel="noopener noreferrer" target="_blank">{es ? "Web de O'Reilly's" : "O'Reilly's site"}</a>
            </p>
          )}
          {bar.id === 'oconnell' && (
            <p class="four-bars-meet__site">
              <a href={es ? SISTER_SITES.oconnellsEs : SISTER_SITES.oconnells} rel="noopener noreferrer" target="_blank">oconnellsmadrid.es</a>
            </p>
          )}
        </article>
      ))}
    </div>
    <p class="four-bars-meet__links">
      {!compact && (
        <>
          <a href={withBase(FAN_WEEKEND_HUB[lang])}>{es ? 'VER LOS CUATRO BARES' : 'MEET US NEAR SOL'}</a>
          {' · '}
        </>
      )}
      <span data-show-until="2026-11-07">
        <a href={withBase(FAN_WEEKEND_SATURDAY_TONIGHT[lang])}>{es ? 'Quedada 18:00–19:00' : 'Tonight 18:00–19:00'}</a>
        {' · '}
      </span>
      <a href={withBase(FAN_WEEKEND_SATURDAY[lang])}>{es ? 'Sábado en Sol' : 'Saturday in Sol'}</a>
      {' · '}
      <a href={withBase(FAN_WEEKEND_FOUR_CORNER[lang])}>{es ? 'Four Corner domingo 14:00' : 'Four Corner Sunday 14:00'}</a>
      {' · '}
      <a href={withBase(FAN_WEEKEND_SUNDAY[lang])}>{es ? 'Domingo en Sol' : 'Sunday sports in Sol'}</a>
      {' · '}
      <a href={withBase(FAN_WEEKEND_NFL_GUIDE[lang])}>{es ? 'Guía NFL del domingo' : 'NFL Sunday guide'}</a>
      {' · '}
      <a href={withBase(ORIGINAL_WEEKEND_ARTICLES.meetup[lang])}>{es ? ORIGINAL_WEEKEND_ARTICLES.meetup.labelEs : ORIGINAL_WEEKEND_ARTICLES.meetup.labelEn}</a>
      {' · '}
      <a href={withBase(ORIGINAL_WEEKEND_ARTICLES.walk[lang])}>{es ? ORIGINAL_WEEKEND_ARTICLES.walk.labelEs : ORIGINAL_WEEKEND_ARTICLES.walk.labelEn}</a>
      {' · '}
      <a href={withBase(ORIGINAL_WEEKEND_ARTICLES.screens[lang])}>{es ? ORIGINAL_WEEKEND_ARTICLES.screens.labelEs : ORIGINAL_WEEKEND_ARTICLES.screens.labelEn}</a>
      {' · '}
      <a href={withBase(ORIGINAL_WEEKEND_ARTICLES.international[lang])}>{es ? ORIGINAL_WEEKEND_ARTICLES.international.labelEs : ORIGINAL_WEEKEND_ARTICLES.international.labelEn}</a>
    </p>
  </div>
</section>

<style>
  .four-bars-meet__kicker {
    margin: 0 0 0.35rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--accent-2);
    font-size: 0.95rem;
  }
  .four-bars-meet__title { margin-top: 0; }
  .four-bars-meet__tonight { font-weight: 700; }
  .four-bars-meet__addr,
  .four-bars-meet__hours {
    margin: 0 0 0.55rem;
    color: var(--muted);
  }
  .four-bars-meet__hours { font-weight: 600; color: var(--text); }
  .four-bars-meet__card .btn { width: 100%; min-height: 44px; }
  .four-bars-meet__site { margin: 0.45rem 0 0; font-size: 0.9rem; }
  .four-bars-meet__links {
    margin: 1.25rem 0 0;
    font-weight: 600;
  }
  @media (min-width: 1000px) {
    .card-grid.cols-4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
