---
/**
 * Four names + addresses + Maps. Campaign copy retired 9 Nov 2026 (past tense).
 */
import { withBase } from '../site';
import {
  FAN_WEEKEND_HUB,
  FOUR_BARS,
  SHOW_UNTIL_FAN_WEEKEND,
  SISTER_SITES,
} from '../data/fourBars';

interface Props {
  lang?: 'en' | 'es';
  heading?: 'h1' | 'h2';
  compact?: boolean;
}
const { lang = 'en', heading = 'h2', compact = false } = Astro.props;
const es = lang === 'es';
const H = heading;
---

<section class="section band-gold four-bars-meet" id={es ? 'punto-de-encuentro-sol' : 'meet-us-near-sol'} data-show-until={SHOW_UNTIL_FAN_WEEKEND}>
  <div class="container">
    <p class="four-bars-meet__kicker">{es ? 'Archivo · 7 y 8 de noviembre de 2026' : 'Archive · 7 and 8 November 2026'}</p>
    <H class="four-bars-meet__title">{es ? 'Cuatro bares junto a Sol — aquel fin de semana' : 'Four bars near Sol — that weekend'}</H>
    <p>
      {es
        ? 'Ese fin de semana ya pasó. Dubliners, O’Reilly’s, O’Connell’s y Four Corner están en las mismas calles junto a Puerta del Sol. NFL los domingos: Ver NFL en Madrid. Esta semana: Partidos.'
        : 'That weekend has passed. Dubliners, O’Reilly’s, O’Connell’s and Four Corner sit on the same streets by Puerta del Sol. Sunday NFL: Watch NFL Madrid. This week: What’s On.'}
    </p>
    <div class="card-grid cols-4">
      {FOUR_BARS.map((bar) => (
        <article class="card four-bars-meet__card">
          <h3>{bar.name}</h3>
          <p class="four-bars-meet__addr">{bar.address}</p>
          <p class="four-bars-meet__hours">{es ? bar.hoursEs : bar.hoursEn}</p>
          <a class="btn btn-gold" data-track-event="directions_click" href={bar.maps} rel="noopener noreferrer" target="_blank">
            {es ? 'CÓMO LLEGAR' : 'GET DIRECTIONS'}
          </a>
          {bar.id === 'oreillys' && (
            <p class="four-bars-meet__site">
              <a href={SISTER_SITES.oreillys} rel="noopener noreferrer" target="_blank">{es ? "Web de O'Reilly's" : "O'Reilly's site"}</a>
            </p>
          )}
          {bar.id === 'oconnell' && (
            <p class="four-bars-meet__site">
              <a href={es ? SISTER_SITES.oconnellsEs : SISTER_SITES.oconnells} rel="noopener noreferrer" target="_blank">oconnellsmadrid.es</a>
            </p>
          )}
        </article>
      ))}
    </div>
    <p class="four-bars-meet__links">
      {!compact && (
        <>
          <a href={withBase(FAN_WEEKEND_HUB[lang])}>{es ? 'Archivo de aquel fin de semana' : 'That weekend’s archive'}</a>
          {' · '}
        </>
      )}
      <a href={withBase(es ? '/es/nfl-madrid/' : '/nfl-madrid/')}>{es ? 'Ver NFL en Madrid' : 'Watch NFL Madrid'}</a>
      {' · '}
      <a href={withBase(es ? '/es/partidos/' : '/whats-on/')}>{es ? 'Partidos' : "What's On"}</a>
    </p>
  </div>
</section>

<style>
  .four-bars-meet__kicker {
    margin: 0 0 0.35rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    color: var(--accent-2);
    font-size: 0.95rem;
  }
  .four-bars-meet__title { margin-top: 0; }
  .four-bars-meet__addr,
  .four-bars-meet__hours {
    margin: 0 0 0.55rem;
    color: var(--muted);
  }
  .four-bars-meet__hours { font-weight: 600; color: var(--text); }
  .four-bars-meet__card .btn { width: 100%; min-height: 44px; }
  .four-bars-meet__site { margin: 0.45rem 0 0; font-size: 0.9rem; }
  .four-bars-meet__links {
    margin: 1.25rem 0 0;
    font-weight: 600;
  }
  @media (min-width: 1000px) {
    .card-grid.cols-4 {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
