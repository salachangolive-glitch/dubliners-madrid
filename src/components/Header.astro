---
import { SITE, withBase } from '../site';
import { type Lang, navLinks, t, alternatePath } from '../i18n';

interface Props {
  lang?: Lang;
  path?: string;
}
const { lang = 'en', path = '/' } = Astro.props;
const links = navLinks(lang);
const copy = t(lang);
const alt = alternatePath(path);
const enHref = lang === 'en' ? withBase(path) : withBase(alt);
const esHref = lang === 'es' ? withBase(path) : withBase(alt);
const logoHref = withBase(lang === 'es' ? '/es/' : '/');
---

<header class="site-header" data-track-location="header">
  <div class="container header-inner">
    <a class="logo" href={logoHref} translate="no">{SITE.name} <span>Madrid</span></a>
    <nav class="nav" aria-label={lang === 'es' ? 'Principal' : 'Primary'}>
      {links.map((l) => (
        <a href={withBase(l.href)}>{l.label}</a>
      ))}
      <span class="lang-sel" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
        <a href={enHref} class:list={[{ active: lang === 'en' }]} hreflang="en" lang="en">EN</a>
        <span aria-hidden="true">|</span>
        <a href={esHref} class:list={[{ active: lang === 'es' }]} hreflang="es" lang="es">ES</a>
      </span>
    </nav>
    <div class="header-actions">
      <span class="lang-sel lang-sel--mobile" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
        <a href={enHref} class:list={[{ active: lang === 'en' }]} hreflang="en" lang="en">EN</a>
        <span aria-hidden="true">|</span>
        <a href={esHref} class:list={[{ active: lang === 'es' }]} hreflang="es" lang="es">ES</a>
      </span>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" id="menu-btn">
        {copy.menu}
      </button>
    </div>
  </div>
  <nav class="container mobile-nav" id="mobile-nav" aria-label={lang === 'es' ? 'Móvil' : 'Mobile'}>
    {links.map((l) => (
      <a href={withBase(l.href)}>{l.label}</a>
    ))}
    <a data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">{copy.directions}</a>
  </nav>
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
