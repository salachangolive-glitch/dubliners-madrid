---
import { SITE, withBase } from '../site';
import { type Lang, navLinks, t, alternatePath, normalizePath } from '../i18n';
import FanWeekendBanner from './FanWeekendBanner.astro';
import {
  FAN_WEEKEND_HUB,
  FOUR_BARS_MAPS,
  SHOW_UNTIL_FAN_WEEKEND,
  isFanWeekendLive,
} from '../data/fourBars';

interface Props {
  lang?: Lang;
  path?: string;
}
const { lang = 'en', path = '/' } = Astro.props;
const links = navLinks(lang);
const copy = t(lang);
const alt = alternatePath(path);
// Error page (404.html): there is no /404/ or /es/404/ URL, so the language
// switch always goes to the home of each language (EN → /, ES → /es/).
const isErrorPage = ['/404/', '/es/404/'].includes(normalizePath(path));
const enHref = isErrorPage ? withBase('/') : lang === 'en' ? withBase(path) : withBase(alt);
const esHref = isErrorPage ? withBase('/es/') : lang === 'es' ? withBase(path) : withBase(alt);
const logoHref = withBase(lang === 'es' ? '/es/' : '/');
const showFanWeekend = isFanWeekendLive();
const hubHref = FAN_WEEKEND_HUB[lang];
const visitHref = lang === 'es' ? '/es/visitar/' : '/visit/';
---

<header class="site-header" data-track-location="header">
  <div class="container header-inner">
    <a class="logo" href={logoHref} translate="no">{SITE.name} <span>Madrid</span></a>
    <nav class="nav" aria-label={lang === 'es' ? 'Principal' : 'Primary'}>
      {links.map((l) => (
        <a href={withBase(l.href)}>{l.label}</a>
      ))}
      {showFanWeekend && (
        <a class="nav-fan-weekend" href={withBase(hubHref)} data-show-until={SHOW_UNTIL_FAN_WEEKEND}>{lang === 'es' ? 'Cuatro bares' : '4 Bars'}</a>
      )}
      <span class="lang-sel" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
        <a href={enHref} class:list={[{ active: lang === 'en' }]} hreflang="en" lang="en">EN</a>
        <span aria-hidden="true">|</span>
        <a href={esHref} class:list={[{ active: lang === 'es' }]} hreflang="es" lang="es">ES</a>
      </span>
    </nav>
    <div class="header-actions">
      <span class="lang-sel lang-sel--mobile" aria-label={lang === 'es' ? 'Idioma' : 'Language'}>
        <a href={enHref} class:list={[{ active: lang === 'en' }]} hreflang="en" lang="en">EN</a>
        <span aria-hidden="true">|</span>
        <a href={esHref} class:list={[{ active: lang === 'es' }]} hreflang="es" lang="es">ES</a>
      </span>
      <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="mobile-nav" id="menu-btn">
        {copy.menu}
      </button>
    </div>
  </div>
  <nav class="container mobile-nav" id="mobile-nav" aria-label={lang === 'es' ? 'Móvil' : 'Mobile'}>
    {links.map((l) => (
      <a href={withBase(l.href)}>{l.label}</a>
    ))}
    {showFanWeekend && (
      <>
        <a href={withBase(hubHref)} data-show-until={SHOW_UNTIL_FAN_WEEKEND}>{lang === 'es' ? 'VER LOS CUATRO BARES' : 'MEET US NEAR SOL'}</a>
        <a href={withBase(visitHref)} data-show-until={SHOW_UNTIL_FAN_WEEKEND}>FIND US</a>
        <a data-track-event="directions_click" href={FOUR_BARS_MAPS.dubliners} rel="noopener noreferrer" target="_blank" data-show-until={SHOW_UNTIL_FAN_WEEKEND}>{lang === 'es' ? 'CÓMO LLEGAR' : 'GET DIRECTIONS'}</a>
      </>
    )}
    <a data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">{copy.directions}</a>
  </nav>
  {showFanWeekend && <FanWeekendBanner lang={lang} />}
</header>
<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('open');
    btn.setAttribute('aria-expanded', open ? 'true' : 'false');
  });
</script>
