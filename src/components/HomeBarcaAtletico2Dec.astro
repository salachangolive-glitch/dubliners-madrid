---
/**
 * TEMPORARY home featured block — Barça v Atlético LaLiga J23, Wed 2 Dec 2026 21:30 Madrid (owner 26 Nov 2026 00:30).
 * Spotify Camp Nou kick-off; watch at Dubliners. Off from Thu 3 Dec 2026 (Europe/Madrid).
 * REMOVE after 2026-12-02: delete component + home imports.
 */
import { SITE } from '../site';
import { buildNow, madridToday } from '../data/fixtures';

interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const SHOW_UNTIL = '2026-12-02';
if (madridToday(buildNow()) > SHOW_UNTIL) return null;
---

<section
  class="section band-gold home-barca-atleti"
  id={es ? 'barca-atletico-2-diciembre' : 'barca-atletico-2-december'}
  data-show-until={SHOW_UNTIL}
  data-home-block="barca-atleti-2dec"
  aria-label={es ? 'Barça – Atlético en pantalla' : 'Barça v Atlético on our screens'}
>
  <div class="container">
    {es ? (
      <>
        <h2 class="home-barca-atleti__title">Barça – Atlético · Miércoles 2 de diciembre · 21:30</h2>
        <p class="home-barca-atleti__hook">¿Marcará Julián en el Camp Nou para ganarse del todo el perdón de la afición rojiblanca? Vívelo con nosotros.</p>
      </>
    ) : (
      <>
        <h2 class="home-barca-atleti__title">Barça v Atlético · Wed 2 Dec · 21:30</h2>
        <p class="home-barca-atleti__hook">Will Julián finally win back the Atleti fans… at the Camp Nou? Watch it with us.</p>
      </>
    )}
    <div class="cta-row home-barca-atleti__cta">
      <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">
        {es ? 'Cómo llegar' : 'Get directions'}
      </a>
    </div>
  </div>
</section>