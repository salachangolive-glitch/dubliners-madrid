---
/**
 * TEMPORARY home block — NFL Sunday 8 Nov 2026 (owner order 30 Oct 01:22/01:23 via DG: 3rd block of the home page EN/ES,
 * "hasta que termine" the Sunday). Data comes from FIXTURES (same rows as What's On / Partidos).
 * Auto-hide: build-time (todayKey <= SHOW_UNTIL in the pages) + client data-show-until (FixtureAntiStale).
 * REMOVE on Mon 9 Nov: delete the two `<HomeNfl8Nov ... />` lines + imports in src/pages/index.astro and
 * src/pages/es/index.astro (or `git revert` the commit that added this file).
 */
import { FIXTURES } from '../data/fixtures';
import { withBase } from '../site';

interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const SHOW_UNTIL = '2026-11-08';

const rows = FIXTURES.filter(
  (f) => f.dateKey === '2026-11-08' && f.competition === 'NFL' && f.teams !== 'NFL RedZone' && f.confirmedOnScreens,
);
const byTime = new Map<string, string[]>();
for (const r of [...rows].sort((a, b) => a.madridTime.localeCompare(b.madridTime))) {
  if (!byTime.has(r.madridTime)) byTime.set(r.madridTime, []);
  byTime.get(r.madridTime)!.push(r.teams);
}
const hasRedZone = FIXTURES.some((f) => f.dateKey === '2026-11-08' && f.teams === 'NFL RedZone');
// Week schedule on nfl.com (Sun 8 Nov = REG9). Times/slots per /workspace/radar/2026-11-02-nfl.md (15:30 Madrid game; 19:00 and 22:05/22:25 with RedZone).
const NFL_SCHEDULE_URL = 'https://www.nfl.com/schedules/2026/REG9/';
// DG 4 Nov: TV channels are NOT named. Post-game 19:00 hook per DG 4 Nov (pub opens 12:00).
const slotDefs = [
  { label: '15:30', times: ['15:30'], kind: 'madrid' },
  { label: '19:00', times: ['19:00'], kind: 'redzone' },
  { label: '22:05 / 22:25', times: ['22:05', '22:25'], kind: 'redzone' },
] as const;
const slots = slotDefs
  .map((d) => ({ ...d, games: d.times.flatMap((t) => byTime.get(t) ?? []) }))
  .filter((d) => d.games.length > 0);
const guideHref = es ? '/es/guia-domingo-nfl-madrid/' : '/nfl-sunday-madrid-guide/';
const agendaHref = es ? '/es/partidos/' : '/whats-on/';
const hubHref = es ? '/es/cuatro-bares-fin-de-semana/' : '/4-bars-one-fan-weekend/';
---

<section class="section band-gold home-nfl8" id={es ? 'nfl-domingo-8-noviembre' : 'nfl-sunday-8-november'} data-show-until={SHOW_UNTIL} data-home-block="nfl-8nov">
  <div class="container">
    <h2>{es ? 'Domingo NFL en Madrid · domingo 8 de noviembre' : 'NFL Sunday in Madrid · Sunday 8 November'}</h2>
    <p class="home-nfl8__hook" data-nfl-hook="2026-11-08"><strong>{es ? 'Domingo 8 nov: punto de encuentro de la afición que viene de fuera — ambiente y pantalla grande desde las 15:30, y desde las 19:00, el pub para cuando volváis del estadio.' : 'Sunday 8 Nov: fans meeting point for visitors — the atmosphere and the big screen from 15:30, and from 19:00, the pub to head back to after the stadium.'}</strong></p>
    <p>
      {es
        ? 'Bengals vs Falcons se juega en el Estadio Santiago Bernabéu, y en Dubliners la NFL sigue todo el domingo: estos partidos van EN DIRECTO en nuestras pantallas (hora de Madrid).'
        : 'Bengals vs Falcons is played at the Santiago Bernabéu, and at Dubliners the NFL stays on all Sunday: these games are LIVE on our screens (Madrid time).'}
    </p>
    <h3 class="home-nfl8__h3">
      <a href={NFL_SCHEDULE_URL} target="_blank" rel="noopener">{es ? 'Calendario de la semana NFL (nfl.com)' : 'NFL week schedule (nfl.com)'}</a>
    </h3>
    <ul class="home-nfl8__list" data-nfl-calendar="2026-11-08">
      {slots.map((slot) => (
        <li>
          <strong>{slot.label}</strong> — {slot.games.join(' · ')}
          {slot.kind === 'madrid'
            ? (es ? ' — EN DIRECTO cerca de Sol (se juega en el Estadio Santiago Bernabéu)' : ' — LIVE near Sol (played at the Santiago Bernabéu)')
            : hasRedZone && (es ? ' — con NFL RedZone' : ' — with NFL RedZone')}
        </li>
      ))}
    </ul>
    <p>
      {es
        ? 'Domingo 8 nov, 21:00 (hora de Madrid): Atlético de Madrid–FC Barcelona (LaLiga), en directo en nuestras pantallas. Abierto desde las 12:00.'
        : 'Sunday 8 Nov, 21:00 (Madrid time): Atlético de Madrid vs FC Barcelona (LaLiga), live on our screens. Open from 12:00.'}
    </p>
    <p class="small">
      <a href={NFL_SCHEDULE_URL} target="_blank" rel="noopener">{es ? 'Ver el calendario completo en nfl.com' : 'Full schedule on nfl.com'}</a>
    </p>
    <p class="small">{es ? 'Dubliners: domingo abierto de 12:00 a 02:00. Four Corner: domingo 8 nov desde las 14:00.' : 'Dubliners: open Sunday 12:00–02:00. Four Corner: Sunday 8 Nov from 14:00.'}</p>
    <div class="cta-row">
      <a class="btn btn-gold" href={withBase(hubHref)}>{es ? 'VER LOS CUATRO BARES' : 'MEET US NEAR SOL'}</a>
      <a class="btn btn-primary" href={withBase(guideHref)}>{es ? 'Guía del domingo NFL' : 'NFL Sunday guide'}</a>
      <a class="btn btn-secondary" data-track-event="whats_on_cta_click" href={withBase(agendaHref)}>{es ? 'Agenda completa' : 'Full What’s On'}</a>
    </div>
  </div>
</section>

<style>
  .home-nfl8__h3 { margin: 1rem 0 0.25rem; font-size: 1.05rem; }
  .home-nfl8__list { list-style: none; padding: 0; margin: 1rem 0; }
  .home-nfl8__list li { padding: 0.45rem 0; border-bottom: 1px solid var(--border); line-height: 1.45; }
  .home-nfl8__list li:last-child { border-bottom: 0; }
</style>
