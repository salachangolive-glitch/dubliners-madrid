---
/**
 * TEMPORARY home hero — Rugby Nations Championship Sat 21 Nov 2026 (owner 17 Nov 14:10).
 * Auto-hide: build-time (todayKey <= '2026-11-21') + data-show-until (FixtureAntiStale).
 * REMOVE after Sat 21 Nov: delete imports/usages in index.astro + es/index.astro.
 */
import { SITE } from '../site';
import { OPENING_HOURS } from '../data/hours';

interface Props {
  lang?: 'en' | 'es';
}
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const SHOW_UNTIL = '2026-11-21';
const sat = OPENING_HOURS.find((d) => d.day === 'Saturday')!;
const guideUrl = es
  ? `${SITE.siteUrl}/es/rugby-irlanda-21-noviembre-puerta-del-sol/`
  : `${SITE.siteUrl}/irish-rugby-fans-madrid-saturday-21-nov/`;
---

<section
  class="home-rugby-21nov"
  id={es ? 'rugby-sabado-21-nov' : 'rugby-saturday-21-nov'}
  data-show-until={SHOW_UNTIL}
  data-home-block="rugby-21nov"
  data-track-location="home-rugby-21nov"
  aria-label={es ? 'Rugby sábado 21 de noviembre' : 'Rugby Saturday 21 November'}
>
  <div class="home-rugby-21nov__inner">
    <h2 class="home-rugby-21nov__title">
      {es ? 'Jornada internacional de rugby – sábado 21 de noviembre' : 'International Rugby – Saturday 21 November'}
    </h2>
    <p class="home-rugby-21nov__lead">
      {es
        ? 'Partidos en directo en nuestras pantallas (hora Madrid). Sin nombrar canales de TV.'
        : 'Matches LIVE on our screens (Madrid time). We do not name TV channels here.'}
    </p>
    <ul class="home-rugby-21nov__matches">
      {es ? (
        <>
          <li><strong>15:10</strong> Inglaterra–Nueva Zelanda</li>
          <li><strong>17:40</strong> Irlanda–Sudáfrica</li>
          <li><strong>21:10</strong> Francia–Argentina</li>
          <li><strong>21:10</strong> Gales–Australia</li>
        </>
      ) : (
        <>
          <li><strong>15:10</strong> England–New Zealand</li>
          <li><strong>17:40</strong> Ireland–South Africa</li>
          <li><strong>21:10</strong> France–Argentina</li>
          <li><strong>21:10</strong> Wales–Australia</li>
        </>
      )}
    </ul>
    <p class="home-rugby-21nov__meta">
      <strong>{SITE.address}</strong>, {SITE.postal} ·{' '}
      {es ? `Sábado ${sat.opens}–${sat.closes}` : `Saturday ${sat.opens}–${sat.closes}`} ·{' '}
      {es ? 'Metro Sol (1, 2 y 3) o Sevilla (2)' : 'Metro Sol (L1, L2, L3) or Sevilla (L2)'} ·{' '}
      {es ? 'Sin reservas; acceso por orden de llegada.' : 'No reservations; first come, first served.'}
    </p>
    <a
      class="btn btn-gold home-rugby-21nov__cta"
      href={guideUrl}
      data-track-event="rugby_cta_click"
      data-track-bar="dubliners"
    >
      {es ? 'Ver partidos de rugby' : 'View rugby schedule'}
    </a>
  </div>
</section>

<style>
  .home-rugby-21nov {
    background:
      linear-gradient(135deg, rgba(201, 162, 39, 0.22), rgba(20, 26, 18, 0.95) 48%),
      var(--bg-elev);
    border-bottom: 2px solid rgba(201, 162, 39, 0.45);
    padding: 0.85rem 1rem 1rem;
  }
  .home-rugby-21nov__inner {
    width: min(100%, 40rem);
    margin-inline: auto;
    text-align: center;
  }
  .home-rugby-21nov__title {
    margin: 0;
    font-size: clamp(1.05rem, 3.4vw, 1.35rem);
    line-height: 1.25;
    color: var(--accent-2);
  }
  .home-rugby-21nov__lead {
    margin: 0.35rem 0 0.5rem;
    font-size: 0.88rem;
    color: var(--text-muted);
  }
  .home-rugby-21nov__matches {
    list-style: none;
    margin: 0 0 0.55rem;
    padding: 0;
    display: grid;
    gap: 0.2rem;
    font-size: 0.92rem;
  }
  .home-rugby-21nov__meta {
    margin: 0 0 0.65rem;
    font-size: 0.8rem;
    line-height: 1.45;
    color: var(--text-muted);
  }
  .home-rugby-21nov__cta {
    width: 100%;
    max-width: 20rem;
    min-height: 44px;
  }
  @media (min-width: 600px) {
    .home-rugby-21nov__matches {
      grid-template-columns: 1fr 1fr;
      text-align: left;
      max-width: 28rem;
      margin-inline: auto;
    }
  }
</style>