---
/**
 * Weekend video 28–29 Nov 2026 (rugby finals, Libertadores final, UCLA–USC) — home EN/ES above hero.
 * Gone from Mon 30 Nov 00:00 Madrid: build-time check + FixtureAntiStale hides [data-show-until-ms].
 */
import { SITE, withBase } from '../site';
import { buildNow } from '../data/fixtures';

interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const UNTIL_ISO = '2026-11-30T00:00:00+01:00';
const untilMs = new Date(UNTIL_ISO).getTime();
if (buildNow().getTime() >= untilMs) return null;

const es = lang === 'es';
const poster = withBase('/videos/finde-28-29-nov/finde-28-29-nov-poster-640.webp');
const videoSrc = withBase('/videos/finde-28-29-nov/finde-28-29-nov-v2.mp4');
const copy = es
  ? 'Este fin de semana, en directo en nuestras pantallas (hora de Madrid): rugby Nations Championship sáb 28 a las 14:10 y 17:40 y dom 29 a las 14:10 y 17:40 (final Francia–Sudáfrica); final de la Copa Libertadores Palmeiras–Estudiantes sáb 28 a las 21:00; UCLA–USC sáb 28 a las 21:30.'
  : 'This weekend, LIVE on our screens (Madrid time): Nations Championship rugby Sat 28 at 14:10 and 17:40 and Sun 29 at 14:10 and 17:40 (France v South Africa final); Copa Libertadores final Palmeiras v Estudiantes Sat 28 at 21:00; UCLA v USC Sat 28 at 21:30.';
const ariaVideo = es
  ? 'Vídeo: fin de semana de deporte 28 y 29 de noviembre de 2026 en Dubliners'
  : 'Video: sports weekend 28–29 November 2026 at Dubliners';
const whatsOnHref = withBase(es ? '/es/partidos/' : '/whats-on/');
---
<section
  class="home-weekend-video"
  id={es ? 'fin-de-semana-28-29' : 'weekend-28-29'}
  data-show-until-ms={String(untilMs)}
  data-home-block="weekend-video-28-29"
  aria-label={es ? 'Fin de semana de deporte 28–29 nov en Dubliners' : 'Sports weekend 28–29 Nov at Dubliners'}
>
  <video
    class="home-weekend-video__video"
    autoplay
    muted
    loop
    playsinline
    preload="metadata"
    poster={poster}
    width="960"
    height="720"
    aria-label={ariaVideo}
  >
    <source src={videoSrc} type="video/mp4" />
  </video>
  <div class="home-weekend-video__bar container">
    <div class="home-weekend-video__cta">
      <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">{es ? 'Cómo llegar' : 'Get directions'}</a>
      <a class="btn btn-secondary" data-track-event="whats_on_cta_click" href={whatsOnHref}>{es ? 'Partidos de la semana' : 'What’s On this week'}</a>
    </div>
    <p class="home-weekend-video__copy">{copy}</p>
    <button type="button" class="home-weekend-video__toggle" data-weekend-video-toggle data-label-pause={es ? 'Pausar vídeo' : 'Pause video'} data-label-play={es ? 'Reproducir vídeo' : 'Play video'}>{es ? 'Pausar vídeo' : 'Pause video'}</button>
  </div>
</section>
<script is:inline>
(function () {
  var b = document.querySelector('[data-weekend-video-toggle]');
  var v = document.querySelector('.home-weekend-video__video');
  if (!b || !v) return;
  b.addEventListener('click', function () {
    if (v.paused) { v.play(); b.textContent = b.getAttribute('data-label-pause'); }
    else { v.pause(); b.textContent = b.getAttribute('data-label-play'); }
  });
})();
</script>

<style>
  .home-weekend-video {
    margin: 0;
    background: var(--bg);
    border-bottom: 1px solid var(--border);
  }
  .home-weekend-video {
    overflow: visible;
  }
  .home-weekend-video__video {
    display: block;
    width: 100% !important;
    max-width: 720px;
    height: auto !important;
    max-height: none !important;
    aspect-ratio: 4 / 3;
    object-fit: contain !important;
    object-position: center;
    margin: 0 auto;
    border: 0;
    border-radius: 0;
    background: #000;
  }
  .home-weekend-video__toggle {
    margin-top: 0.45rem;
    padding: 0.3rem 0;
    background: none;
    border: 0;
    color: inherit;
    font: inherit;
    font-size: 0.82rem;
    text-decoration: underline;
    cursor: pointer;
  }
  .home-weekend-video__bar {
    padding: 0.6rem 1rem 0.85rem;
  }
  .home-weekend-video__cta {
    display: flex;
    gap: 0.5rem;
  }
  .home-weekend-video__cta .btn {
    flex: 1 1 0;
    text-align: center;
  }
  .home-weekend-video__copy {
    margin: 0.55rem 0 0;
    font-size: 0.9rem;
    line-height: 1.4;
  }
  @media (min-width: 640px) {
    .home-weekend-video__cta .btn {
      flex: 0 0 auto;
    }
  }
</style>
