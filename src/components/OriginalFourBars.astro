---
/**
 * Four sister bars + Maps. Campaign copy retired 9 Nov 2026 (past tense).
 */
import { FOUR_BARS_MAPS } from '../data/fourBars';
import { withBase } from '../site';

interface Props {
  lang: 'en' | 'es';
  when: 'tonight' | 'sunday';
  findHref?: string;
}
const { lang } = Astro.props;
const MAPS = FOUR_BARS_MAPS;
const es = lang === 'es';
const home = es ? '/es/' : '/';
const hub = es ? '/es/cuatro-bares-fin-de-semana/' : '/4-bars-one-fan-weekend/';
---

{es ? (
  <>
    <h2>Los cuatro bares hermanos</h2>
    <p>
      Archivo del 7 y 8 de noviembre de 2026. Ese fin de semana ya pasó.
      O’Reilly’s (Pasaje de Matheu 4), Dubliners y O’Connell’s (Espoz y Mina 7) y Four Corner (Calle de la Victoria 6)
      siguen en las mismas calles — contexto geográfico.
    </p>
  </>
) : (
  <>
    <h2>The four sister bars</h2>
    <p>
      Archive of 7 and 8 November 2026. That weekend has passed.
      O’Reilly’s (Pasaje de Matheu 4), Dubliners and O’Connell’s (Espoz y Mina 7) and Four Corner (Calle de la Victoria 6)
      still sit on those streets — geographic context only.
    </p>
  </>
)}

<h3>O'Reilly's Restaurant Bar</h3>
<p>
  Pasaje de Matheu 4, 28012 Madrid.<br />
  {es ? 'Horario habitual: todos los días 11:30–01:30.' : 'Usual hours: daily 11:30–01:30.'}<br />
  <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">O'Reilly's on Google Maps</a>
</p>
<h3>Dubliners</h3>
<p>
  Calle de Espoz y Mina 7, 28012 Madrid.<br />
  {es ? 'Lun–jue y dom 12:00–02:00 · vie–sáb 12:00–02:30.' : 'Sun–Thu 12:00–02:00 · Fri–Sat 12:00–02:30.'}<br />
  <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Dubliners on Google Maps</a>
</p>
<h3>O'Connell's</h3>
<p>
  Calle de Espoz y Mina 7, 28012 Madrid.<br />
  {es ? 'Domingo habitual desde las 14:00.' : 'Usual Sunday from 14:00.'}<br />
  <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">O'Connell's on Google Maps</a>
</p>
<h3>Four Corner</h3>
<p>
  Calle de la Victoria 6, 28012 Madrid.<br />
  {es ? 'Abierto desde las 14:00 hasta la madrugada · pantallas de deporte.' : 'Open from 14:00 until late · sports screens.'}<br />
  <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Four Corner on Google Maps</a>
</p>

<p>
  Maps:
  {' '}
  <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's</a>
  {' · '}
  <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners</a>
  {' · '}
  <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell's</a>
  {' · '}
  <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Four Corner</a>
</p>
<p class="small">
  {es ? (
    <>
      <a href={withBase(home)}>Inicio Dubliners</a>
      {' · '}
      <a href={withBase(hub)}>Archivo de aquel fin de semana</a>
    </>
  ) : (
    <>
      <a href={withBase(home)}>Dubliners home</a>
      {' · '}
      <a href={withBase(hub)}>That weekend’s archive</a>
    </>
  )}
</p>
