---
/**
 * Four sister bars + Maps for original weekend articles only.
 * Tonight: three doors open; Four Corner is Sunday 14:00.
 * Sunday: all four, Four Corner from 14:00 with sports screens.
 */
import { FOUR_BARS_MAPS } from '../data/fourBars';
import FanWeekendCtas from './FanWeekendCtas.astro';
import { withBase } from '../site';

interface Props {
  lang: 'en' | 'es';
  when: 'tonight' | 'sunday';
  findHref?: string;
}
const { lang, when, findHref } = Astro.props;
const MAPS = FOUR_BARS_MAPS;
const es = lang === 'es';
const sunday = when === 'sunday';
const home = es ? '/es/' : '/';
const hub = es ? '/es/cuatro-bares-fin-de-semana/' : '/4-bars-one-fan-weekend/';
---

{es ? (
  <>
    <h2>Los cuatro bares hermanos</h2>
    {sunday ? (
      <p>
        Domingo 8 nov. O’Reilly’s desde las 11:30, Dubliners y O’Connell’s desde las 12:00, Four Corner desde las 14:00
        (pantallas de deporte). Preguntad en barra qué hay en pantalla — no todos los partidos van en todas las pantallas.
      </p>
    ) : (
      <p>
        Esta noche (sábado 7 nov) están abiertos tres: O’Reilly’s, Dubliners y O’Connell’s. Four Corner no abre hoy —
        entra el domingo 8 nov desde las 14:00, con pantallas de deporte. Hoy no hay NFL oficial.
      </p>
    )}

    <h3>O'Reilly's Restaurant Bar</h3>
    <p>
      Pasaje de Matheu 4, 28012 Madrid.<br />
      Restaurante-bar con terraza. Horario habitual: todos los días 11:30–01:30.
      {sunday ? '' : ' Abierto para la quedada 18:00–19:00.'}<br />
      <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">O'Reilly's en Google Maps</a>
    </p>

    <h3>Dubliners</h3>
    <p>
      Calle de Espoz y Mina 7, 28012 Madrid.<br />
      {sunday
        ? 'Domingo 8 nov: 12:00–02:00. Pantallas confirmadas para Bengals–Falcons 15:30, NFL desde las 19:00 / 22:05 / 22:25 y Atlético–Barcelona 21:00 — preguntad qué echan.'
        : 'Sábado 12:00–02:30. Quedada 18:00–19:00. Valencia–Real Madrid 21:00 EN DIRECTO solo aquí. Hoy no hay NFL.'}<br />
      <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Dubliners en Google Maps</a>
    </p>

    <h3>O'Connell's</h3>
    <p>
      Calle de Espoz y Mina 7, 28012 Madrid (misma calle que Dubliners; en Maps figura como O'Connell St).<br />
      {sunday
        ? 'Excepción domingo 8 nov: abre desde las 12:00 (habitual 14:00–03:00). Punto de encuentro; no listamos su programación.'
        : 'Sábado habitual 15:00–03:30 — ya abierto a las 18:00. Punto de encuentro; no copiamos aquí la parrilla de Dubliners.'}<br />
      <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">O'Connell's en Google Maps</a>
    </p>

    <h3>Four Corner</h3>
    <p>
      Calle de la Victoria 6, 28012 Madrid.<br />
      {sunday
        ? 'Domingo 8 nov: abre a las 14:00 hasta la madrugada. Tiene pantallas de deporte. No listamos qué partidos echa.'
        : 'No abre esta noche. Domingo 8 nov desde las 14:00 hasta la madrugada · pantallas de deporte. Sin horario de sábado ni lista de partidos.'}<br />
      <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Four Corner en Google Maps</a>
    </p>
  </>
) : (
  <>
    <h2>The four sister bars</h2>
    {sunday ? (
      <p>
        Sunday 8 Nov. O’Reilly’s from 11:30, Dubliners and O’Connell’s from 12:00, Four Corner from 14:00
        (sports screens). Ask at the bar which game is on — not every game on every screen.
      </p>
    ) : (
      <p>
        Tonight (Saturday 7 Nov) three doors are open: O’Reilly’s, Dubliners and O’Connell’s. Four Corner is not open tonight —
        it joins Sunday 8 Nov from 14:00, with sports screens. No official NFL game Saturday.
      </p>
    )}

    <h3>O'Reilly's Restaurant Bar</h3>
    <p>
      Pasaje de Matheu 4, 28012 Madrid.<br />
      Restaurant-bar with terrace. Usual hours: daily 11:30–01:30.
      {sunday ? '' : ' Open for the 18:00–19:00 meetup.'}<br />
      <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">O'Reilly's on Google Maps</a>
    </p>

    <h3>Dubliners</h3>
    <p>
      Calle de Espoz y Mina 7, 28012 Madrid.<br />
      {sunday
        ? 'Sunday 8 Nov: 12:00–02:00. Confirmed screens for Bengals–Falcons 15:30, NFL from 19:00 / 22:05 / 22:25 and Atlético–Barcelona 21:00 — ask which game is on.'
        : 'Saturday 12:00–02:30. Meetup 18:00–19:00. Valencia vs Real Madrid 21:00 LIVE here only. No NFL tonight.'}<br />
      <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Dubliners on Google Maps</a>
    </p>

    <h3>O'Connell's</h3>
    <p>
      Calle de Espoz y Mina 7, 28012 Madrid (same street as Dubliners; Maps listing: O'Connell St).<br />
      {sunday
        ? 'Exception Sunday 8 Nov: open from 12:00 (usual 14:00–03:00). Meeting point; we do not list its broadcasts.'
        : 'Usual Saturday 15:00–03:30 — already open by 18:00. Meeting point; we do not copy Dubliners’ board here.'}<br />
      <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">O'Connell's on Google Maps</a>
    </p>

    <h3>Four Corner</h3>
    <p>
      Calle de la Victoria 6, 28012 Madrid.<br />
      {sunday
        ? 'Sunday 8 Nov: opens 14:00 until late. Has sports screens. We do not list which games it shows.'
        : 'Not open tonight. Sunday 8 Nov from 14:00 until late · sports screens. No Saturday hours and no match list.'}<br />
      <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Four Corner on Google Maps</a>
    </p>
  </>
)}

<p>
  {es ? 'Maps:' : 'Maps:'}
  {' '}
  <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's</a>
  {' · '}
  <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners</a>
  {' · '}
  <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell's</a>
  {' · '}
  <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Four Corner{sunday ? '' : es ? ' (domingo 14:00)' : ' (Sunday 14:00)'}</a>
</p>

<FanWeekendCtas lang={lang} findHref={findHref} />
<p class="small">
  {es ? (
    <>
      <a href={withBase(home)}>Inicio Dubliners</a>
      {' · '}
      <a href={withBase(hub)}>VER LOS CUATRO BARES</a>
    </>
  ) : (
    <>
      <a href={withBase(home)}>Dubliners home</a>
      {' · '}
      <a href={withBase(hub)}>MEET US NEAR SOL</a>
    </>
  )}
</p>
<p class="small">
  {es
    ? 'Pubs independientes. No es un evento oficial de la NFL. Sin descuentos ni reservas inventadas.'
    : 'Independent pubs. Not an official NFL event. No invented discounts or bookings.'}
</p>
