---
/**
 * Four sister bars — geographic context. 8 Nov campaign copy retired 9 Nov 2026.
 */
import { FOUR_BARS_MAPS } from '../data/fourBars';

interface Props {
  lang: 'en' | 'es';
}
const { lang } = Astro.props;
const MAPS = FOUR_BARS_MAPS;
const es = lang === 'es';
---

<section id="four-bars">
{es ? (
  <>
    <h2>Los cuatro bares junto a Sol</h2>
    <p>
      O’Reilly’s, Dubliners, O’Connell’s y Four Corner están a pocos minutos de la Puerta del Sol.
      Preguntad en barra qué hay en pantalla. Independientes.
    </p>
    <h3>O'Reilly's Restaurant Bar</h3>
    <p>
      Pasaje de Matheu 4, 28012 Madrid.<br />
      Restaurante-bar con terraza. Horario habitual: todos los días 11:30–01:30.<br />
      <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
    </p>
    <h3>Dubliners</h3>
    <p>
      Calle de Espoz y Mina 7, 28012 Madrid.<br />
      Pub irlandés. Lun–jue y dom 12:00–02:00 · vie–sáb 12:00–02:30. Listados con nombre: Partidos.<br />
      <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
    </p>
    <h3>O'Connell's</h3>
    <p>
      Calle de Espoz y Mina 7, 28012 Madrid.<br />
      Pub irlandés deportivo. Domingo habitual desde las 14:00.<br />
      <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
    </p>
    <h3>Four Corner</h3>
    <p>
      Calle de la Victoria 6, 28012 Madrid.<br />
      Bar hermano con pantallas de deporte. Abierto desde las 14:00 hasta la madrugada.<br />
      <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
    </p>
  </>
) : (
  <>
    <h2>The four bars near Sol</h2>
    <p>
      O’Reilly’s, Dubliners, O’Connell’s and Four Corner sit a few minutes from Puerta del Sol.
      Ask at the bar which game is on. Independent pubs.
    </p>
    <h3>O'Reilly's Restaurant Bar</h3>
    <p>
      Pasaje de Matheu 4, 28012 Madrid.<br />
      Restaurant-bar with terrace. Usual hours: daily 11:30–01:30.<br />
      <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
    </p>
    <h3>Dubliners</h3>
    <p>
      Calle de Espoz y Mina 7, 28012 Madrid.<br />
      Irish pub. Sun–Thu 12:00–02:00 · Fri–Sat 12:00–02:30. Named listings: What’s On.<br />
      <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
    </p>
    <h3>O'Connell's</h3>
    <p>
      Calle de Espoz y Mina 7, 28012 Madrid.<br />
      Irish sports pub. Usual Sunday from 14:00.<br />
      <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
    </p>
    <h3>Four Corner</h3>
    <p>
      Calle de la Victoria 6, 28012 Madrid.<br />
      Sister bar with sports screens. Open from 14:00 until late.<br />
      <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
    </p>
  </>
)}
</section>
