---
import { SITE, withBase } from '../site';
import { type Lang, t } from '../i18n';

interface Props {
  lang?: Lang;
}
const { lang = 'en' } = Astro.props;
const copy = t(lang);
const whatsOnHref = lang === 'es' ? '/es/partidos/' : '/whats-on/';
---

<div class="sticky-cta" role="region" aria-label={lang === 'es' ? 'Acciones rápidas' : 'Quick actions'}>
  <a class="btn btn-secondary" href={withBase(whatsOnHref)}>{copy.whatsOn}</a>
  <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">{copy.directions}</a>
  <a class="btn btn-primary" href="#hours">{copy.openingHours}</a>
</div>
