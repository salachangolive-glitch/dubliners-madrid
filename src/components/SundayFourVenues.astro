---
/**
 * Four sister bars for Sunday 8 Nov 2026 campaign pages.
 * Screen claims stay on Dubliners only. Four Corner: 14:00 opening, no invented broadcasts.
 */
import { FOUR_BARS_MAPS, SISTER_SITES } from '../data/fourBars';
import SisterSitesLine from './SisterSitesLine.astro';

interface Props {
  lang: 'en' | 'es';
}
const { lang } = Astro.props;
const MAPS = FOUR_BARS_MAPS;
const es = lang === 'es';
---

{es ? (
  <>
    <h2>Los cuatro bares junto a Sol</h2>
    <p>
      Domingo 8 nov junto a Sol. Dubliners 12:00–02:00, Espoz y Mina 7. Bengals–Falcons EN DIRECTO 15:30
      (Bernabéu; también en pantalla grande). NFL desde las 19:00, luego 22:05 y 22:25. Atlético–Barcelona 21:00.
      Four Corner desde las 14:00 hasta la madrugada. Preguntad en barra qué hay en pantalla — no todos van en todas las pantallas.
      Pubs irlandeses independientes. No es un evento oficial de la NFL.
    </p>

    <h3>O'Reilly's Restaurant Bar</h3>
    <p>
      Pasaje de Matheu 4, 28012 Madrid.<br />
      Restaurante-bar con terraza. Horario habitual: todos los días 11:30–01:30.<br />
      <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
      {' · '}
      <a href={SISTER_SITES.oreillys} rel="noopener noreferrer" target="_blank">Web de O'Reilly's</a>
    </p>

    <h3>Dubliners</h3>
    <p>
      Calle de Espoz y Mina 7, 28012 Madrid.<br />
      Pub irlandés. Domingo 8 de noviembre: abre desde las <strong>12:00</strong> (hasta las 02:00).
      Pantallas confirmadas para Bengals–Falcons, la jornada NFL y Atlético–Barcelona — pregunta en barra qué echan.<br />
      <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
    </p>

    <h3>O'Connell's</h3>
    <p>
      Calle de Espoz y Mina 7, 28012 Madrid (misma calle que Dubliners; en Maps figura como O'Connell St).<br />
      Pub irlandés deportivo. Horario habitual domingo 14:00–03:00;
      <strong>excepción domingo 8 nov: abren desde las 12:00</strong>. Punto de encuentro; no listamos aquí su programación.<br />
      <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
      {' · '}
      <a href={SISTER_SITES.oconnellsEs} rel="noopener noreferrer" target="_blank">oconnellsmadrid.es</a>
    </p>

    <h3>Four Corner</h3>
    <p>
      Calle de la Victoria 6, 28012 Madrid.<br />
      Bar hermano con pantallas de deporte. Domingo 8 de noviembre: <strong>abre a las 14:00 hasta la madrugada</strong> — no a las 12:00.
      Apertura confirmada. Tiene pantallas de deporte; no listamos qué partidos echan.<br />
      <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
    </p>
  </>
) : (
  <>
    <h2>The four bars near Sol</h2>
    <p>
      Sunday 8 Nov near Sol. Dubliners open 12:00–02:00, Espoz y Mina 7. Bengals vs Falcons LIVE 15:30
      (Bernabéu game; also on our big screen). NFL from 19:00, then 22:05 and 22:25. Atlético vs Barcelona 21:00.
      Four Corner from 14:00 until late. Ask at the bar which game is on — not every game is on every screen.
      Independent Irish pubs. Not an official NFL event.
    </p>

    <h3>O'Reilly's Restaurant Bar</h3>
    <p>
      Pasaje de Matheu 4, 28012 Madrid.<br />
      Restaurant-bar with terrace. Usual hours: daily 11:30–01:30.<br />
      <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
      {' · '}
      <a href={SISTER_SITES.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's site</a>
    </p>

    <h3>Dubliners</h3>
    <p>
      Calle de Espoz y Mina 7, 28012 Madrid.<br />
      Irish pub. Sunday 8 November: open from <strong>12:00</strong> (until 02:00).
      Confirmed screens for Bengals–Falcons, Sunday NFL and Atlético–Barcelona — ask at the bar which game is on.<br />
      <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
    </p>

    <h3>O'Connell's</h3>
    <p>
      Calle de Espoz y Mina 7, 28012 Madrid (same street as Dubliners; Maps listing: O'Connell St).<br />
      Irish sports pub. Usual Sunday hours 14:00–03:00;
      <strong>exception Sunday 8 Nov: open from 12:00</strong>. Meeting point; we do not list its broadcasts here.<br />
      <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
      {' · '}
      <a href={SISTER_SITES.oconnells} rel="noopener noreferrer" target="_blank">oconnellsmadrid.es</a>
    </p>

    <h3>Four Corner</h3>
    <p>
      Calle de la Victoria 6, 28012 Madrid.<br />
      Sister bar with sports screens. Sunday 8 November: <strong>opens at 14:00 until late</strong> — not 12:00.
      Opening confirmed. It has sports screens; we do not list which games it shows.<br />
      <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Google Maps</a>
    </p>
  </>
)}
<SisterSitesLine lang={lang} />
