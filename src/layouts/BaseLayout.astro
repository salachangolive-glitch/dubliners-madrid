---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import Analytics from '../components/Analytics.astro';
import AttributionCapture from '../components/AttributionCapture.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { SITE, absUrl, withBase } from '../site';
import { openingHoursJsonLd } from '../data/hours';
import { type Lang, detectLang, hreflangFor, t, normalizePath } from '../i18n';

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: Lang;
  ogImage?: string;
  hreflang?: { en?: string; es?: string; nl?: string; de?: string; no?: string };
  /** Standalone page in another language (e.g. 'de'): sets html lang, self hreflang + x-default, no en/es alternates. */
  htmlLang?: string;
  /** Defaults to index,follow. Error documents pass noindex. */
  robots?: string;
  /** Emit the WebSite JSON-LD node (home pages only). */
  website?: boolean;
  /** Consolidated page: canonical points to this path and hreflang alternates are omitted (DG 24 Oct 2026). */
  canonicalPath?: string;
  /** Extra JSON-LD graph nodes (e.g. SportsEvent) rendered after BarOrPub. */
  extraJsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  lang: langProp,
  ogImage = '/images/facade.jpg',
  hreflang: hreflangProp,
  robots: robotsProp,
  extraJsonLd,
  htmlLang,
  website = false,
  canonicalPath,
} = Astro.props;

const extraJsonLdList = extraJsonLd
  ? Array.isArray(extraJsonLd)
    ? extraJsonLd
    : [extraJsonLd]
  : [];

const pathNorm = normalizePath(path);
const lang: Lang = langProp || detectLang(pathNorm);
const hreflang = canonicalPath ? {} : htmlLang && !hreflangProp ? {} : hreflangProp || hreflangFor(pathNorm);
const copy = t(lang);

const canonical = absUrl(canonicalPath ? normalizePath(canonicalPath) : pathNorm);
const ogImageAbs = absUrl(ogImage);

// GO LIVE on dublinersmadrid.es — indexable. 404 passes noindex.
const robots = robotsProp ?? 'index,follow';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BarOrPub',
  '@id': absUrl('/#pub'),
  name: SITE.name,
  alternateName: [SITE.fullName, 'Dubliners Irish Pub Madrid'],
  description: copy.jsonLdDescription,
  slogan: copy.jsonLdSlogan,
  url: absUrl(lang === 'es' ? '/es/' : '/'),
  hasMenu: absUrl(lang === 'es' ? '/es/carta/' : '/menu/'),
  knowsLanguage: ['en', 'es'],
  image: [
    absUrl('/images/facade.jpg'),
    absUrl('/images/mural-hero.jpg'),
    absUrl('/images/bar-interior.jpg'),
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address,
    addressLocality: 'Madrid',
    postalCode: '28012',
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 40.4158342,
    longitude: -3.7022626,
  },
  // Google Search Central: hours past midnight = one spec on the opening day
  // with closes earlier than opens (e.g. Sat 18:00–03:00). Same hours as GBP/footer.
  openingHoursSpecification: openingHoursJsonLd(),
  // Google Business Profile of Dubliners (CID from the Maps place data, evidence 12 Oct).
  // DG 24 Oct 2026: the former Premier/Champions freeze is lifted — one BarOrPub node on every page.
  hasMap: SITE.gbpUrl,
  sameAs: [SITE.instagram, SITE.gbpUrl],
  // Telephone: schema only, never in visible text (DG VERDE, LUNES-26 item 4, 26 Oct 2026; SCHEMA-TEL-DUB)
  telephone: '+34 915 32 79 56',
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.fullName,
  url: absUrl('/'),
  inLanguage: ['en', 'es'],
};
---

<!doctype html>
<html lang={htmlLang || lang} translate="no" class="notranslate">
  <head>
    <meta charset="utf-8" />
    <meta name="google-site-verification" content="giOZ-9tx7mDwt4RTFhmhWiqykIMNLBlm4Ye-AUKxdJU" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="google" content="notranslate" />
    {hreflang?.en && <link rel="alternate" hreflang="en" href={absUrl(hreflang.en)} />}
    {hreflang?.es && <link rel="alternate" hreflang="es" href={absUrl(hreflang.es)} />}
    {hreflang?.nl && <link rel="alternate" hreflang="nl" href={absUrl(hreflang.nl)} />}
    {hreflang?.de && <link rel="alternate" hreflang="de" href={absUrl(hreflang.de)} />}
    {hreflang?.no && <link rel="alternate" hreflang="no" href={absUrl(hreflang.no)} />}
    {(hreflang?.en || hreflang?.es) && (
      <link rel="alternate" hreflang="x-default" href={absUrl(hreflang.en || pathNorm)} />
    )}
    {htmlLang && !hreflangProp && <link rel="alternate" hreflang={htmlLang} href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:locale" content={htmlLang === 'de' ? 'de_DE' : htmlLang === 'nl' ? 'nl_NL' : htmlLang === 'no' ? 'nb_NO' : lang === 'es' ? 'es_ES' : 'en_GB'} />
    {lang === 'es' ? (
      <meta property="og:locale:alternate" content="en_GB" />
    ) : (
      <meta property="og:locale:alternate" content="es_ES" />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f1410" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    {website && <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />}
    {extraJsonLdList.map((node) => (
      <script type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <Header lang={lang} path={pathNorm} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
    <StickyCta lang={lang} />
    <CookieBanner lang={lang} />
    <AttributionCapture />
    <Analytics />
  </body>
</html>
