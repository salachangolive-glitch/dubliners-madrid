---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { SITE, absUrl, withBase } from '../site';
import { type Lang, detectLang, hreflangFor, t, normalizePath } from '../i18n';

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: Lang;
  ogImage?: string;
  hreflang?: { en?: string; es?: string };
}

const {
  title,
  description,
  path,
  lang: langProp,
  ogImage = '/images/facade.jpg',
  hreflang: hreflangProp,
} = Astro.props;

const pathNorm = normalizePath(path);
const lang: Lang = langProp || detectLang(pathNorm);
const hreflang = hreflangProp || hreflangFor(pathNorm);
const copy = t(lang);

const canonical = absUrl(pathNorm);
const ogImageAbs = absUrl(ogImage);

// GO LIVE on dublinersmadrid.es — indexable
const robots = 'index,follow';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BarOrPub',
  name: SITE.name,
  alternateName: SITE.fullName,
  description: copy.jsonLdDescription,
  url: absUrl(lang === 'es' ? '/es/' : '/'),
  image: [
    absUrl('/images/facade.jpg'),
    absUrl('/images/mural-hero.jpg'),
    absUrl('/images/bar-interior.jpg'),
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address,
    addressLocality: 'Madrid',
    postalCode: '28012',
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 40.4164,
    longitude: -3.7025,
  },
  // Google Search Central: hours past midnight = one spec on the opening day
  // with closes earlier than opens (e.g. Sat 18:00–03:00). Same hours as GBP/footer.
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Sunday'],
      opens: '12:00',
      closes: '02:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Friday', 'Saturday'],
      opens: '12:30',
      closes: '02:30',
    },
  ],
  sameAs: [SITE.instagram],
};
---

<!doctype html>
<html lang={lang} translate="no" class="notranslate">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    <meta name="google" content="notranslate" />
    {hreflang?.en && <link rel="alternate" hreflang="en" href={absUrl(hreflang.en)} />}
    {hreflang?.es && <link rel="alternate" hreflang="es" href={absUrl(hreflang.es)} />}
    {(hreflang?.en || hreflang?.es) && (
      <link rel="alternate" hreflang="x-default" href={absUrl(hreflang.en || pathNorm)} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    {lang === 'es' ? (
      <meta property="og:locale:alternate" content="en_GB" />
    ) : (
      <meta property="og:locale:alternate" content="es_ES" />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f1410" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">{copy.skip}</a>
    <Header lang={lang} path={pathNorm} />
    <main id="main-content">
      <slot />
    </main>
    <Footer lang={lang} />
    <StickyCta lang={lang} />
  </body>
</html>
