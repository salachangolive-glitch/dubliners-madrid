---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import StickyCta from '../components/StickyCta.astro';
import { SITE, absUrl, withBase } from '../site';

interface Props {
  title: string;
  description: string;
  path: string;
  lang?: string;
  ogImage?: string;
  hreflang?: { en?: string; es?: string };
}

const {
  title,
  description,
  path,
  lang = 'en',
  ogImage = '/images/facade.jpg',
  hreflang,
} = Astro.props;

const canonical = absUrl(path);
const ogImageAbs = absUrl(ogImage);

// github.io = preview only — always noindex until domain flip
const robots = 'noindex,follow';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BarOrPub',
  name: SITE.name,
  alternateName: SITE.fullName,
  description:
    'Irish pub near Puerta del Sol in Madrid with indoor sports screens. Walk-in. Wednesday €1 shots.',
  url: absUrl('/'),
  telephone: SITE.phone,
  image: [
    absUrl('/images/facade.jpg'),
    absUrl('/images/mural-hero.jpg'),
    absUrl('/images/bar-interior.jpg'),
  ],
  address: {
    '@type': 'PostalAddress',
    streetAddress: SITE.address,
    addressLocality: 'Madrid',
    postalCode: '28012',
    addressCountry: 'ES',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 40.4164,
    longitude: -3.7025,
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Monday', opens: '12:00', closes: '02:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Tuesday', opens: '12:00', closes: '02:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Wednesday', opens: '12:00', closes: '02:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Friday', opens: '12:30', closes: '02:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '12:30', closes: '02:30' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Sunday', opens: '12:00', closes: '02:00' },
  ],
  sameAs: [SITE.instagram],
};
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content={robots} />
    {hreflang?.en && <link rel="alternate" hreflang="en" href={absUrl(hreflang.en)} />}
    {hreflang?.es && <link rel="alternate" hreflang="es" href={absUrl(hreflang.es)} />}
    {(hreflang?.en || hreflang?.es) && (
      <link rel="alternate" hreflang="x-default" href={absUrl(hreflang.en || path)} />
    )}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.fullName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageAbs} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageAbs} />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" href={withBase('/favicon.ico')} />
    <meta name="generator" content={Astro.generator} />
    <meta name="theme-color" content="#0f1410" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <StickyCta />
  </body>
</html>
