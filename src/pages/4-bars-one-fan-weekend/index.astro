---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import { withBase } from '../../site';
import { OPENING_HOURS } from '../../data/hours';
import FanWeekendCtas from '../../components/FanWeekendCtas.astro';
import FourBarsMeet from '../../components/FourBarsMeet.astro';
import { FAN_WEEKEND_SATURDAY_TONIGHT, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

// Campaign landing: 4 BARS. ONE FAN WEEKEND. Owner correction 6 Nov 2026 15:48.
// One collective meeting point: four sister bars near Puerta del Sol, including Four Corner.
const path = '/4-bars-one-fan-weekend/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is 4 Bars. One Fan Weekend?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'One collective meeting point near Puerta del Sol across four sister bars a short walk apart: O\'Reilly\'s Restaurant Bar (Pasaje de Matheu 4), Dubliners and O\'Connell St (both at Espoz y Mina 7), and Four Corner (Calle de la Victoria 6). Saturday 7 and Sunday 8 November; Sunday from 12:00 at Dubliners.',
      },
    },
    {
      '@type': 'Question',
      name: 'When does Dubliners open on Sunday 8 November?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'From 12:00. Usual hours: Monday–Thursday and Sunday 12:00–02:00; Friday and Saturday 12:00–02:30.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which games are LIVE at Dubliners this weekend?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Saturday 7: Spain vs Uruguay rugby at 16:00 and Valencia vs Real Madrid at 21:00. Sunday 8: Bengals vs Falcons at 15:30, Sunday NFL games from 19:00, and Atlético vs Barcelona at 21:00. All times Madrid. Full list on What\'s On.',
      },
    },
  ],
};
---

<BaseLayout
  title="4 BARS. ONE FAN WEEKEND. | NFL Madrid near Sol — Dubliners"
  description="Four bars near Sol, 7–8 Nov: O'Reilly's, Dubliners, O'Connell's and Four Corner. Addresses, Maps, hours. Sunday: Dubliners from 12:00, Four Corner from 14:00."
  path={path}
  lang="en"
  hreflang={{ en: path, es: '/es/cuatro-bares-fin-de-semana/' }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="4 Bars. One Fan Weekend" schema />
      <h1>4 BARS. ONE FAN WEEKEND.</h1>
      <p class="lead">
        <strong>NFL Madrid 2026 — 7 &amp; 8 November.</strong> Four sister bars a short walk from Puerta del Sol —
        <strong>one fan meeting point</strong> for the weekend, not four separate nights out.
      </p>
      <p class="small">Friday 6 · Saturday 7 · Sunday 8 November 2026 · Near Puerta del Sol</p>
      <p class="small">En español: <a href={withBase('/es/cuatro-bares-fin-de-semana/')} hreflang="es" lang="es">Cuatro bares. Un gran fin de semana deportivo</a></p>
      <FanWeekendCtas lang="en" findHref="#meet-us-near-sol" />
      <div class="cta-row">
        <a class="btn btn-gold" href={withBase(FAN_WEEKEND_SATURDAY_TONIGHT.en)} data-show-until="2026-11-07">Tonight 18:00–19:00</a>
        <a class="btn btn-secondary" href={withBase('/nfl-madrid/')}>NFL at Dubliners</a>
      </div>
    </div>
  </section>

  <FourBarsMeet lang="en" compact />

  <section class="section">
    <div class="container prose">
      <h2>Four bars, one meeting point near Sol</h2>
      <p>
        The idea is collective: four sister bars in the same streets around Puerta del Sol, so fans can meet in one area
        before the game, after the game, and through Sunday. O'Reilly's Restaurant Bar, Dubliners, O'Connell St and Four Corner
        sit a few minutes from each other — one fan meeting point, not four isolated campaigns.
      </p>

      <h2>Before the game. After the game. All Sunday football.</h2>
      <p>
        Fans arriving for NFL Madrid do not need to wait until kick-off on Sunday. On Saturday you can keep the day going a few minutes’ walk from Sol
        (Spain vs Uruguay rugby at 16:00 and Valencia vs Real Madrid at 21:00 LIVE at Dubliners).
        On Sunday Dubliners opens from <strong>12:00</strong> — meeting point atmosphere from midday, then Bengals vs Falcons LIVE from 15:30,
        more NFL from 19:00, and Atlético vs Barcelona at 21:00 on our screens.
      </p>

      <h2 id="the-four-sister-bars">FIND US · The four sister bars</h2>
      <p>Each has its own character. All sit within a few minutes of Puerta del Sol.</p>

      <h3>O'Reilly's Restaurant Bar</h3>
      <p>
        Restaurant-bar with terrace · Pasaje de Matheu 4, 28012 Madrid.<br />
        Hours: open daily 11:30–01:30.<br />
        <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Google Maps</a>
        · <a href="https://oreillys-restaurant-bar.localo.site/" rel="noopener" target="_blank">O'Reilly's site</a>
      </p>
      <p>
        Sports on screens in a restaurant-bar setting a short walk from Sol — useful if you want to eat, meet up and follow the weekend.
        Check their site and Maps listing for the latest hours.
      </p>

      <h3>Dubliners</h3>
      <p>
        Irish pub · Calle de Espoz y Mina 7, 28012 Madrid.<br />
        Hours: Mon–Thu &amp; Sun 12:00–02:00 · Fri–Sat 12:00–02:30. Sunday 8 November: open from 12:00.<br />
        <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Google Maps</a>
        · <a href={withBase('/nfl-madrid/')}>NFL in Madrid</a>
        · <a href={withBase('/whats-on/')}>What's On</a>
        · <a href="https://dublinersmadrid.es/">dublinersmadrid.es</a>
      </p>
      <p>
        <strong>Confirmed LIVE this weekend (Dubliners screens):</strong>
      </p>
      <ul data-show-until={SHOW_UNTIL}>
        <li><strong>Sat 7 Nov, 16:00</strong> — Spain vs Uruguay (rugby, Nations Cup, Complutense)</li>
        <li><strong>Sat 7 Nov, 21:00</strong> — Valencia vs Real Madrid</li>
        <li><strong>Sun 8 Nov, 15:30</strong> — Bengals vs Falcons (Madrid Game) on the <strong>big screen</strong></li>
        <li><strong>Sun 8 Nov, from 19:00</strong> — Sunday NFL games LIVE (within opening hours; we close at 02:00)</li>
        <li><strong>Sun 8 Nov, 21:00</strong> — Atlético de Madrid vs FC Barcelona</li>
      </ul>
      <p class="small">Full fixture list: <a href={withBase('/whats-on/')}>What's On</a>. Hour-by-hour Sunday: <a href={withBase('/nfl-sunday-madrid-guide/')}>NFL Sunday guide</a>.</p>

      <h3>O'Connell St</h3>
      <p>
        Irish sports pub · Calle de Espoz y Mina 7, 28012 Madrid (same street as Dubliners).<br />
        Usual hours: Mon–Thu 18:00–03:00 · Fri 16:00–03:30 · Sat 15:00–03:30 · Sun 14:00–03:00.
        <strong>Exception Sunday 8 Nov: open from 12:00.</strong><br />
        <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Google Maps</a>
        · <a href="https://oconnellsmadrid.es/nfl-madrid" rel="noopener" target="_blank">NFL at O'Connell St</a>
        · <a href="https://oconnellsmadrid.es/" rel="noopener" target="_blank">oconnellsmadrid.es</a>
      </p>
      <p>
        Another meeting point on Espoz y Mina for NFL and football. On Sunday 8 they open from 12:00 for the Madrid Game day.
      </p>

      <h3>Four Corner</h3>
      <p>
        Sister bar in the same area · Calle de la Victoria 6, 28012 Madrid.<br />
        Four Corner: Sunday 8 November from 14:00 until late. Has sports screens.<br />
        <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Google Maps</a>
      </p>
      <p>
        Four Corner joins the same fan meeting point around Sol on Sunday — a sister bar with sports screens,
        a short walk from the other three. Opening is confirmed; we do not list which games it shows.
      </p>

      <h2>Saturday 7 November — tonight 18:00–19:00</h2>
      <p data-show-until="2026-11-07">
        Meetup <strong>18:00–19:00</strong> at the three bars open Saturday:
        O’Reilly’s (Pasaje de Matheu 4), Dubliners and O’Connell’s (both Espoz y Mina 7).
        <strong>Four Corner is not open tonight</strong> — Sunday from 14:00, with sports screens.
        No official NFL game Saturday. After 19:00, Valencia vs Real Madrid 21:00 LIVE at Dubliners only.
      </p>
      <p data-show-until="2026-11-07">
        Maps:
        <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O’Reilly’s</a>
        · <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners</a>
        · <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O’Connell’s</a>
        · <a href={withBase('/nfl-fans-madrid-this-saturday/')}>Tonight’s guide</a>
        · <a href={withBase('/saturday-in-sol-today/')}>Walk from Sol</a>
      </p>
      <p data-show-until="2026-11-07">
        Stepping off Metro Sol as 21:00 starts?
        <a href={withBase('/sol-metro-2100-which-saturday-door/')}>Which of the three Saturday doors</a>
        (walking minutes + Maps). English fans whose Premier starts Sunday 15:00:
        <a href={withBase('/english-tourists-saturday-hours-until-premier/')}>what Saturday night is still for</a>,
        then the four-bar stack from Victoria 6.
        After Valencia–RM: <a href={withBase('/hop-two-streets-last-pint-after-derby/')}>last pint on the two streets still open</a>
        (door-to-door metres + Maps). Overnight clock:
        <a href={withBase('/fifteen-hours-sol-until-four-corner-1400/')}>~15 hours until Four Corner 14:00</a>, stay in Sol.
      </p>

      <h2>Sunday 8 November — from 12:00</h2>
      <p data-show-until={SHOW_UNTIL}>
        The day starts at midday, not after the Bernabéu whistle. Dubliners opens at 12:00; O'Connell St also opens from 12:00 that day.
        Four Corner: Sunday 8 November from 14:00 until late (sports screens). Bengals vs Falcons at 15:30, more NFL from 19:00, Atlético–Barcelona at 21:00.
      </p>
      <p data-show-until={SHOW_UNTIL}>
        Waking in a Sol hotel or Airbnb?
        <a href={withBase('/from-sol-hotel-first-sunday-street-victoria-6/')}>First Sunday street is Victoria 6</a>
        — arrive before 14:00 (door not open before then), then hop Matheu 4 and Espoz y Mina 7 twice (metres + Maps).
        English fans whose first football today is the 15:00 Premier block, then United 17:30:
        <a href={withBase('/wake-sol-sunday-premier-block-which-door/')}>which of the four Sunday doors to aim for</a>.
        Landed Barajas in the small hours and missed Saturday?
        <a href={withBase('/barajas-small-hours-into-sol-until-1400/')}>Taxi (Metro typically shut) into Sol; first useful door is Four Corner 14:00</a>,
        then the three sister doors.         Mixed table — English Premier 15:00, NFL later, Atleti 21:00:
        <a href={withBase('/two-streets-all-day-premier-nfl-atleti/')}>stay on Victoria and Espoz y Mina all day</a> (Matheu is the cut-through).
        Riding the first Sunday Metro <em>into</em> Sol (not a hotel, not Barajas)?
        <a href={withBase('/first-metro-into-sol-sunday-station-to-door/')}>Station to Victoria 6, Espoz y Mina 7, Pasaje de Matheu 4</a>
        when Sunday Metro starts. Not chasing Liverpool, Chelsea or United?
        <a href={withBase('/brighton-ipswich-1500-sol-skip-liverpool-chelsea-united/')}>Brighton–Brentford and Ipswich–Bournemouth at 15:00</a>
        — four-bar meet, ask which screen.
        Already on Plaza Mayor (a plaza, not a fan venue)?
        <a href={withBase('/plaza-mayor-arcade-downhill-sol-doors-before-1400/')}>East arcade downhill to the four doors before 14:00</a>
        (street names, metres, Maps). Group splitting Premier 15:00 vs NFL later?
        <a href={withBase('/espoz-mina-7-two-doors-split-premier-then-nfl/')}>Dubliners and O’Connell’s share Espoz y Mina 7</a>
        — same number, two doors; then Matheu 4 and Victoria 6.
        Off a train at Atocha (AVE / Cercanías, not Metro, not Barajas)?
        <a href={withBase('/atocha-cercanias-one-stop-into-sol-doors-before-1400/')}>C3/C4 one stop to Sol, then the four doors before 14:00</a>
        (concourse exits, metres, Maps). November weather, first pint under glass before 15:00?
        <a href={withBase('/glass-arcade-matheu-4-first-pint-before-sunday-kickoff/')}>O’Reilly’s in Pasaje de Matheu 4, then hop Espoz y Mina 7 and Victoria 6</a>.
        Shopping at Callao / Calle de Preciados with bags in hand?
        <a href={withBase('/callao-preciados-shop-south-sol-doors-before-1400/')}>Walk Preciados south to the four doors before 14:00</a>
        (shopping street, metres, Maps). Three hours to spare until Four Corner 14:00?
        <a href={withBase('/oreillys-table-three-hours-until-victoria-6-1400/')}>Sit a table at O’Reilly’s, then hop Victoria 6 and Espoz y Mina 7</a>.
        Already south of Sol at Tirso de Molina or Antón Martín (L1)?
        <a href={withBase('/tirso-anton-martin-north-sol-doors-before-1400/')}>Walk north on Magdalena / Cruz / Espoz y Mina to the four doors before 14:00</a>
        (street names, metres, Maps). Last 60 minutes before Four Corner 14:00?
        <a href={withBase('/last-hour-before-four-corner-1400/')}>Sit now at O’Reilly’s and Dubliners (usual 11:30 / 12:00), then walk Victoria 6 and O’Connell’s usual Sunday door at 14:00</a>.
      </p>

      <h2>Opening hours at Dubliners</h2>
      <ul>{OPENING_HOURS.map((d) => <li>{d.day}: {d.opens}–{d.closes}</li>)}</ul>

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>What is 4 Bars. One Fan Weekend?</strong></dt>
        <dd>One collective meeting point near Puerta del Sol across four sister bars a short walk apart: O'Reilly's, Dubliners, O'Connell St and Four Corner. Saturday 7 and Sunday 8 November; Sunday from 12:00 at Dubliners.</dd>
        <dt><strong>When does Dubliners open on Sunday 8 November?</strong></dt>
        <dd>From 12:00. Usual hours: Monday–Thursday and Sunday 12:00–02:00; Friday and Saturday 12:00–02:30.</dd>
        <dt><strong>Which games are LIVE at Dubliners this weekend?</strong></dt>
        <dd>Saturday: Spain vs Uruguay (16:00) and Valencia vs Real Madrid (21:00). Sunday: Bengals vs Falcons (15:30), Sunday NFL from 19:00, and Atlético vs Barcelona (21:00). See <a href={withBase('/whats-on/')}>What's On</a>.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Saturday 7 November',
            until: SHOW_UNTIL,
            items: [
              { href: '/nfl-fans-madrid-this-saturday/', label: 'Tonight 18:00–19:00', note: 'Three bars open Saturday', until: '2026-11-07' },
              { href: '/sol-metro-2100-which-saturday-door/', label: 'Off Metro Sol at 21:00', note: 'Three Saturday doors + walking minutes', until: '2026-11-07' },
              { href: '/english-tourists-saturday-hours-until-premier/', label: 'English fans: Saturday left until 15:00', note: 'Then Sunday from Victoria 6', until: SHOW_UNTIL },
              { href: '/hop-two-streets-last-pint-after-derby/', label: 'Last pint after Valencia–RM', note: 'Three doors on two streets + metres', until: '2026-11-07' },
              { href: '/fifteen-hours-sol-until-four-corner-1400/', label: 'Overnight clock: 15 hours to 14:00', note: 'Stay in Sol until Four Corner + PL 15:00', until: SHOW_UNTIL },
              { href: '/meetup-1800-pasaje-matheu-espoz-mina/', label: 'Meetup walking order 18:00–19:00', note: 'Pasaje de Matheu to Espoz y Mina', until: '2026-11-07' },
              { href: '/walk-sol-four-sister-bars/', label: 'Walk from Sol to the four bars', note: 'Tonight vs Sunday', until: SHOW_UNTIL },
              { href: '/international-nfl-fans-near-sol/', label: 'International NFL fans near Sol', note: 'English-speaking rooms', until: SHOW_UNTIL },
              { href: '/saturday-in-sol-today/', label: 'Saturday in Sol today', note: 'Walk from Puerta del Sol', until: SHOW_UNTIL },
              { href: '/saturday-night-sol-valencia-real-madrid/', label: 'Valencia–Real Madrid 21:00', note: 'LIVE at Dubliners only', until: SHOW_UNTIL },
              { href: '/whats-on/', label: "What's On", note: 'Confirmed Saturday fixtures' },
            ],
          },
          {
            title: 'Sunday 8 November',
            until: SHOW_UNTIL,
            items: [
              { href: '/from-sol-hotel-first-sunday-street-victoria-6/', label: 'Sol hotel: first Sunday street is Victoria 6', note: 'Arrive before 14:00, then three sister doors', until: SHOW_UNTIL },
              { href: '/wake-sol-sunday-premier-block-which-door/', label: 'Woke up: 15:00 Premier — which Sunday door', note: 'Then United 17:30', until: SHOW_UNTIL },
              { href: '/barajas-small-hours-into-sol-until-1400/', label: 'Landed Barajas ~03:00: taxi into Sol', note: 'First useful door Four Corner 14:00', until: SHOW_UNTIL },
              { href: '/two-streets-all-day-premier-nfl-atleti/', label: 'Two streets all day: Premier, NFL, Atleti', note: 'Victoria + Espoz y Mina', until: SHOW_UNTIL },
              { href: '/first-metro-into-sol-sunday-station-to-door/', label: 'First Sunday Metro into Sol: station to door', note: 'Victoria / Espoz y Mina / Matheu · when Metro starts', until: SHOW_UNTIL },
              { href: '/brighton-ipswich-1500-sol-skip-liverpool-chelsea-united/', label: 'Skip Liverpool/Chelsea/United: Brighton & Ipswich 15:00', note: 'Quieter English games · ask which screen', until: SHOW_UNTIL },
              { href: '/plaza-mayor-arcade-downhill-sol-doors-before-1400/', label: 'Plaza Mayor east arcade downhill before 14:00', note: 'Tourist street route · metres + Maps', until: SHOW_UNTIL },
              { href: '/espoz-mina-7-two-doors-split-premier-then-nfl/', label: 'Espoz y Mina 7: two doors, one number', note: 'Split Premier 15:00 vs NFL later', until: SHOW_UNTIL },
              { href: '/atocha-cercanias-one-stop-into-sol-doors-before-1400/', label: 'Atocha Cercanías: one stop into Sol before 14:00', note: 'C3/C4 train, not Metro · concourse to four doors', until: SHOW_UNTIL },
              { href: '/glass-arcade-matheu-4-first-pint-before-sunday-kickoff/', label: 'Pasaje de Matheu 4: covered arcade, first pint', note: 'Glass roof before 15:00 · then hop to Victoria 6', until: SHOW_UNTIL },
              { href: '/callao-preciados-shop-south-sol-doors-before-1400/', label: 'Callao–Preciados: shop south to four doors before 14:00', note: 'Shopping street walk · bags to pint · ~3 h to Victoria 6', until: SHOW_UNTIL },
              { href: '/oreillys-table-three-hours-until-victoria-6-1400/', label: 'Three hours to spare: O’Reilly’s table until 14:00', note: 'Sit down at Matheu 4 · then hop Victoria 6', until: SHOW_UNTIL },
              { href: '/last-hour-before-four-corner-1400/', label: 'Last 60 minutes: sit O’Reilly’s and Dubliners, walk at 14:00', note: 'Usual 11:30 / 12:00 now · Four Corner + O’Connell’s usual Sunday door', until: SHOW_UNTIL },
              { href: '/tirso-anton-martin-north-sol-doors-before-1400/', label: 'Tirso / Antón Martín: walk north to four doors before 14:00', note: 'L1 south of Sol · Magdalena / Cruz · metres + Maps', until: SHOW_UNTIL },
              { href: '/four-corner-opens-sunday-1400/', label: 'Four Corner opens 14:00', note: 'Sports screens · Victoria 6', until: SHOW_UNTIL },
              { href: '/which-sister-bar-sunday-sol/', label: 'Which sister bar on Sunday', note: 'Terrace, screens, or sports pub', until: SHOW_UNTIL },
              { href: '/sunday-nfl-slate-stay-in-sol/', label: 'Sunday slate without leaving Sol', note: '12:00 to late', until: SHOW_UNTIL },
              { href: '/pick-sunday-nfl-clock-sol/', label: 'Pick a Sunday NFL clock', note: '15:30 vs 19:00 doors', until: SHOW_UNTIL },
