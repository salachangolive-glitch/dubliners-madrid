              { href: '/tonight-valencia-then-sunday-sol/', label: 'Tonight Valencia, then Sunday kick-off', until: SHOW_UNTIL },
              { href: '/after-valencia-late-sol/', label: 'After Valencia: late rooms tonight', until: '2026-11-07' },
              { href: '/sunday-lunch-then-screens-sol/', label: 'Sunday lunch then screens', until: SHOW_UNTIL },
