---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../site';

const title = 'Page not found | Dubliners Madrid';
const description = 'That page doesn’t exist. Head home to Dubliners Irish pub near Puerta del Sol.';
---

<BaseLayout title={title} description={description} path="/404/">
  <section class="section">
    <div class="container not-found">
      <h1>404 — page not found</h1>
      <p class="lead" style="margin-inline:auto">
        That URL isn’t on this site. Try the home page or visit info.
      </p>
      <div class="cta-row" style="justify-content:center">
        <a class="btn btn-primary" href={withBase('/')}>Home</a>
        <a class="btn btn-secondary" href={withBase('/visit/')}>Visit / hours</a>
        <a class="btn btn-secondary" href={withBase('/whats-on/')}>What's on</a>
      </div>
    </div>
  </section>
</BaseLayout>
