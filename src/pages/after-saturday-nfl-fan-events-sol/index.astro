---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

// After-event capture, Sat 7 Nov. Origin points only (no event links, no OnePass).
// NFL Experience Plaza de España until 19:00; NFL House Casa de las Alhajas / Plaza de San Martín until 20:00.
const path = '/after-saturday-nfl-fan-events-sol/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: "After Saturday's fan events: walk to the four bars in Sol",
  inLanguage: 'en',
  datePublished: '2026-11-07T15:00:00+01:00',
  dateModified: '2026-11-07T15:00:00+01:00',
  image: [absUrl('/images/facade.jpg')],
  mainEntityOfPage: absUrl(path),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Where do I go after the Saturday fan events?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Walk to Puerta del Sol. Four sister bars share the next streets: O'Reilly's Restaurant Bar (Pasaje de Matheu 4), Dubliners and O'Connell St (Espoz y Mina 7), and Four Corner (Calle de la Victoria 6).",
      },
    },
    {
      '@type': 'Question',
      name: 'When do the Saturday fan events finish?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'NFL Experience in Plaza de España is listed until 19:00 today. NFL House at Casa de las Alhajas on Plaza de San Martín is listed until 20:00 today. Dubliners stays open until 02:30 on Saturday.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are these bars an official NFL venue?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Independent sister bars near Sol. Not an official NFL event, and not the Saturday activations in Plaza de España or Plaza de San Martín.',
      },
    },
  ],
};
---

<BaseLayout
  title="After Saturday's NFL fan events: four bars in Sol | Dubliners"
  description="After NFL Experience (Plaza de España, until 19:00) or NFL House (Plaza de San Martín, until 20:00), walk to four sister bars near Sol. Maps for today."
  path={path}
  lang="en"
  hreflang={{ en: path, es: '/es/despues-eventos-nfl-sabado-sol/' }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="After Saturday fan events" schema />
      <h1>After Saturday's fan events: walk to the four bars in Sol</h1>
      <p class="lead">
        Official Saturday activations wind down this evening. The four sister bars around Puerta del Sol stay open.
        This page is <strong>where to go next</strong> — not those events, and not official NFL.
      </p>
      <p class="small">En español: <a href={withBase('/es/despues-eventos-nfl-sabado-sol/')} hreflang="es" lang="es">Después de los eventos NFL del sábado: los cuatro bares en Sol</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Walk to Dubliners — Maps</a>
        <a class="btn btn-secondary" href={withBase('/4-bars-one-fan-weekend/')}>All four bars</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Leave the activations, keep the same evening</h2>
      <p>
        Two official Saturday fan events are on in Madrid today, 7 November 2026:
        NFL Experience in <strong>Plaza de España until 19:00</strong>, and NFL House at Casa de las Alhajas on
        <strong>Plaza de San Martín until 20:00</strong> (NFL Spain / Marca, 2 Nov 2026; still listed on nfl.com's Madrid Game page).
        When those doors close, Sol is the next useful pocket — a short walk, not a taxi across town.
      </p>
      <p>
        We do not run those events, take bookings for them, or send you back there. No OnePass. No extra discounts.
        If you are already done, walk east toward Sol and meet in the four-bar cluster.
      </p>

      <h2>Walking, not a scavenger hunt</h2>
      <ul>
        <li>
          <strong>From Plaza de España:</strong> about 15–20 minutes on foot along Gran Vía or Calle del Arenal to Puerta del Sol.
        </li>
        <li>
          <strong>From Plaza de San Martín (Ópera):</strong> about 5–8 minutes down Calle del Arenal to Sol, then one more minute into Espoz y Mina.
        </li>
      </ul>

      <h2>The four bars — pin these</h2>

      <h3>O'Reilly's Restaurant Bar</h3>
      <p>
        Pasaje de Matheu 4, 28012 Madrid.<br />
        Useful if you want food and a terrace after a day on your feet. Usual hours on the live four-bar page: 11:30–01:30.<br />
        <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's on Google Maps</a>
      </p>

      <h3>Dubliners</h3>
      <p>
        Calle de Espoz y Mina 7, 28012 Madrid.<br />
        Saturday 12:00–02:30. Valencia vs Real Madrid at 21:00 is LIVE here — that kick-off sits after both Saturday activations close.<br />
        <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Google Maps</a>
      </p>

      <h3>O'Connell St</h3>
      <p>
        Calle de Espoz y Mina 7, 28012 Madrid (same doorway street as Dubliners).<br />
        Usual Saturday hours on the live four-bar page: 15:00–03:30.<br />
        <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell St on Google Maps</a>
      </p>

      <h3>Four Corner</h3>
      <p>
        Calle de la Victoria 6, 28012 Madrid.<br />
        Same cluster. Advertised from Saturday: Sunday 8 November from 14:00 until late. Saturday hours are not listed here.<br />
        <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Four Corner on Google Maps</a>
      </p>

      <p>
        Open Maps now:
        <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners</a>
        · <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's</a>
        · <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell St</a>
        · <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Four Corner</a>
      </p>

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Where do I go after the Saturday fan events?</strong></dt>
        <dd>Walk to Sol. O'Reilly's, Dubliners, O'Connell St and Four Corner share the next streets.</dd>
        <dt><strong>When do the Saturday fan events finish?</strong></dt>
        <dd>Plaza de España listed until 19:00; Plaza de San Martín until 20:00. Dubliners Saturday close 02:30.</dd>
        <dt><strong>Are these bars an official NFL venue?</strong></dt>
        <dd>No. Independent sister bars. Not official NFL.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Saturday in Sol',
            items: [
              { href: '/saturday-in-sol-today/', label: 'Saturday in Sol today', note: 'Find the four bars from Sol', until: SHOW_UNTIL },
              { href: '/saturday-night-sol-valencia-real-madrid/', label: 'Saturday night: Valencia–Real Madrid', note: '21:00 LIVE at Dubliners', until: SHOW_UNTIL },
              { href: '/4-bars-one-fan-weekend/', label: '4 Bars. One Fan Weekend' },
              { href: '/es/despues-eventos-nfl-sabado-sol/', label: 'Después de los eventos del sábado', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
