---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../components/OriginalFourBars.astro';
import FanWeekendCtas from '../../components/FanWeekendCtas.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/already-in-sol-during-madrid-game-four-open-doors/';
const PATH_ES = '/es/ya-en-sol-durante-madrid-game-cuatro-puertas-abiertas/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Already in Sol during the Madrid Game: four open doors as the in-city meeting point',
  inLanguage: 'en',
  datePublished: '2026-11-08T15:05:00+01:00',
  dateModified: '2026-11-08T15:05:00+01:00',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'I am already in Sol while Bengals–Falcons is on at the Bernabéu. Where is the in-city meeting point?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The four sister doors near Puerta del Sol — all open now. Four Corner, Calle de la Victoria 6, is open (from 14:00 until late, sports screens). Dubliners and O’Connell’s at Calle de Espoz y Mina 7. O’Reilly’s at Pasaje de Matheu 4. Hold that cluster while the stadium game is on, then meet stadium-exit fans after. Named listings: Dubliners What’s On only. Ask which game is on.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is this the before-and-after Bengals page or the after-game continue page?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Before-and-after is the Sol meet before 15:30 and the return after. After-game continue is the later NFL then Atlético–Barcelona 21:00 pin once the Madrid Game is behind you. Stadium-exit Maps is for people leaving the Bernabéu. This page is only the person already sitting in Sol while the stadium is still playing.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does holding Sol during the Madrid Game replace Premier 15:00 / 17:30 or Atlético–Barcelona 21:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Coordinate; do not substitute. Premier League from 15:00 and United–Villa 17:30 sit alongside the 15:30 Madrid Game on Dubliners What’s On. Later NFL from 19:00 and Atlético vs Barcelona 21:00 sit on the same two streets after. We do not assign those matches to O’Reilly’s, O’Connell’s or Four Corner. Ask which screen.',
      },
    },
  ],
};
---

<BaseLayout
  title="Already in Sol during the Madrid Game: four doors open NOW | Dubliners"
  description="Sunday 8 Nov: already in Sol, not at the Bernabéu. All four sister doors are open NOW while the Madrid Game is on at the stadium. Hold the in-city pin, then meet stadium-exit fans after. Maps. FIND US."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Already in Sol during the Madrid Game: four doors open NOW" schema />
      <h1>Already in Sol during the Madrid Game: four open doors as the in-city meeting point</h1>
      <p class="lead">
        You did <strong>not</strong> go to the Santiago Bernabéu. You are already near Puerta del Sol while Bengals vs Falcons is on at the stadium.
        <strong>All four sister doors are open NOW</strong> — Four Corner on Calle de la Victoria 6 (from 14:00 until late, sports screens),
        Dubliners and O’Connell’s at Espoz y Mina 7, O’Reilly’s at Pasaje de Matheu 4.
        Hold this cluster as the in-city pin. Stadium-exit fans join you after. Named listings: Dubliners What’s On only. Ask which game. Maps below.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Ya en Sol durante el Madrid Game: cuatro puertas abiertas ahora</a></p>
      <FanWeekendCtas lang="en" findHref="/visit/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>This is the during-game city pin — not before-after, not stadium-exit, not after-game continue</h2>
      <p>
        <a href={withBase('/before-after-bengals-falcons-sol/')}>Before and after Bengals–Falcons</a> is the Sol meet
        before 15:30 and the return after. <a href={withBase('/from-bernabeu-exit-to-four-sol-doors/')}>Stadium-exit Maps</a>
        is for people leaving the Bernabéu. <a href={withBase('/after-madrid-game-continue-four-open-doors/')}>After the Madrid Game</a>
        is the later-NFL then Atleti pin once that whistle has gone.
        This page is only the person <strong>already sitting in Sol while the stadium is still playing</strong>.
        Not a last hour before 14:00. Not a Plaza Mayor, Atocha, Callao or Tirso walk. Do not re-promote Saturday 18:00–19:00 as still on.
      </p>

      <h2>Hold the four-door pin while the stadium is on</h2>
      <p>
        Text the group <strong>Victoria 6 / Espoz y Mina 7 / Pasaje de Matheu 4</strong> — not a neighbourhood across town.
        Four Corner <strong>is open now</strong> (from 14:00 until late · sports screens). We do not list which game is on there.
        O’Reilly’s and O’Connell’s are meeting points on the same cluster; we do not copy Dubliners’ board onto those doors.
        Bengals vs Falcons is LIVE at 15:30 on Dubliners <a href={withBase('/whats-on/')}>What’s On</a> (also the Bernabéu game).
        Ask which screen. Not every game on every screen.
      </p>
      <ol>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid.</strong>
          Open NOW (from 14:00 until late · sports screens). Ask at the door.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          Sunday 12:00–02:00. Named screens on What’s On. Ask which game is on.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (Maps listing: O’Connell St).
          Same number, different door, different CID. Meeting point; we do not invent its board.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Covered passage. Usual from 11:30. Meeting point; no invented menu.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
      </ol>

      <h2>What sits on the city screens during 15:30 — then meet the stadium crowd</h2>
      <p>
        Dubliners <a href={withBase('/whats-on/')}>What’s On</a> already lists Sunday 8 November in Madrid time.
        Premier League from <strong>15:00</strong> (Crystal Palace vs Liverpool · Sunderland vs Chelsea · Brighton vs Brentford · Ipswich Town vs Bournemouth)
        sits alongside Bengals vs Falcons <strong>15:30</strong> LIVE. United–Villa is <strong>17:30</strong>.
        Later NFL from <strong>19:00</strong> then <strong>22:05</strong> / <strong>22:25</strong>, RedZone from 19:00, Atlético vs Barcelona <strong>21:00</strong>.
        Coordinate; do not substitute. Named listings: Dubliners only. We do not assign those matches to O’Reilly’s, O’Connell’s or Four Corner.
      </p>
      <p>
        When the stadium empties, keep the same pin. People leaving the Bernabéu use
        <a href={withBase('/from-bernabeu-exit-to-four-sol-doors/')}>Maps from the stadium to these four open doors</a>.
        After they sit, the later-NFL then Atleti pin is
        <a href={withBase('/after-madrid-game-continue-four-open-doors/')}>after-game continue at the four open doors</a>.
        Shirt split at Espoz y Mina 7?
        <a href={withBase('/bengals-falcons-split-two-doors-espoz-mina-7/')}>Bengals and Falcons fans, two doors, one number</a>.
      </p>

      <OriginalFourBars lang="en" when="sunday" findHref="/visit/" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Already in Sol while the Madrid Game is on at the stadium. Where do we meet?</strong></dt>
        <dd>The four open doors NOW: Victoria 6, Espoz y Mina 7 twice, Pasaje de Matheu 4. Hold that pin. Stadium-exit fans join after. Ask which game.</dd>
        <dt><strong>Is this before-after or after-game continue?</strong></dt>
        <dd>No. Those pages are the meet before 15:30 / the return, and the later-NFL then Atleti pin once the whistle has gone. This is during: already in Sol, stadium still playing.</dd>
        <dt><strong>Does this replace Premier 15:00 / 17:30 or Atleti 21:00?</strong></dt>
        <dd>No. Coordinate. Those clocks sit alongside on Dubliners What’s On. We do not copy that board onto sister doors.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Already in Sol this Sunday',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'FIND US — Dubliners home' },
              { href: '/visit/', label: 'GET DIRECTIONS — visit / hours' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/bengals-falcons-split-two-doors-espoz-mina-7/', label: 'Bengals and Falcons: split the two doors at Espoz y Mina 7' },
              { href: '/whats-on/', label: 'What’s On — named screens only' },
              { href: PATH_ES, label: 'Ya en Sol durante el Madrid Game: cuatro puertas abiertas ahora', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
