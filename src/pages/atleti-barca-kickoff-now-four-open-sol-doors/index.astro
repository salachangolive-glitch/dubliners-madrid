const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Atlético–Barcelona kickoff is NOW at the four open Sol doors',
  inLanguage: 'en',
  datePublished: '2026-11-08T21:00:00+01:00',
  dateModified: '2026-11-08T21:00:00+01:00',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Atlético vs Barcelona is kicking off now. Which of the four Sol doors do we walk into?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Any of the four open sister doors near Puerta del Sol. Four Corner, Calle de la Victoria 6, is open (from 14:00 until late, sports screens). Dubliners and O’Connell’s at Calle de Espoz y Mina 7. O’Reilly’s at Pasaje de Matheu 4. Named Atlético vs Barcelona 21:00: Dubliners What’s On only. At the sister doors, ask which game is on. Do not copy Dubliners’ board onto those doors.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is this the NFL-visitors page, the local gather, the 8 Nov Atleti cover, or the hop-from-19:00 NFL page?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. NFL visitors sharing Sol is for fans who came for NFL and share the square with 21:00 football. The local gather is the Spanish-fan meeting pin. The 8 Nov cover is the advance Atleti listing. Hop from 19:00 NFL is sit-then-hop at 21:00. This page is only the live 21:00 whistle: kickoff is NOW at the four open doors.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does walking in for Atleti 21:00 replace Premier or late NFL?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Coordinate; do not substitute. Premier 15:00 / 17:30 already sat on Dubliners What’s On. Late NFL from 22:05 / 22:25 still follows at the same four doors. We do not assign those matches to O’Reilly’s, O’Connell’s or Four Corner. Ask which screen.',
      },
    },
  ],
};
---

<BaseLayout
  title="Atleti–Barça kickoff is NOW at the four open Sol doors | Dubliners"
  description="Sunday 8 Nov 21:00: Atlético vs Barcelona is kicking off NOW at the four open Sol doors. Named screen: Dubliners What’s On. Sister doors: ask which game. Maps. FIND US."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Atleti–Barça kickoff is NOW at the four open Sol doors" schema />
      <h1>Atlético–Barcelona kickoff is NOW at the four open Sol doors</h1>
      <p class="lead">
        The <strong>21:00</strong> whistle is happening <strong>right now</strong>.
        This is not an advance listing and not a hop-from-NFL note.
        Walk into the four sister doors — all <strong>open NOW</strong> —
        Four Corner on Calle de la Victoria 6 (from 14:00 until late, sports screens),
        Dubliners and O’Connell’s at Espoz y Mina 7, O’Reilly’s at Pasaje de Matheu 4.
        Named Atlético vs Barcelona: Dubliners <a href={withBase('/whats-on/')}>What’s On</a> only.
        At the sister doors, <strong>ask which game</strong>. Maps below.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Atleti–Barça saque AHORA en las cuatro puertas abiertas de Sol</a></p>
      <FanWeekendCtas lang="en" findHref="/visit/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>This is the live 21:00 whistle — not visitors, not the local gather, not the cover, not hop-from-19:00</h2>
      <p>
        <a href={withBase('/nfl-visitors-sol-atletico-barcelona/')}>NFL visitors sharing Sol</a> is for fans who came for NFL and share the square with 21:00 football.
        <a href={withBase('/gather-sol-atletico-barcelona-sunday/')}>Local gather Sunday</a> is the Spanish-fan meeting pin.
        <a href={withBase('/atletico-barcelona-sol-8-nov/')}>Atlético–Barcelona near Sol, 8 Nov</a> is the advance cover.
        <a href={withBase('/nfl-on-now-1900-then-hop-atleti-2100/')}>NFL on NOW from 19:00, then hop</a> is sit for 19:00 NFL, then change doors at 21:00.
        This page is only <strong>kickoff already happening at 21:00</strong>: walk in now.
        Saturday’s three-bar meetup is over. Sunday is four doors. Do not re-promote 18:00–19:00 as still on.
      </p>

      <h2>Walk in now. Named screen is Dubliners; sister doors: ask which game</h2>
      <p>
        Text the group <strong>Victoria 6 / Espoz y Mina 7 / Pasaje de Matheu 4</strong>.
        Four Corner <strong>is open now</strong> (from 14:00 until late · sports screens). We do not list which game is on there.
        O’Reilly’s and O’Connell’s are meeting points on the same cluster; we do not copy Dubliners’ board onto those doors.
        Named listings: Dubliners What’s On only. Ask which screen. Not every game on every screen.
        If the door you walk into is not showing Atlético–Barcelona, hop — the other three open doors are still on these two streets.
      </p>
      <ol>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid.</strong>
          Open NOW (from 14:00 until late · sports screens). Ask at the door.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          Sunday 12:00–02:00. Named Atlético vs Barcelona 21:00 on What’s On. Ask which game is on.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (Maps listing: O’Connell St).
          Same number, different door, different CID. Meeting point; we do not invent its board.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Covered passage. Usual from 11:30. Meeting point; no invented menu.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
      </ol>

      <h2>What is on now — Premier sits alongside; late NFL still follows</h2>
      <p>
        Dubliners <a href={withBase('/whats-on/')}>What’s On</a> already lists Sunday 8 November in Madrid time.
        Atlético vs Barcelona <strong>21:00</strong> is the named football now. Premier 15:00 / 17:30 already ran on the same board; they sit alongside, they do not stand in for this whistle.
        Late NFL from <strong>22:05</strong> / <strong>22:25</strong> still follows at the same four doors — stay after this kickoff if that is your night.
        Coordinate; do not substitute. Named listings: Dubliners only. We do not assign those matches to O’Reilly’s, O’Connell’s or Four Corner.
        Ask which screen.
      </p>
      <p>
        Already sitting through Atleti and staying for the late NFL clocks?
        <a href={withBase('/stay-after-atleti-2100-late-nfl-2205-2225/')}>Stay after 21:00 for NFL 22:05 / 22:25 at the same four doors</a>.
        Came from the 19:00 NFL window and still choosing a door?
        <a href={withBase('/nfl-on-now-1900-then-hop-atleti-2100/')}>That hop-from-19:00 note is the previous clock</a>.
      </p>

      <OriginalFourBars lang="en" when="sunday" findHref="/visit/" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Atleti–Barça is kicking off now. Which door?</strong></dt>
        <dd>Any of the four open doors: Victoria 6, Espoz y Mina 7 twice, Pasaje de Matheu 4. Named Atleti: Dubliners What’s On. Sister doors: ask which game.</dd>
        <dt><strong>Is this the visitors page, the local gather, the 8 Nov cover, or hop-from-19:00?</strong></dt>
        <dd>No. Those pages are NFL visitors sharing Sol, the Spanish-fan pin, the advance listing, and sit-then-hop at 21:00. This is the live 21:00 whistle: kickoff is NOW.</dd>
        <dt><strong>Does 21:00 Atleti replace Premier or late NFL?</strong></dt>
        <dd>No. Coordinate. Premier already sat alongside. Late NFL 22:05 / 22:25 still follows. We do not copy Dubliners’ board onto sister doors.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Kickoff NOW this Sunday',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'FIND US — Dubliners home' },
              { href: '/visit/', label: 'GET DIRECTIONS — visit / hours' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/stay-after-atleti-2100-late-nfl-2205-2225/', label: 'Stay after 21:00: late NFL 22:05 / 22:25' },
              { href: '/whats-on/', label: 'What’s On — named screens only' },
              { href: PATH_ES, label: 'Atleti–Barça saque AHORA en las cuatro puertas abiertas de Sol', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
