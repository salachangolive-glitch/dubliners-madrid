---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { SITE, withBase, absUrl } from '../../../site';
import { OPENING_HOURS } from '../../../data/hours';
const mon = OPENING_HOURS.find((d) => d.day === 'Monday')!;
const mapsCta = SITE.mapsDir;

// Kneipe article — Monday 14 Dec 2026 (night before EuroLeague tip-off Tue 15, 20:45 Movistar Arena).
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Bayern Fans Madrid Kneipe: Monday 14 December night',
  datePublished: '2026-11-26',
  inLanguage: 'en',
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub' },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  mainEntityOfPage: absUrl('/bayern-basketball-fans-madrid/what-to-know-before-the-game/'),
};
---

<BaseLayout
  title={'Bayern Fans Madrid Kneipe: Monday 14 December Night | Dubliners'}
  description={'Bayern basketball fans in Madrid: Irish pub meeting point on Monday 14 December, the night before Real Madrid v FC Bayern Munich (Tue 15 Dec, 20:45, Movistar Arena). Bayrisch-münchner Kneipenstimmung im Zentrum — English and German at the bar.'}
  path="/bayern-basketball-fans-madrid/what-to-know-before-the-game/"
  lang="en"
  hreflang={{ en: '/bayern-basketball-fans-madrid/what-to-know-before-the-game/', de: '/de/bayern-basketball-fans-madrid/was-ihr-vor-dem-spiel-wissen-muesst/' }}
  ogImage="/images/facade.jpg"
  extraJsonLd={articleLd}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current={'Bayern Fans Madrid Kneipe'} schema />
      <h1>Bayern Fans Madrid Kneipe: Monday 14 December night</h1>
      <p class="lead">The EuroLeague clash is on <strong>Tuesday 15 December 2026</strong> at the Movistar Arena (20:45 Madrid time). On <strong>Monday 14 December</strong>, Dubliners is where Bayern fans gather in central Madrid for pints, conversation and that familiar Irish-pub buzz before match day.</p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={mapsCta} rel="noopener noreferrer" target="_blank">Get directions</a>
        <a class="btn btn-primary" href={withBase('/bayern-basketball-fans-madrid/')}>Tuesday meeting point &amp; match</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <h2>Why Monday night at Dubliners</h2>
      <p>Dubliners is an Irish pub in the former Barragán tailor shop (1885) at {SITE.address}, {SITE.postal}, by Puerta del Sol. On <strong>Monday 14 December</strong> we are open {mon.opens}–{mon.closes} — a relaxed window to meet travelling Bayern supporters, swap EuroLeague talk and ease into Madrid without rushing straight to the arena.</p>
      <p>Think <strong>Bayern Fans Madrid Kneipe</strong> energy in the centre: dark wood, pints, English and German at the bar, international crowd — not a stadium queue, but the same door you use on <strong>Tuesday 15 December</strong> before and after tip-off. For times, transport and the Movistar Arena fixture, use the <a href={withBase('/bayern-basketball-fans-madrid/')}>Bayern basketball meeting-point guide</a> (match day).</p>
      <h2>No reservations</h2>
      <p><strong>No table reservations</strong> — first come, first served at the bar, Monday and Tuesday.</p>
      <h2>After Monday night</h2>
      <p>On <strong>Tuesday 15 December</strong>, Real Madrid host FC Bayern Munich at 20:45 at the Movistar Arena. Dubliners, O’Connell’s and O’Reilly’s remain your meeting point by Puerta del Sol. The game is <strong>confirmed LIVE on our screens at Dubliners</strong> on match night — also listed on <a href={withBase('/whats-on/')}>What’s On</a>.</p>
      <p>Auf Deutsch: <a href={withBase('/de/bayern-basketball-fans-madrid/was-ihr-vor-dem-spiel-wissen-muesst/')} hreflang="de">Bayern Fans Madrid Kneipe — Montagabend, 14. Dezember</a>.</p>
      <p class="small">Dubliners is an independent pub, not affiliated with the EuroLeague, Real Madrid or FC Bayern Munich.</p>
    </div>
  </section>
</BaseLayout>