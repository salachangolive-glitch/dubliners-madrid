---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LinkHub from '../../../components/LinkHub.astro';
import { SITE, withBase } from '../../../site';
import { OPENING_HOURS } from '../../../data/hours';

// Bayern day 2 (DG 25 Oct 2026, task BAYERN-D2-DUB). Angle: arriving in Madrid → Sol as your base → match-day plan.
// Distinct from O'Connell (things to do near Sol on foot) and from day 1 (hub).
// Match/stadium/transport facts ONLY from rows marked CONFIRMADO in /workspace/radar/bayern-3nov.md (rows 1, 8, 9, 12, 15).
// No invented routes: airport/station → Sol and Sol → stadium refer to the Metro de Madrid app / crtm.es.
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'How do I get from the airport or the train station to Sol?', acceptedAnswer: { '@type': 'Answer', text: 'Check your connection in the Metro de Madrid app or on crtm.es before you travel. Our nearest Metro stations are Sol (lines 1, 2 and 3) and Sevilla (line 2).' } },
    { '@type': 'Question', name: 'Is Madrid in the same time zone as Munich?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Kick-off on Tuesday 3 November is 21:00 in Madrid and 21:00 in Munich.' } },
    { '@type': 'Question', name: 'Which Metro station serves the stadium?', acceptedAnswer: { '@type': 'Answer', text: 'Estadio Metropolitano, on line 7. Plan your route from Sol in the Metro de Madrid app or on crtm.es.' } },
    { '@type': 'Question', name: 'What time does Dubliners open?', acceptedAnswer: { '@type': 'Answer', text: 'Every day from 12:00. Monday to Thursday and Sunday until 02:00, Friday and Saturday until 02:30.' } },
  ],
};
---

<BaseLayout title={'Arriving in Madrid: Bayern Fans, Start at Sol | Dubliners'} description={'Just landed for Atlético v Bayern (Tue 3 Nov, 21:00)? Make Sol your base: how to plan your trip, our hours from 12:00 and a match-day plan. Dubliners, Espoz y Mina 7.'} path="/bayern-fans-madrid/arriving-in-madrid/" lang="en" hreflang={{ en: '/bayern-fans-madrid/arriving-in-madrid/', de: '/de/bayern-fans-madrid/ankunft-in-madrid/' }} ogImage="/images/facade.jpg" extraJsonLd={[faqLd]}>
  <section class="hero hero-compact">
    <div class="container">
      <h1>Arriving in Madrid for Atlético v Bayern? Start at Sol</h1>
      <p class="lead">Just landed or stepped off the train? Head for Puerta del Sol first. It is the centre of Madrid, and Dubliners is a few steps away: drop in, get your bearings and plan the days until kick-off.</p>
      <p class="small">Atlético v Bayern · Tuesday 3 November 2026 · kick-off 21:00 Madrid time · Updated 25 October 2026</p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
        <a class="btn btn-primary" href={withBase('/contact/#request-information')}>Request information</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p>This is part of our guide for Bayern fans. Looking for where to watch the match with other fans? See <a href={withBase('/bayern-fans-madrid/')}>Bayern fans in Madrid</a>.</p>
      <h2>Step 1: get to Sol</h2>
      <p>Whether you arrive at the airport, Atocha or Chamartín, check your connection in the <strong>Metro de Madrid app</strong> or on <a href="https://www.crtm.es/" target="_blank" rel="noopener">crtm.es</a> before you set off. We do not list routes here, because services can change. Our nearest Metro stations are <strong>Sol (lines 1, 2 and 3)</strong> and <strong>Sevilla (line 2)</strong>.</p>
      <p>From Sol it is a short walk to us: Calle de Espoz y Mina 7, 28012 Madrid.</p>
      <h2>Step 2: same clock as Munich</h2>
      <p>No need to reset your watch: Madrid and Munich are in the same time zone. Kick-off on Tuesday 3 November is 21:00 here and 21:00 at home.</p>
      <h2>Step 3: your days before the match</h2>
      <p>Arriving early? We are open every day from 12:00, so you can come by on any day of your trip.</p>
      <ul>{OPENING_HOURS.map((d) => <li>{d.day}: {d.opens}–{d.closes}</li>)}</ul>
      <h2>Step 4: match day, from Sol to kick-off</h2>
      <ul>
        <li><strong>12:00</strong>: Dubliners opens. Come early and meet other fans in the centre.</li>
        <li><strong>Before you leave for the stadium</strong>: the match is at the Riyadh Air Metropolitano. Its Metro station is <strong>Estadio Metropolitano (line 7)</strong>; EMT buses 28, 38, 48, 140, 153, 167, E2 and SE721 also serve the area, and the nearest Cercanías station is Coslada. Plan your route from Sol in the Metro de Madrid app or on crtm.es.</li>
        <li><strong>Pack light</strong>: stadium rules forbid bringing in alcohol, flares or pyrotechnics, and objects over 500 g, among other items. Check the latest rules before you go.</li>
        <li><strong>21:00</strong>: kick-off. No ticket? Watch Atlético v Bayern LIVE with us. In Spain the match is broadcast on Movistar Plus+.</li>
        <li><strong>After the match</strong>: night buses N5 and N6 also serve the stadium area. On Tuesday we are open until 02:00.</li>
      </ul>
      <h2>Where we are</h2>
      <p>Dubliners Irish Pub, Calle de Espoz y Mina 7, 28012 Madrid, between Puerta del Sol, Plaza Mayor and the Barrio de las Letras.</p>
      <div class="cta-row">
        <a class="btn btn-primary" href={withBase('/contact/#request-information')}>Request information</a>
      </div>
      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>How do I get from the airport or the train station to Sol?</strong></dt><dd>Check your connection in the Metro de Madrid app or on crtm.es before you travel. Our nearest Metro stations are Sol (lines 1, 2 and 3) and Sevilla (line 2).</dd>
        <dt><strong>Is Madrid in the same time zone as Munich?</strong></dt><dd>Yes. Kick-off on Tuesday 3 November is 21:00 in Madrid and 21:00 in Munich.</dd>
        <dt><strong>Which Metro station serves the stadium?</strong></dt><dd>Estadio Metropolitano, on line 7. Plan your route from Sol in the Metro de Madrid app or on crtm.es.</dd>
        <dt><strong>What time does Dubliners open?</strong></dt><dd>Every day from 12:00. Monday to Thursday and Sunday until 02:00, Friday and Saturday until 02:30.</dd>
      </dl>
      <p class="small">Dubliners Irish Pub · Calle de Espoz y Mina 7, 28012 Madrid · Dubliners is an independent pub, not affiliated with UEFA or the clubs.</p>
      <p>Auf Deutsch: <a href={withBase('/de/bayern-fans-madrid/ankunft-in-madrid/')} hreflang="de" lang="de">Ankunft in Madrid: euer Startpunkt an der Sol</a></p>
      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'More for Bayern fans',
            items: [
              { href: '/bayern-fans-madrid/', label: 'Bayern fans in Madrid', note: 'Where to watch with other fans' },
              { href: '/whats-on/', label: "What's On", note: 'Everything we show' },
              { href: '/menu/', label: 'Food menu' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
