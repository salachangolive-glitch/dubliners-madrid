---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LinkHub from '../../../components/LinkHub.astro';
import { SITE, withBase } from '../../../site';
import { OPENING_HOURS } from '../../../data/hours';

// Bayern day 11 (PLAN.md, Tue 3 Nov 2026, match day). Angle: today hour by hour at the pub + German clubs LIVE this week.
// Matches ONLY from src/data/fixtures.ts (Radar-verified; Wed 4 re-checked vs UEFA API, radar/horarios-oficiales-2026-11-04-05.md).
// Match facts ONLY from CONFIRMADO rows 1, 8 and 10 of /workspace/radar/bayern-3nov.md. "Meeting point" allowed only for this campaign (owner 2 Nov).
// No prices, no bookings, no "official", no exact Metro route.
const tue = OPENING_HOURS.find((d) => d.day === 'Tuesday')!;
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What time is Atlético v Bayern today?', acceptedAnswer: { '@type': 'Answer', text: 'Atlético de Madrid v FC Bayern München kicks off on Tuesday 3 November 2026 at 21:00 Madrid time at the Riyadh Air Metropolitano. It is LIVE at Dubliners, by Puerta del Sol, broadcast in Spain on Movistar Plus+.' } },
    { '@type': 'Question', name: 'What time does Dubliners open and close today?', acceptedAnswer: { '@type': 'Answer', text: `On Tuesday Dubliners is open from ${tue.opens} to ${tue.closes}, so you can stay after the final whistle.` } },
  ],
};
---

<BaseLayout title={'Match Day: Atlético v Bayern Today, 21:00 LIVE near Sol | Dubliners'} description={'Today is match day. Atlético v Bayern at 21:00 LIVE at Dubliners by Puerta del Sol, plus Galatasaray v Stuttgart at 18:45. Open from 12:00 to 02:00. Come early.'} path="/bayern-fans-madrid/match-day-live/" lang="en" hreflang={{ en: '/bayern-fans-madrid/match-day-live/', de: '/de/bayern-fans-madrid/spieltag-live/' }} ogImage="/images/dubliners-main-room-madrid-v2-1200.webp" extraJsonLd={[faqLd]}>
  <section class="hero hero-compact">
    <div class="container">
      <h1>Today: Atlético v Bayern, 21:00 LIVE</h1>
      <p class="lead">It's match day. Whether you have a ticket or not, here is your Tuesday hour by hour, with a fans' meeting point a few steps from Puerta del Sol.</p>
      <p class="small">Tuesday 3 November 2026 · Madrid time · Updated 3 November 2026</p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Come early: directions</a>
        <a class="btn btn-primary" href={withBase('/contact/#request-information')}>Request information</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p>This is part of our guide for Bayern fans in Madrid; start with <a href={withBase('/bayern-fans-madrid/')}>Bayern fans in Madrid</a>.</p>
      <h2>Your Tuesday, hour by hour</h2>
      <ul>
        <li><strong>{tue.opens}</strong> · Doors open at Dubliners. Lunch, a cold beer and the first red shirts in the bar. See <a href={withBase('/menu/')}>the food menu</a>.</li>
        <li><strong>18:45</strong> · Galatasaray v Stuttgart and Shakhtar Donetsk v Sporting CP (Champions League): the warm-up on our screens.</li>
        <li><strong>From about 19:00</strong> · Got a ticket? Time to head for the stadium. On match days the club says EMT runs a special bus between Canillejas and Plaza de Grecia from two hours before kick-off, and Metro line 7 stops at Estadio Metropolitano. Plan your route from Sol in the Metro de Madrid app or on <a href="https://www.crtm.es/" target="_blank" rel="noopener">crtm.es</a>.</li>
        <li><strong>21:00</strong> · <strong>Atlético de Madrid v FC Bayern München</strong>, Champions League league phase, LIVE on the big screen and our 8 screens (Movistar Plus+ in Spain). Barcelona v Aston Villa and the rest of the 21:00 games are on too; clashes go on different screens.</li>
        <li><strong>After the match</strong> · We're open until {tue.closes} on Tuesday, so celebrate (or recover) with other fans before heading back to your hotel.</li>
      </ul>
      <h2>No ticket? Watch it here</h2>
      <p>Dubliners is at Calle de Espoz y Mina 7, between Puerta del Sol, Plaza Mayor and the Barrio de las Letras. Metro Sol (lines 1, 2 and 3) or Sevilla (line 2). The bar fills up before big games, so come early.</p>
      <h2>German clubs LIVE this week</h2>
      <ul>
        <li>Tuesday 3 November · 18:45 · Galatasaray v Stuttgart · 21:00 · Atlético v Bayern.</li>
        <li>Wednesday 4 November · 21:00 · Borussia Dortmund v Betis and RB Leipzig v Manchester City.</li>
      </ul>
      <p>Staying longer? The full list is on <a href={withBase('/whats-on/')}>What's On</a>.</p>
      <h2>Three pubs near Sol</h2>
      <ul>
        <li><strong>Dubliners</strong>: Calle de Espoz y Mina 7, a few steps from Puerta del Sol.</li>
        <li><strong>O'Connell St</strong>: right next door, also at Calle de Espoz y Mina 7.</li>
        <li><strong>O'Reilly's</strong>: 200 m from Puerta del Sol.</li>
      </ul>
      <h2>Opening hours</h2>
      <ul>{OPENING_HOURS.map((d) => <li>{d.day}: {d.opens}–{d.closes}</li>)}</ul>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Come early: directions</a>
        <a class="btn btn-primary" href={withBase('/contact/#request-information')}>Request information</a>
      </div>
      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>What time is Atlético v Bayern today?</strong></dt><dd>Atlético de Madrid v FC Bayern München kicks off on Tuesday 3 November 2026 at 21:00 Madrid time at the Riyadh Air Metropolitano. It is LIVE at Dubliners, by Puerta del Sol, broadcast in Spain on Movistar Plus+.</dd>
        <dt><strong>What time does Dubliners open and close today?</strong></dt><dd>On Tuesday Dubliners is open from {tue.opens} to {tue.closes}, so you can stay after the final whistle.</dd>
      </dl>
      <p class="small">Dubliners Irish Pub · Calle de Espoz y Mina 7, 28012 Madrid · Dubliners is an independent pub, not affiliated with UEFA or the clubs.</p>
      <p>Auf Deutsch: <a href={withBase('/de/bayern-fans-madrid/spieltag-live/')} hreflang="de" lang="de">Heute: Atlético–Bayern, 21:00 Uhr LIVE</a></p>
      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'More for Bayern fans',
            items: [
              { href: '/bayern-fans-madrid/', label: 'Bayern fans in Madrid', note: 'The match LIVE near Sol' },
              { href: '/bayern-fans-madrid/where-to-watch-atletico-bayern/', label: 'Where to watch Atlético v Bayern in Madrid', note: 'Tuesday 3 November, 21:00' },
              { href: '/bayern-fans-madrid/match-day-plan/', label: 'Your match-day plan', note: 'Times and how to reach the Metropolitano' },
              { href: '/bayern-fans-madrid/practical-tips/', label: '5 tips for your Madrid trip', note: 'Time zone, travel, hours, stadium rules' },
              { href: '/whats-on/', label: "What's On", note: 'Everything we show' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
