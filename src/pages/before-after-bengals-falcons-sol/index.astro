---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import LinkHub from '../../components/LinkHub.astro';
import SundayFourVenues from '../../components/SundayFourVenues.astro';
import FanWeekendCtas from '../../components/FanWeekendCtas.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/before-after-bengals-falcons-sol/';
const PATH_ES = '/es/antes-despues-bengals-falcons-sol/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Before and after Bengals–Falcons: meet near Sol on Sunday 8 November',
  inLanguage: 'en',
  datePublished: '2026-11-07',
  dateModified: '2026-11-07T16:00:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Where can I meet before Bengals–Falcons on Sunday 8 November?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Four sister bars near Puerta del Sol: O’Reilly’s Restaurant Bar (Pasaje de Matheu 4, from 11:30), Dubliners and O’Connell’s (Espoz y Mina 7, from 12:00), and Four Corner (Calle de la Victoria 6, from 14:00). Bengals vs Falcons is at the Bernabéu at 15:30.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where can I go after the Madrid Game?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Back to the same Sol cluster. Dubliners keeps confirmed NFL screens from 19:00 and Atlético–Barcelona at 21:00. Four Corner is open from 14:00 until late as a sister meeting point; we do not list its broadcasts. Ask at Dubliners which game is on — not every game is on every screen.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I have to wait until Sunday 12:00 to plan this?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Plan today (Saturday). Sunday hours are already confirmed: Dubliners and O’Connell’s from 12:00, Four Corner from 14:00, O’Reilly’s from 11:30.',
      },
    },
  ],
};
---

<BaseLayout
  title="Before and after Bengals–Falcons near Sol | Dubliners"
  description="Sunday 8 Nov: meet near Puerta del Sol before Bengals–Falcons at 15:30 and come back after. Four sister bars, maps and hours. Plan it today."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Before and after Bengals–Falcons" schema />
      <h1>Before and after Bengals–Falcons: meet near Sol on Sunday 8 November</h1>
      <p class="lead">
        Sunday 8 Nov near Sol. Dubliners open 12:00–02:00, Espoz y Mina 7. Bengals vs Falcons LIVE 15:30
        (Bernabéu game; also on our big screen). NFL from 19:00, then 22:05 and 22:25. Atlético vs Barcelona 21:00.
        Four sister bars, one area — Four Corner from 14:00. Plan it <strong>today (Saturday)</strong>. Ask at the bar which game is on.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Antes y después de Bengals–Falcons junto a Sol</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Maps</a>
        <a class="btn btn-secondary" href={withBase('/4-bars-one-fan-weekend/')}>4 Bars. One Fan Weekend</a>
      </div>
      <FanWeekendCtas lang="en" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <div data-show-until={SHOW_UNTIL}>
        <h2>Before kick-off (15:30 at the Bernabéu)</h2>
        <p>
          Cincinnati Bengals vs Atlanta Falcons is Sunday 8 November 2026 at <strong>15:30 Madrid time</strong>
          (9:30 a.m. ET) at the Santiago Bernabéu. If you are going to the game, the four sister bars around Sol are
          the meeting point before kick-off. If you are staying in Sol, it is LIVE on the <strong>big screen at Dubliners</strong>
          from 15:30. Ask which game is on. Not every game is on every screen.
        </p>
        <p>
          Dubliners and O’Connell’s open from <strong>12:00</strong>, O’Reilly’s from 11:30. Four Corner opens at
          <strong>14:00</strong> — not midday. Advertise that hour from Saturday so nobody waits until Sunday noon.
        </p>

        <h2>After the final whistle</h2>
        <p>
          The NFL Sunday does not end at the Bernabéu. Walk back to the same streets. At Dubliners, confirmed LIVE
          screens continue: seven NFL games from <strong>19:00</strong>, Atlético de Madrid vs FC Barcelona at
          <strong>21:00</strong>, Texans–Chargers at <strong>22:05</strong> and three more NFL games at <strong>22:25</strong>.
          NFL RedZone is LIVE from 19:00. We close at 02:00; the 02:20 Monday Sunday-night game is not shown.
        </p>
        <p>
          Four Corner is open from 14:00 until late as a sister meeting point on Calle de la Victoria.
          We do not invent Four Corner broadcasts. O’Reilly’s and O’Connell’s share the same cluster if the group splits.
        </p>
      </div>

      <SundayFourVenues lang="en" />

      <p class="small">
        Independent Irish pub and sister bars — not an official NFL event and not linked to the stadium organisers.
      </p>

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Where can I meet before Bengals–Falcons on Sunday 8 November?</strong></dt>
        <dd>Four sister bars near Puerta del Sol: O’Reilly’s (Pasaje de Matheu 4, from 11:30), Dubliners and O’Connell’s (Espoz y Mina 7, from 12:00), and Four Corner (Victoria 6, from 14:00). Bengals vs Falcons at the Bernabéu at 15:30.</dd>
        <dt><strong>Where can I go after the Madrid Game?</strong></dt>
        <dd>Back to the same Sol cluster. Dubliners keeps confirmed NFL screens from 19:00 and Atlético–Barcelona at 21:00. Four Corner is open from 14:00 until late; we do not list its broadcasts. Ask at Dubliners which game is on.</dd>
        <dt><strong>Do I have to wait until Sunday 12:00 to plan this?</strong></dt>
        <dd>No. Plan today (Saturday). Sunday hours are already confirmed.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Sunday 8 November near Sol',
            until: SHOW_UNTIL,
            items: [
              { href: '/sunday-nfl-near-sol-8-nov/', label: 'Sunday NFL near Sol', note: 'Four bars, one meeting point' },
              { href: '/afternoon-evening-nfl-sol-8-nov/', label: 'Afternoon and evening NFL', note: '15:30 then 19:00 / 22:05 / 22:25' },
              { href: '/four-corner-opens-sunday-1400/', label: 'Four Corner opens 14:00', note: 'Confirmed Sunday opening' },
              { href: '/atletico-barcelona-sol-8-nov/', label: 'Atlético–Barcelona near Sol', note: '21:00 Sunday' },
              { href: '/4-bars-one-fan-weekend/', label: '4 Bars. One Fan Weekend', note: 'Hub' },
              { href: '/nfl-madrid/', label: 'NFL in Madrid', note: 'Dubliners Sunday list' },
              { href: PATH_ES, label: 'Antes y después de Bengals–Falcons', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
