              { href: '/', label: 'FIND US — Dubliners home' },
              { href: '/visit/', label: 'GET DIRECTIONS — visit / hours' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/whats-on/', label: 'What’s On — named screens' },
              { href: '/first-metro-into-sol-sunday-station-to-door/', label: 'First Sunday Metro into Sol: station to door' },
              { href: PATH_ES, label: 'Brighton e Ipswich 15:00, sin Liverpool/Chelsea/United', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
