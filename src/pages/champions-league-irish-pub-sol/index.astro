---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { withBase } from '../../site';
const faqLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Is Getafe vs Brighton a Champions League game?", "acceptedAnswer": {"@type": "Answer", "text": "No. It's a UEFA Conference League match, Thursday 5 November 2026 at 21:00 Madrid time, and we show it LIVE."}}, {"@type": "Question", "name": "How many screens do you have?", "acceptedAnswer": {"@type": "Answer", "text": "A big projector and 8 screens."}}]};
---
<BaseLayout title="Champions League in an Irish Pub by Sol, Madrid | Dubliners" description="Watch European football in an Irish pub by Puerta del Sol: Real Madrid vs RB Leipzig (21 Oct), Atlético vs Bayern (3 Nov) and Getafe vs Brighton (5 Nov), all LIVE." path="/champions-league-irish-pub-sol/" lang="en" hreflang={{ en: '/champions-league-irish-pub-sol/', es: '/es/champions-pub-irlandes-sol/' }} ogImage="/images/facade.jpg">
  <section class="hero hero-compact"><div class="container">
    <Breadcrumb current="Champions League in an Irish pub" />
    <h1>Watching the Champions League in an Irish pub in Sol</h1>
  </div></section>
  <section class="section"><div class="container prose">
    <p>Big European nights in Madrid fill the stadiums fast. If you're not at the ground, Dubliners is an Irish pub on Calle de Espoz y Mina 7, a couple of minutes from Puerta del Sol, with a big projector and 8 screens. Every Champions League and Conference League game we list is LIVE.</p>
    <h2>Three Madrid-area nights</h2><ul>
      <li><strong>Wednesday 21 October, 21:00</strong> — Real Madrid vs RB Leipzig, UEFA Champions League (Matchday 3, Bernabéu). LIVE. <a href={withBase('/de/leipzig-fans-madrid/')} hreflang="de" lang="de">Für Leipzig-Fans auf Deutsch</a>.</li>
      <li><strong>Tuesday 3 November, 21:00</strong> — Atlético de Madrid vs Bayern München, UEFA Champions League (Matchday 4, Metropolitano). LIVE. <a href={withBase('/de/bayern-fans-madrid/')} hreflang="de" lang="de">Für Bayern-Fans auf Deutsch</a>.</li>
      <li><strong>Thursday 5 November, 21:00</strong> — Getafe vs Brighton. Not Champions League: it's the UEFA Conference League, at the Coliseum in Getafe. LIVE. Travelling Brighton fans: <a href={withBase('/brighton-fans-madrid/')}>our short guide</a>.</li></ul>
    <p>Times are Madrid time, from uefa.com's fixture lists (kick-offs 21:00 CET unless stated) and the clubs' own sites.</p>
    <h2>On the night</h2><p>For the biggest games, earlier is better. Open from 12:00 every day (until 02:00 Sunday–Thursday). Full list of what's on, including the other Champions League games each week: <a href={withBase('/whats-on/')}>What's On</a> and <a href={withBase('/champions-league-bar-madrid/')}>Champions League bar in Madrid</a>.</p>
    <h2>FAQ</h2><dl class="faq"><dt><strong>Is Getafe vs Brighton a Champions League game?</strong></dt><dd>No. It's a UEFA Conference League match, Thursday 5 November 2026 at 21:00 Madrid time, and we show it LIVE.</dd><dt><strong>How many screens do you have?</strong></dt><dd>A big projector and 8 screens.</dd></dl>
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </div></section>
</BaseLayout>
