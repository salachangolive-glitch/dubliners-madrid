---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE, withBase, isContactFormReady, getContactFormEndpoint, getContactFormAjaxEndpoint } from '../../site';

const title = 'Contact Dubliners Madrid | Irish Pub near Sol';
const description =
  'Email comunicacion@dublinersmadrid.es or message Dubliners near Sol on Instagram. Espoz y Mina 7 — match nights, groups, general questions.';
const formReady = isContactFormReady();
const formAction = formReady ? getContactFormEndpoint() : undefined;
const formAjax = formReady ? getContactFormAjaxEndpoint() : '';
---

<BaseLayout title={title} description={description} path="/contact/" ogImage="/images/facade.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Contact" />
      <h1>Get in touch</h1>
      <p class="lead">
        Match nights, groups, or finding us near Sol — email us, use the form below, or Instagram.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-aside">
        <h2>Reach Dubliners</h2>
        <p>
          <strong>Visit</strong><br />
          {SITE.address}<br />
          {SITE.postal}
        </p>
        <p>
          <strong>Instagram</strong><br />
          <a href={SITE.instagram} rel="noopener noreferrer" target="_blank">{SITE.instagramHandle}</a>
        </p>
        {SITE.publicEmail ? (
          <p>
            <strong>Email</strong><br />
            <a href={`mailto:${SITE.publicEmail}`}>{SITE.publicEmail}</a>
          </p>
        ) : (
          <p class="contact-note">
            Official email will appear here once it’s live. Until then, Instagram or drop by.
          </p>
        )}
        <p>
          <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
          <a class="btn btn-secondary" href={withBase('/visit/')}>Visit / hours</a>
        </p>
      </div>

      <div class="contact-form-wrap">
        <h2>Send a message</h2>
        {formReady ? (
          <p class="contact-note" role="status">
            The form is live — send your enquiry and we’ll reply by email.
          </p>
        ) : (
          <p class="contact-note" role="status">
            The form activates when Dubliners email is configured. Message us on Instagram or see Directions and Visit.
          </p>
        )}
        <form
          class="contact-form"
          method="POST"
          action={formAction}
          data-form-ready={formReady ? 'true' : 'false'}
          data-ajax-action={formAjax || undefined}
          data-success-path={formReady ? '/contact/?sent=1' : undefined}
          novalidate
        >
          {/* FormSubmit: _subject, table template, disable captcha for AJAX JSON replies */}
          {formReady && <input type="hidden" name="_subject" value="Dubliners Madrid — website contact" />}
          {formReady && <input type="hidden" name="_template" value="table" />}
          {formReady && <input type="hidden" name="_captcha" value="false" />}
          {formReady && <input type="hidden" name="_next" value="https://dublinersmadrid.es/contact/?sent=1" />}
          <div class="hp" aria-hidden="true">
            <label for="company_website">Company</label>
            {/* FormSubmit honeypot field name is _honey; leave empty for humans */}
            <input type="text" id="company_website" name="_honey" tabindex="-1" autocomplete="off" />
          </div>

          <label for="name">Name</label>
          <input id="name" name="name" type="text" required maxlength="120" autocomplete="name" disabled={!formReady} />

          <label for="email">Email</label>
          <input id="email" name="email" type="email" required maxlength="160" autocomplete="email" disabled={!formReady} />

          <label for="reason">Reason for contact</label>
          <select id="reason" name="reason" required disabled={!formReady}>
            <option value="">Select…</option>
            <option value="General information">General information</option>
            <option value="Groups">Groups</option>
            <option value="Sports / matches">Sports / matches</option>
            <option value="Events">Events</option>
            <option value="Other">Other</option>
          </select>

          <label for="message">Message</label>
          <textarea id="message" name="message" rows="6" required maxlength="4000" disabled={!formReady}></textarea>

          <p class="form-legal">
            By sending this message you agree we may use your details only to reply to this enquiry.
            See our <a href={withBase('/privacy/')}>privacy note</a>.
          </p>

          <button class="btn btn-primary" type="submit" disabled={!formReady}>Send message</button>
          <p id="form-status" class="contact-note" hidden></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector('.contact-form');
  const status = document.getElementById('form-status');
  const params = new URLSearchParams(location.search);
  if (params.get('sent') === '1' && status) {
    status.hidden = false;
    status.textContent = 'Thanks — your message was sent. We’ll get back to you soon.';
    document.dispatchEvent(
      new CustomEvent('dubliners:contact_submit', {
        detail: { language: 'en', page_path: location.pathname },
      }),
    );
  }

  // FormSubmit AJAX → then redirect to ?sent=1 so confirmation + GA4 contact_submit fire.
  // Classic _next redirects were unreliable (landing on formsubmit.co/hash).
  form?.addEventListener('submit', async (e) => {
    if (!form || form.getAttribute('data-form-ready') !== 'true') {
      e.preventDefault();
      if (status) {
        status.hidden = false;
        status.textContent = 'The form is not active yet. Use Instagram or visit us.';
      }
      return;
    }
    const ajaxUrl = form.getAttribute('data-ajax-action');
    const successPath = form.getAttribute('data-success-path') || '/contact/?sent=1';
    if (!ajaxUrl) return; // fall through to classic POST

    e.preventDefault();
    const submitBtn = form.querySelector('button[type="submit"]');
    if (submitBtn) submitBtn.disabled = true;
    if (status) {
      status.hidden = false;
      status.textContent = 'Sending…';
    }
    try {
      const response = await fetch(ajaxUrl, {
        method: 'POST',
        headers: { Accept: 'application/json' },
        body: new FormData(form),
      });
      const data = await response.json().catch(() => ({}));
      const ok =
        response.ok && (data.success === true || data.success === 'true');
      if (!ok) throw new Error(String(data.message || 'submit_failed'));
      window.location.assign(successPath);
    } catch {
      if (submitBtn) submitBtn.disabled = false;
      if (status) {
        status.hidden = false;
        status.textContent = 'Unable to send the message. Please try again or email comunicacion@dublinersmadrid.es.';
      }
    }
  });
</script>
