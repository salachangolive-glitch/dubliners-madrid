---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import MapEmbed from '../../../components/MapEmbed.astro';
import { SITE, withBase, absUrl } from '../../../site';
import { OPENING_HOURS } from '../../../data/hours';
const DE: Record<string, string> = {
  Monday: 'Montag',
  Tuesday: 'Dienstag',
  Wednesday: 'Mittwoch',
  Thursday: 'Donnerstag',
  Friday: 'Freitag',
  Saturday: 'Samstag',
  Sunday: 'Sonntag',
};
const tue = OPENING_HOURS.find((d) => d.day === 'Tuesday')!;
const mapsCta =
  'https://www.google.com/maps/dir/?api=1&destination=Dubliners+Madrid&destination_place_id=ChIJLdKNhYAoQg0RE6Nxotwa1zw';

// Same fixture notes as the EN hub: 15 Dec 2026, 20:45 Madrid, Movistar Arena, E2026_166.
// Übertragung bei Dubliners bestätigt 24. Nov. 2026 20:24 (Eigner). Treffpunkt mit O’Connell’s und O’Reilly’s. Kein TV-Sender genannt.
const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: 'Real Madrid gegen FC Bayern München — EuroLeague-Basketball',
  description:
    'Real Madrid gegen FC Bayern München, EuroLeague, Dienstag, 15. Dezember 2026, 20:45 Uhr Madrider Zeit, in der Movistar Arena. Dubliners Irish Pub, Calle de Espoz y Mina 7, weniger als eine Minute von der Puerta del Sol, ist der Treffpunkt für Bayern-Basketball-Fans vor und nach dem Spiel.',
  inLanguage: 'de',
  startDate: '2026-12-15T20:45:00+01:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'StadiumOrArena',
    name: 'Movistar Arena',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Avenida de Felipe II s/n',
      addressLocality: 'Madrid',
      postalCode: '28009',
      addressCountry: 'ES',
    },
  },
  homeTeam: { '@type': 'SportsTeam', name: 'Real Madrid' },
  awayTeam: { '@type': 'SportsTeam', name: 'FC Bayern München' },
  url: absUrl('/de/bayern-basketball-fans-madrid/'),
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Wann spielt Real Madrid gegen den FC Bayern München im Basketball?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Am Dienstag, 15. Dezember 2026, um 20:45 Uhr Madrider Zeit in der Movistar Arena (EuroLeague, 17. Spieltag). Madrid und München liegen im Dezember in derselben Zeitzone.',
      },
    },
    {
      '@type': 'Question',
      name: 'Ist Dubliners ein Treffpunkt für Bayern-Basketball-Fans?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ja. Dubliners ist mit O’Connell’s und O’Reilly’s an denselben Straßen an der Puerta del Sol — ein Treffpunkt für Bayern-Fans am Montag, 14., und Dienstag, 15. Dezember, vor und nach dem Spiel in der Movistar Arena. Keine Reservierungen. Das Spiel läuft LIVE auf unseren Bildschirmen bei Dubliners am Dienstag, 15. Dezember. Wir nennen keinen TV-Sender.',
      },
    },
    {
      '@type': 'Question',
      name: 'Wie komme ich von der Sol zur Movistar Arena?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Die Halle liegt an der Avenida de Felipe II, 28009 Madrid. Die Real-Madrid-Seite zur Halle nennt die Metro-Stationen Goya (Linien 2 und 4) und O’Donnell (Linie 6) sowie Cercanías Recoletos. Dubliners liegt an der Metro Sol (Linien 1, 2 und 3) oder Sevilla (Linie 2); die Linie 2 bedient Sol und Goya. Die Verbindung am Spieltag prüft ihr in der App von Metro de Madrid oder auf crtm.es. Hier stehen keine Fahrzeiten.',
      },
    },
  ],
};
---

<BaseLayout
  title={'Bayern-Basketball-Fans in Madrid: Treffpunkt, 15. Dez. | Dubliners'}
  description={'Real Madrid gegen FC Bayern München (EuroLeague-Basketball), Dienstag, 15. Dezember 2026, 20:45 Uhr Madrider Zeit, Movistar Arena. Treffpunkt für Bayern-Fans bei Dubliners, weniger als eine Minute von der Sol. Keine Reservierungen, Einlass nach Reihenfolge der Ankunft.'}
  path="/de/bayern-basketball-fans-madrid/"
  htmlLang="de"
  hreflang={{ en: '/bayern-basketball-fans-madrid/', es: '/es/aficionados-bayern-baloncesto-madrid/', de: '/de/bayern-basketball-fans-madrid/' }}
  ogImage="/images/facade-queue.jpg"
  extraJsonLd={[eventLd, faqLd]}
>
  <section class="hero hero-compact">
    <div class="container">
      <h1>Bayern-Basketball-Fans in Madrid: Treffpunkt vor Real Madrid gegen Bayern</h1>
      <p class="lead">Dienstag, 15. Dezember 2026, Spielbeginn 20:45 Uhr Madrider Zeit. EuroLeague-Basketball, 17. Spieltag, in der Movistar Arena. Dubliners, O’Connell’s und O’Reilly’s bilden den Treffpunkt an der Puerta del Sol — vor der Halle und danach. <strong>Real Madrid gegen FC Bayern München läuft LIVE auf unseren Bildschirmen bei Dubliners</strong> am Spielabend.</p>
      <p class="small">Calle de Espoz y Mina 7, 28012 Madrid · Dienstag {tue.opens}–{tue.closes} Uhr · Keine Reservierungen, Einlass nach Reihenfolge der Ankunft</p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Route planen</a>
        <a class="btn btn-primary" href={withBase('/whats-on/')}>What’s On</a>
      </div>
    </div>
  </section>
  <section class="section getting-here" id="anreise">
    <div class="container prose">
      <h2>Anreise von der Puerta del Sol / Metro Sol</h2>
      <ul>
        <li><strong>Adresse:</strong> {SITE.address}, {SITE.postal}.</li>
        <li><strong>Metro:</strong> Sol (Linien 1, 2 und 3) oder Sevilla (Linie 2).</li>
        <li><strong>Cercanías:</strong> Bahnhof Sol (eine Station von Atocha).</li>
        <li><strong>Zu Fuß von der Puerta del Sol:</strong> verlasst den Platz in Richtung Carrera de San Jerónimo / Sevilla und geht in die Calle de Espoz y Mina; das grüne Neon von Dubliners hängt an der Nummer 7, weniger als eine Minute von der Sol.</li>
      </ul>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" data-directions-btn href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Route planen</a>
        <a class="btn btn-secondary" href={withBase('/visit/')}>Öffnungszeiten und Karte</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <div class="prose">
        <h2>Das Spiel</h2>
        <p>Der FC Bayern München gastiert am Dienstag, 15. Dezember 2026, bei Real Madrid in der EuroLeague. Spielbeginn ist 20:45 Uhr Madrider Zeit (im Dezember dieselbe Uhrzeit wie in München), in der Movistar Arena, Avenida de Felipe II, 28009 Madrid. Die Angaben stehen auf der <a href="https://www.realmadrid.com/es-ES/baloncesto/partidos/euroliga/real-madrid-fc-bayern-munich/15-12-2026" rel="noopener noreferrer" target="_blank">Spielseite von Real Madrid</a> und stimmen mit dem EuroLeague-Feed überein (Spiel E2026_166, 19:45 UTC).</p>
        <h2>Treffpunkt bei Dubliners</h2>
        <p>Dubliners ist ein Irish Pub in der {SITE.address}, {SITE.postal}, mit O’Connell’s und O’Reilly’s an denselben Straßen an der Puerta del Sol. <strong>Montag, 14., und Dienstag, 15. Dezember</strong> ist ihr Treffpunkt — vor der Movistar Arena und danach. Am Dienstag haben wir von {tue.opens} bis {tue.closes} Uhr geöffnet. <strong>Real Madrid gegen FC Bayern München läuft LIVE auf unseren Bildschirmen bei Dubliners</strong> (20:45 Uhr). An der Bar wird Deutsch und Englisch verstanden. Wir nennen keinen TV-Sender.</p>
        <h2>Reservierungen</h2>
        <p><strong>Keine Reservierungen</strong>, Einlass nach Reihenfolge der Ankunft.</p>
        <h2>Von der Sol zur Movistar Arena</h2>
        <p>Nur öffentlicher Verkehr, ohne erfundene Fahrzeiten. Die <a href="https://www.realmadrid.com/es-ES/el-club/movistar-arena" rel="noopener noreferrer" target="_blank">Real-Madrid-Seite zur Movistar Arena</a> nennt die Metro <strong>Goya (Linien 2 und 4)</strong> und <strong>O’Donnell (Linie 6)</strong> sowie Cercanías <strong>Recoletos</strong> und die dort aufgeführten EMT-Busse. Dubliners liegt an der Metro Sol (Linien 1, 2 und 3) oder Sevilla (Linie 2). Die Linie 2 bedient Sol und Goya. Die Verbindung am Spieltag prüft ihr in der App von Metro de Madrid oder auf <a href="https://www.crtm.es/" rel="noopener noreferrer" target="_blank">crtm.es</a>.</p>
        <h2>Vor und nach dem Spiel</h2>
        <p><strong>Vor dem Spielbeginn:</strong> ab 12:00 Uhr trefft ihr euch im Pub und fahrt dann mit dem öffentlichen Verkehr zur Halle. <strong>Nach dem Spiel:</strong> dieselbe Station Sol ist ein natürlicher Ort, um sich wiederzutreffen; am Dienstag haben wir bis {tue.closes} Uhr geöffnet.</p>
        <p>Der Vorabend: <a href={withBase('/de/bayern-basketball-fans-madrid/was-ihr-vor-dem-spiel-wissen-muesst/')}>Bayern Fans Madrid Kneipe — Montagabend, 14. Dezember</a> (Deutsch · English). In English: <a href={withBase('/bayern-basketball-fans-madrid/')} hreflang="en">Bayern basketball meeting point</a>. En español: <a href={withBase('/es/aficionados-bayern-baloncesto-madrid/')} hreflang="es">Punto de encuentro Bayern baloncesto</a>.</p>
        <p class="small">Dubliners ist ein unabhängiger Pub, ohne Verbindung zur EuroLeague, zu Real Madrid oder zum FC Bayern München. Diese Seite ist nicht der Fußball-Leitfaden zu Atlético gegen Bayern am 3. November — der bleibt unter <a href={withBase('/de/bayern-fans-madrid/')}>/de/bayern-fans-madrid/</a>.</p>
      </div>
      <picture>
        <source type="image/webp" srcset={`${withBase('/images/facade-queue-sm.webp')} 640w, ${withBase('/images/facade-queue.webp')} 1320w`} sizes="(max-width: 800px) 100vw, 720px" />
        <img class="split-photo landscape" src={withBase('/images/facade-queue.jpg')} width="1320" height="986" loading="lazy" decoding="async" alt="Gäste vor dem Eingang von Dubliners am Abend, Calle de Espoz y Mina 7, weniger als eine Minute von der Puerta del Sol" />
      </picture>
    </div>
  </section>
  <section class="section band">
    <div class="container prose">
      <h2>Karte</h2>
      <div class="map-frame">
        <MapEmbed lang="de" title="Google-Karte — Dubliners Madrid, Espoz y Mina 7" />
      </div>
      <h2>Öffnungszeiten</h2>
      <ul>{OPENING_HOURS.map((d) => <li>{DE[d.day]}: {d.opens}–{d.closes} Uhr</li>)}</ul>
      <h2>Häufige Fragen</h2>
      <dl class="faq">
        <dt><strong>Wann spielt Real Madrid gegen den FC Bayern München im Basketball?</strong></dt>
        <dd>Am Dienstag, 15. Dezember 2026, um 20:45 Uhr Madrider Zeit in der Movistar Arena (EuroLeague, 17. Spieltag).</dd>
        <dt><strong>Ist Dubliners ein Treffpunkt für Bayern-Basketball-Fans?</strong></dt>
        <dd>Ja — Montag, 14., und Dienstag, 15. Dezember, vor und nach dem Spiel, mit O’Connell’s und O’Reilly’s an der Puerta del Sol. Keine Reservierungen. LIVE auf unseren Bildschirmen bei Dubliners am Dienstag, 15. Dezember.</dd>
        <dt><strong>Wie komme ich von der Sol zur Movistar Arena?</strong></dt>
        <dd>Die Real-Madrid-Seite nennt Metro Goya (Linien 2 und 4) und O’Donnell (Linie 6); die Linie 2 bedient auch Sol. Prüft die App von Metro de Madrid oder crtm.es am Spieltag. Hier stehen keine Fahrzeiten.</dd>
        <dt><strong>Wann habt ihr am Dienstag geöffnet?</strong></dt>
        <dd>Ab 12:00 Uhr. Am Dienstag haben wir von 12:00 bis 02:00 Uhr geöffnet.</dd>
      </dl>
    </div>
  </section>
</BaseLayout>
