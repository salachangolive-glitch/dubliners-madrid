---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../../components/Breadcrumb.astro';
import { SITE, withBase, absUrl } from '../../../../site';
import { OPENING_HOURS } from '../../../../data/hours';
const mon = OPENING_HOURS.find((d) => d.day === 'Monday')!;
const mapsCta = SITE.mapsDir;

// Kneipe-Artikel — Montag, 14. Dezember 2026 (Vorabend zu Di. 15. Dez., 20:45 Movistar Arena).
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Bayern Fans Madrid Kneipe: Montagabend, 14. Dezember 2026',
  datePublished: '2026-11-26',
  inLanguage: 'de',
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub' },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  mainEntityOfPage: absUrl('/de/bayern-basketball-fans-madrid/was-ihr-vor-dem-spiel-wissen-muesst/'),
};
---

<BaseLayout
  title={'Bayern Fans Madrid Kneipe: Montagabend, 14. Dezember | Dubliners'}
  description={'Bayern-Basketball-Fans in Madrid: Irish Pub am Montag, 14. Dezember — Abend vor Real Madrid gegen FC Bayern (Di. 15. Dez., 20:45 Uhr, Movistar Arena). Kneipenstimmung im Zentrum, Deutsch und Englisch an der Bar.'}
  path="/de/bayern-basketball-fans-madrid/was-ihr-vor-dem-spiel-wissen-muesst/"
  htmlLang="de"
  hreflang={{ en: '/bayern-basketball-fans-madrid/what-to-know-before-the-game/', de: '/de/bayern-basketball-fans-madrid/was-ihr-vor-dem-spiel-wissen-muesst/' }}
  ogImage="/images/facade.jpg"
  extraJsonLd={articleLd}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current={'Bayern Fans Madrid Kneipe'} lang="de" schema />
      <h1>Bayern Fans Madrid Kneipe: Montagabend, 14. Dezember 2026</h1>
      <p class="lead">Das EuroLeague-Spiel ist am <strong>Dienstag, 15. Dezember 2026</strong> in der Movistar Arena (20:45 Uhr Madrider Zeit). Am <strong>Montag, 14. Dezember</strong> treffen sich Bayern-Fans im Dubliners im Zentrum — für ein Bier, Gespräche und Kneipenatmosphäre vor dem Spieltag.</p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={mapsCta} rel="noopener noreferrer" target="_blank">Route</a>
        <a class="btn btn-primary" href={withBase('/de/bayern-basketball-fans-madrid/')}>Treffpunkt am Dienstag</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <h2>Warum der Montagabend bei Dubliners</h2>
      <p>Dubliners ist ein Irish Pub in der ehemaligen Sastrería Barragán (1885), {SITE.address}, {SITE.postal}, an der Puerta del Sol. Am <strong>Montag, 14. Dezember</strong> haben wir von {mon.opens} bis {mon.closes} Uhr geöffnet — Zeit, mit anreisenden Bayern-Fans zusammenzukommen, über die EuroLeague zu reden und Madrid entspannt anzukommen, ohne sofort zur Halle zu fahren.</p>
      <p><strong>Bayern Fans Madrid Kneipe</strong> im Zentrum: dunkles Holz, Bier, Deutsch und Englisch an der Bar, internationales Publikum — kein Stadionstau, aber dieselbe Tür wie am <strong>Dienstag, 15. Dezember</strong> vor und nach dem Spielbeginn. Zeiten, Anreise und die Partie in der Movistar Arena stehen im <a href={withBase('/de/bayern-basketball-fans-madrid/')}>Treffpunkt-Leitfaden</a> (Spieltag).</p>
      <h2>Keine Reservierungen</h2>
      <p><strong>Keine Reservierungen</strong>, Einlass nach Reihenfolge der Ankunft — Montag und Dienstag.</p>
      <h2>Nach dem Montagabend</h2>
      <p>Am <strong>Dienstag, 15. Dezember</strong> gastiert der FC Bayern München bei Real Madrid (20:45 Uhr). Dubliners, O’Connell’s und O’Reilly’s bleiben euer Treffpunkt an der Puerta del Sol. Das Spiel läuft <strong>LIVE auf unseren Bildschirmen bei Dubliners</strong> am Spielabend — auch auf <a href={withBase('/whats-on/')}>What’s On</a>.</p>
      <p>In English: <a href={withBase('/bayern-basketball-fans-madrid/what-to-know-before-the-game/')} hreflang="en">Bayern Fans Madrid Kneipe — Monday 14 December</a>.</p>
      <p class="small">Dubliners ist ein unabhängiger Pub, ohne Verbindung zur EuroLeague, zu Real Madrid oder zum FC Bayern München.</p>
    </div>
  </section>
</BaseLayout>