---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import LinkHub from '../../../../components/LinkHub.astro';
import { SITE, withBase } from '../../../../site';
import { OPENING_HOURS } from '../../../../data/hours';

// Bayern Tag 7 (PLAN.md, 30.10.2026). DE-Version von /bayern-fans-madrid/football-weekend/. Spiele NUR aus src/data/fixtures.ts.
const dayDe: Record<string, string> = { Monday: 'Montag', Tuesday: 'Dienstag', Wednesday: 'Mittwoch', Thursday: 'Donnerstag', Friday: 'Freitag', Saturday: 'Samstag', Sunday: 'Sonntag' };
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'de',
  mainEntity: [
    { '@type': 'Question', name: 'Kann ich Bayern gegen Dortmund in Madrid schauen?', acceptedAnswer: { '@type': 'Answer', text: 'Ja. FC Bayern München gegen Borussia Dortmund (Bundesliga) läuft am Samstag, 31. Oktober, um 18:30 Uhr LIVE im Dubliners.' } },
    { '@type': 'Question', name: 'Ist der 2. November in Madrid ein Feiertag?', acceptedAnswer: { '@type': 'Answer', text: 'Ja, Montag, der 2. November, ist in der Region Madrid Feiertag. Viele Fans machen daraus ein langes Wochenende vor Atlético–Bayern am Dienstag, 3. November.' } },
  ],
};
---

<BaseLayout title="Früh angereist? Bayern–Dortmund & das Wochenende LIVE an der Sol | Dubliners" description="Schon vor Atlético–Bayern in Madrid? Schaut Bayern–Dortmund (Sa., 31. Okt., 18:30 Uhr) und das ganze lange Wochenende LIVE im Dubliners, ein paar Schritte von der Puerta del Sol." path="/de/bayern-fans-madrid/fussball-wochenende/" htmlLang="de" hreflang={{ en: '/bayern-fans-madrid/football-weekend/', de: '/de/bayern-fans-madrid/fussball-wochenende/' }} ogImage="/images/dubliners-main-room-madrid-v2-1200.webp" extraJsonLd={[faqLd]}>
  <section class="hero hero-compact">
    <div class="container">
      <h1>Früh angereist? Das Wochenende LIVE, los geht’s mit dem Klassiker</h1>
      <p class="lead">Ihr seid schon Tage vor Atlético–Bayern in Madrid? Schaut Bayern gegen Dortmund am Samstag und den Rest des langen Wochenendes mit anderen Fans, ein paar Schritte von der Puerta del Sol.</p>
      <p class="small">Samstag, 31. Oktober – Montag, 2. November 2026 · Madrider Zeit · Aktualisiert am 30. Oktober 2026</p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Route planen</a>
        <a class="btn btn-primary" href={withBase('/contact/#request-information')}>Request information</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p>Dieser Artikel gehört zu unserem Guide für Bayern-Fans in Madrid; fangt hier an: <a href={withBase('/de/bayern-fans-madrid/')}>Bayern-Fans in Madrid</a>.</p>
      <h2>Samstag, 31. Oktober</h2>
      <ul>
        <li><strong>18:30 Uhr · FC Bayern München – Borussia Dortmund</strong> (Bundesliga): das Aufwärmen für Dienstag.</li>
        <li>14:00 Uhr · Levante – Atlético de Madrid (LaLiga): schaut euch den nächsten Gegner vorher an.</li>
        <li>13:30 Uhr · Chelsea – Manchester United (Premier League).</li>
        <li>Ab 19:00 Uhr · Halloween im Dubliners, mit Kostümen, Deko und Musik.</li>
        <li>21:00 Uhr · Barcelona – Alavés (LaLiga) · 22:00 Uhr · Qualifying zum Großen Preis von Mexiko (F1).</li>
      </ul>
      <h2>Sonntag, 1. November</h2>
      <ul>
        <li>16:15 Uhr · Racing – Real Madrid (LaLiga) · 17:30 Uhr · Liverpool – Arsenal (Premier League).</li>
        <li>Ab 19:00 Uhr · NFL-Sonntag mit RedZone · 21:00 Uhr · Großer Preis von Mexiko (F1).</li>
      </ul>
      <h2>Montag, 2. November (Feiertag in Madrid)</h2>
      <ul>
        <li>21:00 Uhr · Newcastle United – Everton (Premier League) und Deportivo – Osasuna (LaLiga).</li>
      </ul>
      <p>Das komplette Programm, auch Rugby und NHL, findet ihr unter <a href={withBase('/whats-on/')} hreflang="en" lang="en">What's On</a> (auf Englisch).</p>
      <h2>Und dann Dienstag: Atlético–Bayern</h2>
      <p>Atlético de Madrid – FC Bayern München, UEFA Champions League (Ligaphase), <strong>Dienstag, 3. November 2026, 21:00 Uhr</strong>, im Riyadh Air Metropolitano. Kein Ticket? Das Spiel läuft LIVE im Dubliners auf unseren 8 Bildschirmen, in Spanien übertragen von Movistar Plus+. Kommt früh.</p>
      <h2>Drei Pubs an der Sol</h2>
      <ul>
        <li><strong>Dubliners</strong>: Calle de Espoz y Mina 7, ein paar Schritte von der Puerta del Sol.</li>
        <li><strong>O'Connell St</strong>: direkt nebenan, ebenfalls Calle de Espoz y Mina 7.</li>
        <li><strong>O'Reilly's</strong>: 200 m von der Puerta del Sol.</li>
      </ul>
      <h2>Öffnungszeiten</h2>
      <ul>{OPENING_HOURS.map((d) => <li>{dayDe[d.day]}: {d.opens}–{d.closes} Uhr</li>)}</ul>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Kommt früh: Route planen</a>
        <a class="btn btn-primary" href={withBase('/contact/#request-information')}>Request information</a>
      </div>
      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Kann ich Bayern gegen Dortmund in Madrid schauen?</strong></dt><dd>Ja. FC Bayern München gegen Borussia Dortmund (Bundesliga) läuft am Samstag, 31. Oktober, um 18:30 Uhr LIVE im Dubliners.</dd>
        <dt><strong>Ist der 2. November in Madrid ein Feiertag?</strong></dt><dd>Ja, Montag, der 2. November, ist in der Region Madrid Feiertag. Viele Fans machen daraus ein langes Wochenende vor Atlético–Bayern am Dienstag, 3. November.</dd>
      </dl>
      <p class="small">Dubliners Irish Pub · Calle de Espoz y Mina 7, 28012 Madrid · Das Dubliners ist ein unabhängiger Pub und nicht mit der UEFA, der Bundesliga oder den Vereinen verbunden.</p>
      <p>In English: <a href={withBase('/bayern-fans-madrid/football-weekend/')} hreflang="en" lang="en">Arrived early? The weekend LIVE</a></p>
      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Mehr für Bayern-Fans',
            items: [
              { href: '/de/bayern-fans-madrid/', label: 'Bayern-Fans in Madrid', note: 'Das Spiel LIVE an der Sol' },
              { href: '/de/bayern-fans-madrid/praktische-tipps/', label: '5 Tipps für euren Madrid-Trip', note: 'Zeitzone, Anreise, Öffnungszeiten, Stadionordnung' },
              { href: '/de/bayern-fans-madrid/spieltag-plan/', label: 'Euer Spieltag-Plan', note: 'Zeiten und Anreise zum Metropolitano' },
              { href: '/de/bayern-fans-madrid/duell-geschichte/', label: 'Die Geschichte von Atlético–Bayern', note: '1974, 2016 und jetzt der 3. November' },
              { href: '/whats-on/', label: "What's On", note: 'Unser ganzes Programm (Englisch)' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
