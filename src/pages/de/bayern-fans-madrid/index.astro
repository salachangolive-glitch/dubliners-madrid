---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LinkHub from '../../../components/LinkHub.astro';
import { SITE, withBase } from '../../../site';
import { OPENING_HOURS } from '../../../data/hours';
const DE: Record<string, string> = { Monday: 'Montag', Tuesday: 'Dienstag', Wednesday: 'Mittwoch', Thursday: 'Donnerstag', Friday: 'Freitag', Saturday: 'Samstag', Sunday: 'Sonntag' };
const faqLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Wann ist Atlético gegen Bayern?", "acceptedAnswer": {"@type": "Answer", "text": "Am Dienstag, 3. November 2026, um 21:00 Uhr Madrider Zeit (Champions League, 4. Spieltag, im Metropolitano)."}}, {"@type": "Question", "name": "Zeigt ihr das Spiel live?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, LIVE auf der großen Leinwand und 8 Bildschirmen."}}, {"@type": "Question", "name": "Wann habt ihr geöffnet?", "acceptedAnswer": {"@type": "Answer", "text": "Montag bis Donnerstag und Sonntag 12:00–02:00 Uhr, Freitag und Samstag 12:00–02:30 Uhr."}}]};
---
<BaseLayout title="Bayern-Fans in Madrid: Treffpunkt für Fans an der Puerta del Sol | Dubliners" description="Bayern-Fans in Madrid: euer Treffpunkt an der Puerta del Sol vor Atlético–Bayern (Di., 3. Nov., 21:00 Uhr). Irish Pub Dubliners, Spiel LIVE. Kommt früh!" path="/de/bayern-fans-madrid/" htmlLang="de" hreflang={{ en: '/bayern-fans-madrid/', de: '/de/bayern-fans-madrid/' }} ogImage="/images/facade.jpg">
  <section class="hero hero-compact"><div class="container">
    <h1>Bayern-Fans in Madrid: Treffpunkt für Fans an der Puerta del Sol</h1>
    <p class="lead">Ihr seid für Atlético gegen Bayern in Madrid? Dann kommt zu uns: Dubliners ist euer Treffpunkt mitten im Zentrum, nur ein paar Schritte von der Puerta del Sol. Hier trefft ihr andere Bayern-Fans, stoßt gemeinsam auf den Abend an und seid trotzdem mitten in der Stadt.</p>
    <p class="small">Dienstag, 3. November 2026 · Anstoß 21:00 Uhr Madrider Zeit · Champions League im Metropolitano · Stand: 24. Oktober 2026</p>
    <div class="cta-row">
      <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Route zu uns</a>
      <a class="btn btn-primary" href={withBase('/contact/#request-information')}>Info anfragen</a>
    </div>
  </div></section>
  <section class="section"><div class="container prose">
    <p>Am Dienstag, 3. November 2026, spielt Atlético de Madrid in der Champions League (4. Spieltag) gegen den FC Bayern München – Anstoß 21:00 Uhr Madrider Zeit, im Metropolitano. Ohne Karte oder schon tagsüber in der Stadt? Dubliners ist ein Irish Pub mitten im Zentrum, direkt an der Puerta del Sol, und zeigt das Spiel LIVE.</p>
    <h2>Euer Treffpunkt im Herzen von Madrid</h2>
    <p>Bildschirme, ein kühles Bier an der Bar, Pub-Essen und jede Menge Vorfreude mit anderen Fans: So fängt ein Champions-League-Abend in Madrid richtig an. Ob ihr euch vor der Fahrt ins Stadion trefft oder ohne Karte den ganzen Abend bei uns bleibt – bei Dubliners seid ihr herzlich willkommen.</p>
    <picture><source type="image/webp" srcset={`${withBase('/images/facade-queue-sm.webp')} 640w, ${withBase('/images/facade-queue.webp')} 1320w`} sizes="(max-width: 800px) 100vw, 720px" /><img class="split-photo landscape" src={withBase('/images/facade-queue.jpg')} width="1320" height="986" loading="lazy" decoding="async" alt="Gäste vor dem Eingang von Dubliners am Abend, Calle de Espoz y Mina 7, nahe der Puerta del Sol" /></picture>
    <h2>Kommt früh</h2>
    <p>Bei großen Spielen lohnt es sich, früher da zu sein. Am Dienstag haben wir ab 12:00 Uhr geöffnet – genug Zeit, um sich in Ruhe zu treffen.</p>
    <h2>Das Spiel</h2>
    <p>Atlético gegen Bayern LIVE auf der großen Leinwand und 8 Bildschirmen. In Spanien überträgt Movistar Plus+.</p>
    <h2>Drei Pubs, ein Treffpunkt</h2>
    <ul>
      <li><strong>Dubliners</strong> – Calle de Espoz y Mina 7, an der Puerta del Sol.</li>
      <li><strong>O'Connell St</strong> – gleich nebenan, ebenfalls Calle de Espoz y Mina 7 (<a href="https://oconnellsmadrid.es/" rel="noopener" hreflang="es">oconnellsmadrid.es</a>).</li>
      <li><strong>O'Reilly's</strong> – 200 m von der Puerta del Sol.</li>
    </ul>
    <h2>Wo wir sind</h2>
    <p>Calle de Espoz y Mina 7, 28012 Madrid – zwischen Puerta del Sol, Plaza Mayor und dem Barrio de las Letras. Metro: Sol (Linien 1, 2, 3) oder Sevilla (Linie 2).</p>
    <h2>Vom Zentrum zum Metropolitano</h2>
    <p>Gerade angekommen? Lest <a href={withBase('/de/bayern-fans-madrid/ankunft-in-madrid/')}>Ankunft in Madrid: euer Startpunkt an der Sol</a>. Ihr schaut bei uns? Hier gibt’s <a href={withBase('/de/bayern-fans-madrid/leinwand-und-essen/')}>Leinwand und Essen am Spieltag</a>. Gespielt wird im Riyadh Air Metropolitano. Das Stadion hat eine eigene Metro-Station: <strong>Estadio Metropolitano (Linie 7)</strong>. Außerdem fahren die EMT-Busse 28, 38, 48, 140, 153, 167, E2 und SE721 in die Gegend, nachts die Linien N5 und N6; der nächste Cercanías-Bahnhof ist Coslada. Eure Verbindung ab Sol am Spieltag findet ihr in der App von Metro de Madrid oder auf <a href="https://www.crtm.es/" target="_blank" rel="noopener">crtm.es</a>.</p>
    <p>Ihr geht ins Stadion? Laut Stadionordnung sind unter anderem Alkohol, Bengalos bzw. Pyrotechnik und Gegenstände über 500 g verboten. Prüft vor dem Spiel die aktuellen Regeln.</p>
    <h2>Öffnungszeiten</h2>
    <ul>{OPENING_HOURS.map((d) => <li>{DE[d.day]}: {d.opens}–{d.closes} Uhr</li>)}</ul>
    <h2>Madrid vor dem Spiel</h2>
    <p>Von hier aus sind Plaza Mayor, der Mercado de San Miguel, die Gran Vía und der Prado gut zu Fuß erreichbar. Danach einfach zurück an die Sol und in Ruhe das Spiel schauen.</p>
    <h2>Häufige Fragen</h2><dl class="faq"><dt><strong>Wann ist Atlético gegen Bayern?</strong></dt><dd>Am Dienstag, 3. November 2026, um 21:00 Uhr Madrider Zeit (Champions League, 4. Spieltag, im Metropolitano).</dd><dt><strong>Zeigt ihr das Spiel live?</strong></dt><dd>Ja, LIVE auf der großen Leinwand und 8 Bildschirmen.</dd><dt><strong>Wann habt ihr geöffnet?</strong></dt><dd>Montag bis Donnerstag und Sonntag 12:00–02:00 Uhr, Freitag und Samstag 12:00–02:30 Uhr.</dd></dl>
    <p class="small">Dubliners Irish Pub · Calle de Espoz y Mina 7, 28012 Madrid · Dubliners ist ein unabhängiger Pub, ohne Verbindung zur UEFA oder zu den Vereinen.</p>
    <p>Auf Englisch: <a href={withBase('/bayern-fans-madrid/')} hreflang="en" lang="en">Bayern fans in Madrid</a></p>
    <LinkHub
      heading="h2"
      groups={[
        {
          title: 'Mehr Fußball bei Dubliners',
          items: [
            { href: '/de/bayern-fans-madrid/ankunft-in-madrid/', label: 'Ankunft in Madrid: euer Startpunkt an der Sol', note: 'Von der Ankunft bis zum Anstoß' },
            { href: '/de/bayern-fans-madrid/leinwand-und-essen/', label: 'Leinwand und Essen am Spieltag', note: 'Große Leinwand, 8 Bildschirme, Speisekarte' },
            { href: '/champions-league-bar-madrid/', label: 'Champions League near Sol', note: 'Auf Englisch', hreflang: 'en', lang: 'en' },
            { href: '/es/champions-league-bar-madrid/', label: 'Champions League cerca de Sol', note: 'Auf Spanisch', hreflang: 'es', lang: 'es' },
            { href: '/whats-on/', label: "What's On", note: 'Alle Übertragungen (Englisch)', hreflang: 'en', lang: 'en' },
            { href: '/bayern-fans-madrid/', label: 'Bayern fans in Madrid', note: 'Diese Seite auf Englisch', hreflang: 'en', lang: 'en' },
          ],
        },
      ]}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </div></section>
</BaseLayout>
