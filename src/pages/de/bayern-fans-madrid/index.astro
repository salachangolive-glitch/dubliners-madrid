---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LinkHub from '../../../components/LinkHub.astro';
import { withBase } from '../../../site';
import { OPENING_HOURS } from '../../../data/hours';
const DE: Record<string, string> = { Monday: 'Montag', Tuesday: 'Dienstag', Wednesday: 'Mittwoch', Thursday: 'Donnerstag', Friday: 'Freitag', Saturday: 'Samstag', Sunday: 'Sonntag' };
const faqLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Wann ist Atlético gegen Bayern?", "acceptedAnswer": {"@type": "Answer", "text": "Am Dienstag, 3. November 2026, um 21:00 Uhr Madrider Zeit (Champions League, 4. Spieltag, im Metropolitano)."}}, {"@type": "Question", "name": "Zeigt ihr das Spiel live?", "acceptedAnswer": {"@type": "Answer", "text": "Ja, LIVE auf der großen Leinwand und 8 Bildschirmen."}}, {"@type": "Question", "name": "Wann habt ihr geöffnet?", "acceptedAnswer": {"@type": "Answer", "text": "Montag bis Donnerstag und Sonntag 12:00–02:00 Uhr, Freitag und Samstag 12:00–02:30 Uhr."}}]};
---
<BaseLayout title="Bayern-Fans in Madrid: Treffpunkt für Fans an der Puerta del Sol | Dubliners" description="Treffpunkt für Fans an der Puerta del Sol: Atlético gegen Bayern am Di., 3. November 2026, 21:00 Uhr, LIVE im Irish Pub Dubliners. Lage, Öffnungszeiten." path="/de/bayern-fans-madrid/" htmlLang="de" ogImage="/images/facade.jpg">
  <section class="hero hero-compact"><div class="container">
    <h1>Bayern-Fans in Madrid: Treffpunkt für Fans an der Puerta del Sol</h1>
  </div></section>
  <section class="section"><div class="container prose">
    <p>Am Dienstag, 3. November 2026, spielt Atlético de Madrid in der Champions League (4. Spieltag) gegen den FC Bayern München – Anstoß 21:00 Uhr Madrider Zeit, im Metropolitano. Ohne Karte oder schon tagsüber in der Stadt? Dubliners ist ein Irish Pub mitten im Zentrum, direkt an der Puerta del Sol, und zeigt das Spiel LIVE.</p>
    <h2>Wo wir sind</h2>
    <p>Calle de Espoz y Mina 7, 28012 Madrid – zwischen Puerta del Sol, Plaza Mayor und dem Barrio de las Letras. Metro: Sol (Linien 1, 2, 3) oder Sevilla (Linie 2).</p>
    <h2>Das Spiel</h2>
    <p>Atlético gegen Bayern LIVE auf der großen Leinwand und 8 Bildschirmen. Bei großen Spielen lohnt es sich, früher da zu sein.</p>
    <h2>Öffnungszeiten</h2>
    <ul>{OPENING_HOURS.map((d) => <li>{DE[d.day]}: {d.opens}–{d.closes} Uhr</li>)}</ul>
    <h2>Madrid vor dem Spiel</h2>
    <p>Von hier aus sind Plaza Mayor, der Mercado de San Miguel, die Gran Vía und der Prado gut zu Fuß erreichbar. Danach einfach zurück an die Sol und in Ruhe das Spiel schauen.</p>
    <h2>Häufige Fragen</h2><dl class="faq"><dt><strong>Wann ist Atlético gegen Bayern?</strong></dt><dd>Am Dienstag, 3. November 2026, um 21:00 Uhr Madrider Zeit (Champions League, 4. Spieltag, im Metropolitano).</dd><dt><strong>Zeigt ihr das Spiel live?</strong></dt><dd>Ja, LIVE auf der großen Leinwand und 8 Bildschirmen.</dd><dt><strong>Wann habt ihr geöffnet?</strong></dt><dd>Montag bis Donnerstag und Sonntag 12:00–02:00 Uhr, Freitag und Samstag 12:00–02:30 Uhr.</dd></dl>
    <LinkHub
      heading="h2"
      groups={[
        {
          title: 'Mehr Fußball bei Dubliners',
          items: [
            { href: '/champions-league-irish-pub-sol/', label: 'Champions League in an Irish pub in Sol', note: 'Auf Englisch', hreflang: 'en', lang: 'en' },
            { href: '/es/champions-pub-irlandes-sol/', label: 'Champions en un pub irlandés en Sol', note: 'Auf Spanisch', hreflang: 'es', lang: 'es' },
            { href: '/whats-on/', label: "What's On", note: 'Alle Übertragungen (Englisch)', hreflang: 'en', lang: 'en' },
          ],
        },
      ]}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </div></section>
</BaseLayout>
