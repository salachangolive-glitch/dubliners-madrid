---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import LinkHub from '../../../../components/LinkHub.astro';
import { SITE, withBase } from '../../../../site';
import { OPENING_HOURS } from '../../../../data/hours';

// Bayern Tag 11 (PLAN.md, Di. 3.11.2026, Spieltag). DE-Version von /bayern-fans-madrid/match-day-live/. Spiele NUR aus src/data/fixtures.ts.
// Spieldaten NUR aus CONFIRMADO-Zeilen 1, 8, 10 von radar/bayern-3nov.md. «Treffpunkt» nur für diese Kampagne erlaubt (Inhaber, 2.11.).
const dayDe: Record<string, string> = { Monday: 'Montag', Tuesday: 'Dienstag', Wednesday: 'Mittwoch', Thursday: 'Donnerstag', Friday: 'Freitag', Saturday: 'Samstag', Sunday: 'Sonntag' };
const tue = OPENING_HOURS.find((d) => d.day === 'Tuesday')!;
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  inLanguage: 'de',
  mainEntity: [
    { '@type': 'Question', name: 'Wann ist heute Anpfiff bei Atlético–Bayern?', acceptedAnswer: { '@type': 'Answer', text: 'Atlético de Madrid gegen FC Bayern München beginnt am Dienstag, 3. November 2026, um 21:00 Uhr Madrider Zeit im Riyadh Air Metropolitano. Das Spiel läuft LIVE im Dubliners an der Puerta del Sol, in Spanien übertragen von Movistar Plus+.' } },
    { '@type': 'Question', name: 'Wie lange hat das Dubliners heute geöffnet?', acceptedAnswer: { '@type': 'Answer', text: `Am Dienstag hat das Dubliners von ${tue.opens} bis ${tue.closes} Uhr geöffnet – ihr könnt also nach dem Abpfiff bleiben.` } },
  ],
};
---

<BaseLayout title="Spieltag: Atlético–Bayern heute, 21:00 Uhr LIVE an der Sol | Dubliners" description="Heute ist Spieltag! Atlético–Bayern um 21:00 Uhr LIVE im Dubliners an der Puerta del Sol, vorher Galatasaray–Stuttgart um 18:45 Uhr. Geöffnet 12:00–02:00 Uhr. Kommt früh." path="/de/bayern-fans-madrid/spieltag-live/" htmlLang="de" hreflang={{ en: '/bayern-fans-madrid/match-day-live/', de: '/de/bayern-fans-madrid/spieltag-live/' }} ogImage="/images/dubliners-main-room-madrid-v2-1200.webp" extraJsonLd={[faqLd]}>
  <section class="hero hero-compact">
    <div class="container">
      <h1>Heute: Atlético–Bayern, 21:00 Uhr LIVE</h1>
      <p class="lead">Endlich Spieltag! Ob mit Ticket oder ohne – hier ist euer Dienstag Stunde für Stunde, mit einem Treffpunkt für Fans ein paar Schritte von der Puerta del Sol.</p>
      <p class="small">Dienstag, 3. November 2026 · Madrider Zeit · Aktualisiert am 3. November 2026</p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Kommt früh: Route planen</a>
        <a class="btn btn-primary" href={withBase('/contact/#request-information')}>Request information</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p>Dieser Artikel gehört zu unserem Guide für Bayern-Fans in Madrid; los geht’s mit <a href={withBase('/de/bayern-fans-madrid/')}>Bayern-Fans in Madrid</a>.</p>
      <h2>Euer Dienstag, Stunde für Stunde</h2>
      <ul>
        <li><strong>{tue.opens} Uhr</strong> · Das Dubliners öffnet. Mittagessen, ein kühles Bier und die ersten roten Trikots an der Bar. Hier ist <a href={withBase('/menu/')}>unsere Speisekarte</a> (Englisch).</li>
        <li><strong>18:45 Uhr</strong> · Galatasaray–Stuttgart und Schachtar Donezk–Sporting (Champions League): das Aufwärmprogramm auf unseren Bildschirmen.</li>
        <li><strong>Ab etwa 19:00 Uhr</strong> · Ihr habt ein Ticket? Dann ab ins Stadion. Laut Verein fährt die EMT an Spieltagen ab zwei Stunden vor Anpfiff einen Sonderbus zwischen Canillejas und Plaza de Grecia, und die Metro-Linie 7 hält an der Station Estadio Metropolitano. Eure Verbindung ab Sol findet ihr in der App von Metro de Madrid oder auf <a href="https://www.crtm.es/" target="_blank" rel="noopener">crtm.es</a>.</li>
        <li><strong>21:00 Uhr</strong> · <strong>Atlético de Madrid – FC Bayern München</strong>, Champions League (Ligaphase), LIVE auf der großen Leinwand und auf unseren 8 Bildschirmen (in Spanien auf Movistar Plus+). Barça–Aston Villa und die anderen 21-Uhr-Spiele laufen auch, bei Überschneidungen auf verschiedenen Bildschirmen.</li>
        <li><strong>Nach dem Abpfiff</strong> · Dienstags haben wir bis {tue.closes} Uhr offen. Feiert (oder verarbeitet) das Ergebnis mit anderen Fans, bevor es zurück ins Hotel geht.</li>
      </ul>
      <h2>Kein Ticket? Schaut bei uns</h2>
      <p>Das Dubliners liegt in der Calle de Espoz y Mina 7, zwischen Puerta del Sol, Plaza Mayor und dem Barrio de las Letras. Metro: Sol (Linien 1, 2, 3) oder Sevilla (Linie 2). Vor großen Spielen wird es voll – also kommt früh.</p>
      <h2>Deutsche Klubs diese Woche LIVE</h2>
      <ul>
        <li>Dienstag, 3. November · 18:45 Uhr · Galatasaray–Stuttgart · 21:00 Uhr · Atlético–Bayern.</li>
        <li>Mittwoch, 4. November · 21:00 Uhr · Borussia Dortmund–Betis und RB Leipzig–Manchester City.</li>
      </ul>
      <p>Ihr bleibt länger? Das ganze Programm steht auf <a href={withBase('/whats-on/')} hreflang="en" lang="en">What's On</a> (Englisch).</p>
      <h2>Drei Pubs an der Sol</h2>
      <ul>
        <li><strong>Dubliners</strong>: Calle de Espoz y Mina 7, ein paar Schritte von der Puerta del Sol.</li>
        <li><strong>O'Connell St</strong>: direkt nebenan, ebenfalls Calle de Espoz y Mina 7.</li>
        <li><strong>O'Reilly's</strong>: 200 m von der Puerta del Sol.</li>
      </ul>
      <h2>Öffnungszeiten</h2>
      <ul>{OPENING_HOURS.map((d) => <li>{dayDe[d.day]}: {d.opens}–{d.closes} Uhr</li>)}</ul>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Kommt früh: Route planen</a>
        <a class="btn btn-primary" href={withBase('/contact/#request-information')}>Request information</a>
      </div>
      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Wann ist heute Anpfiff bei Atlético–Bayern?</strong></dt><dd>Atlético de Madrid gegen FC Bayern München beginnt am Dienstag, 3. November 2026, um 21:00 Uhr Madrider Zeit im Riyadh Air Metropolitano. Das Spiel läuft LIVE im Dubliners an der Puerta del Sol, in Spanien übertragen von Movistar Plus+.</dd>
        <dt><strong>Wie lange hat das Dubliners heute geöffnet?</strong></dt><dd>Am Dienstag hat das Dubliners von {tue.opens} bis {tue.closes} Uhr geöffnet – ihr könnt also nach dem Abpfiff bleiben.</dd>
      </dl>
      <p class="small">Dubliners Irish Pub · Calle de Espoz y Mina 7, 28012 Madrid · Das Dubliners ist ein unabhängiger Pub und nicht mit der UEFA oder den Vereinen verbunden.</p>
      <p>In English: <a href={withBase('/bayern-fans-madrid/match-day-live/')} hreflang="en" lang="en">Today: Atlético v Bayern, 21:00 LIVE</a></p>
      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Mehr für Bayern-Fans',
            items: [
              { href: '/de/bayern-fans-madrid/', label: 'Bayern-Fans in Madrid', note: 'Das Spiel LIVE an der Sol' },
              { href: '/de/bayern-fans-madrid/atletico-bayern-wo-schauen/', label: 'Atlético–Bayern: Wo schauen in Madrid?', note: 'Dienstag, 3. November, 21:00 Uhr' },
              { href: '/de/bayern-fans-madrid/spieltag-plan/', label: 'Euer Spieltag-Plan', note: 'Zeiten und Anreise zum Metropolitano' },
              { href: '/de/bayern-fans-madrid/praktische-tipps/', label: '5 Tipps für euren Madrid-Trip', note: 'Zeitzone, Anreise, Öffnungszeiten, Stadionordnung' },
              { href: '/whats-on/', label: "What's On", note: 'Unser ganzes Programm (Englisch)' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
