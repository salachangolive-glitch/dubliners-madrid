---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import LinkHub from '../../../../components/LinkHub.astro';
import { SITE, withBase } from '../../../../site';
import { OPENING_HOURS } from '../../../../data/hours';

// Bayern Tag 4 (DG 27 Oct 2026, P1). Angle: noch eine Woche, der Spieltag-Plan (Zeiten, Sol, Anreise zum Metropolitano via Metro-App / crtm.es).
// DG-Entscheidung 26 Oct 12:48: KEIN Treffpunkt-Winkel, KEIN «Zentrum zu Fuß». Abgegrenzt von Tag 1 (Hub), Tag 2 (Ankunft), Tag 3 (Leinwand + Essen).
// Fakten NUR aus CONFIRMADO-Zeilen in /workspace/radar/bayern-3nov.md: 1, 8, 9, 10 (Vereinsnorm, Hinweis für 3. Nov offen), 12, 15. Keine Preise, keine Reservierungen.
const DE: Record<string, string> = { Monday: 'Montag', Tuesday: 'Dienstag', Wednesday: 'Mittwoch', Thursday: 'Donnerstag', Friday: 'Freitag', Saturday: 'Samstag', Sunday: 'Sonntag' };
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'Wann ist Atlético gegen Bayern?', acceptedAnswer: { '@type': 'Answer', text: 'Dienstag, 3. November 2026, Anstoß 21:00 Uhr Madrider Zeit (wie in München), im Riyadh Air Metropolitano. In Spanien überträgt Movistar Plus+.' } },
    { '@type': 'Question', name: 'Wie komme ich von der Sol zum Metropolitano?', acceptedAnswer: { '@type': 'Answer', text: 'Das Stadion hat eine eigene Metro-Station: Estadio Metropolitano (Linie 7). Eure genaue Route ab Sol findet ihr in der App von Metro de Madrid oder auf crtm.es.' } },
    { '@type': 'Question', name: 'Zeigt ihr das Spiel, wenn ich keine Karte habe?', acceptedAnswer: { '@type': 'Answer', text: 'Ja. Atlético gegen Bayern läuft LIVE bei Dubliners auf unserer großen Leinwand und 8 Bildschirmen.' } },
    { '@type': 'Question', name: 'Wann habt ihr am Dienstag, 3. November, geöffnet?', acceptedAnswer: { '@type': 'Answer', text: 'Von 12:00 bis 02:00 Uhr.' } },
  ],
};
---
<BaseLayout title="Atlético–Bayern: Noch eine Woche – euer Spieltag-Plan | Dubliners" description="Atlético–Bayern, Di., 3. Nov., 21:00 Uhr: noch eine Woche. Zeiten am Spieltag, Metro-Linie 7 zum Metropolitano und das Spiel LIVE bei Dubliners an der Sol, ab 12:00 Uhr." path="/de/bayern-fans-madrid/spieltag-plan/" htmlLang="de" hreflang={{ en: '/bayern-fans-madrid/match-day-plan/', de: '/de/bayern-fans-madrid/spieltag-plan/' }} ogImage="/images/dubliners-projector-main-room-madrid-v2-1200.webp" extraJsonLd={[faqLd]}>
  <section class="hero hero-compact"><div class="container">
    <h1>Noch eine Woche: euer Spieltag-Plan für Atlético–Bayern</h1>
    <p class="lead">Nächsten Dienstag, am 3. November, spielt Atlético um 21:00 Uhr Madrider Zeit gegen Bayern. So läuft der Tag ab der Sol: wann wir öffnen, wie ihr zum Metropolitano kommt und wo ihr das Spiel ohne Karte LIVE seht.</p>
    <p class="small">Atlético – Bayern · Dienstag, 3. November 2026 · Anstoß 21:00 Uhr Madrider Zeit · Stand: 27. Oktober 2026</p>
    <div class="cta-row">
      <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Route zu uns</a>
      <a class="btn btn-primary" href={withBase('/contact/#request-information')}>Informationen anfordern</a>
    </div>
  </div></section>
  <section class="section"><div class="container prose">
    <p>Dieser Artikel gehört zu unserem Guide für Bayern-Fans in Madrid; los geht’s mit <a href={withBase('/de/bayern-fans-madrid/')}>Bayern-Fans in Madrid</a>. Gerade gelandet? Lest <a href={withBase('/de/bayern-fans-madrid/ankunft-in-madrid/')}>Ankunft in Madrid</a>. Ihr schaut bei uns? Hier gibt’s <a href={withBase('/de/bayern-fans-madrid/leinwand-und-essen/')}>Leinwand und Essen</a>.</p>
    <h2>Das Spiel</h2>
    <p>Atlético de Madrid gegen FC Bayern München, UEFA Champions League (Ligaphase), <strong>Dienstag, 3. November 2026, 21:00 Uhr Madrider Zeit</strong> – dieselbe Uhrzeit wie in München. Gespielt wird im Riyadh Air Metropolitano. In Spanien überträgt Movistar Plus+.</p>
    <h2>Der Spieltag Stunde für Stunde</h2>
    <ul>
      <li><strong>12:00 Uhr</strong>: Dubliners öffnet, ein paar Schritte von der Puerta del Sol. Mittagessen von unserer <a href={withBase('/menu/')} hreflang="en" lang="en">Speisekarte (Englisch)</a> und ein Bier mitten in Madrid.</li>
      <li><strong>Nachmittags</strong>: Ihr geht ins Stadion? Plant genug Zeit ein. Das Metropolitano hat eine eigene Metro-Station: <strong>Estadio Metropolitano (Linie 7)</strong>. Eure genaue Route ab Sol findet ihr in der App von Metro de Madrid oder auf <a href="https://www.crtm.es/" target="_blank" rel="noopener">crtm.es</a>.</li>
      <li><strong>Ab 19:00 Uhr</strong>: Laut Atlético fährt EMT an Heimspieltagen einen Sonderbus zwischen Canillejas und Plaza de Grecia, von zwei Stunden vor dem Anstoß bis 1 Std. 30 Min. nach dem Spiel. Der konkrete Hinweis für den 3. November ist noch nicht veröffentlicht: Schaut am Spieltag auf <a href="https://www.emtmadrid.es/" target="_blank" rel="noopener">emtmadrid.es</a>.</li>
      <li><strong>21:00 Uhr</strong>: Anstoß. Keine Karte? Atlético gegen Bayern läuft LIVE bei Dubliners auf unserer großen Leinwand und 8 Bildschirmen.</li>
      <li><strong>Nach dem Spiel</strong>: Dienstags haben wir bis 02:00 Uhr geöffnet.</li>
    </ul>
    <h2>Anreise zum Metropolitano</h2>
    <ul>
      <li><strong>Metro</strong>: Linie 7, Station Estadio Metropolitano.</li>
      <li><strong>EMT-Busse</strong>: 28, 38, 48, 140, 153, 167, E2 und SE721; nachts N5 und N6.</li>
      <li><strong>Cercanías</strong>: Als nächster Bahnhof zum Stadion wird Coslada angegeben.</li>
      <li><strong>BiciMAD</strong>: Stationen Av. de Arcentales und Av. de Niza 67.</li>
    </ul>
    <p>Die genaue Verbindung ab Sol am Spieltag findet ihr in der App von Metro de Madrid oder auf <a href="https://www.crtm.es/" target="_blank" rel="noopener">crtm.es</a>.</p>
    <h2>Bevor ihr ins Stadion geht</h2>
    <p>Laut Stadionordnung sind unter anderem Alkohol, Bengalos bzw. Pyrotechnik und Gegenstände über 500 g verboten. Die UEFA kann eigene Regeln ergänzen – prüft vorher die aktuellen. Die Einlasszeiten für den 3. November sind noch nicht veröffentlicht.</p>
    <h2>Wo wir sind</h2>
    <p>Calle de Espoz y Mina 7, 28012 Madrid – zwischen Puerta del Sol, Plaza Mayor und dem Barrio de las Letras. Metro: Sol (Linien 1, 2, 3).</p>
    <h2>Öffnungszeiten</h2>
    <ul>{OPENING_HOURS.map((d) => <li>{DE[d.day]}: {d.opens}–{d.closes} Uhr</li>)}</ul>
    <div class="cta-row">
      <a class="btn btn-primary" href={withBase('/contact/#request-information')}>Informationen anfordern</a>
    </div>
    <h2>Häufige Fragen</h2>
    <dl class="faq">
      <dt><strong>Wann ist Atlético gegen Bayern?</strong></dt><dd>Dienstag, 3. November 2026, Anstoß 21:00 Uhr Madrider Zeit (wie in München), im Riyadh Air Metropolitano. In Spanien überträgt Movistar Plus+.</dd>
      <dt><strong>Wie komme ich von der Sol zum Metropolitano?</strong></dt><dd>Das Stadion hat eine eigene Metro-Station: Estadio Metropolitano (Linie 7). Eure genaue Route ab Sol findet ihr in der App von Metro de Madrid oder auf crtm.es.</dd>
      <dt><strong>Zeigt ihr das Spiel, wenn ich keine Karte habe?</strong></dt><dd>Ja. Atlético gegen Bayern läuft LIVE bei Dubliners auf unserer großen Leinwand und 8 Bildschirmen.</dd>
      <dt><strong>Wann habt ihr am Dienstag, 3. November, geöffnet?</strong></dt><dd>Von 12:00 bis 02:00 Uhr.</dd>
    </dl>
    <p class="small">Dubliners Irish Pub · Calle de Espoz y Mina 7, 28012 Madrid · Dubliners ist ein unabhängiger Pub, ohne Verbindung zur UEFA oder zu den Vereinen.</p>
    <p>Auf Englisch: <a href={withBase('/bayern-fans-madrid/match-day-plan/')} hreflang="en" lang="en">One week to go: your Atlético v Bayern match-day plan</a></p>
    <LinkHub
      heading="h2"
      groups={[
        {
          title: 'Mehr für Bayern-Fans',
          items: [
            { href: '/de/bayern-fans-madrid/', label: 'Bayern-Fans in Madrid', note: 'Das Spiel LIVE an der Sol' },
            { href: '/de/bayern-fans-madrid/ankunft-in-madrid/', label: 'Ankunft in Madrid', note: 'Startpunkt an der Sol' },
            { href: '/de/bayern-fans-madrid/leinwand-und-essen/', label: 'Leinwand und Essen', note: 'Große Leinwand, 8 Bildschirme, Speisekarte' },
            { href: '/whats-on/', label: "What's On", note: 'Alle Übertragungen (Englisch)', hreflang: 'en', lang: 'en' },
          ],
        },
      ]}
    />
  </div></section>
</BaseLayout>
