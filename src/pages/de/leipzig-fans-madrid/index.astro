---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LinkHub from '../../../components/LinkHub.astro';
import { withBase } from '../../../site';
import { OPENING_HOURS } from '../../../data/hours';
const DE: Record<string, string> = { Monday: 'Montag', Tuesday: 'Dienstag', Wednesday: 'Mittwoch', Thursday: 'Donnerstag', Friday: 'Freitag', Saturday: 'Samstag', Sunday: 'Sonntag' };
const faqLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Wann war Real Madrid gegen RB Leipzig?", "acceptedAnswer": {"@type": "Answer", "text": "Am Mittwoch, 21. Oktober 2026, um 21:00 Uhr Madrider Zeit (Champions League, 3. Spieltag der Ligaphase, im Estadio Santiago Bernabéu). Das Spiel ist vorbei."}}, {"@type": "Question", "name": "Welche Spiele zeigt ihr als Nächstes?", "acceptedAnswer": {"@type": "Answer", "text": "Alle aktuellen Spiele mit Uhrzeit stehen auf unserer Seite What’s On. Für Bayern-Fans gibt es eine eigene Seite zu Atlético gegen Bayern."}}, {"@type": "Question", "name": "Wann habt ihr geöffnet?", "acceptedAnswer": {"@type": "Answer", "text": "Montag bis Donnerstag und Sonntag 12:00–02:00 Uhr, Freitag und Samstag 12:00–02:30 Uhr."}}]};
---
<BaseLayout title="RB-Leipzig-Fans in Madrid (Spiel vom 21. Okt.) | Dubliners an der Puerta del Sol" description="Real Madrid gegen RB Leipzig wurde am 21. Oktober 2026 gespielt. Dubliners, Irish Pub an der Puerta del Sol: nächste Spiele, Lage und Öffnungszeiten." path="/de/leipzig-fans-madrid/" htmlLang="de" ogImage="/images/facade.jpg">
  <section class="hero hero-compact"><div class="container">
    <h1>RB-Leipzig-Fans in Madrid: Treffpunkt für Fans an der Puerta del Sol</h1>
  </div></section>
  <section class="section"><div class="container prose">
    <p><strong>Dieses Spiel ist vorbei:</strong> Real Madrid gegen RB Leipzig wurde am Mittwoch, 21. Oktober 2026, in der Champions League (3. Spieltag der Ligaphase) im Estadio Santiago Bernabéu gespielt. Die nächsten Spiele auf unseren Bildschirmen stehen auf <a href={withBase('/whats-on/')}>What’s On</a>; für Bayern-Fans gibt es die Seite <a href={withBase('/de/bayern-fans-madrid/')}>Bayern-Fans in Madrid</a>. Dubliners ist ein Irish Pub mitten im Zentrum, direkt an der Puerta del Sol.</p>
    <h2>Wo wir sind</h2>
    <p>Calle de Espoz y Mina 7, 28012 Madrid – zwischen Puerta del Sol, Plaza Mayor und dem Barrio de las Letras. Metro: Sol (Linien 1, 2, 3) oder Sevilla (Linie 2). Zum Bernabéu geht es von Sol mit der Linie 10 bis Santiago Bernabéu (Umstieg in Tribunal oder Plaza de España) oder mit Cercanías bis Nuevos Ministerios.</p>
    <h2>Das Spiel</h2>
    <p>Real Madrid gegen RB Leipzig lief am 21. Oktober LIVE auf der großen Leinwand und 8 Bildschirmen. Auch die nächsten großen Spiele zeigen wir dort.</p>
    <h2>Öffnungszeiten</h2>
    <ul>{OPENING_HOURS.map((d) => <li>{DE[d.day]}: {d.opens}–{d.closes} Uhr</li>)}</ul>
    <h2>Madrid vor dem Spiel</h2>
    <p>Von hier aus sind Plaza Mayor, der Mercado de San Miguel, die Gran Vía und der Prado gut zu Fuß erreichbar. Danach einfach zurück an die Sol und in Ruhe das Spiel schauen.</p>
    <h2>Häufige Fragen</h2><dl class="faq"><dt><strong>Wann war Real Madrid gegen RB Leipzig?</strong></dt><dd>Am Mittwoch, 21. Oktober 2026, um 21:00 Uhr Madrider Zeit (Champions League, 3. Spieltag der Ligaphase, im Estadio Santiago Bernabéu). Das Spiel ist vorbei.</dd><dt><strong>Welche Spiele zeigt ihr als Nächstes?</strong></dt><dd>Alle aktuellen Spiele mit Uhrzeit stehen auf <a href={withBase('/whats-on/')}>What’s On</a>. Für Bayern-Fans: <a href={withBase('/de/bayern-fans-madrid/')}>Bayern-Fans in Madrid</a>.</dd><dt><strong>Wann habt ihr geöffnet?</strong></dt><dd>Montag bis Donnerstag und Sonntag 12:00–02:00 Uhr, Freitag und Samstag 12:00–02:30 Uhr.</dd></dl>
    <p class="small">Dubliners ist ein unabhängiger Pub, ohne Verbindung zur UEFA oder zu den Vereinen.</p>
    <LinkHub
      heading="h2"
      groups={[
        {
          title: 'Mehr Fußball bei Dubliners',
          items: [
            { href: '/champions-league-bar-madrid/', label: 'Champions League near Sol', note: 'Auf Englisch', hreflang: 'en', lang: 'en' },
            { href: '/es/champions-league-bar-madrid/', label: 'Champions League cerca de Sol', note: 'Auf Spanisch', hreflang: 'es', lang: 'es' },
            { href: '/whats-on/', label: "What's On", note: 'Alle Übertragungen (Englisch)', hreflang: 'en', lang: 'en' },
            { href: '/de/bayern-fans-madrid/', label: 'Bayern-Fans in Madrid', note: 'Atlético gegen Bayern am 3. November', hreflang: 'de', lang: 'de' },
          ],
        },
      ]}
    />
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
  </div></section>
</BaseLayout>
