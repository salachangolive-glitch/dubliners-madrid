---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../../data/fourBars';

const PATH = '/es/aficionados-nfl-internacionales-sol/';
const PATH_EN = '/international-nfl-fans-near-sol/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Aficionados NFL internacionales junto a Sol: salas en inglés este fin de semana',
  inLanguage: 'es',
  datePublished: '2026-11-07T18:30:00+01:00',
  dateModified: '2026-11-07T18:30:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Dónde pueden quedar esta noche los aficionados NFL que vienen de fuera?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: '18:00–19:00 en O’Reilly’s (Pasaje de Matheu 4), Dubliners y O’Connell’s (Espoz y Mina 7). En Dubliners hay personal que habla inglés. Four Corner es el domingo desde las 14:00.',
      },
    },
    {
      '@type': 'Question',
      name: '¿A qué hora es el Madrid Game en hora del Este de EE. UU.?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Bengals–Falcons es el domingo 8 de noviembre a las 15:30 en Madrid, las 9:30 a.m. ET. EN DIRECTO en la pantalla grande de Dubliners si no vais al Bernabéu.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Son recintos oficiales de la NFL?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Bares hermanos independientes junto a Sol. No es un evento oficial de la NFL. Sin logos de liga, descuentos ni reservas inventados.',
      },
    },
  ],
};
---

<BaseLayout
  title="Aficionados NFL internacionales junto a Sol | Dubliners"
  description="Visitantes NFL: salas en inglés junto a Sol. Quedada esta noche 18:00–19:00. Pantallas el domingo desde las 12:00, Four Corner 14:00. Maps de los cuatro bares."
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Aficionados NFL internacionales junto a Sol" lang="es" schema />
      <h1>Aficionados NFL internacionales junto a Sol: salas en inglés este fin de semana</h1>
      <p class="lead">
        Si habéis venido al Madrid Game y el hotel está alrededor de Sol, los bares hermanos están a pocos minutos andando — no es un lío de metro.
        Esta noche 18:00–19:00 es la coincidencia en tres puertas. El pitido del domingo es 15:30 Madrid / 9:30 a.m. ET.
        En Dubliners hay personal que habla inglés. Pubs independientes. No es NFL oficial.
      </p>
      <p class="small">In English: <a href={withBase(PATH_EN)} hreflang="en" lang="en">International NFL fans near Sol</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">CÓMO LLEGAR</a>
        <a class="btn btn-secondary" href={withBase('/es/cuatro-bares-fin-de-semana/')}>VER LOS CUATRO BARES</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>¿Ya estáis en un hotel alrededor de Sol?</h2>
      <p>
        Guardad las dos calles del sábado: Pasaje de Matheu 4 y Espoz y Mina 7. Se llega andando desde Metro Sol o Sevilla.
        La ventana 18:00–19:00 es para grupos que han aterrizado hoy y aún necesitan un hito.
        El sábado <strong>no hay NFL en directo</strong> — el partido de noche aquí es Valencia–Real Madrid a las 21:00 en Dubliners.
      </p>

      <h2>El reloj del domingo para quien viene de fuera</h2>
      <p>
        Las 15:30 en Madrid son las 9:30 a.m. en Nueva York. Dubliners abre a las 12:00. Four Corner abre a las 14:00 con pantallas de deporte, una calle más allá.
        Si os quedáis a la pantalla, la NFL de noche empieza a las 19:00 (1:00 p.m. ET), luego 22:05 y 22:25. Atlético–Barcelona es a las 21:00 hora local.
        Preguntad en barra qué echan. No prometemos cada partido en cada pantalla, y no inventamos la parrilla de Four Corner.
      </p>

      <OriginalFourBars lang="es" when="tonight" />

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>¿Dónde quedan esta noche los que vienen de fuera?</strong></dt>
        <dd>18:00–19:00 en O’Reilly’s, Dubliners y O’Connell’s. Four Corner es el domingo desde las 14:00.</dd>
        <dt><strong>¿A qué hora es el Madrid Game en ET?</strong></dt>
        <dd>15:30 Madrid = 9:30 a.m. ET, domingo 8 de noviembre. EN DIRECTO en la pantalla grande de Dubliners.</dd>
        <dt><strong>¿Son recintos oficiales de la NFL?</strong></dt>
        <dd>No. Bares hermanos independientes. No es un evento oficial de la NFL.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Para quien viene de fuera',
            until: SHOW_UNTIL,
            items: [
              { href: '/es/', label: 'Inicio Dubliners' },
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'VER LOS CUATRO BARES' },
              { href: '/es/andar-sol-cuatro-bares-hermanos/', label: 'Andar desde Sol' },
              { href: '/es/fin-semana-nfl-madrid-en-pantalla/', label: 'Fin de semana sin estadio' },
              { href: '/es/guia-domingo-nfl-madrid/', label: 'Guía hora a hora del domingo' },
              { href: PATH_EN, label: 'International NFL fans', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
