const PATH = '/es/atleti-barca-saque-ahora-cuatro-puertas-sol-abiertas/';
const PATH_EN = '/atleti-barca-kickoff-now-four-open-sol-doors/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'El saque Atlético–Barcelona es AHORA en las cuatro puertas abiertas de Sol',
  inLanguage: 'es',
  datePublished: '2026-11-08T21:00:00+01:00',
  dateModified: '2026-11-08T21:00:00+01:00',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Atlético vs Barcelona está sacando ahora. ¿En cuál de las cuatro puertas de Sol entramos?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Cualquiera de las cuatro puertas hermanas abiertas junto a Puerta del Sol. Four Corner, Calle de la Victoria 6, está abierto (desde las 14:00 hasta la madrugada, pantallas de deporte). Dubliners y O’Connell’s en Calle de Espoz y Mina 7. O’Reilly’s en Pasaje de Matheu 4. Atlético vs Barcelona 21:00 con nombre: solo Partidos de Dubliners. En las puertas hermanas, preguntad qué echan. No copiéis el cartel de Dubliners a esas puertas.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Esto es la página de visitantes NFL, la quedada local, la portada del 8 nov o el salto desde la NFL 19:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Visitantes NFL compartiendo Sol es para quien vino por la NFL y comparte la plaza con el fútbol 21:00. La quedada local es el pin de afición. La portada del 8 nov es el listado previo. El salto desde la NFL 19:00 es sentarse y cambiar de puerta a las 21:00. Esta página es solo el silbato en vivo a las 21:00: el saque es AHORA en las cuatro puertas abiertas.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Entrar para Atleti 21:00 sustituye Premier o la NFL de después?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Coordinad; no sustituyáis. Premier 15:00 / 17:30 ya estuvo en Partidos de Dubliners. La NFL de después desde las 22:05 / 22:25 sigue en las mismas cuatro puertas. No asignamos esos partidos a O’Reilly’s, O’Connell’s ni Four Corner. Preguntad qué pantalla.',
      },
    },
  ],
};
---

<BaseLayout
  title="Atleti–Barça saque AHORA en las cuatro puertas abiertas de Sol | Dubliners"
  description="Domingo 8 nov 21:00: Atlético vs Barcelona está sacando AHORA en las cuatro puertas abiertas de Sol. Pantalla con nombre: Partidos de Dubliners. Puertas hermanas: preguntad qué echan. Maps. FIND US."
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Atleti–Barça saque AHORA en las cuatro puertas abiertas de Sol" schema />
      <h1>El saque Atlético–Barcelona es AHORA en las cuatro puertas abiertas de Sol</h1>
      <p class="lead">
        El silbato de las <strong>21:00</strong> está ocurriendo <strong>ahora mismo</strong>.
        Esto no es un listado previo ni una nota de salto desde la NFL.
        Entrad en las cuatro puertas hermanas — todas <strong>abiertas AHORA</strong> —
        Four Corner en Calle de la Victoria 6 (desde las 14:00 hasta la madrugada, pantallas de deporte),
        Dubliners y O’Connell’s en Espoz y Mina 7, O’Reilly’s en Pasaje de Matheu 4.
        Atlético vs Barcelona con nombre: solo <a href={withBase('/es/partidos/')}>Partidos</a> de Dubliners.
        En las puertas hermanas, <strong>preguntad qué echan</strong>. Maps abajo.
      </p>
      <p class="small">In English: <a href={withBase(PATH_EN)} hreflang="en" lang="en">Atleti–Barça kickoff is NOW at the four open Sol doors</a></p>
      <FanWeekendCtas lang="es" findHref="/es/visitar/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Este es el silbato en vivo a las 21:00 — no visitantes, no quedada local, no la portada, no salto desde las 19:00</h2>
      <p>
        <a href={withBase('/es/visitantes-nfl-sol-atletico-barcelona/')}>Visitantes NFL compartiendo Sol</a> es para quien vino por la NFL y comparte la plaza con el fútbol 21:00.
        <a href={withBase('/es/quedada-sol-atletico-barcelona-domingo/')}>Quedada local del domingo</a> es el pin de afición.
        <a href={withBase('/es/atletico-barcelona-sol-8-nov/')}>Atlético–Barcelona cerca de Sol, 8 nov</a> es la portada previa.
        <a href={withBase('/es/nfl-en-pantalla-ahora-1900-luego-saltar-atleti-2100/')}>NFL en pantalla AHORA desde las 19:00, luego saltar</a> es sentarse para la NFL 19:00 y cambiar de puerta a las 21:00.
        Esta página es solo <strong>el saque ya en curso a las 21:00</strong>: entrad ahora.
        La quedada de tres bares del sábado ya ha acabado. El domingo son cuatro puertas. No re-promováis 18:00–19:00 como si siguiera.
      </p>

      <h2>Entrad ahora. Pantalla con nombre: Dubliners; puertas hermanas: preguntad qué echan</h2>
      <p>
        Escribid al grupo <strong>Victoria 6 / Espoz y Mina 7 / Pasaje de Matheu 4</strong>.
        Four Corner <strong>está abierto ahora</strong> (desde las 14:00 hasta la madrugada · pantallas de deporte). No listamos qué echan ahí.
        O’Reilly’s y O’Connell’s son puntos de encuentro del mismo clúster; no copiamos el cartel de Dubliners a esas puertas.
        Listados con nombre: solo Partidos de Dubliners. Preguntad qué pantalla. No está cada partido en cada pantalla.
        Si la puerta en la que entráis no echa Atlético–Barcelona, saltad — las otras tres puertas abiertas siguen en estas dos calles.
      </p>
      <ol>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid.</strong>
          Abierto AHORA (desde las 14:00 hasta la madrugada · pantallas de deporte). Preguntad en la puerta.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          Domingo 12:00–02:00. Atlético vs Barcelona 21:00 con nombre en Partidos. Preguntad qué echan.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (en Maps: O’Connell St).
          Mismo número, otra puerta, otro CID. Punto de encuentro; no inventamos su cartel.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Pasaje cubierto. Habitual desde las 11:30. Punto de encuentro; sin menú inventado.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
      </ol>

      <h2>Qué hay ahora — Premier va a la vez; la NFL de después sigue</h2>
      <p>
        <a href={withBase('/es/partidos/')}>Partidos</a> de Dubliners ya lista el domingo 8 de noviembre en hora de Madrid.
        Atlético vs Barcelona <strong>21:00</strong> es el fútbol con nombre ahora. Premier 15:00 / 17:30 ya corrió en el mismo cartel; va a la vez, no ocupa este silbato.
        La NFL de después desde las <strong>22:05</strong> / <strong>22:25</strong> sigue en las mismas cuatro puertas — quedaos después de este saque si esa es vuestra noche.
        Coordinad; no sustituyáis. Listados con nombre: solo Dubliners. No asignamos esos partidos a O’Reilly’s, O’Connell’s ni Four Corner.
        Preguntad qué pantalla.
      </p>
      <p>
        ¿Ya sentados en Atleti y os quedáis a los relojes NFL de después?
        <a href={withBase('/es/quedarse-despues-atleti-2100-nfl-tarde-2205-2225/')}>Quedaos después de las 21:00 para la NFL 22:05 / 22:25 en las mismas cuatro puertas</a>.
        ¿Venís de la ventana NFL 19:00 y aún elegís puerta?
        <a href={withBase('/es/nfl-en-pantalla-ahora-1900-luego-saltar-atleti-2100/')}>Esa nota de salto desde las 19:00 es el reloj anterior</a>.
      </p>

      <OriginalFourBars lang="es" when="sunday" findHref="/es/visitar/" />

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>Atleti–Barça está sacando ahora. ¿Qué puerta?</strong></dt>
        <dd>Cualquiera de las cuatro puertas abiertas: Victoria 6, Espoz y Mina 7 dos veces, Pasaje de Matheu 4. Atleti con nombre: Partidos de Dubliners. Puertas hermanas: preguntad qué echan.</dd>
        <dt><strong>¿Esto es visitantes, quedada local, portada del 8 nov o salto desde las 19:00?</strong></dt>
        <dd>No. Esas páginas son visitantes NFL compartiendo Sol, el pin de afición, el listado previo y sentarse-luego-saltar a las 21:00. Esto es el silbato en vivo a las 21:00: el saque es AHORA.</dd>
        <dt><strong>¿Atleti 21:00 sustituye Premier o la NFL de después?</strong></dt>
        <dd>No. Coordinad. Premier ya fue a la vez. La NFL 22:05 / 22:25 sigue. No copiamos el cartel de Dubliners a las puertas hermanas.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Saque AHORA este domingo',
            until: SHOW_UNTIL,
            items: [
              { href: '/es/', label: 'FIND US — inicio Dubliners' },
              { href: '/es/visitar/', label: 'CÓMO LLEGAR — visitar / horario' },
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'VER LOS CUATRO BARES' },
              { href: '/es/quedarse-despues-atleti-2100-nfl-tarde-2205-2225/', label: 'Quedarse después de las 21:00: NFL 22:05 / 22:25' },
              { href: '/es/partidos/', label: 'Partidos — pantallas con nombre' },
              { href: PATH_EN, label: 'Atleti–Barça kickoff is NOW at the four open Sol doors', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
