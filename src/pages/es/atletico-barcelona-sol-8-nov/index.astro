---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import LinkHub from '../../../components/LinkHub.astro';
import SundayFourVenues from '../../../components/SundayFourVenues.astro';
import { withBase, absUrl } from '../../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../../data/fourBars';

const PATH = '/es/atletico-barcelona-sol-8-nov/';
const PATH_EN = '/atletico-barcelona-sol-8-nov/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Atlético–Barcelona junto a Sol el domingo 8 de noviembre a las 21:00',
  inLanguage: 'es',
  datePublished: '2026-11-07',
  dateModified: '2026-11-07',
  image: absUrl('/images/screens-sports.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿A qué hora es Atlético–Barcelona el domingo 8 de noviembre?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'A las 21:00 hora de Madrid, LaLiga. En Dubliners, Espoz y Mina 7, va EN DIRECTO en pantallas. Pregunta qué echan: las ventanas NFL de las 19:00 y 22:05/22:25 se pisan esa misma noche.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Es el Clásico?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Este domingo es Atlético de Madrid vs FC Barcelona, no Real Madrid vs Barcelona. La página evergreen de El Clásico es otro partido.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Dónde quedar junto a Sol para las 21:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Cuatro bares hermanos: O’Reilly’s (Pasaje de Matheu 4), Dubliners y O’Connell’s (Espoz y Mina 7, desde las 12:00), Four Corner (Victoria 6, desde las 14:00 hasta la madrugada). Pantallas de las 21:00 confirmadas: Dubliners. No inventamos la programación de Four Corner.',
      },
    },
  ],
};
---

<BaseLayout
  title="Atlético–Barcelona junto a Sol, domingo 8 nov 21:00 | Dubliners"
  description="Domingo 8 nov, 21:00: Atlético–Barcelona junto a Sol. En directo confirmado en Dubliners. Cuatro bares hermanos y maps. La NFL se pisa: pregunta qué echan."
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/screens-sports.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Atlético–Barcelona junto a Sol" lang="es" schema />
      <h1>Atlético–Barcelona junto a Sol, domingo 8 de noviembre a las 21:00</h1>
      <p class="lead">
        Domingo 8 nov junto a Sol. Dubliners 12:00–02:00, Espoz y Mina 7. Bengals–Falcons EN DIRECTO 15:30
        (Bernabéu; también en pantalla grande). NFL desde las 19:00, luego 22:05 y 22:25.
        <strong>Atlético–Barcelona 21:00</strong> en nuestras pantallas. Four Corner desde las 14:00. Preguntad en barra qué hay en pantalla.
      </p>
      <p class="small">In English: <a href={withBase(PATH_EN)} hreflang="en" lang="en">Atlético–Barcelona near Sol</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners en Maps</a>
        <a class="btn btn-secondary" href={withBase('/es/partidos/')}>Partidos y eventos</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <div data-show-until={SHOW_UNTIL}>
        <h2>Las 21:00 caen en una noche NFL</h2>
        <p>
          Esto no es el Clásico (Real Madrid vs Barcelona). Este domingo es Atlético vs Barcelona.
          En Dubliners va confirmado EN DIRECTO en pantallas. Dubliners abre desde las 12:00 y cierra a las 02:00,
          así que el final del partido cabe en el horario.
        </p>
        <p>
          La misma noche ya tiene NFL a las <strong>19:00</strong>, luego <strong>22:05</strong> y <strong>22:25</strong>.
          Esos relojes se pisan. <strong>Preguntad en barra qué echan. No está cada partido en cada pantalla.</strong>
          Si al grupo le importa Atlético–Barcelona, decídlo al sentaros.
        </p>
        <p>
          Four Corner ya abre desde las 14:00 hasta la madrugada como punto de encuentro hermano. No inventamos su programación.
          O’Reilly’s y O’Connell’s están en las mismas calles si queréis comer o partir el grupo antes de las 21:00.
        </p>
      </div>

      <SundayFourVenues lang="es" />

      <p class="small">
        Pubs independientes — sin vínculo con LaLiga ni los clubes. No es un evento oficial de la NFL.
      </p>

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>¿A qué hora es Atlético–Barcelona el domingo 8 de noviembre?</strong></dt>
        <dd>A las 21:00 hora de Madrid, LaLiga. EN DIRECTO en Dubliners. Preguntad qué echan: la NFL se pisa esa noche.</dd>
        <dt><strong>¿Es el Clásico?</strong></dt>
        <dd>No. Este domingo es Atlético vs Barcelona, no Real Madrid vs Barcelona.</dd>
        <dt><strong>¿Dónde quedar junto a Sol para las 21:00?</strong></dt>
        <dd>Cuatro bares hermanos alrededor de Sol. Pantallas de las 21:00 confirmadas: Dubliners. Four Corner desde las 14:00; no listamos su programación.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Domingo 8 de noviembre junto a Sol',
            until: SHOW_UNTIL,
            items: [
              { href: '/es/nfl-domingo-cerca-sol-8-nov/', label: 'NFL domingo cerca de Sol' },
              { href: '/es/nfl-tarde-noche-sol-8-nov/', label: 'NFL de tarde y de noche' },
              { href: '/es/antes-despues-bengals-falcons-sol/', label: 'Antes y después de Bengals–Falcons' },
              { href: '/es/four-corner-abre-domingo-1400/', label: 'Four Corner abre a las 14:00' },
              { href: '/es/deportes-domingo-sol/', label: 'Deportes domingo en Sol', note: 'Tabla Dubliners' },
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'Cuatro bares. Un fin de semana' },
              { href: PATH_EN, label: 'Atlético–Barcelona near Sol', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
