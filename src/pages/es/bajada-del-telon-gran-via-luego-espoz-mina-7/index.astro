---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import MapEmbed from '../../../components/MapEmbed.astro';
import { SITE, withBase } from '../../../site';

const PATH = '/es/bajada-del-telon-gran-via-luego-espoz-mina-7/';
const PATH_EN = '/gran-via-curtain-down-then-espoz-mina-7/';
const title = 'Bajada del telón en Gran Vía, luego Espoz y Mina 7 | Pub irlandés cerca de Sol';
const description =
  '¿Bajó el telón en Gran Vía? Camina hacia Sol hasta el pub irlandés de interior en Espoz y Mina 7. Inglés en barra. CÓMO LLEGAR.';
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Dónde tomo una pinta después de un espectáculo en Gran Vía?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Dubliners es un pub irlandés de interior en la calle de Espoz y Mina 7, 28012 Madrid, junto a Puerta del Sol. Gran Vía hacia el este hasta Sol, luego Espoz y Mina hasta el neón verde. Metro Gran Vía (L1, L5), Sol (L1, L2, L3) o Sevilla (L2).',
      },
    },
    {
      '@type': 'Question',
      name: '¿Es la página del Metro de tarde Gran Vía del domingo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. El Metro de tarde Gran Vía es llegada en un reloj deportivo de fin de semana. Esta página es salida de teatro: sales del espectáculo y quieres un pub, no un horario de estación.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Hay partido después del teatro?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Los partidos con nombre están en Partidos. Si la lista está vacía, sigue siendo una pinta irlandesa de interior. Pregunta en barra qué pantalla hay, si hay alguna.',
      },
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/bar-interior.jpg"
  extraJsonLd={[faqLd]}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Bajada del telón en Gran Vía, luego Espoz y Mina 7" lang="es" schema />
      <h1>Bajada del telón en Gran Vía, luego Espoz y Mina 7</h1>
      <p class="lead">
        Suben las luces, el vestíbulo vuelca a Gran Vía, y sigues queriendo sentarte con una pinta e inglés en barra.
        Dubliners está a dos calles de Puerta del Sol — calle de Espoz y Mina 7 — pub irlandés de interior en el lado teatral del centro.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">CÓMO LLEGAR</a>
        <a class="btn btn-secondary" href={withBase('/es/partidos/')}>Partidos</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Salida de teatro, no horario de Metro</h2>
      <p>
        No es la página de noche cerca de Sol —
        <a href={withBase('/es/noche-cerca-de-sol/')}>noche cerca de Sol</a> —
        ni el Metro de tarde del domingo —
        <a href={withBase('/es/metro-tarde-gran-via-sevilla-a-puertas-sol-abiertas/')}>Gran Vía o Sevilla a puertas abiertas</a>.
        Sales de un musical, una obra o una sala de conciertos en Gran Vía y quieres un pub irlandés a pie antes de dormir.
      </p>
      <p>
        No el paseo del Prado, no la plaza mojada, no las compras de Callao, no la primera noche en el aeropuerto.
        Telón en Gran Vía, pinta en la sala de la sastrería en Espoz y Mina 7.
      </p>

      <h2>Gran Vía hacia el este hasta Sol</h2>
      <ol>
        <li>Sal del teatro a <strong>Gran Vía</strong> (zona Callao / Plaza de España, según el local).</li>
        <li>Camina <strong>hacia el este, hacia Puerta del Sol</strong> — por el eje teatral, no de vuelta a Plaza de España salvo que sea tu taquilla.</li>
        <li>En Sol, entra en la <strong>calle de Espoz y Mina</strong> hacia Carrera de San Jerónimo / Sevilla.</li>
        <li>Busca el <strong>neón verde de Dubliners</strong> en el número 7.</li>
      </ol>
      <p>
        Metro Gran Vía (L1, L5) si prefieres saltarte el último tramo con tacones.
        NAP: <strong>{SITE.address}</strong>, {SITE.postal}.
      </p>

      <h2>Pantallas solo cuando lo dice Partidos</h2>
      <p>
        Una pinta después del espectáculo no necesita saque. Los listados con nombre están en
        <a href={withBase('/es/partidos/')}>Partidos</a> en hora de Madrid.
        Si no hay nada, siéntate igual. Pregunta qué echan.
      </p>

      <div class="map-frame">
        <MapEmbed lang="es" title="Mapa a Dubliners — después del telón en Gran Vía" />
      </div>
      <p class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">CÓMO LLEGAR</a>
        <a class="btn btn-secondary" href={withBase('/es/visitar/')}>FIND US</a>
      </p>

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>¿Dónde tomo una pinta después de un espectáculo en Gran Vía?</strong></dt>
        <dd>Gran Vía este → Sol → Espoz y Mina 7. Pub irlandés de interior, neón verde.</dd>
        <dt><strong>¿Es la página del Metro de tarde Gran Vía del domingo?</strong></dt>
        <dd>No. Eso es Metro de llegada en un fin de semana deportivo. Esto es salida de teatro.</dd>
        <dt><strong>¿Hay partido después del teatro?</strong></dt>
        <dd>Listados con nombre: <a href={withBase('/es/partidos/')}>Partidos</a>. Si la lista está vacía, la pinta sigue.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Relacionado (no este paseo de teatro)',
            items: [
              { href: '/es/noche-cerca-de-sol/', label: 'Noche cerca de Sol', note: 'Pub tardío, no paseo post-teatro' },
              { href: '/es/desde-las-escaleras-del-prado-a-espoz-mina-7/', label: 'Desde las escaleras del Prado', note: 'Paseo de museo, no Gran Vía' },
              { href: '/es/visitar/', label: 'FIND US', note: 'Maps, Metro Sol, CÓMO LLEGAR' },
              { href: '/es/partidos/', label: 'Partidos', note: 'Solo listados con nombre' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
