---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../../components/OriginalFourBars.astro';
import FanWeekendCtas from '../../../components/FanWeekendCtas.astro';
import { withBase, absUrl } from '../../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../../data/fourBars';

const PATH = '/es/bengals-falcons-reparte-dos-puertas-espoz-mina-7/';
const PATH_EN = '/bengals-falcons-split-two-doors-espoz-mina-7/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Afición Bengals y Falcons: dos puertas en Espoz y Mina 7',
  inLanguage: 'es',
  datePublished: '2026-11-08T15:05:00+01:00',
  dateModified: '2026-11-08T15:05:00+01:00',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'El grupo se parte: camisetas Bengals y camisetas Falcons. ¿Nos vamos de Espoz y Mina 7?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Dubliners y O’Connell’s comparten Calle de Espoz y Mina 7 — mismo número, dos puertas, dos CID de Maps. Dejad ese número como reencuentro. No nombramos qué puerta echa qué pantalla. Preguntad qué echan. Listados con nombre: solo Partidos de Dubliners.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Dónde quedan O’Reilly’s y Four Corner si el número 7 está lleno?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'O’Reilly’s Restaurant Bar está en Pasaje de Matheu 4 — el atajo cubierto desde Espoz y Mina. Four Corner está en Calle de la Victoria 6, abierto AHORA (desde las 14:00 hasta la madrugada, pantallas de deporte). Pines de desborde, no sustitutos. No listamos su programación. Maps abajo.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Esto es la página de dos puertas Premier 15:00 frente a NFL después?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Esa página parte saques ingleses a las 15:00 frente a NFL después. Esta es solo afición Bengals y afición Falcons en un mismo número. Premier 15:00 / 17:30 va a la vez; NFL de después desde las 19:00 y Atlético–Barcelona 21:00 también. Coordinad; no sustituyáis.',
      },
    },
  ],
};
---

<BaseLayout
  title="Bengals y Falcons, dos puertas en Espoz y Mina 7 | Dubliners"
  description="Domingo 8 nov: afición Bengals y afición Falcons se parten en Calle de Espoz y Mina 7 — mismo número, dos puertas, dos CID. No nombramos qué pantalla. O’Reilly’s Matheu 4 y Four Corner Victoria 6 (abierto AHORA) de desborde. Preguntad qué echan. Maps."
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Bengals y Falcons: dos puertas en Espoz y Mina 7" schema />
      <h1>Afición Bengals y Falcons: dos puertas en Espoz y Mina 7 (mismo número, dos CID)</h1>
      <p class="lead">
        Media mesa es Cincinnati. La otra media es Atlanta. <strong>No hacen falta dos barrios.</strong>
        Dubliners y O’Connell’s comparten <strong>Calle de Espoz y Mina 7</strong> — mismo número, dos puertas, dos CID de Maps.
        Marcad el número. No nombramos qué puerta echa qué pantalla. Preguntad qué echan.
        Desborde: O’Reilly’s, Pasaje de Matheu 4, y Four Corner, Calle de la Victoria 6 — <strong>abierto AHORA</strong> (desde las 14:00, pantallas de deporte).
        Listados con nombre: solo Partidos de Dubliners.
      </p>
      <p class="small">In English: <a href={withBase(PATH_EN)} hreflang="en" lang="en">Bengals and Falcons fans: split the two doors at Espoz y Mina 7</a></p>
      <FanWeekendCtas lang="es" findHref="/es/visitar/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Reparto de camisetas, no Premier frente a NFL después</h2>
      <p>
        <a href={withBase('/es/espoz-mina-7-dos-puertas-reparte-premier-luego-nfl/')}>Espoz y Mina 7 dos puertas: Premier 15:00 frente a NFL después</a>
        es el grupo que parte saques ingleses frente a un reloj NFL posterior.
        Esta página es solo <strong>camisetas Bengals por una puerta del número 7, camisetas Falcons por la otra</strong>
        — un solo texto de reencuentro. No afirmamos qué puerta de las dos echa qué partido.
        No es antes y después de Bengals. No es un test de personalidad de bar. No es un paseo desde Plaza Mayor, Atocha, Callao o Tirso.
      </p>

      <h2>Misma línea de fachada, dos pines de Maps — preguntad qué echan</h2>
      <p>
        Ambos listados leen Calle de Espoz y Mina 7, 28012 Madrid. Son CID distintos (O’Connell’s figura en Maps como O’Connell St).
        Si la mesa se parte por equipo, dejad <strong>Espoz y Mina 7</strong> como reencuentro. Salid; la otra puerta es la misma línea de fachada.
        Con nombre en <a href={withBase('/es/partidos/')}>Partidos</a> de Dubliners (preguntad qué pantalla — no está cada partido en cada pantalla):
      </p>
      <ul>
        <li><strong>15:00</strong> — Crystal Palace vs Liverpool · Sunderland vs Chelsea · Brighton vs Brentford · Ipswich Town vs Bournemouth</li>
        <li><strong>15:30</strong> — Bengals vs Falcons EN DIRECTO (NFL Madrid Game; también el saque del Bernabéu)</li>
        <li><strong>17:30</strong> — Manchester United vs Aston Villa</li>
        <li><strong>desde las 19:00</strong> — NFL de noche / RedZone · <strong>21:00</strong> — Atlético vs Barcelona</li>
      </ul>
      <p>
        No copiamos ese cartel a O’Connell’s, O’Reilly’s ni Four Corner. No nombramos qué pantalla es qué puerta. Preguntad en cada puerta.
        Premier 15:00 / 17:30 va a la vez; NFL de después y Atleti también. Coordinad, no sustituyáis.
      </p>

      <h2>Luego Matheu 4 y Victoria 6 — desborde, no sustitutos. Las cuatro puertas abiertas AHORA</h2>
      <p>
        Four Corner, Calle de la Victoria 6, <strong>está abierto AHORA</strong> (desde las 14:00 hasta la madrugada · pantallas de deporte). Preguntad qué echan; no listamos su programación.
        O’Reilly’s, Pasaje de Matheu 4, es el atajo cubierto (habitual desde las 11:30). Usadlos cuando el número 7 esté lleno — no para mandar a media mesa al otro lado de la ciudad.
        Maps abajo. Sin reloj a pie inventado.
      </p>
      <ol>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          Una de las dos puertas de este número. Domingo desde las 12:00. Listados con nombre de Premier, NFL y Atleti en Partidos. Preguntad qué pantalla.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (en Maps: O’Connell St).
          La otra puerta del mismo número. Otro CID. Punto de encuentro; no inventamos su cartel ni nombramos su pantalla.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Desborde del pasaje. Restaurante-bar con terraza. No listamos su cartel.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid.</strong>
          Abierto AHORA desde las 14:00 hasta la madrugada · pantallas de deporte. Preguntad qué echan.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
      </ol>
      <p>
        ¿Ya en Sol mientras el estadio sigue jugando?
        <a href={withBase('/es/ya-en-sol-durante-madrid-game-cuatro-puertas-abiertas/')}>Mantened las cuatro puertas abiertas como punto de encuentro en la ciudad</a>.
      </p>

      <OriginalFourBars lang="es" when="sunday" findHref="/es/visitar/" />

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>Camisetas Bengals frente a camisetas Falcons. ¿Salimos de Espoz y Mina 7?</strong></dt>
        <dd>No. Mismo número, dos puertas, dos CID. Marcad Espoz y Mina 7. No nombramos qué pantalla. Preguntad qué echan. Listados con nombre: Partidos de Dubliners.</dd>
        <dt><strong>¿Dónde están O’Reilly’s y Four Corner si el número 7 está lleno?</strong></dt>
        <dd>Matheu 4 es el atajo cubierto. Victoria 6 está abierto AHORA (desde las 14:00, pantallas de deporte). Desborde, no sustitutos. Maps abajo.</dd>
        <dt><strong>¿Esto es la página Premier-luego-NFL de dos puertas?</strong></dt>
        <dd>No. Esa parte fútbol inglés 15:00 frente a NFL después. Esto es solo Bengals frente a Falcons en un número. Premier y Atleti siguen a la vez.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Dos puertas, un número este domingo',
            until: SHOW_UNTIL,
            items: [
              { href: '/es/', label: 'FIND US — inicio Dubliners' },
              { href: '/es/visitar/', label: 'CÓMO LLEGAR — visitar / horario' },
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'VER LOS CUATRO BARES' },
              { href: '/es/ya-en-sol-durante-madrid-game-cuatro-puertas-abiertas/', label: 'Ya en Sol durante el Madrid Game: cuatro puertas abiertas AHORA' },
              { href: '/es/partidos/', label: 'Partidos — pantallas con nombre' },
              { href: PATH_EN, label: 'Bengals and Falcons fans: split the two doors at Espoz y Mina 7', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
