import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../../components/OriginalFourBars.astro';
import FanWeekendCtas from '../../../components/FanWeekendCtas.astro';
import { withBase, absUrl } from '../../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../../data/fourBars';

const PATH = '/es/callao-preciados-compras-sur-puertas-sol-antes-1400/';
const PATH_EN = '/callao-preciados-shop-south-sol-doors-before-1400/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Callao y Preciados: compras hacia el sur, las cuatro puertas de Sol antes de las 14:00',
  inLanguage: 'es',
  datePublished: '2026-11-08T11:00:00+01:00',
  dateModified: '2026-11-08T11:00:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Estoy de compras en Callao / Calle de Preciados este domingo por la mañana. ¿Hacia dónde van los cuatro bares antes de las 14:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Seguid hacia el sur por la peatonal Calle de Preciados hacia Puerta del Sol — bolsas en la mano, no un salto de estación ni una parada de fotos en una plaza. Cruzad la plaza hacia el sureste, Calle de Carretas / Carrera de San Jerónimo, luego Espoz y Mina 7, Pasaje de Matheu 4 y Calle de la Victoria 6. Marcad Four Corner para las 14:00 (pantallas de deporte; no abre antes). Maps abajo.',
      },
    },
    {
      '@type': 'Question',
      name: '¿A qué distancia está Callao / Preciados de Victoria 6, Espoz y Mina 7 y Pasaje de Matheu 4?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Desde Plaza del Callao hacia el sur por Preciados: Espoz y Mina 7 unos 10–13 min / 700–850 m; Pasaje de Matheu 4 unos 11–13 min / 750–900 m; Victoria 6 unos 11–14 min / 780–950 m. Al llegar a Puerta del Sol, el bolsillo sureste son 2–6 min más. No esperéis en Victoria 6 antes de las 14:00.',
      },
    },
    {
      '@type': 'Question',
      name: 'Son alrededor de las 11:00. ¿Puedo ir ahora a Four Corner?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Four Corner abre el domingo 8 de noviembre desde las 14:00 hasta la madrugada, con pantallas de deporte — unas tres horas desde las 11:00, no antes. Acabad Preciados, marcad las cuatro puertas y sentaos en la primera hermana que esté abierta. O’Reilly’s habitual desde las 11:30; Dubliners y O’Connell’s desde las 12:00. Premier League desde las 15:00, NFL tarde/noche y Atlético–Barcelona 21:00 van en las mismas calles después — coordinad, no sustituyáis. Listados con nombre: Partidos de Dubliners solamente.',
      },
    },
  ],
};
---

<BaseLayout
  title="Callao–Preciados compras al sur, cuatro puertas de Sol antes de las 14:00 | Dubliners"
  description="Domingo 8 nov ~11:00: ¿compras en Callao / Calle de Preciados? Andad al sur a Puerta del Sol y marcad Victoria 6, Espoz y Mina 7 y Pasaje de Matheu 4 antes de las 14:00. De tiendas a pinta, Maps, metros."
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Callao–Preciados compras al sur, las cuatro puertas de Sol" schema />
      <h1>Callao y Preciados: compras hacia el sur, las cuatro puertas de Sol antes de las 14:00</h1>
      <p class="lead">
        El sábado ya ha acabado. No salís de un hotel, no bajáis del tren en Atocha ni estáis ya bajo unos soportales.
        <strong>Estáis en la calle comercial Callao–Preciados</strong> — bolsas, domingo de tiendas, granito peatonal.
        Andad <strong>al sur por Calle de Preciados</strong> hasta Puerta del Sol, luego el bolsillo sureste.
        Marcad las cuatro puertas hermanas antes de que Four Corner abra a las 14:00 con pantallas de deporte (unas tres horas desde las 11:00; no abre antes). Maps abajo.
      </p>
      <p class="small">In English: <a href={withBase(PATH_EN)} hreflang="en" lang="en">Callao and Preciados: shop south to the four Sol doors before 14:00</a></p>
      <FanWeekendCtas lang="es" findHref="/es/visitar/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Esto es un paseo de calle comercial, no una cuesta de plaza, no Atocha, no la primera calle del hotel</h2>
      <p>
        Otras páginas ya cubren los soportales este de Plaza Mayor, Atocha Cercanías una parada, la primera calle desde un hotel en Sol
        y el paseo desde la propia plaza.
        Esta página es solo para quien <strong>ya está en Plaza del Callao o Calle de Preciados con bolsas de compras</strong>
        y necesita rumbo sur, metros y qué puerta marcar antes de las 14:00.
        No re-promocionéis el sábado 18:00–19:00 ni Valencia–Real Madrid como si siguieran esta noche.
      </p>

      <h2>Callao → Preciados al sur → Sol — luego qué bolsillo</h2>
      <p>
        Empezad en <strong>Plaza del Callao</strong>. Quedaos en la peatonal <strong>Calle de Preciados</strong> y seguid
        <strong>hacia el sur, a Puerta del Sol</strong> — es la calle de tiendas, no un pasillo de Metro ni un vestíbulo de tren.
        Cruzad la plaza por el lado sureste hacia <strong>Calle de Carretas</strong> y <strong>Carrera de San Jerónimo</strong>.
        Luego Espoz y Mina, Pasaje de Matheu (el atajo cubierto) y Calle de la Victoria.
      </p>
      <ul>
        <li>
          <strong>Desde Plaza del Callao, sur por Preciados.</strong>
          Espoz y Mina 7: <strong>10–13 min / 700–850 m</strong>.
          Pasaje de Matheu 4: <strong>11–13 min / 750–900 m</strong>.
          Victoria 6: <strong>11–14 min / 780–950 m</strong>.
        </li>
        <li>
          <strong>Al llegar a Puerta del Sol.</strong>
          El bolsillo sureste es corto: Espoz y Mina 7 unos <strong>2–4 min / 150–250 m</strong>;
          Matheu 4 unos <strong>3–5 min / 200–300 m</strong>;
          Victoria 6 unos <strong>4–6 min / 250–350 m</strong>.
        </li>
      </ul>
      <p>
        Desde alrededor de las 11:00 faltan <strong>unas tres horas</strong> hasta que Four Corner abra a las 14:00.
        Acabad las tiendas, marcad Victoria 6 para esa hora. No acampéis una puerta cerrada en Calle de la Victoria antes.
      </p>

      <h2>Antes de las 14:00 — qué puerta está siquiera abierta</h2>
      <p>
        Four Corner abre el <strong>domingo 8 de noviembre desde las 14:00 hasta la madrugada, con pantallas de deporte</strong>.
        No antes de las 14:00. No listamos qué partido hay ahí — preguntad en la puerta.
        O’Reilly’s habitual desde las 11:30 (Pasaje de Matheu 4). Dubliners y O’Connell’s desde las 12:00 (Espoz y Mina 7).
        Andad Preciados ahora; sentaos en la primera hermana que esté abierta; estad en Victoria para la apertura de las 14:00.
        Premier League desde las 15:00 (Palace–Liverpool, Sunderland–Chelsea, Brighton–Brentford, Ipswich–Bournemouth),
        United–Villa 17:30, NFL tarde/noche y Atlético–Barcelona 21:00 van en las mismas calles después — coordinad, no sustituyáis.
        Listados con nombre: <a href={withBase('/es/partidos/')}>Partidos</a> de Dubliners solamente. Preguntad qué pantalla — no todos los partidos van en todas las pantallas.
      </p>

      <h2>De la calle comercial a tres calles — direcciones</h2>
      <ol>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid</strong> (marcar para las 14:00; pantallas de deporte; no abre antes).
          Unos 11–14 min desde Callao / 4–6 min ya en Sol.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Pasaje cubierto desde Espoz y Mina. Habitual desde las 11:30. Unos 11–13 min desde Callao.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          Unos 10–13 min desde Callao. Domingo desde las 12:00. Pantallas con nombre en Partidos — preguntad qué hay.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (en Maps: O’Connell St).
          Mismo número que Dubliners, otra puerta. Domingo 8 nov desde las 12:00 (habitual domingo 14:00). Punto de encuentro; no inventamos su cartel.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
      </ol>

      <OriginalFourBars lang="es" when="sunday" findHref="/es/visitar/" />

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>Compras en Callao / Preciados esta mañana. ¿Hacia dónde antes de las 14:00?</strong></dt>
        <dd>Sur por la peatonal Preciados a Puerta del Sol, luego sureste a Carretas / San Jerónimo. Marcad Victoria 6 para las 14:00. Luego Matheu 4 y Espoz y Mina 7 dos veces.</dd>
        <dt><strong>¿A qué distancia de Callao a las cuatro puertas?</strong></dt>
        <dd>Callao sur por Preciados: Espoz y Mina 7 10–13 min / 700–850 m; Matheu 4 11–13 min / 750–900 m; Victoria 6 11–14 min / 780–950 m. Desde Sol, 2–6 min más. No esperéis en Victoria 6 antes de las 14:00.</dd>
        <dt><strong>Son ~11:00. ¿Abre Four Corner?</strong></dt>
        <dd>No. Desde las 14:00, pantallas de deporte — unas tres horas desde ahora. O’Reilly’s desde las 11:30; Dubliners y O’Connell’s desde las 12:00. No esperéis en Victoria 6 antes de las 14:00.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Desde Callao / Preciados este domingo',
            until: SHOW_UNTIL,
            items: [
              { href: '/es/', label: 'FIND US — inicio Dubliners' },
              { href: '/es/visitar/', label: 'CÓMO LLEGAR — visitar / horario' },
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'VER LOS CUATRO BARES' },
              { href: '/es/mesa-oreillys-tres-horas-hasta-victoria-6-1400/', label: 'Tres horas libres: mesa en O’Reilly’s hasta las 14:00' },
              { href: '/es/four-corner-abre-domingo-1400/', label: 'Four Corner domingo 14:00' },
              { href: PATH_EN, label: 'Callao and Preciados: shop south to the four Sol doors', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
