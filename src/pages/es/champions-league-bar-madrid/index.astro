---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import { SITE, withBase } from '../../../site';

const title = 'Bar Champions League Madrid | Ver UCL cerca de Sol — Dubliners';
const description =
  'Bar Champions League en Madrid cerca de Puerta del Sol. UCL en pantallas indoor. Pub irlandés walk-in, Espoz y Mina 7.';
---

<BaseLayout title={title} description={description} path="/es/champions-league-bar-madrid/" lang="es" ogImage="/images/screens-sports.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Bar Champions League Madrid" lang="es" />
        <h1>Bar Champions League Madrid — cerca de Sol</h1>
        <p class="lead">
          Noches europeas sin salir del centro. Dubliners pone la Champions League en pantallas indoor
          cuando se echa — pub irlandés walk-in en Calle de Espoz y Mina 7.
        </p>
        <CtaRow lang="es" />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 45vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/screens-sports.jpg')} alt="Champions League en la pantalla grande de Dubliners Madrid" width="1400" height="788" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>Dónde</h3>
          <p>Corazón de Madrid, a un paso de Puerta del Sol — no junto al estadio.</p>
        </article>
        <article class="card">
          <h3>Cómo llegar</h3>
          <p>Metro a Sol, paseo corto hasta Espoz y Mina 7.</p>
        </article>
        <article class="card">
          <h3>Qué ver hoy</h3>
          <p>Consulta <a href={withBase('/es/partidos/')}>Partidos</a> antes de salir.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Después de un día en el Bernabéu</h2>
      <p>
        Estamos en Sol / centro. Tras el estadio, Metro de vuelta y entra a por una cerveza —
        u otro partido si está en pantallas.
      </p>
      <p>
        Más: <a href={withBase('/es/ver-futbol-madrid/')}>ver fútbol</a> ·
        <a href={withBase('/es/premier-league-pub-madrid/')}>Premier League</a> ·
        <a href={withBase('/es/bar-deportivo-madrid/')}>bar deportivo</a>.
      </p>
      <div class="faq">
        <details>
          <summary>¿Estáis cerca del Bernabéu?</summary>
          <p>No — Sol / centro. Metro desde la zona del estadio hasta Sol, y a pie a Espoz y Mina 7.</p>
        </details>
        <details>
          <summary>Contacto</summary>
          <p>{SITE.address}, {SITE.postal} · <a href={SITE.phoneHref}>{SITE.phone}</a></p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
