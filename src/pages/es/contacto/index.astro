---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { SITE, withBase, isContactFormReady, getContactFormEndpoint } from '../../../site';

const title = 'Contacto Dubliners Madrid | Pub irlandés cerca de Sol';
const description =
  'Email comunicacion@dublinersmadrid.es o escríbenos en Instagram. Espoz y Mina 7 — partidos, grupos, consultas.';
const formReady = isContactFormReady();
const formAction = formReady ? getContactFormEndpoint() : undefined;
---

<BaseLayout title={title} description={description} path="/es/contacto/" lang="es" ogImage="/images/facade.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Contacto" lang="es" />
      <h1>Escríbenos</h1>
      <p class="lead">
        Partidos, grupos o cómo encontrarnos cerca de Sol — escríbenos por email, usa el formulario, o Instagram.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container contact-layout">
      <div class="contact-aside">
        <h2>Habla con Dubliners</h2>
        <p>
          <strong>Visitar</strong><br />
          {SITE.address}<br />
          {SITE.postal}
        </p>
        <p>
          <strong>Instagram</strong><br />
          <a href={SITE.instagram} rel="noopener noreferrer" target="_blank">{SITE.instagramHandle}</a>
        </p>
        {SITE.publicEmail ? (
          <p>
            <strong>Email</strong><br />
            <a href={`mailto:${SITE.publicEmail}`}>{SITE.publicEmail}</a>
          </p>
        ) : (
          <p class="contact-note">
            El email oficial aparecerá aquí cuando esté activo. Mientras tanto, Instagram o pásate.
          </p>
        )}
        <p>
          <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
          <a class="btn btn-secondary" href={withBase('/es/visitar/')}>Visitar / horario</a>
        </p>
      </div>

      <div class="contact-form-wrap">
        <h2>Enviar un mensaje</h2>
        {formReady ? (
          <p class="contact-note" role="status">
            El formulario está activo — envía tu consulta y te responderemos por email.
          </p>
        ) : (
          <p class="contact-note" role="status">
            El formulario se activa cuando esté configurado el email de Dubliners. Mientras, Instagram o Cómo llegar / Visitar.
          </p>
        )}
        <form
          class="contact-form"
          method="POST"
          action={formAction}
          data-form-ready={formReady ? 'true' : 'false'}
          data-form-endpoint={formAction || ''}
          novalidate
        >
          {/* FormSubmit: _subject, plantilla table, captcha off para AJAX JSON */}
          {formReady && <input type="hidden" name="_subject" value="Dubliners Madrid — contacto web" />}
          {formReady && <input type="hidden" name="_template" value="table" />}
          {formReady && <input type="hidden" name="_captcha" value="false" />}
          <div class="hp" aria-hidden="true">
            <label for="company_website">Company</label>
            {/* FormSubmit honeypot: name="_honey"; vacío para humanos */}
            <input type="text" id="company_website" name="_honey" tabindex="-1" autocomplete="off" />
          </div>

          <label for="name">Nombre</label>
          <input id="name" name="name" type="text" required maxlength="120" autocomplete="name" disabled={!formReady} />

          <label for="email">Email</label>
          <input id="email" name="email" type="email" required maxlength="160" autocomplete="email" disabled={!formReady} />

          <label for="reason">Motivo del contacto</label>
          <select id="reason" name="reason" required disabled={!formReady}>
            <option value="">Elige…</option>
            <option value="Información general">Información general</option>
            <option value="Grupos">Grupos</option>
            <option value="Deporte / partidos">Deporte / partidos</option>
            <option value="Eventos">Eventos</option>
            <option value="Otro">Otro</option>
          </select>

          <label for="message">Mensaje</label>
          <textarea id="message" name="message" rows="6" required maxlength="4000" disabled={!formReady}></textarea>

          <p class="form-legal">
            Al enviar este mensaje aceptas que usemos tus datos solo para responder a esta consulta.
            Consulta nuestra <a href={withBase('/es/privacidad/')}>nota de privacidad</a>.
          </p>

          <button class="btn btn-primary" type="submit" disabled={!formReady}>Enviar mensaje</button>
          <p id="form-status" class="contact-note" hidden></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector('.contact-form') as HTMLFormElement | null;
  const status = document.getElementById('form-status');
  const params = new URLSearchParams(location.search);
  if (params.get('sent') === '1' && status) {
    status.hidden = false;
    status.textContent = 'Gracias — tu mensaje se ha enviado. Te responderemos pronto.';
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (!form || form.getAttribute('data-form-ready') !== 'true') {
      if (status) {
        status.hidden = false;
        status.textContent = 'El formulario aún no está activo. Usa Instagram o visítanos.';
      }
      return;
    }

    const endpoint = form.getAttribute('data-form-endpoint') || form.getAttribute('action');
    if (!endpoint) return;

    const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;
    if (submitBtn) submitBtn.disabled = true;
    if (status) {
      status.hidden = false;
      status.textContent = 'Enviando…';
    }

    try {
      const body = new FormData(form);
      const res = await fetch(endpoint, {
        method: 'POST',
        body,
        headers: { Accept: 'application/json' },
      });
      let data: { success?: string | boolean; message?: string } = {};
      try {
        data = await res.json();
      } catch {
        /* respuesta no JSON */
      }

      const ok =
        res.ok && (data.success === 'true' || data.success === true);
      if (ok) {
        if (status) {
          status.textContent = 'Gracias — tu mensaje se ha enviado. Te responderemos pronto.';
        }
        form.reset();
        document.dispatchEvent(
          new CustomEvent('dubliners:contact_submit', {
            detail: { language: 'es', page_path: location.pathname },
          }),
        );
      } else {
        if (status) {
          status.textContent =
            data.message || 'Algo ha fallado. Inténtalo de nuevo o escríbenos por email.';
        }
        // Conservar valores en error — no reset
      }
    } catch {
      if (status) {
        status.textContent = 'Error de red. Inténtalo de nuevo o escríbenos por email.';
      }
    } finally {
      if (submitBtn) submitBtn.disabled = false;
    }
  });
</script>
