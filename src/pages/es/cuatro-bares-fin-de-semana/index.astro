      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Ver en Dubliners',
            items: [
              { href: '/es/bar-deportivo-madrid/', label: 'Bar deportivo Madrid', note: 'Pub irlandés cerca de Puerta del Sol' },
