import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../../components/OriginalFourBars.astro';
import FanWeekendCtas from '../../../components/FanWeekendCtas.astro';
import { withBase, absUrl } from '../../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../../data/fourBars';

const PATH = '/es/despues-madrid-game-seguir-cuatro-puertas-abiertas/';
const PATH_EN = '/after-madrid-game-continue-four-open-doors/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Después del Madrid Game: seguir en las cuatro puertas abiertas para la NFL de después y el Atlético–Barcelona 21:00',
  inLanguage: 'es',
  datePublished: '2026-11-08T15:00:00+01:00',
  dateModified: '2026-11-08T15:00:00+01:00',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Después del Madrid Game, ¿dónde es el punto de encuentro junto a Sol?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Las cuatro puertas hermanas que ya están abiertas: Four Corner, Calle de la Victoria 6 (desde las 14:00 hasta la madrugada, pantallas de deporte); Dubliners y O’Connell’s, Espoz y Mina 7; O’Reilly’s, Pasaje de Matheu 4. Marcad una calle y preguntad qué echan. Listados con nombre: Partidos de Dubliners solamente. No inventamos la programación de los bares hermanos.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Qué hay confirmado en Dubliners después del partido de las 15:30?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Partidos lista NFL después desde las 19:00 (siete partidos), NFL RedZone desde las 19:00, Texans–Chargers a las 22:05, tres NFL más a las 22:25 y Atlético vs Barcelona a las 21:00. Cerramos a las 02:00; el partido de las 02:20 del lunes no se echa. Preguntad qué pantalla. Premier League 15:00 y United–Villa 17:30 van a la vez — coordinad, no sustituyáis.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Esto es la parrilla de tarde–noche, el reloj a elegir o las quedadas Atleti?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Esas páginas ya cubren los dos relojes NFL, quedarse en Sol todo el día, elegir 15:30 frente a 19:00, visitantes NFL que comparten Sol y la quedada local Atleti–Barça. Esta página es solo el punto de encuentro después del partido en las cuatro puertas abiertas: NFL de después, luego Atlético–Barcelona 21:00.',
      },
    },
  ],
};
---

<BaseLayout
  title="Después del Madrid Game: cuatro puertas abiertas, NFL luego Atleti | Dubliners"
  description="Domingo 8 nov después del Madrid Game: quedada en las cuatro puertas abiertas de Sol. NFL desde las 19:00 y Atlético–Barcelona 21:00 en Dubliners. Four Corner está abierto (desde las 14:00, pantallas de deporte). Preguntad qué echan. FIND US."
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Después del Madrid Game: seguir en las cuatro puertas abiertas" schema />
      <h1>Después del Madrid Game: seguir en las cuatro puertas abiertas (NFL de después, luego Atlético–Barcelona 21:00)</h1>
      <p class="lead">
        El Madrid Game de las 15:30 no vacía Sol. <strong>Las cuatro puertas hermanas están abiertas ahora</strong> —
        Four Corner en Calle de la Victoria 6 (desde las 14:00 hasta la madrugada, pantallas de deporte), Dubliners y O’Connell’s en Espoz y Mina 7,
        O’Reilly’s en Pasaje de Matheu 4. Este es el <strong>punto de encuentro después del partido</strong>: NFL de después, luego Atlético vs Barcelona 21:00.
        Listados con nombre: <a href={withBase('/es/partidos/')}>Partidos</a> de Dubliners solamente. Preguntad qué echan. Maps abajo.
      </p>
      <p class="small">In English: <a href={withBase(PATH_EN)} hreflang="en" lang="en">After the Madrid Game: continue at the four open doors</a></p>
      <FanWeekendCtas lang="es" findHref="/es/visitar/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Punto de encuentro después del partido — no la parrilla, no el reloj, no la quedada Atleti</h2>
      <p>
        Otras páginas ya cubren los relojes NFL de tarde y de noche, quedarse en Sol todo el día sin salir,
        elegir 15:30 frente a 19:00, visitantes NFL que comparten las calles con el fútbol de las 21:00 y la quedada local Atleti–Barça.
        Esta página es solo para el grupo que <strong>ya tiene el Madrid Game detrás</strong> — saliendo del Bernabéu
        o de la pantalla grande de las 15:30 en Dubliners — y necesita un pin para lo que sigue en las mismas dos calles.
        ¿Salís del estadio? Usad
        <a href={withBase('/es/salida-bernabeu-a-las-cuatro-puertas-sol/')}>Maps del Bernabéu a las cuatro puertas abiertas</a>.
        No re-promocionéis el sábado 18:00–19:00 como si siguiera.
      </p>

      <h2>Cuatro puertas abiertas — marcad una calle y preguntad qué echan</h2>
      <p>
        Four Corner <strong>está abierto</strong> (desde las 14:00 hasta la madrugada · pantallas de deporte). No listamos su programación.
        O’Reilly’s y O’Connell’s son puntos de encuentro del mismo clúster; no copiamos el cartel de Dubliners a esas puertas.
        Decid si queréis NFL de después o Atlético–Barcelona al sentaros. No todos los partidos van en todas las pantallas.
      </p>
      <ol>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid.</strong>
          Abierto ahora, pantallas de deporte, hasta la madrugada. Preguntad en la puerta.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          Domingo 12:00–02:00. Pantallas con nombre en Partidos.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (en Maps: O’Connell St).
          Mismo número, otra puerta. Punto de encuentro; no inventamos su cartel.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Habitual desde las 11:30. Punto de encuentro; no inventamos la carta.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
      </ol>

      <h2>NFL de después, luego Atlético–Barcelona 21:00 — la Premier va a la vez</h2>
      <p>
        Confirmado solo en Dubliners, desde <a href={withBase('/es/partidos/')}>Partidos</a> (hora de Madrid). Preguntad qué pantalla:
      </p>
      <ul>
        <li>NFL después desde las <strong>19:00</strong> (siete partidos) y NFL RedZone EN DIRECTO desde las 19:00.</li>
        <li>Atlético de Madrid vs FC Barcelona a las <strong>21:00</strong> — misma ventana, otra pantalla si coinciden.</li>
        <li>Texans vs Chargers a las <strong>22:05</strong>, luego tres NFL más a las <strong>22:25</strong>.</li>
        <li>Cerramos a las 02:00. El partido de las 02:20 del lunes no se echa.</li>
      </ul>
      <p>
        Premier League desde las <strong>15:00</strong> (Palace–Liverpool, Sunderland–Chelsea, Brighton–Brentford, Ipswich–Bournemouth)
        y United–Villa a las <strong>17:30</strong> van en las mismas calles. No sustituyen la NFL de después ni el Atleti 21:00 —
        coordinad, no sustituyáis. Si un 15:00 o el 17:30 sigue en pantalla al sentaros, preguntad. No asignamos esos partidos
        a O’Reilly’s, O’Connell’s ni Four Corner.
      </p>

      <OriginalFourBars lang="es" when="sunday" findHref="/es/visitar/" />

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>Después del Madrid Game, ¿dónde quedamos?</strong></dt>
        <dd>Las cuatro puertas abiertas: Victoria 6, Espoz y Mina 7 dos veces, Pasaje de Matheu 4. Four Corner está abierto (desde las 14:00, pantallas de deporte). Preguntad qué echan.</dd>
        <dt><strong>¿Qué hay confirmado después de las 15:30 en Dubliners?</strong></dt>
        <dd>Partidos: NFL desde las 19:00, RedZone desde las 19:00, Atleti–Barça 21:00, Texans–Chargers 22:05, tres más a las 22:25. Cierre 02:00. Premier 15:00 / 17:30 a la vez.</dd>
        <dt><strong>¿Esto es la parrilla, el reloj o la quedada Atleti?</strong></dt>
        <dd>No. Esto es solo el punto de encuentro después del partido en las cuatro puertas abiertas.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Después del Madrid Game este domingo',
            until: SHOW_UNTIL,
            items: [
              { href: '/es/', label: 'FIND US — inicio Dubliners' },
              { href: '/es/visitar/', label: 'CÓMO LLEGAR — visitar / horario' },
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'VER LOS CUATRO BARES' },
              { href: '/es/salida-bernabeu-a-las-cuatro-puertas-sol/', label: 'Salida del estadio: del Bernabéu a las cuatro puertas abiertas' },
              { href: '/es/partidos/', label: 'Partidos — pantallas con nombre' },
              { href: PATH_EN, label: 'After the Madrid Game: continue at the four open doors', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
