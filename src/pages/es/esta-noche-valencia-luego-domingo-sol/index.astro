---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../../data/fourBars';

const PATH = '/es/esta-noche-valencia-luego-domingo-sol/';
const PATH_EN = '/tonight-valencia-then-sunday-sol/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Esta noche Valencia–Real Madrid, luego el pitido del domingo — sin salir de Sol',
  inLanguage: 'es',
  datePublished: '2026-11-07T18:40:00+01:00',
  dateModified: '2026-11-07T18:40:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Cuál es el pitido de esta noche junto a Sol?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Valencia–Real Madrid a las 21:00, EN DIRECTO solo en Dubliners. Quedada antes a las 18:00–19:00 en O’Reilly’s, Dubliners y O’Connell’s. Hoy no hay NFL oficial.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Cuál es el pitido del domingo si me quedo en estas calles?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Bengals–Falcons a las 15:30, EN DIRECTO en la pantalla grande de Dubliners (partido del Bernabéu). Dubliners desde las 12:00, Four Corner desde las 14:00 con pantallas de deporte.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Cuándo cierra Dubliners esta noche y cuándo abre el domingo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sábado 12:00–02:30. Domingo 12:00–02:00. O’Reilly’s todos los días 11:30–01:30. Four Corner no es la madrugada del sábado — domingo desde las 14:00.',
      },
    },
  ],
};
---

<BaseLayout
  title="Esta noche Valencia–RM, luego el pitido del domingo | Dubliners"
  description="Antes y después de dos pitidos: Valencia–Real Madrid 21:00 esta noche en Dubliners, Bengals–Falcons 15:30 el domingo en pantalla grande. Cuatro bares, Maps. Hoy no hay NFL."
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Esta noche Valencia, luego el pitido del domingo" lang="es" schema />
      <h1>Esta noche Valencia–Real Madrid, luego el pitido del domingo — sin salir de Sol</h1>
      <p class="lead">
        Dos pitidos, las mismas calles. Esta noche a las 21:00 es LaLiga en Dubliners (quedada 18:00–19:00 antes).
        El domingo a las 15:30 es Bengals–Falcons en pantalla grande. Hoy no hay NFL oficial.
        Four Corner entra el domingo desde las 14:00 con pantallas de deporte.
      </p>
      <p class="small">In English: <a href={withBase(PATH_EN)} hreflang="en" lang="en">Tonight Valencia–RM, then Sunday kick-off</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners en Maps</a>
        <a class="btn btn-secondary" href={withBase('/es/cuatro-bares-fin-de-semana/')}>VER LOS CUATRO BARES</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Antes del pitido de esta noche (21:00)</h2>
      <p>
        18:00–19:00 en O’Reilly’s (Pasaje de Matheu 4) o en las dos puertas de Espoz y Mina 7.
        Llegad a Dubliners antes de las 21:00 si queréis asiento frente a una pantalla. Valencia–Real Madrid está confirmado EN DIRECTO solo aquí —
        no lo listamos en O’Reilly’s, O’Connell’s ni Four Corner.
      </p>

      <h2>Después de esta noche, antes de las 15:30 del domingo</h2>
      <p>
        Dubliners cierra el sábado a las 02:30. Reabre el domingo a las 12:00. O’Reilly’s desde las 11:30. O’Connell’s desde las 12:00 este domingo.
        Four Corner desde las 14:00 — esa es la última puerta hermana antes de Bengals–Falcons.
        Esta no es la página de ir y volver del estadio; es la noche en Sol.
      </p>

      <OriginalFourBars lang="es" when="tonight" />

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>¿Cuál es el pitido de esta noche junto a Sol?</strong></dt>
        <dd>Valencia–Real Madrid 21:00, EN DIRECTO solo en Dubliners. Quedada 18:00–19:00 antes. Hoy no hay NFL.</dd>
        <dt><strong>¿Cuál es el pitido del domingo en estas calles?</strong></dt>
        <dd>Bengals–Falcons 15:30 en la pantalla grande de Dubliners. Four Corner desde las 14:00, pantallas de deporte.</dd>
        <dt><strong>¿Cierre esta noche / apertura domingo?</strong></dt>
        <dd>Dubliners sábado hasta las 02:30, domingo desde las 12:00. Four Corner no es la madrugada del sábado.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Dos pitidos',
            until: SHOW_UNTIL,
            items: [
              { href: '/es/', label: 'Inicio Dubliners' },
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'VER LOS CUATRO BARES' },
              { href: '/es/sabado-noche-sol-valencia-real-madrid/', label: 'Sábado noche: Valencia–RM' },
              { href: '/es/antes-despues-bengals-falcons-sol/', label: 'Antes y después del partido en el Bernabéu' },
              { href: '/es/quedada-1800-pasaje-matheu-espoz-mina/', label: 'Quedada 18:00–19:00' },
              { href: PATH_EN, label: 'Tonight Valencia, then Sunday', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
