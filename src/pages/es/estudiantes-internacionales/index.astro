---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import { SITE, withBase } from '../../../site';

const title = 'Pub para Erasmus cerca de Sol | Dubliners Madrid';
const description =
  'Pub irlandés en Espoz y Mina 7, junto a Sol. Ambiente internacional, chupitos a 1 € los miércoles. Ideal para Erasmus y estudiantes.';
---

<BaseLayout title={title} description={description} path="/es/estudiantes-internacionales/" lang="es" ogImage="/images/interior-vert.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Erasmus y estudiantes" lang="es" />
        <h1>Pub para Erasmus junto a Sol</h1>
        <p class="lead">
          Dubliners está en Calle de Espoz y Mina 7, a un paseo de Puerta del Sol.
          Ambiente internacional, pantallas cuando hay partido y chupitos a 1 € los miércoles.
        </p>
        <CtaRow lang="es" />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/interior-vert-sm.webp')} 506w, ${withBase('/images/interior-vert.webp')} 900w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img class="hero-photo portrait" src={withBase('/images/interior-vert.jpg')} alt="Entrada a mesas y neones en Dubliners" width="900" height="1600" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>Ambiente internacional</h3>
          <p>Se habla inglés. Fácil quedar con estudiantes internacionales y con gente de Madrid.</p>
        </article>
        <article class="card">
          <h3>En Sol</h3>
          <p>Calle de Espoz y Mina 7, 28012 Madrid.</p>
        </article>
        <article class="card">
          <h3>MIÉRCOLES · CHUPITOS A 1 €</h3>
          <p>Solo miércoles. Después, Four Corner After Party, Calle Victoria 6, hasta las 05:30.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Plan entre semana</h2>
      <p>
        Ven en grupo o solo. Los miércoles: chupitos a 1 € y, si quieres seguir,
        Four Corner After Party, Calle Victoria 6, solo miércoles, hasta las 05:30.
      </p>
      <p>
        El resto de la semana: deporte en pantallas cuando hay partido.
        <a href={withBase('/es/miercoles-chupitos-1-euro/')}>Miércoles chupitos a 1 €</a> ·
        <a href={withBase('/es/partidos/')}>Partidos</a>.
      </p>
      <CtaRow lang="es" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Preguntas frecuentes</h2>
      <div class="faq">
        <details>
          <summary>¿Se habla inglés?</summary>
          <p>Sí. Pub irlandés con ambiente internacional.</p>
        </details>
        <details>
          <summary>¿Dónde estáis?</summary>
          <p>{SITE.address}, {SITE.postal}</p>
        </details>
        <details>
          <summary>¿Qué noche conviene más?</summary>
          <p>Miércoles, por los chupitos a 1 €.</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
