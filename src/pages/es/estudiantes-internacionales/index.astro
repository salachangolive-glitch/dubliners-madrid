---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { SITE, withBase } from '../../../site';

const title = 'Pub Erasmus y estudiantes internacionales Madrid cerca de Sol | Dubliners';
const description =
  'Pub para Erasmus y estudiantes internacionales junto a Puerta del Sol. Ambiente en inglés, deporte en directo y chupitos a 1 € los miércoles. Espoz y Mina 7.';
---

<BaseLayout title={title} description={description} path="/es/estudiantes-internacionales/" lang="es" ogImage="/images/mural-hero.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Estudiantes internacionales" lang="es" />
      <h1>Pub Erasmus y estudiantes internacionales cerca de Sol</h1>
      <p class="lead">
        Dubliners recibe a Erasmus y estudiantes internacionales junto a Puerta del Sol —
        atención en inglés, deporte en pantallas y chupitos a 1 € los miércoles.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
        <a class="btn btn-secondary" href={withBase('/es/miercoles-chupitos-1-euro/')}>Miércoles chupitos a 1 €</a>
        <a class="btn btn-secondary" href={withBase('/es/partidos/')}>Partidos</a>
      </div>
    </div>
  </section>

  <section class="hero-artwork" aria-label="Pintura del techo">
    <picture>
      <source
        type="image/webp"
        srcset={`${withBase('/images/mural-hero-sm.webp')} 900w, ${withBase('/images/mural-hero.webp')} 1872w`}
        sizes="100vw"
      />
      <img
        class="hero-artwork__img"
        src={withBase('/images/mural-hero.jpg')}
        alt="Pintura histórica del techo de Dubliners Madrid"
        width="1872"
        height="1056"
        loading="eager"
        decoding="async"
      />
    </picture>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Ambiente internacional</h2>
      <p>
        Madrileños, viajeros y estudiantes Erasmus comparten la misma barra — Guinness, fútbol en directo y un ambiente fácil en inglés en el centro de Madrid.
        Sin reserva: entra, siéntate y pregunta qué hay en pantallas.
      </p>
      <p>
        Siguientes pasos útiles:
        <a href={withBase('/es/partidos/')}>Partidos de hoy</a>,
        <a href={withBase('/es/bar-deportivo-madrid/')}>pantallas deportivas cerca de Sol</a>,
        <a href={withBase('/es/visitar/')}>cómo llegar</a>.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>MIÉRCOLES · CHUPITOS A 1 €</h2>
      <p>
        Promo propia de Dubliners: chupitos a 1 € todos los miércoles en el pub. Pregunta en barra los detalles.
      </p>
      <p>
        <a class="btn btn-secondary" href={withBase('/es/miercoles-chupitos-1-euro/')}>Miércoles chupitos a 1 €</a>
      </p>

      <h2>Un local con historia</h2>
      <p>
        Antes de convertirse en Dubliners, este espacio albergó la histórica sastrería Barragán, cuya actividad comenzó en 1885.
        Parte de la estructura y decoración original todavía se conserva, incluida su característica pintura del techo.
      </p>
      <p class="brand-line"><strong>Donde antes se cosían trajes, hoy se tejen historias.</strong></p>

      <h2>Ubicación</h2>
      <p>
        Calle de Espoz y Mina 7<br />
        28012 Madrid · Metro Sol o Sevilla
      </p>
      <p>
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
      </p>
    </div>
  </section>
</BaseLayout>
