---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import { SITE, withBase } from '../../../site';

const title = 'Dubliners para estudiantes internacionales en Madrid | Sol';
const description =
  'Pub irlandés junto a Puerta del Sol. Ambiente internacional, deporte en directo y chupitos a 1 € los miércoles. Espoz y Mina 7.';
---

<BaseLayout title={title} description={description} path="/es/estudiantes-internacionales/" lang="es" ogImage="/images/interior-vert.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Estudiantes internacionales" lang="es" />
        <h1>Dubliners para estudiantes internacionales en Madrid</h1>
        <p class="lead">
          Dubliners está a pocos minutos de la Puerta del Sol. Un pub irlandés con ambiente internacional,
          deporte en directo y chupitos a 1 € todos los miércoles.
        </p>
        <CtaRow lang="es" showWednesday={false} />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/interior-vert-sm.webp')} 506w, ${withBase('/images/interior-vert.webp')} 900w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img class="hero-photo portrait" src={withBase('/images/interior-vert.jpg')} alt="Entrada a mesas y neones en Dubliners" width="900" height="1600" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-2">
        <article class="card">
          <h3>Ambiente internacional</h3>
          <p>Ambiente internacional y atención en inglés.</p>
        </article>
        <article class="card">
          <h3>En Sol</h3>
          <p>{SITE.address}, {SITE.postal}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>MIÉRCOLES · CHUPITOS A 1 €</h2>
      <p>
        Todos los miércoles, chupitos a 1 € en Dubliners.
        La noche puede seguir en Four Corner After Party, Calle Victoria 6, hasta las 05:30 (solo miércoles).
      </p>
      <p>
        <a href={withBase('/es/miercoles-chupitos-1-euro/')}>Más sobre el miércoles</a>
        ·
        <a href={withBase('/es/visitar/')}>Cómo llegar</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Preguntas frecuentes</h2>
      <div class="faq">
        <details>
          <summary>¿Dónde estáis?</summary>
          <p>{SITE.address}, {SITE.postal}. Metro Sol o Sevilla.</p>
        </details>
        <details>
          <summary>¿Cómo llego desde Puerta del Sol?</summary>
          <p>Unos dos minutos a pie por Calle de Espoz y Mina hasta el número 7.</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
