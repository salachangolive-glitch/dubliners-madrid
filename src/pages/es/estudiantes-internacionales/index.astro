---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import { SITE, withBase } from '../../../site';

const title = 'Pub para estudiantes internacionales Madrid | Cerca de Sol';
const description =
  'Pub irlandés cerca de Sol para Erasmus y estudiantes internacionales. Miércoles chupitos a 1 €. Espoz y Mina 7, Madrid.';
---

<BaseLayout title={title} description={description} path="/es/estudiantes-internacionales/" lang="es" ogImage="/images/interior-vert.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Estudiantes internacionales" lang="es" />
        <h1>Pub cerca de Sol para gente de fuera</h1>
        <p class="lead">
          Punto de encuentro para Erasmus y estudiantes internacionales —
          Espoz y Mina 7, a un paseo de Puerta del Sol.
        </p>
        <CtaRow lang="es" />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/interior-vert-sm.webp')} 506w, ${withBase('/images/interior-vert.webp')} 900w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img class="hero-photo portrait" src={withBase('/images/interior-vert.jpg')} alt="Entrada a mesas y neones en Dubliners" width="900" height="1600" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>Ambiente internacional</h3>
          <p>Equipo que habla inglés; estudiantes y viajeros en el centro.</p>
        </article>
        <article class="card">
          <h3>Justo en Sol</h3>
          <p>Calle de Espoz y Mina 7 — cerca después de clase o antes de salir.</p>
        </article>
        <article class="card">
          <h3>MIÉRCOLES · CHUPITOS A 1 €</h3>
          <p>Ritual semanal. Solo miércoles: Four Corner After Party, Calle Victoria 6, hasta las 05:30.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Entre semana cerca de Sol</h2>
      <p>
        Trae a tu grupo o ven solo. Los miércoles hay chupitos a 1 € y, si quieres,
        Four Corner After Party, Calle Victoria 6, solo miércoles, hasta las 05:30.
      </p>
      <p>
        Otras noches: deporte en pantallas cuando hay partido.
        <a href={withBase('/es/miercoles-chupitos-1-euro/')}>Miércoles chupitos a 1 €</a> ·
        <a href={withBase('/es/partidos/')}>Partidos</a>.
      </p>
      <CtaRow lang="es" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Preguntas frecuentes</h2>
      <div class="faq">
        <details>
          <summary>¿Se habla inglés?</summary>
          <p>Sí — pub irlandés con ambiente internacional y equipo que habla inglés.</p>
        </details>
        <details>
          <summary>¿Dónde estáis?</summary>
          <p>{SITE.address}, {SITE.postal}</p>
        </details>
        <details>
          <summary>¿Mejor noche para estudiantes?</summary>
          <p>Miércoles por los chupitos a 1 €.</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
