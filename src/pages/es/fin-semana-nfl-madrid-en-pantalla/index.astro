---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../../data/fourBars';

const PATH = '/es/fin-semana-nfl-madrid-en-pantalla/';
const PATH_EN = '/nfl-weekend-madrid-screens-only/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Fin de semana NFL en Madrid sin estadio — pantallas junto a Sol',
  inLanguage: 'es',
  datePublished: '2026-11-07T18:30:00+01:00',
  dateModified: '2026-11-07T18:30:00+01:00',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Puedo seguir el fin de semana NFL Madrid sin ir al Bernabéu?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sí. Quedaos en el rincón de Sol. El sábado es quedada y Valencia–Real Madrid a las 21:00 en Dubliners (hoy no hay NFL). El domingo Bengals–Falcons va EN DIRECTO en la pantalla grande de Dubliners a las 15:30, luego más NFL desde las 19:00.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Dónde veo el partido si no voy al estadio el domingo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Las pantallas NFL confirmadas este domingo están en Dubliners, Espoz y Mina 7, desde las 12:00. Four Corner abre a las 14:00 con pantallas de deporte; no listamos sus partidos. Preguntad qué echan.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Hay que salir de Sol entre el sábado noche y el pitido del domingo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Dubliners cierra el sábado a las 02:30 y reabre el domingo a las 12:00. O’Reilly’s es todos los días 11:30–01:30. Four Corner entra el domingo a las 14:00.',
      },
    },
  ],
};
---

<BaseLayout
  title="Fin de semana NFL en Madrid sin estadio | Dubliners"
  description="Quedaos junto a Sol todo el fin de semana: quedada 18:00–19:00, Valencia–RM 21:00 en Dubliners, pantallas el domingo desde las 12:00. Four Corner 14:00. Hoy no hay NFL."
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Fin de semana NFL en pantalla junto a Sol" lang="es" schema />
      <h1>Fin de semana NFL en Madrid sin estadio — pantallas junto a Sol</h1>
      <p class="lead">
        No hace falta entrada del Bernabéu para pasar el fin de semana con otra afición.
        Esta noche es la quedada y LaLiga en Dubliners. El domingo el Madrid Game también va en nuestra pantalla grande a las 15:30.
        Cuatro bares hermanos, un rincón. Pubs independientes — no es un evento oficial de la NFL.
      </p>
      <p class="small">In English: <a href={withBase(PATH_EN)} hreflang="en" lang="en">NFL weekend in Madrid without the stadium</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners en Maps</a>
        <a class="btn btn-secondary" href={withBase('/es/cuatro-bares-fin-de-semana/')}>VER LOS CUATRO BARES</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Sábado: sin NFL, con noche de afición</h2>
      <p>
        El sábado 7 de noviembre <strong>no hay partido oficial de la NFL</strong>. Si ya estás en Madrid, no esperes al mediodía del domingo.
        Quedada <strong>18:00–19:00</strong> en O’Reilly’s, Dubliners y O’Connell’s. Luego Valencia–Real Madrid a las <strong>21:00, EN DIRECTO solo en Dubliners</strong>.
        Four Corner sigue cerrado hasta el domingo.
      </p>

      <h2>Domingo: el partido en una pantalla en Sol</h2>
      <p>
        Bengals–Falcons es a las 15:30 hora de Madrid (9:30 a.m. ET) en el Bernabéu — y EN DIRECTO en la pantalla grande de Dubliners si os quedáis aquí.
        Dubliners 12:00–02:00. Four Corner desde las 14:00 hasta la madrugada, con pantallas de deporte (sin listados inventados).
        NFL de noche desde las 19:00, luego 22:05 y 22:25, más Atlético–Barcelona a las 21:00. Preguntad qué echan. No todos los partidos van en todas las pantallas.
      </p>
      <p>
        Esta página es para quien <strong>no</strong> va al estadio. Si el grupo se divide, las pantallas siguen en estas calles de todos modos.
      </p>

      <OriginalFourBars lang="es" when="sunday" />

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>¿Puedo seguir el fin de semana sin el Bernabéu?</strong></dt>
        <dd>Sí. Quedada del sábado + Valencia 21:00 en Dubliners. Domingo Bengals–Falcons EN DIRECTO en pantalla grande a las 15:30.</dd>
        <dt><strong>¿Dónde veo si no voy al estadio?</strong></dt>
        <dd>Pantallas NFL confirmadas el domingo: Dubliners, Espoz y Mina 7. Four Corner tiene pantallas de deporte desde las 14:00; no listamos sus partidos.</dd>
        <dt><strong>¿Hay que salir de Sol por la noche?</strong></dt>
        <dd>No. Cierre sábado 02:30 en Dubliners, domingo desde las 12:00. Four Corner desde las 14:00.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Quedarse en Sol',
            until: SHOW_UNTIL,
            items: [
              { href: '/es/', label: 'Inicio Dubliners' },
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'VER LOS CUATRO BARES' },
              { href: '/es/quedada-1800-pasaje-matheu-espoz-mina/', label: 'Quedada 18:00–19:00, orden del paseo' },
              { href: '/es/antes-despues-bengals-falcons-sol/', label: 'Antes y después si sí vais al partido' },
              { href: '/es/nfl-madrid/', label: 'Lista NFL del domingo en Dubliners' },
              { href: PATH_EN, label: 'Screens only, no stadium', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
