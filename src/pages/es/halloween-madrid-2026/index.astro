---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import { SITE, withBase, absUrl } from '../../../site';
import { OPENING_HOURS } from '../../../data/hours';

// Par ES de /halloween-madrid-2026/ (DG HALLOWEEN 24 oct). Datos confirmados por el dueño vía DG:
// sáb 31 oct 2026 desde las 19:00, disfraces, decoración y música. Sin precios, promociones ni concursos.
// Ángulo: pub irlandés internacional y Erasmus junto a Sol. Archivar el dom 1 nov.
const path = '/es/halloween-madrid-2026/';
const sat = OPENING_HOURS.find((d) => d.day === 'Saturday')!;
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: '¿Cuándo fue la fiesta de Halloween en Dubliners?', acceptedAnswer: { '@type': 'Answer', text: 'Fue el sábado 31 de octubre de 2026, desde las 19:00 (hora de Madrid). Los próximos eventos y el deporte en directo están en Partidos y eventos.' } },
    { '@type': 'Question', name: '¿Dónde fue?', acceptedAnswer: { '@type': 'Answer', text: 'En Dubliners Irish Pub, calle de Espoz y Mina 7, 28012 Madrid, a pocos pasos de la Puerta del Sol. Metro Sol (líneas 1, 2 y 3) o Sevilla (línea 2).' } },
    { '@type': 'Question', name: '¿Se habla inglés?', acceptedAnswer: { '@type': 'Answer', text: 'Sí. Dubliners es un pub irlandés internacional: el equipo habla español e inglés, y vienen estudiantes Erasmus y gente de muchos países.' } },
    { '@type': 'Question', name: '¿Cómo fue?', acceptedAnswer: { '@type': 'Answer', text: 'Con disfraces, decoración de Halloween y música toda la noche.' } },
  ],
};
// ARCHIVADA 2 nov 2026 (rutina 0b): el evento fue el sáb 31 oct; en pasado, sin JSON-LD Event, misma URL.
---

<BaseLayout title={'Halloween en Madrid junto a Sol 2026: fiesta en un pub irlandés | Dubliners'} description={'Halloween 2026 en Dubliners, pub irlandés internacional en Espoz y Mina 7 junto a la Puerta del Sol: la fiesta fue el sábado 31 de octubre, con disfraces, decoración y música. Consulta los próximos eventos.'} path={path} lang="es" hreflang={{ en: '/halloween-madrid-2026/', es: path }} ogImage="/images/facade-queue.jpg" extraJsonLd={[faqLd]}>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current={'Halloween en Madrid'} lang="es" schema />
      <h1>Halloween en Madrid junto a Sol: fiesta en Dubliners</h1>
      <p class="lead">La fiesta de Halloween 2026 en Dubliners fue el sábado 31 de octubre desde las 19:00: disfraces, decoración de Halloween y música en un pub irlandés internacional en Espoz y Mina 7, a pocos pasos de la Puerta del Sol. ¡Gracias a todos los que vinisteis! Lo próximo, en <a href={withBase('/es/partidos/')}>Partidos y eventos</a>.</p>
      <p class="small">Evento finalizado · Sábado 31 de octubre de 2026 · Calle de Espoz y Mina 7 · Actualizado el 2 de noviembre de 2026</p>
      <p class="small">In English: <a href={withBase('/halloween-madrid-2026/')} hreflang="en" lang="en">Halloween in Madrid near Sol</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
        <a class="btn btn-primary" href={withBase('/contact/#request-information')}>Pedir información</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <h2>Una noche de Halloween internacional</h2>
      <p>¿Acabas de llegar a Madrid, estás de Erasmus o de visita? Halloween es la noche perfecta para conocer gente. En Dubliners se habla español e inglés, suena la música y el pub entero se disfraza, así que puedes vivir Halloween en Madrid sin preocuparte por el idioma.</p>
      <picture><source type="image/webp" srcset={`${withBase('/images/facade-queue-sm.webp')} 640w, ${withBase('/images/facade-queue.webp')} 1320w`} sizes="(max-width: 800px) 100vw, 720px" /><img class="split-photo landscape" src={withBase('/images/facade-queue.jpg')} width="1320" height="986" loading="lazy" decoding="async" alt="Gente en la puerta de Dubliners por la noche, Espoz y Mina 7, junto a la Puerta del Sol" /></picture>
      <h2>Cómo fue la noche</h2>
      <ul>
        <li><strong>Disfraces:</strong> brujas, zombis, vampiros y mucho más.</li>
        <li><strong>Decoración:</strong> el pub se decoró para Halloween.</li>
        <li><strong>Música:</strong> ambiente de fiesta desde las 19:00.</li>
      </ul>
      <h2>Para Erasmus, internacionales y grupos</h2>
      <p>Si estás de Erasmus, vives en Madrid desde hace poco o vas a salir con tus compañeros de piso, de clase o de trabajo, Dubliners es un sitio fácil para empezar la noche: a unos pasos de la Puerta del Sol, cerca de la Plaza Mayor y del Barrio de las Letras. ¿Venís en grupo grande? Escríbenos desde <a href={withBase('/contact/#request-information')}>Pedir información</a>.</p>
      <h2>Cuándo y dónde</h2>
      <p><strong>Sábado 31 de octubre de 2026, desde las 19:00</strong> (evento finalizado).</p>
      <p>Dubliners Irish Pub, calle de Espoz y Mina 7, 28012 Madrid. Metro Sol (líneas 1, 2 y 3) o Sevilla (línea 2).</p>
      <h2>Horario</h2>
      <ul>{OPENING_HOURS.map((d) => <li>{d.es}: {d.opens}–{d.closes}</li>)}</ul>
      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>¿Cuándo fue la fiesta de Halloween en Dubliners?</strong></dt><dd>Fue el sábado 31 de octubre de 2026, desde las 19:00 (hora de Madrid). Los próximos eventos están en <a href={withBase('/es/partidos/')}>Partidos y eventos</a>.</dd>
        <dt><strong>¿Dónde fue?</strong></dt><dd>En Dubliners Irish Pub, calle de Espoz y Mina 7, 28012 Madrid, a pocos pasos de la Puerta del Sol. Metro Sol (líneas 1, 2 y 3) o Sevilla (línea 2).</dd>
        <dt><strong>¿Se habla inglés?</strong></dt><dd>Sí. Dubliners es un pub irlandés internacional: el equipo habla español e inglés, y vienen estudiantes Erasmus y gente de muchos países.</dd>
        <dt><strong>¿Cómo fue?</strong></dt><dd>Con disfraces, decoración de Halloween y música toda la noche.</dd>
      </dl>
      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Más en Dubliners',
            items: [
              { href: '/es/partidos/', label: 'Partidos y eventos', note: 'Agenda de la semana' },
              { href: '/es/estudiantes-internacionales/', label: 'Erasmus y estudiantes internacionales' },
              { href: '/es/noche-cerca-de-sol/', label: 'Salir de noche cerca de Sol' },
              { href: '/es/visitar/', label: 'Horario y mapa' },
              { href: '/halloween-madrid-2026/', label: 'Halloween in Madrid near Sol', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
