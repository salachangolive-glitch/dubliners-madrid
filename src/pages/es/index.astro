---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, withBase } from '../../site';

const title = 'Pub irlandés cerca de Sol | Fútbol en directo — Dubliners Madrid';
const description =
  'Pub irlandés junto a Puerta del Sol en Espoz y Mina 7. Guinness, fútbol en pantallas, sin reserva — Metro Sol (L1, L2, L3) o Sevilla (L2).';
---

<BaseLayout title={title} description={description} path="/es/" lang="es" ogImage="/images/bar-interior.jpg">
  <!-- Hero: foto real de la barra, sin overlays -->
  <section class="hero-photo-band" aria-label="Interior del bar">
    <picture>
      <source
        type="image/webp"
        srcset={`${withBase('/images/bar-interior-sm.webp')} 800w, ${withBase('/images/bar-interior.webp')} 1400w`}
        sizes="100vw"
      />
      <img
        class="hero-photo-band__img"
        src={withBase('/images/bar-interior.jpg')}
        alt="Barra y suelo de damero en Dubliners Madrid"
        width="1400"
        height="788"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </section>

  <!-- Identidad + enlaces compactos -->
  <div class="home-identity">
    <div class="home-identity__inner">
      <p class="home-identity__name">Dubliners Madrid</p>
      <p class="home-identity__tag">Pub irlandés · Puerta del Sol · Fútbol en directo</p>
      <nav class="home-identity__links" aria-label="Enlaces rápidos">
        <a href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
        <span class="home-identity__sep" aria-hidden="true">·</span>
        <a href={withBase('/es/partidos/')}>Partidos</a>
        <span class="home-identity__sep" aria-hidden="true">·</span>
        <a href={withBase('/es/bar-deportivo-madrid/')}>Bar deportivo</a>
      </nav>
    </div>
  </div>

  <section class="section home-intro">
    <div class="container">
      <h1>Pub irlandés cerca de Puerta del Sol</h1>
      <p class="lead">
        Junto a Puerta del Sol en Espoz y Mina 7. Guinness, fútbol en directo en pantallas y ambiente internacional — todos los días.
      </p>
      <p class="nap-line">
        <strong>{SITE.address}</strong>, {SITE.postal} · Metro Sol (L1, L2, L3) o Sevilla (L2)
      </p>
      <CtaRow lang="es" showWednesday={false} showContact={false} />
    </div>
  </section>

  <!-- Sobre / historia con mural -->
  <section class="section band home-about" id="nuestro-local">
    <div class="container">
      <div class="home-about__copy prose">
        <h2>Nuestro local · un sitio con historia</h2>
        <p>
          Antes de Dubliners, este espacio albergó la histórica sastrería Barragán, cuya actividad comenzó en 1885.
          Parte de su estructura y decoración original todavía se conserva, incluida la característica pintura del techo.
        </p>
        <p class="brand-line"><strong>Donde antes se cosían trajes, hoy se tejen historias.</strong></p>
        <p>
          <a href={withBase('/es/sobre-dubliners/')}>Descubre nuestra historia</a>
        </p>
      </div>
      <figure class="home-mural">
        <picture>
          <source
            type="image/webp"
            srcset={`${withBase('/images/mural-hero-sm.webp')} 900w, ${withBase('/images/mural-hero.webp')} 1872w`}
            sizes="(max-width: 880px) 100vw, 70vw"
          />
          <img
            class="home-mural__img"
            src={withBase('/images/mural-hero.jpg')}
            alt="Pintura histórica del techo de Dubliners Madrid"
            width="1872"
            height="1056"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="home-mural__cap">El techo pintado — resto de la antigua sastrería Barragán</figcaption>
      </figure>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div>
        <h2>Dubliners hoy</h2>
        <p>
          Un pub irlandés para madrileños, visitantes y gente de todo el mundo. Ven a ver el partido y quédate a tomar una Guinness.
        </p>
        <p>
          Deportes en directo por TV — Premier League, Champions, LaLiga y más. Mira
          <a href={withBase('/es/partidos/')}>partidos</a> o pregunta en barra.
        </p>
        <p>
          Más páginas de partido:
          <a href={withBase('/es/bar-deportivo-madrid/')}>Bar deportivo cerca de Sol</a>,
          <a href={withBase('/es/premier-league-pub-madrid/')}>Noches de Premier League</a>,
          <a href={withBase('/es/champions-league-bar-madrid/')}>Pantallas Champions League</a>.
        </p>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img
          src={withBase('/images/screens-sports.jpg')}
          alt="Pantallas deportivas y proyector en Dubliners"
          width="1400"
          height="788"
          loading="lazy"
          class="split-photo landscape"
        />
      </picture>
    </div>
  </section>


  <section class="section">
    <div class="container">
      <h2>El local</h2>
      <div class="photo-grid">
        {[
          { src: 'window-display', alt: 'Escaparate vintage delante de Dubliners', w: 1600, h: 902 },
          { src: 'window-display-2', alt: 'Detalle del escaparate en Dubliners', w: 1600, h: 902 },
        ].map(({ src, alt, w, h }) => (
          <picture>
            <source srcset={withBase(`/images/${src}.webp`)} type="image/webp" />
            <img src={withBase(`/images/${src}.jpg`)} alt={alt} width={w} height={h} loading="lazy" />
          </picture>
        ))}
      </div>
    </div>
  </section>


  <section class="section band-gold">
    <div class="container split reverse">
      <div>
        <h2>Los miércoles en Dubliners — chupitos a 1 €</h2>
        <p>
          Promo propia de Dubliners: chupitos a 1 € en el pub. Pregunta en barra al llegar.
        </p>
        <a class="btn btn-gold" href={withBase('/es/miercoles-chupitos-1-euro/')}>Miércoles chupitos a 1 €</a>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/interior-vert-sm.webp')} 506w, ${withBase('/images/interior-vert.webp')} 900w`}
          sizes="(max-width: 880px) 100vw, 35vw"
        />
        <img
          src={withBase('/images/interior-vert.jpg')}
          alt="Entrada a mesas con neones y pantallas en Dubliners"
          width="900"
          height="1600"
          loading="lazy"
          class="split-photo tall"
        />
      </picture>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Respuestas rápidas</h2>
      <div class="faq">
        <details>
          <summary>¿Cuál es el horario?</summary>
          <p>Lun–jue y dom 12:00–02:00 · Vie–sáb 12:30–02:30.</p>
        </details>
        <details>
          <summary>¿Ponéis fútbol en directo?</summary>
          <p>
            Sí — Premier League, Champions, LaLiga y más en pantallas cuando hay partido.
            Consulta <a href={withBase('/es/partidos/')}>Partidos</a> o pregunta en barra.
          </p>
        </details>
        <details>
          <summary>¿Hay que reservar mesa?</summary>
          <p>No — entra cuando quieras. En partidos populares, mejor llegar pronto.</p>
        </details>
        <details>
          <summary>¿Cómo llego desde Metro Sol?</summary>
          <p>
            A un paseo corto de Puerta del Sol. Metro Sol (L1, L2, L3) o Sevilla (L2).
            Dirección: {SITE.address}, {SITE.postal}.
            <a href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Abrir Cómo llegar</a>.
          </p>
        </details>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Dónde estamos</h2>
        <p>
          Calle de Espoz y Mina 7, 28012 Madrid — a un paseo de Sol.
          Metro: Sol o Sevilla.
        </p>
        <p>
          <a href={withBase('/es/estudiantes-internacionales/')}>Estudiantes internacionales y noches Erasmus</a>
        </p>
        <picture>
          <source
            type="image/webp"
            srcset={`${withBase('/images/facade-sm.webp')} 800w, ${withBase('/images/facade.webp')} 1280w`}
            sizes="(max-width: 880px) 100vw, 45vw"
          />
          <img
            src={withBase('/images/facade.jpg')}
            alt="Fachada de Dubliners en Calle de Espoz y Mina"
            width="1280"
            height="720"
            loading="lazy"
            class="split-photo landscape"
            style="margin-bottom:1rem"
          />
        </picture>
        <CtaRow lang="es" />
      </div>
      <div class="map-frame">
        <iframe title="Mapa a Dubliners Madrid" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={SITE.mapsEmbed}></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
