---
import MapEmbed from '../../components/MapEmbed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaRow from '../../components/CtaRow.astro';
import LinkHub from '../../components/LinkHub.astro';
import HomeFixtureCards from '../../components/HomeFixtureCards.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import { SITE, withBase } from '../../site';
import { hoursSummary } from '../../data/hours';

import { madridToday } from '../../data/fixtures';
const todayKey = madridToday();
const title = 'Pub irlandés Madrid cerca de Sol | Bar deportivo, NFL y rugby — Dubliners';
const description =
  'Pub irlandés y bar deportivo en la antigua sastrería Barragán (1885), junto a Puerta del Sol: fútbol de Premier League, Champions League y LaLiga, NFL y rugby en nuestras pantallas, ambiente internacional, desde las 12:00.';
---

<BaseLayout title={title} description={description} path="/es/" lang="es" ogImage="/images/bar-interior.jpg" website>
  <!-- 1. Hero -->
  <section class="hero-photo-band" aria-label="Interior del bar">
    <picture>
      <source
        type="image/webp"
        srcset={`${withBase('/images/facade-queue-480.webp')} 480w, ${withBase('/images/facade-queue-sm.webp')} 640w, ${withBase('/images/facade-queue-768.webp')} 768w, ${withBase('/images/facade-queue-1200.webp')} 1200w, ${withBase('/images/facade-queue.webp')} 1320w`}
        sizes="100vw"
      />
      <img
        class="hero-photo-band__img"
        src={withBase('/images/facade-queue.jpg')}
        alt="Gente haciendo cola en la puerta de Dubliners por la noche, Espoz y Mina 7, junto a Puerta del Sol"
        width="1320"
        height="986"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </section>

  <div class="home-identity">
    <div class="home-identity__inner">
      <p class="home-identity__name">Dubliners Madrid</p>
      <p class="home-identity__tag">Pub irlandés y bar deportivo en el corazón de Madrid</p>
    </div>
  </div>

  <!-- 2. Presentación (breve y natural; las guías van en las secciones de abajo) -->
  <section class="section home-intro">
    <div class="container">
      <h1>Un pub irlandés cerca de Puerta del Sol, en el corazón de Madrid</h1>
      <p class="lead">
        Dubliners es un pub irlandés a un paso de Puerta del Sol, en la antigua sastrería Barragán (1885): fútbol de Premier League, Champions League y LaLiga, NFL los domingos y test matches de rugby en nuestras pantallas, personal que habla inglés y ambiente internacional, abierto cada día desde las 12:00.
      </p>
      <p class="home-intro__text">
        Pasa a tomar algo, queda con amigos o ven a ver el partido en un bar deportivo cerca de Puerta del Sol. Aquí se juntan madrileños, visitantes y la gente internacional de la ciudad — un bar irlandés en Madrid que también funciona como bar NFL Madrid los domingos — en un local que aún conserva el techo pintado de una sastrería del siglo XIX.
      </p>
      <p class="nap-line">
        <strong>{SITE.address}</strong>, {SITE.postal} · Metro Sol (L1, L2, L3) o Sevilla (L2)
      </p>
      <CtaRow lang="es" showWednesday={false} />
    </div>
  </section>


  <!-- 2b. Fútbol (DG 27 oct: fútbol + público internacional) -->
  <section class="section" id="futbol">
    <div class="container prose">
      <h2>Fútbol cerca de Sol: Premier League, Champions League y LaLiga</h2>
      <p>
        El fútbol es lo que más llena el local casi todas las semanas. Los fines de semana de Premier League — un pub de Premier League en Madrid para el fútbol inglés —, las noches de Champions League y los grandes partidos de LaLiga
        van en nuestras pantallas, con el público internacional de Madrid viéndolos juntos: estudiantes Erasmus e internacionales, visitantes alojados cerca de Sol
        y aficionados de fuera que siguen a su equipo. Todos los partidos que anunciamos están confirmados y en hora de Madrid.
      </p>
      <ul>
        <li><a href={withBase('/es/premier-league-pub-madrid/')}>Pub de Premier League en Madrid</a> — fútbol inglés, sábado y domingo</li>
        <li><a href={withBase('/es/champions-league-bar-madrid/')}>Champions League en Madrid</a> — noches europeas junto a Sol</li>
        <li>LaLiga — los partidos principales de cada jornada; consulta <a href={withBase('/es/partidos/')} data-track-event="whats_on_cta_click">Partidos</a> para esta semana</li>
      </ul>
    </div>
  </section>

  <!-- 3. Deporte en directo -->
  <section class="section band" id="deportes-en-directo">
    <div class="container split">
      <div>
        <h2>Deporte en directo</h2>
        <p>
          Fútbol, NFL, rugby, NBA y más en nuestras pantallas. Solo anunciamos lo confirmado, siempre en hora de Madrid, y en barra te dicen qué se emite esta noche.
          Este bar deportivo en Madrid, junto a Puerta del Sol, es también donde vemos la NFL en Madrid.
        </p>
        {todayKey <= '2026-10-31' && (
          <p data-show-until="2026-10-31"><strong>Halloween en Dubliners: sábado 31 de octubre, desde las 19:00.</strong> Disfraces, decoración y música. <a href={withBase('/es/halloween-madrid-2026/')}>Halloween en Madrid junto a Sol</a></p>
        )}
        {todayKey <= '2026-11-15' && (
          <p data-show-until="2026-11-15">
            Deporte en directo esta semana (lun 9–dom 15 nov, hora de Madrid): jueves Real Madrid–Estrella Roja (EuroLeague) 21:00 · sábado rugby España–Chile 17:00 en el Estadio Ontime Butarque, Leganés · sábado Austria–República de Irlanda 20:45 e Irlanda–Fiyi 21:10 — <a href={withBase('/irish-double-saturday-madrid/')} hreflang="en">sábado doble irlandés</a> · domingo NFL desde las 15:30, luego 19:00, 22:05 y 22:25 · domingo España–Inglaterra 20:45 en el Metropolitano (La 1). Confirmados en pantallas; si coinciden, pantallas distintas.
          </p>
        )}
        <div class="cta-row">
          <a class="btn btn-gold" data-track-event="whats_on_cta_click" href={withBase('/es/partidos/')}>Partidos de esta semana</a>
          <a class="btn btn-secondary" href={withBase('/es/bar-deportivo-madrid/')}>Bar deportivo Madrid</a>
          <a class="btn btn-secondary" href={withBase('/es/nfl-madrid/')}>Bar NFL Madrid</a>
        </div>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/dubliners-match-screens-room-480.webp')} 480w, ${withBase('/images/dubliners-match-screens-room-768.webp')} 768w, ${withBase('/images/dubliners-match-screens-room-800.webp')} 800w, ${withBase('/images/dubliners-match-screens-room-1200.webp')} 1200w`}
          sizes="(max-width: 879px) calc(100vw - 2rem), 40vw"
        />
        <img
          src={withBase('/images/dubliners-match-screens-room-800.webp')}
          alt="Fútbol en las pantallas de la sala principal de Dubliners Madrid"
          width="1200"
          height="1600"
          loading="lazy"
          class="split-photo"
        />
      </picture>
    </div>
  </section>

  <!-- 4. Próximos partidos (solo agenda confirmada) -->
  <section class="section" id="proximos-partidos">
    <div class="container">
      <div class="section-head">
        <h2>Próximos partidos</h2>
        <a href={withBase('/es/partidos/')} data-track-event="whats_on_cta_click">Agenda completa →</a>
      </div>
      <HomeFixtureCards lang="es" />
    </div>
  </section>

  <!-- 5. Guías de deporte y carta (enlaces organizados) -->
  <section class="section band" id="guias-deporte">
    <div class="container">
      <LinkHub
        label="Guías de deporte y carta"
        groups={[
          {
            title: 'Fútbol y rugby',
            id: 'futbol-rugby',
            items: [
              { href: '/es/premier-league-pub-madrid/', label: 'Premier League', note: 'Fútbol inglés cada fin de semana' },
              { href: '/es/champions-league-bar-madrid/', label: 'Champions League', note: 'Noches europeas en nuestras pantallas' },
              { href: '/es/bar-deportivo-madrid/', label: 'Bar deportivo en Madrid', note: 'Pantallas, deportes y cómo funciona' },
              { href: '/es/rugby-irlanda-madrid/', label: 'Rugby de Irlanda en Madrid', note: 'Test matches de noviembre' },
            ],
          },
          {
            title: 'NFL y deportes americanos',
            id: 'nfl-deportes-americanos',
            items: [
              { href: '/es/nfl-madrid/', label: 'Ver NFL en Madrid', note: 'Bar NFL Madrid · pantallas del domingo' },
              { href: '/es/donde-ver-nfl-madrid/', label: 'Dónde ver la NFL en Madrid', note: 'Pub irlandés junto a Puerta del Sol' },
            ],
          },
          {
            title: 'Comida y bebida',
            id: 'comida-bebida',
            intro: 'Comida de pub para acompañar el partido y bebidas en barra.',
            items: [{ href: '/es/carta/', label: 'Carta' }],
          },
          {
            title: 'Cuando Plaza Mayor está mojada',
            items: [
              { href: '/es/pinta-interior-cuando-plaza-mayor-esta-mojada/', label: 'Pinta interior lejos de la plaza mojada', note: 'Sala irlandesa cubierta, Espoz y Mina 7' },
            ],
          },
          {
            title: 'Después del Prado',
            items: [
              { href: '/es/desde-las-escaleras-del-prado-a-espoz-mina-7/', label: 'Desde las escaleras del Prado a Espoz y Mina 7', note: 'Paseo por Letras hasta este pub irlandés' },
            ],
          },
          {
            title: 'Primera noche en Madrid',
            items: [
              { href: '/es/ingles-en-barra-despues-de-aterrizar/', label: 'Inglés en barra después de aterrizar', note: 'Pinta irlandesa junto a Sol antes del hotel' },
            ],
          },
          {
            title: 'Después del teatro en Gran Vía',
            items: [
              { href: '/es/bajada-del-telon-gran-via-luego-espoz-mina-7/', label: 'Bajó el telón, luego Espoz y Mina 7', note: 'Gran Vía hacia Sol hasta este pub irlandés' },
            ],
          },
          {
            title: 'Si pediste soccer',
            items: [
              { href: '/es/si-pediste-soccer-futbol-cerca-de-sol/', label: 'Soccer cerca de Sol', note: 'Fútbol en pantalla en este pub irlandés' },
            ],
          },
          {
            title: 'Martes en la sastrería',
            items: [
              { href: '/es/martes-en-la-sastreria-barragan-junto-a-sol/', label: 'Sala Barragán junto a Sol', note: 'Pinta irlandesa entre semana bajo el techo pintado' },
            ],
          },
          {
            title: 'Cumpleaños junto a Sol',
            items: [
              { href: '/es/mesa-cumpleanos-idiomas-mezclados-junto-a-sol/', label: 'Mesa cumpleaños, idiomas mezclados', note: 'Brindis en grupo en Espoz y Mina 7' },
            ],
          },
          {
            title: 'Antes de clase mañana',
            items: [
              { href: '/es/pinta-de-tarde-antes-de-clase-manana-junto-a-sol/', label: 'Pinta de tarde junto a Sol', note: 'Pausa Erasmus, pub irlandés' },
            ],
          },
          {
            title: 'Domingo sin entrada',
            items: [
              { href: '/es/domingo-sin-entrada-estadio-junto-a-sol/', label: 'Sin entrada al estadio, junto a Sol', note: 'Pantallas cuando hay listado' },
            ],
          },
          {
            title: 'Desde Palacio Real y Ópera',
            items: [
              { href: '/es/paseo-palacio-real-opera-hasta-espoz-mina-7/', label: 'Paseo palacio y Ópera a Espoz y Mina 7', note: 'Oeste de Sol → este pub irlandés' },
            ],
          },
        ]}
      />
    </div>
  </section>

  <!-- 6. Novedades (promociones y eventos temporales) -->
  <section class="section band-gold" id="novedades">
    <div class="container">
      <div>
        <h2>Novedades</h2>
        <h3>Los miércoles, chupitos a 1 €</h3>
        <p>
          Todos los miércoles: chupitos a 1 € en el pub. Pregunta en barra al llegar.
        </p>
        <a class="btn btn-gold" href={withBase('/es/miercoles-chupitos-1-euro/')}>Miércoles chupitos a 1 €</a>
        <LinkHub
          heading="h3"
          compact
          groups={[
            {
              title: 'Próximamente',
              until: '2026-11-15',
              items: [
                { href: '/es/oktoberfest-madrid-2026/', label: 'Temporada de Oktoberfest en Madrid', note: '22 oct–15 nov · cerveza y deporte de jueves a domingo', until: '2026-11-15' },
                { href: '/de/oktoberfest-madrid-2026/', label: 'Oktoberfest-Zeit in Madrid', note: 'En alemán', hreflang: 'de', lang: 'de', until: '2026-11-15' },
              ],
            },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- 4. El local -->
  <section class="section">
    <div class="container">
      <h2>El local</h2>
      <div class="photo-grid">
        {[
          { src: 'window-display', alt: 'Escaparate vintage delante de Dubliners', w: 1600, h: 902 },
          { src: 'window-display-2', alt: 'Detalle del escaparate en Dubliners', w: 1600, h: 902 },
        ].map(({ src, alt, w, h }) => (
          <picture>
            <source
              type="image/webp"
              srcset={`${withBase(`/images/${src}-480.webp`)} 480w, ${withBase(`/images/${src}-768.webp`)} 768w, ${withBase(`/images/${src}-sm.webp`)} 800w, ${withBase(`/images/${src}.webp`)} 1600w`}
              sizes="(max-width: 799px) calc(50vw - 1.5rem), 25vw"
            />
            <img src={withBase(`/images/${src}.jpg`)} alt={alt} width={w} height={h} loading="lazy" decoding="async" />
          </picture>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Historia (más abajo) -->
  <section class="section band home-about" id="nuestro-local">
    <div class="container">
      <div class="home-about__copy prose">
        <h2>Nuestro local · un sitio con historia</h2>
        <p>
          Antes de Dubliners, este espacio albergó la histórica sastrería Barragán, cuya actividad comenzó en 1885.
          Parte de su estructura y decoración original todavía se conserva, incluida la característica pintura del techo.
        </p>
        <p class="brand-line"><strong>Donde antes se cosían trajes, hoy se tejen historias.</strong></p>
        <p>
          <a href={withBase('/es/sobre-dubliners/')}>Descubre nuestra historia</a>
        </p>
      </div>
      <figure class="home-mural">
        <picture>
          <source
            type="image/webp"
            srcset={`${withBase('/images/mural-hero-480.webp')} 480w, ${withBase('/images/mural-hero-768.webp')} 768w, ${withBase('/images/mural-hero-sm.webp')} 900w, ${withBase('/images/mural-hero-1200.webp')} 1200w, ${withBase('/images/mural-hero.webp')} 1872w`}
            sizes="(max-width: 899px) calc(100vw - 2rem), 55vw"
          />
          <img
            class="home-mural__img"
            src={withBase('/images/mural-hero.jpg')}
            alt="Pintura histórica del techo de Dubliners Madrid"
            width="1872"
            height="1056"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="home-mural__cap">El techo pintado — resto de la antigua sastrería Barragán</figcaption>
      </figure>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="section band">
    <div class="container prose">
      <h2>Respuestas rápidas</h2>
      <div class="faq">
        <details>
          <summary>¿Cuál es el horario?</summary>
          <p>{hoursSummary('es')}.</p>
        </details>
        <details>
          <summary>¿Estáis cerca de Puerta del Sol?</summary>
          <p>
            Sí — estamos en Calle de Espoz y Mina 7, a un paseo corto de Puerta del Sol.
          </p>
        </details>
        <details>
          <summary>¿Ponéis deportes en directo?</summary>
          <p>
            Sí — fútbol importante, NFL, NBA, rugby, Fórmula 1 y tenis cuando estén confirmados.
            Consulta <a href={withBase('/es/partidos/')}>Partidos</a> para la agenda de esta semana.
          </p>
        </details>
        <details>
          <summary>¿Sois un pub irlandés y un bar deportivo?</summary>
          <p>
            Sí — Dubliners es un pub irlandés y un bar deportivo a un paso de Puerta del Sol, Espoz y Mina 7.
            Bar irlandés en Madrid, fútbol y NFL en pantallas. Listados con nombre: <a href={withBase('/es/partidos/')}>Partidos</a>.
          </p>
        </details>
        <details>
          <summary>¿Puedo ver la NFL en Madrid aquí?</summary>
          <p>
            Sí — Dubliners es un bar NFL en Madrid cerca de Puerta del Sol. La NFL del domingo va EN DIRECTO en nuestras pantallas cuando está en Partidos.
            <a href={withBase('/es/nfl-madrid/')}>Ver NFL en Madrid</a>.
          </p>
        </details>
        <details>
          <summary>¿Cómo llego desde Metro Sol?</summary>
          <p>
            A un paseo corto de Puerta del Sol. Metro Sol (L1, L2, L3) o Sevilla (L2).
            Dirección: {SITE.address}, {SITE.postal}.
            <a href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Abrir Cómo llegar</a>.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- 8. Dónde estamos -->
  <section class="section">
    <div class="container split">
      <div>
        <h2 id="find-us">FIND US · Dónde estamos</h2>
        <p>
          Calle de Espoz y Mina 7, 28012 Madrid — a un paseo de Sol.
          Metro: Sol o Sevilla.
        </p>
        <p>
          ¿Estudias en Madrid? Mira nuestras
          <a href={withBase('/es/estudiantes-internacionales/')}>noches para estudiantes y Erasmus</a>.
        </p>
        <picture>
          <source
            type="image/webp"
            srcset={`${withBase('/images/facade-480.webp')} 480w, ${withBase('/images/facade-768.webp')} 768w, ${withBase('/images/facade-sm.webp')} 800w, ${withBase('/images/facade.webp')} 1280w`}
            sizes="(max-width: 879px) calc(100vw - 2rem), 45vw"
          />
          <img
            src={withBase('/images/facade.jpg')}
            alt="Fachada de Dubliners en Calle de Espoz y Mina"
            width="1280"
            height="720"
            loading="lazy"
            class="split-photo landscape"
            style="margin-bottom:1rem"
          />
        </picture>
        <CtaRow lang="es" />
      </div>
      <div class="map-frame">
        <MapEmbed lang="es" title="Mapa a Dubliners Madrid" referrerpolicy="no-referrer-when-downgrade" />
      </div>
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
