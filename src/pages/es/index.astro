---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, withBase } from '../../site';

const title = 'Dubliners Madrid | Pub irlandés cerca de Puerta del Sol';
const description =
  'Pub irlandés en Calle de Espoz y Mina 7, a un paso de Puerta del Sol. Pantallas indoor para fútbol en directo, ambiente internacional y miércoles con chupitos a 1 €. Llama al +34 915 32 79 56.';
---

<BaseLayout title={title} description={description} path="/es/" lang="es" ogImage="/images/mural-hero.jpg">
  <section class="hero-artwork" aria-label="Mural del techo">
    <picture>
      <source
        type="image/webp"
        srcset={`${withBase('/images/mural-hero-sm.webp')} 900w, ${withBase('/images/mural-hero.webp')} 1872w`}
        sizes="100vw"
      />
      <img
        class="hero-artwork__img"
        src={withBase('/images/mural-hero.jpg')}
        alt="Mural clásico del techo en Dubliners Irish Pub Madrid"
        width="1872"
        height="1056"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </section>

  <div class="home-rail">
    <div class="home-rail__inner">
      <nav class="home-rail__links" aria-label="Enlaces rápidos">
        <a href={withBase('/es/partidos/')}>Partidos</a>
        <span class="home-rail__dot" aria-hidden="true">·</span>
        <a href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
      </nav>
      <a class="home-wed" href={withBase('/es/miercoles-chupitos-1-euro/')}>
        <span class="home-wed__day">MIÉRCOLES</span>
        <span class="home-wed__price"><span class="home-wed__euro">€1</span> <span class="home-wed__shots">CHUPITOS</span></span>
      </a>
    </div>
  </div>

  <section class="section home-intro">
    <div class="container">
      <span class="badge">Cerca de Puerta del Sol · Madrid Centro</span>
      <h1>Tu rincón irlandés en el corazón de Madrid</h1>
      <p class="lead">
        Dubliners está en Calle de Espoz y Mina 7 — a un paseo corto de Puerta del Sol.
        Ambiente cálido, público internacional y pantallas para las noches de partido.
        Entra cuando quieras. Sin reserva.
      </p>
      <p class="nap-line">
        <strong>{SITE.address}</strong>, {SITE.postal} · <a href={SITE.phoneHref}>{SITE.phone}</a>
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div>
        <h2>Ambiente para quedarte</h2>
        <p>
          Madera oscura, pints de verdad y esa energía fácil de Sol: locales, viajeros y gente de fuera
          en la misma sala. Un pub irlandés indoor pensado tanto para conversar como para el pitido inicial.
        </p>
        <p>
          Ven a media semana, un miércoles de estudiantes o una noche de fútbol. Te vas cuando quieras —
          somos walk-in, no hay mesa que reservar.
        </p>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/bar-interior-sm.webp')} 800w, ${withBase('/images/bar-interior.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img
          src={withBase('/images/bar-interior.jpg')}
          alt="Interior del bar con suelo de damero y mural en Dubliners Madrid"
          width="1400"
          height="788"
          loading="lazy"
          class="split-photo landscape"
        />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Deporte en directo en pantallas</h2>
        <p>
          Premier League, Champions League, LaLiga, Seis Naciones, Fórmula 1, NFL y NBA —
          cuando se echan aquí. Mira <a href={withBase('/es/partidos/')}>Partidos</a> o pregunta en barra.
        </p>
        <div class="card-grid cols-3" style="margin-top:1rem">
          <article class="card">
            <h3>Noches de partido</h3>
            <p>Pantallas indoor en el centro. Llega un poco antes en los partidos grandes.</p>
            <a href={withBase('/es/ver-futbol-madrid/')}>Ver fútbol →</a>
          </article>
          <article class="card">
            <h3>Bar deportivo cerca de Sol</h3>
            <p>A un paso del Metro Sol — ideal si tu hotel ya está en el centro.</p>
            <a href={withBase('/es/bar-deportivo-madrid/')}>Bar deportivo →</a>
          </article>
          <article class="card">
            <h3>Partidos de la semana</h3>
            <p>Hoy y esta semana, cuando tenemos horarios listos para compartir.</p>
            <a href={withBase('/es/partidos/')}>Partidos →</a>
          </article>
        </div>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img
          src={withBase('/images/screens-sports.jpg')}
          alt="Televisión grande y proyector para deporte en directo en Dubliners Madrid"
          width="1400"
          height="788"
          loading="lazy"
          class="split-photo landscape"
        />
      </picture>
    </div>
  </section>

  <section class="section band-gold">
    <div class="container split reverse">
      <div>
        <span class="badge">Todos los miércoles</span>
        <h2>Miércoles: chupitos a 1 €</h2>
        <p>
          El clásico de media semana para Erasmus y noches internacionales — chupitos a 1 € en Dubliners
          y, solo los miércoles, Four Corner After Party en Calle Victoria 6 hasta las 05:30.
        </p>
        <p>Sala animada, solo walk-in. Pregunta al equipo por la promo al llegar.</p>
        <a class="btn btn-gold" href={withBase('/es/miercoles-chupitos-1-euro/')}>Noches de miércoles →</a>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/interior-vert-sm.webp')} 506w, ${withBase('/images/interior-vert.webp')} 900w`}
          sizes="(max-width: 880px) 100vw, 35vw"
        />
        <img
          src={withBase('/images/interior-vert.jpg')}
          alt="Entrada a la zona de mesas con neones y televisiones en Dubliners Madrid"
          width="900"
          height="1600"
          loading="lazy"
          class="split-photo tall"
        />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>¿Viajas por fútbol?</h2>
      <p>
        Si llegas desde otra ciudad de España, Europa o más lejos, Sol es una base cómoda —
        y Dubliners queda a dos minutos de la plaza.
      </p>
      <div class="card-grid">
        <a class="card card-link" href={withBase('/es/premier-league-pub-madrid/')}>
          <h3>Pub Premier League</h3>
          <p>Fútbol inglés los fines de semana cuando la PL está en pantallas.</p>
        </a>
        <a class="card card-link" href={withBase('/es/champions-league-bar-madrid/')}>
          <h3>Bar Champions League</h3>
          <p>Noches europeas en el centro de Madrid.</p>
        </a>
        <a class="card card-link" href={withBase('/es/bar-futbol-puerta-del-sol/')}>
          <h3>Cerca de Puerta del Sol</h3>
          <p>Cómo llegar desde la plaza y hoteles del centro.</p>
        </a>
        <a class="card card-link" href={withBase('/es/estudiantes-internacionales/')}>
          <h3>Ambiente internacional</h3>
          <p>Punto de encuentro fácil para estudiantes y viajeros.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Dentro y fuera</h2>
      <div class="photo-grid">
        {[
          { src: 'facade', alt: 'Fachada de Dubliners con neón verde y banderas irlandesas cerca de Sol', w: 1280, h: 720 },
          { src: 'bar-interior', alt: 'Barra y suelo de damero en Dubliners Madrid', w: 1400, h: 788 },
          { src: 'screens-sports', alt: 'Pantallas deportivas y proyector en Dubliners Irish Pub', w: 1400, h: 788 },
          { src: 'window-display', alt: 'Escaparate vintage delante de Dubliners Irish Pub Madrid', w: 1600, h: 902 },
          { src: 'window-display-2', alt: 'Caja de Jameson y antigüedades en el escaparate de Dubliners', w: 1600, h: 902 },
        ].map(({ src, alt, w, h }) => (
          <picture>
            <source srcset={withBase(`/images/${src}.webp`)} type="image/webp" />
            <img src={withBase(`/images/${src}.jpg`)} alt={alt} width={w} height={h} loading="lazy" />
          </picture>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Encuéntranos</h2>
        <p>
          Calle de Espoz y Mina 7, 28012 Madrid — a un paseo corto de Puerta del Sol.
          Metro: Sol o Sevilla.
        </p>
        <picture>
          <source
            type="image/webp"
            srcset={`${withBase('/images/facade-sm.webp')} 800w, ${withBase('/images/facade.webp')} 1280w`}
            sizes="(max-width: 880px) 100vw, 45vw"
          />
          <img
            src={withBase('/images/facade.jpg')}
            alt="Fachada de Dubliners Irish Pub en Calle de Espoz y Mina, Madrid"
            width="1280"
            height="720"
            loading="lazy"
            class="split-photo landscape"
            style="margin-bottom:1rem"
          />
        </picture>
        <CtaRow lang="es" />
      </div>
      <div class="map-frame">
        <iframe title="Mapa a Dubliners Madrid" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={SITE.mapsEmbed}></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
