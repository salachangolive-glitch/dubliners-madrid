---
import MapEmbed from '../../components/MapEmbed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaRow from '../../components/CtaRow.astro';
import LinkHub from '../../components/LinkHub.astro';
import HomeFixtureCards from '../../components/HomeFixtureCards.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import { SITE, withBase } from '../../site';
import { hoursSummary } from '../../data/hours';

import { madridToday } from '../../data/fixtures';
import FourBarsMeet from '../../components/FourBarsMeet.astro';
import FanWeekendCtas from '../../components/FanWeekendCtas.astro';
import { isFanWeekendLive } from '../../data/fourBars';
const todayKey = madridToday();
const fanWeekend = isFanWeekendLive();
const title = 'Pub irlandés Madrid cerca de Sol | Bar deportivo, NFL y rugby — Dubliners';
const description =
  'Pub irlandés y bar deportivo en la antigua sastrería Barragán (1885), junto a Puerta del Sol: fútbol de Premier League, Champions League y LaLiga, NFL y rugby en nuestras pantallas, ambiente internacional, desde las 12:00.';
---

<BaseLayout title={title} description={description} path="/es/" lang="es" ogImage="/images/bar-interior.jpg" website>
  <!-- 1. Hero -->
  <section class="hero-photo-band" aria-label="Interior del bar">
    <picture>
      <source
        type="image/webp"
        srcset={`${withBase('/images/facade-queue-480.webp')} 480w, ${withBase('/images/facade-queue-sm.webp')} 640w, ${withBase('/images/facade-queue-768.webp')} 768w, ${withBase('/images/facade-queue-1200.webp')} 1200w, ${withBase('/images/facade-queue.webp')} 1320w`}
        sizes="100vw"
      />
      <img
        class="hero-photo-band__img"
        src={withBase('/images/facade-queue.jpg')}
        alt="Gente haciendo cola en la puerta de Dubliners por la noche, Espoz y Mina 7, junto a Puerta del Sol"
        width="1320"
        height="986"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </section>

  <div class="home-identity">
    <div class="home-identity__inner">
      <p class="home-identity__name">Dubliners Madrid</p>
      <p class="home-identity__tag">Pub irlandés y bar deportivo en el corazón de Madrid</p>
    </div>
  </div>

  <!-- 2. Presentación (breve y natural; las guías van en las secciones de abajo) -->
  <section class="section home-intro">
    <div class="container">
      <h1>Un pub irlandés cerca de Puerta del Sol, en el corazón de Madrid</h1>
      <p class="lead">
        Dubliners es un pub irlandés a un paso de Puerta del Sol, en la antigua sastrería Barragán (1885): fútbol de Premier League, Champions League y LaLiga, NFL los domingos y test matches de rugby en nuestras pantallas, personal que habla inglés y ambiente internacional, abierto cada día desde las 12:00.
      </p>
      <p class="home-intro__text">
        Pasa a tomar algo, queda con amigos o ven a ver el partido en un bar deportivo cerca de Puerta del Sol. Aquí se juntan madrileños, visitantes y la gente internacional de la ciudad — un bar irlandés en Madrid que también funciona como bar NFL Madrid los domingos — en un local que aún conserva el techo pintado de una sastrería del siglo XIX.
      </p>
      <p class="nap-line">
        <strong>{SITE.address}</strong>, {SITE.postal} · Metro Sol (L1, L2, L3) o Sevilla (L2)
      </p>
      {fanWeekend ? <FanWeekendCtas lang="es" findHref="#find-us" /> : <CtaRow lang="es" showWednesday={false} />}
    </div>
  </section>

  {fanWeekend && <FourBarsMeet lang="es" />}

  <!-- 2b. Fútbol (DG 27 oct: fútbol + público internacional) -->
  <section class="section" id="futbol">
    <div class="container prose">
      <h2>Fútbol cerca de Sol: Premier League, Champions League y LaLiga</h2>
      <p>
        El fútbol es lo que más llena el local casi todas las semanas. Los fines de semana de Premier League — un pub de Premier League en Madrid para el fútbol inglés —, las noches de Champions League y los grandes partidos de LaLiga
        van en nuestras pantallas, con el público internacional de Madrid viéndolos juntos: estudiantes Erasmus e internacionales, visitantes alojados cerca de Sol
        y aficionados de fuera que siguen a su equipo. Todos los partidos que anunciamos están confirmados y en hora de Madrid.
      </p>
      <ul>
        <li><a href={withBase('/es/premier-league-pub-madrid/')}>Pub de Premier League en Madrid</a> — fútbol inglés, sábado y domingo</li>
        <li><a href={withBase('/es/champions-league-bar-madrid/')}>Champions League en Madrid</a> — noches europeas junto a Sol</li>
        <li>LaLiga — los partidos principales de cada jornada; consulta <a href={withBase('/es/partidos/')} data-track-event="whats_on_cta_click">Partidos</a> para esta semana</li>
      </ul>
    </div>
  </section>

  <!-- 3. Deporte en directo -->
  <section class="section band" id="deportes-en-directo">
    <div class="container split">
      <div>
        <h2>Deporte en directo</h2>
        <p>
          Fútbol, NFL, rugby, NBA y más en nuestras pantallas. Solo anunciamos lo confirmado, siempre en hora de Madrid, y en barra te dicen qué se emite esta noche.
          Este bar deportivo en Madrid, junto a Puerta del Sol, es también donde vemos la NFL en Madrid.
        </p>
        {todayKey <= '2026-10-31' && (
          <p data-show-until="2026-10-31"><strong>Halloween en Dubliners: sábado 31 de octubre, desde las 19:00.</strong> Disfraces, decoración y música. <a href={withBase('/es/halloween-madrid-2026/')}>Halloween en Madrid junto a Sol</a></p>
        )}
        {todayKey <= '2026-11-08' && (
          <p data-show-until="2026-11-08">
            Deporte en directo este fin de semana (7–8 nov, hora de Madrid): sábado Premier League (Leeds–Tottenham 13:30, Arsenal–Hull y Fulham–Newcastle 16:00, Forest–Man City 18:30) y rugby España–Uruguay 16:00 · domingo NFL Bengals–Falcons 15:30, Premier League desde las 15:00 y Atlético–Barcelona 21:00 — abrimos desde las 12:00. Confirmados en pantallas; si coinciden, pantallas distintas.
          </p>
        )}
        <div class="cta-row">
          <a class="btn btn-gold" data-track-event="whats_on_cta_click" href={withBase('/es/partidos/')}>Partidos de esta semana</a>
          <a class="btn btn-secondary" href={withBase('/es/bar-deportivo-madrid/')}>Bar deportivo Madrid</a>
          <a class="btn btn-secondary" href={withBase('/es/nfl-madrid/')}>Bar NFL Madrid</a>
        </div>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/dubliners-match-screens-room-480.webp')} 480w, ${withBase('/images/dubliners-match-screens-room-768.webp')} 768w, ${withBase('/images/dubliners-match-screens-room-800.webp')} 800w, ${withBase('/images/dubliners-match-screens-room-1200.webp')} 1200w`}
          sizes="(max-width: 879px) calc(100vw - 2rem), 40vw"
        />
        <img
          src={withBase('/images/dubliners-match-screens-room-800.webp')}
          alt="Fútbol en las pantallas de la sala principal de Dubliners Madrid"
          width="1200"
          height="1600"
          loading="lazy"
          class="split-photo"
        />
      </picture>
    </div>
  </section>

  <!-- 4. Próximos partidos (solo agenda confirmada) -->
  <section class="section" id="proximos-partidos">
    <div class="container">
      <div class="section-head">
        <h2>Próximos partidos</h2>
        <a href={withBase('/es/partidos/')} data-track-event="whats_on_cta_click">Agenda completa →</a>
      </div>
      <HomeFixtureCards lang="es" />
    </div>
  </section>

  <!-- 5. Guías de deporte y carta (enlaces organizados) -->
  <section class="section band" id="guias-deporte">
    <div class="container">
      <LinkHub
        label="Guías de deporte y carta"
        groups={[
          {
            title: 'Fútbol y rugby',
            id: 'futbol-rugby',
            items: [
              { href: '/es/premier-league-pub-madrid/', label: 'Premier League', note: 'Fútbol inglés cada fin de semana' },
              { href: '/es/champions-league-bar-madrid/', label: 'Champions League', note: 'Noches europeas en nuestras pantallas' },
              { href: '/es/bar-deportivo-madrid/', label: 'Bar deportivo en Madrid', note: 'Pantallas, deportes y cómo funciona' },
              { href: '/es/rugby-irlanda-madrid/', label: 'Rugby de Irlanda en Madrid', note: 'Test matches de noviembre' },
            ],
          },
          {
            title: 'NFL y deportes americanos',
            id: 'nfl-deportes-americanos',
            items: [
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'VER LOS CUATRO BARES', note: 'Cuatro bares junto a Sol, 7–8 nov', until: '2026-11-08' },
              { href: '/es/del-hotel-sol-primera-calle-domingo-victoria-6/', label: 'Hotel en Sol: primera calle del domingo es Victoria 6', note: 'Llegad antes de las 14:00, luego tres puertas hermanas', until: '2026-11-08' },
              { href: '/es/despierta-sol-bloque-premier-que-puerta/', label: 'Despertar: Premier 15:00 — qué puerta del domingo', note: 'Luego United 17:30 · cuatro puertas junto a Sol', until: '2026-11-08' },
              { href: '/es/barajas-madrugada-a-sol-hasta-1400/', label: 'Aterrizaje Barajas ~03:00: taxi a Sol', note: 'Primera puerta útil Four Corner 14:00, luego tres hermanas', until: '2026-11-08' },
              { href: '/es/dos-calles-todo-el-dia-premier-nfl-atleti/', label: 'Dos calles todo el día: Premier, NFL, Atleti', note: 'Victoria + Espoz y Mina · no partáis la ciudad', until: '2026-11-08' },
              { href: '/es/primer-metro-a-sol-domingo-estacion-a-puerta/', label: 'Primer Metro a Sol el domingo: de la estación a la puerta', note: 'Victoria 6 / Espoz y Mina / Matheu · cuando arranque el Metro', until: '2026-11-08' },
              { href: '/es/brighton-ipswich-1500-sol-sin-liverpool-chelsea-united/', label: 'Sin Liverpool/Chelsea/United: Brighton e Ipswich 15:00', note: 'Fútbol inglés más tranquilo · cuatro bares · preguntad qué pantalla', until: '2026-11-08' },
              { href: '/es/plaza-mayor-soportales-cuesta-abajo-puertas-sol-antes-1400/', label: 'Soportales de Plaza Mayor cuesta abajo antes de las 14:00', note: 'Ruta turística · metros + Maps · plaza, no recinto de aficionados', until: '2026-11-08' },
              { href: '/es/espoz-mina-7-dos-puertas-reparte-premier-luego-nfl/', label: 'Espoz y Mina 7: dos puertas, un número', note: 'Premier 15:00 frente a NFL después · luego Matheu + Victoria 6', until: '2026-11-08' },
              { href: '/es/atocha-cercanias-una-parada-a-sol-puertas-antes-1400/', label: 'Atocha Cercanías: una parada a Sol antes de las 14:00', note: 'C3/C4 tren, no Metro · vestíbulo a las cuatro puertas', until: '2026-11-08' },
              { href: '/es/galeria-acristalada-matheu-4-primera-pinta-antes-saque-domingo/', label: 'Pasaje de Matheu 4: galería cubierta, primera pinta', note: 'Techo de cristal antes de las 15:00 · luego Espoz y Mina + Victoria 6', until: '2026-11-08' },
              { href: '/es/callao-preciados-compras-sur-puertas-sol-antes-1400/', label: 'Callao–Preciados: compras al sur, cuatro puertas antes de las 14:00', note: 'Calle comercial · de bolsas a pinta · ~3 h a Victoria 6', until: '2026-11-08' },
              { href: '/es/mesa-oreillys-tres-horas-hasta-victoria-6-1400/', label: 'Tres horas libres: mesa en O’Reilly’s hasta las 14:00', note: 'Sentaos en Matheu 4 · luego salto a Victoria 6 + Espoz y Mina 7', until: '2026-11-08' },
              { href: '/es/ultima-hora-antes-four-corner-1400/', label: 'Última hora: O’Reilly’s y Dubliners ahora, andad a las 14:00', note: 'Habitual 11:30 / 12:00 ahora · Four Corner + puerta habitual de O’Connell’s', until: '2026-11-08' },
              { href: '/es/tirso-anton-martin-norte-puertas-sol-antes-1400/', label: 'Tirso / Antón Martín: al norte a las cuatro puertas antes de las 14:00', note: 'L1 al sur de Sol · Magdalena / Cruz · metros + Maps', until: '2026-11-08' },
              { href: '/es/salida-bernabeu-a-las-cuatro-puertas-sol/', label: 'Salida del Bernabéu a las cuatro puertas abiertas de Sol', note: 'Google Maps desde el estadio · Four Corner está abierto', until: '2026-11-08' },
              { href: '/es/despues-madrid-game-seguir-cuatro-puertas-abiertas/', label: 'Después del Madrid Game: cuatro puertas abiertas, NFL luego Atleti', note: 'Punto de encuentro · NFL 19:00 luego 21:00 · preguntad qué echan', until: '2026-11-08' },
              { href: '/es/ya-en-sol-durante-madrid-game-cuatro-puertas-abiertas/', label: 'Ya en Sol durante el Madrid Game: cuatro puertas abiertas AHORA', note: 'Quedada en la ciudad mientras el estadio sigue · las cuatro puertas abiertas AHORA', until: '2026-11-08' },
              { href: '/es/bengals-falcons-reparte-dos-puertas-espoz-mina-7/', label: 'Bengals y Falcons: dos puertas en Espoz y Mina 7', note: 'Mismo número, dos CID · las cuatro puertas abiertas AHORA · preguntad qué echan', until: '2026-11-08' },
              { href: '/es/quedarse-despues-united-villa-1730-cuatro-puertas-abiertas/', label: 'Después de United–Villa 17:30: quedarse en las cuatro puertas abiertas', note: 'NFL 19:00 luego Atleti 21:00 · las cuatro puertas abiertas AHORA', until: '2026-11-08' },
              { href: '/es/metro-tarde-gran-via-sevilla-a-puertas-sol-abiertas/', label: 'Metro de tarde: Gran Vía o Sevilla a Victoria 6', note: 'Llegada de domingo · cuatro puertas abiertas AHORA · Espoz y Mina 7', until: '2026-11-08' },
              { href: '/es/nfl-en-pantalla-ahora-1900-luego-saltar-atleti-2100/', label: 'NFL en pantalla AHORA desde las 19:00 — luego saltar a Atleti 21:00', note: 'Ventana 19:00 en vivo · cuatro puertas abiertas AHORA · salto a las 21:00', until: '2026-11-08' },
              { href: '/es/en-plaza-sol-ultimos-metros-a-puertas-1900/', label: 'En la plaza de Sol: últimos metros a las puertas 19:00', note: 'Pavimento de la plaza · Victoria 6 / Espoz y Mina 7 / Matheu 4', until: '2026-11-08' },
              { href: '/es/atleti-barca-saque-ahora-cuatro-puertas-sol-abiertas/', label: 'Atleti–Barça saque AHORA en las cuatro puertas abiertas de Sol', note: 'Silbato 21:00 · cuatro puertas abiertas AHORA · preguntad qué echan', until: '2026-11-08' },
              { href: '/es/quedarse-despues-atleti-2100-nfl-tarde-2205-2225/', label: 'Quedarse después de las 21:00: NFL 22:05 / 22:25 en las mismas cuatro puertas', note: 'No os vayáis · 22:05 luego 22:25 · cuatro puertas abiertas AHORA', until: '2026-11-08' },
              { href: '/es/nfl-tarde-en-pantalla-ahora-2205-2225-cuatro-puertas-sol/', label: 'NFL de después en pantalla AHORA: 22:05 / 22:25 en las cuatro puertas abiertas de Sol', note: 'Hora de ahora · cuatro puertas abiertas AHORA · preguntad qué echan', until: '2026-11-08' },
              { href: '/es/ultimo-metro-cercanias-salida-sol-despues-2300/', label: 'Último Metro / Cercanías de salida de Sol después de las 23:00', note: 'Salida desde Victoria 6 / Espoz y Mina 7 / Matheu 4', until: '2026-11-08' },
              { href: '/es/metro-sol-2100-que-puerta-sabado/', label: 'Metro Sol a las 21:00', note: 'Cuál de las tres puertas del sábado + minutos a pie', until: '2026-11-07' },
              { href: '/es/turistas-ingleses-horas-sabado-hasta-premier/', label: 'Turistas ingleses: el sábado hasta las 15:00', note: 'Luego pila de cuatro bares desde Victoria 6', until: '2026-11-08' },
              { href: '/es/saltar-dos-calles-ultima-pinta-despues-derbi/', label: 'Última pinta después de Valencia–RM', note: 'Tres puertas en dos calles + metros a pie', until: '2026-11-07' },
              { href: '/es/quince-horas-sol-hasta-four-corner-1400/', label: 'Reloj de madrugada: 15 horas hasta las 14:00', note: 'Quedarse en Sol hasta Four Corner + Premier 15:00', until: '2026-11-08' },
              { href: '/es/fin-de-semana-nfl-ya-se-vive/', label: 'Quedada 18:00–19:00', note: 'Tres bares abiertos el sábado', until: '2026-11-07' },
              { href: '/es/quedada-1800-pasaje-matheu-espoz-mina/', label: 'Quedada, orden del paseo 18:00–19:00', note: 'Pasaje de Matheu a Espoz y Mina', until: '2026-11-07' },
              { href: '/es/andar-sol-cuatro-bares-hermanos/', label: 'Andar desde Sol a los cuatro bares', note: 'Esta noche tres puertas · domingo Victoria 6', until: '2026-11-08' },
              { href: '/es/aficionados-nfl-internacionales-sol/', label: 'Aficionados NFL internacionales', note: 'Salas en inglés junto a Sol', until: '2026-11-08' },
              { href: '/es/fin-semana-nfl-madrid-en-pantalla/', label: 'Fin de semana en pantalla, sin estadio', note: 'Quedarse en Sol sábado y domingo', until: '2026-11-08' },
              { href: '/es/comida-domingo-luego-pantallas-sol/', label: 'Comida el domingo y luego pantallas', note: 'O’Reilly’s y luego Dubliners 15:30', until: '2026-11-08' },
              { href: '/es/redzone-domingo-sol-dubliners/', label: 'RedZone el domingo noche', note: 'Preguntad qué pantalla a las 19:00', until: '2026-11-08' },
              { href: '/es/four-corner-abre-domingo-1400/', label: 'Four Corner domingo 14:00', note: 'Pantallas de deporte · Victoria 6', until: '2026-11-08' },
              { href: '/es/nfl-madrid/', label: 'Ver NFL en Madrid', note: 'Bar NFL Madrid · pantallas del domingo' },
              { href: '/es/guia-domingo-nfl-madrid/', label: 'Guía del domingo NFL', note: 'Hora a hora, domingo 8 de noviembre' },
              { href: '/es/deportes-domingo-sol/', label: 'Deportes el domingo en Sol', note: 'NFL + Atlético–Barça, 8 nov', until: '2026-11-08' },
            ],
          },
          {
            title: 'Comida y bebida',
            id: 'comida-bebida',
            intro: 'Comida de pub para acompañar el partido y bebidas en barra.',
            items: [{ href: '/es/carta/', label: 'Carta' }],
          },
          {
            title: 'Cuando Plaza Mayor está mojada',
            items: [
              { href: '/es/pinta-interior-cuando-plaza-mayor-esta-mojada/', label: 'Pinta interior lejos de la plaza mojada', note: 'Sala irlandesa cubierta, Espoz y Mina 7' },
            ],
          },
          {
            title: 'Después del Prado',
            items: [
              { href: '/es/desde-las-escaleras-del-prado-a-espoz-mina-7/', label: 'Desde las escaleras del Prado a Espoz y Mina 7', note: 'Paseo por Letras hasta este pub irlandés' },
            ],
          },
          {
            title: 'Primera noche en Madrid',
            items: [
              { href: '/es/ingles-en-barra-despues-de-aterrizar/', label: 'Inglés en barra después de aterrizar', note: 'Pinta irlandesa junto a Sol antes del hotel' },
            ],
          },
          {
            title: 'Después del teatro en Gran Vía',
            items: [
              { href: '/es/bajada-del-telon-gran-via-luego-espoz-mina-7/', label: 'Bajó el telón, luego Espoz y Mina 7', note: 'Gran Vía hacia Sol hasta este pub irlandés' },
            ],
          },
          {
            title: 'Si pediste soccer',
            items: [
              { href: '/es/si-pediste-soccer-futbol-cerca-de-sol/', label: 'Soccer cerca de Sol', note: 'Fútbol en pantalla en este pub irlandés' },
            ],
          },
          {
            title: 'Martes en la sastrería',
            items: [
              { href: '/es/martes-en-la-sastreria-barragan-junto-a-sol/', label: 'Sala Barragán junto a Sol', note: 'Pinta irlandesa entre semana bajo el techo pintado' },
            ],
          },
          {
            title: 'Cumpleaños junto a Sol',
            items: [
              { href: '/es/mesa-cumpleanos-idiomas-mezclados-junto-a-sol/', label: 'Mesa cumpleaños, idiomas mezclados', note: 'Brindis en grupo en Espoz y Mina 7' },
            ],
          },
        ]}
      />
    </div>
  </section>

  <!-- 6. Novedades (promociones y eventos temporales) -->
  <section class="section band-gold" id="novedades">
    <div class="container">
      <div>
        <h2>Novedades</h2>
        <h3>Los miércoles, chupitos a 1 €</h3>
        <p>
          Todos los miércoles: chupitos a 1 € en el pub. Pregunta en barra al llegar.
        </p>
        <a class="btn btn-gold" href={withBase('/es/miercoles-chupitos-1-euro/')}>Miércoles chupitos a 1 €</a>
        <LinkHub
          heading="h3"
          compact
          groups={[
            {
              title: 'Próximamente',
              until: '2026-11-15',
              items: [
                { href: '/es/oktoberfest-madrid-2026/', label: 'Temporada de Oktoberfest en Madrid', note: '22 oct–15 nov · cerveza y deporte de jueves a domingo', until: '2026-11-15' },
                { href: '/de/oktoberfest-madrid-2026/', label: 'Oktoberfest-Zeit in Madrid', note: 'En alemán', hreflang: 'de', lang: 'de', until: '2026-11-15' },
              ],
            },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- 4. El local -->
  <section class="section">
    <div class="container">
      <h2>El local</h2>
      <div class="photo-grid">
        {[
          { src: 'window-display', alt: 'Escaparate vintage delante de Dubliners', w: 1600, h: 902 },
          { src: 'window-display-2', alt: 'Detalle del escaparate en Dubliners', w: 1600, h: 902 },
        ].map(({ src, alt, w, h }) => (
          <picture>
            <source
              type="image/webp"
              srcset={`${withBase(`/images/${src}-480.webp`)} 480w, ${withBase(`/images/${src}-768.webp`)} 768w, ${withBase(`/images/${src}-sm.webp`)} 800w, ${withBase(`/images/${src}.webp`)} 1600w`}
              sizes="(max-width: 799px) calc(50vw - 1.5rem), 25vw"
            />
            <img src={withBase(`/images/${src}.jpg`)} alt={alt} width={w} height={h} loading="lazy" decoding="async" />
          </picture>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Historia (más abajo) -->
  <section class="section band home-about" id="nuestro-local">
    <div class="container">
      <div class="home-about__copy prose">
        <h2>Nuestro local · un sitio con historia</h2>
        <p>
          Antes de Dubliners, este espacio albergó la histórica sastrería Barragán, cuya actividad comenzó en 1885.
          Parte de su estructura y decoración original todavía se conserva, incluida la característica pintura del techo.
        </p>
