---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, withBase } from '../../site';

const title = 'Dubliners Madrid | Pub irlandés cerca de Puerta del Sol';
const description =
  'Dubliners en Sol, Calle de Espoz y Mina 7. Deporte en directo, buen ambiente y chupitos a 1 € cada miércoles.';
---

<BaseLayout title={title} description={description} path="/es/" lang="es" ogImage="/images/mural-hero.jpg">
  <section class="hero-artwork" aria-label="Mural del techo">
    <picture>
      <source
        type="image/webp"
        srcset={`${withBase('/images/mural-hero-sm.webp')} 900w, ${withBase('/images/mural-hero.webp')} 1872w`}
        sizes="100vw"
      />
      <img
        class="hero-artwork__img"
        src={withBase('/images/mural-hero.jpg')}
        alt="Pintura histórica del techo de Dubliners Madrid"
        width="1872"
        height="1056"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </section>

  <div class="home-rail">
    <div class="home-rail__inner">
      <nav class="home-rail__links" aria-label="Enlaces rápidos">
        <a href={withBase('/es/partidos/')}>Partidos</a>
        <span class="home-rail__dot" aria-hidden="true">·</span>
        <a href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
      </nav>
      <a class="home-wed" href={withBase('/es/miercoles-chupitos-1-euro/')}>
        <span class="home-wed__day">MIÉRCOLES</span>
        <span class="home-wed__price"><span class="home-wed__euro">€1</span> <span class="home-wed__shots">CHUPITOS</span></span>
      </a>
    </div>
  </div>

  <section class="section home-intro">
    <div class="container">
      <span class="badge">Espoz y Mina 7 · cerca de Sol</span>
      <h1>Tu pub irlandés junto a la Puerta del Sol</h1>
      <p class="lead">
        Dubliners en Sol, Calle de Espoz y Mina 7.
        Deporte en directo, buen ambiente y chupitos a 1 € cada miércoles.
      </p>
      <p class="nap-line">
        <strong>{SITE.address}</strong>, {SITE.postal}
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Un local con historia</h2>
      <p>
        Antes de Dubliners, este espacio albergó la histórica sastrería Barragán, cuya actividad comenzó en 1885.
        Parte de su estructura y decoración original todavía se conserva, incluida la característica pintura del techo.
      </p>
      <p class="brand-line"><strong>Donde antes se cosían trajes, hoy se tejen historias.</strong></p>
      <p>
        <a href={withBase('/es/sobre-dubliners/')}>Descubre nuestra historia</a>
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div>
        <h2>El ambiente de Dubliners</h2>
        <p>
          Auténtico ambiente de pub irlandés en el centro: tomar algo, quedar con gente o ver el deporte en pantallas.
        </p>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/bar-interior-sm.webp')} 800w, ${withBase('/images/bar-interior.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img
          src={withBase('/images/bar-interior.jpg')}
          alt="Barra y suelo de damero en Dubliners"
          width="1400"
          height="788"
          loading="lazy"
          class="split-photo landscape"
        />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Deporte en las pantallas</h2>
        <p>
          Premier League, Champions League, LaLiga, Seis Naciones, Fórmula 1, NFL y NBA —
          cuando hay partido. Consulta los <a href={withBase('/es/partidos/')}>partidos de hoy</a> o pregunta en barra.
        </p>
        <div class="card-grid cols-3" style="margin-top:1rem">
          <article class="card">
            <h3>Noches de partido</h3>
            <p>Pantallas en el centro. Llega un poco antes si el partido es grande.</p>
            <a href={withBase('/es/ver-futbol-madrid/')}>Ver fútbol →</a>
          </article>
          <article class="card">
            <h3>Bar deportivo</h3>
            <p>Metro Sol o Sevilla — cómodo si ya estás por la zona.</p>
            <a href={withBase('/es/bar-deportivo-madrid/')}>Bar deportivo →</a>
          </article>
          <article class="card">
            <h3>Esta semana</h3>
            <p>Partidos listados cuando tenemos horarios para compartir.</p>
            <a href={withBase('/es/partidos/')}>Partidos →</a>
          </article>
        </div>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img
          src={withBase('/images/screens-sports.jpg')}
          alt="Televisión y proyector para deporte en Dubliners"
          width="1400"
          height="788"
          loading="lazy"
          class="split-photo landscape"
        />
      </picture>
    </div>
  </section>

  <section class="section band-gold">
    <div class="container split reverse">
      <div>
        <span class="badge">Todos los miércoles</span>
        <h2>MIÉRCOLES · CHUPITOS A 1 €</h2>
        <p>
          Chupitos a 1 € en Dubliners. Solo los miércoles, la noche puede seguir en Four Corner After Party,
          Calle Victoria 6, hasta las 05:30.
        </p>
        <p>Pregunta en barra por la promo al llegar.</p>
        <a class="btn btn-gold" href={withBase('/es/miercoles-chupitos-1-euro/')}>Noches de miércoles →</a>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/interior-vert-sm.webp')} 506w, ${withBase('/images/interior-vert.webp')} 900w`}
          sizes="(max-width: 880px) 100vw, 35vw"
        />
        <img
          src={withBase('/images/interior-vert.jpg')}
          alt="Entrada a mesas con neones y pantallas en Dubliners"
          width="900"
          height="1600"
          loading="lazy"
          class="split-photo tall"
        />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>¿Estás en Madrid por el fútbol?</h2>
      <p>
        Si te mueves por Sol, estamos a unos dos minutos de la plaza.
      </p>
      <div class="card-grid">
        <a class="card card-link" href={withBase('/es/premier-league-pub-madrid/')}>
          <h3>Premier League</h3>
          <p>Fútbol inglés cuando la PL está en pantallas.</p>
        </a>
        <a class="card card-link" href={withBase('/es/champions-league-bar-madrid/')}>
          <h3>Champions League</h3>
          <p>Noches europeas en el centro.</p>
        </a>
        <a class="card card-link" href={withBase('/es/bar-futbol-puerta-del-sol/')}>
          <h3>Cerca de Puerta del Sol</h3>
          <p>A pie desde la plaza — mapa y cómo llegar.</p>
        </a>
        <a class="card card-link" href={withBase('/es/estudiantes-internacionales/')}>
          <h3>Público internacional</h3>
          <p>Punto de encuentro cerca de Sol.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>Dentro y fuera</h2>
      <div class="photo-grid">
        {[
          { src: 'facade', alt: 'Fachada de Dubliners con neón verde y banderas irlandesas', w: 1280, h: 720 },
          { src: 'bar-interior', alt: 'Barra y suelo de damero en Dubliners', w: 1400, h: 788 },
          { src: 'screens-sports', alt: 'Pantallas deportivas y proyector en Dubliners', w: 1400, h: 788 },
          { src: 'window-display', alt: 'Escaparate vintage delante de Dubliners', w: 1600, h: 902 },
        ].map(({ src, alt, w, h }) => (
          <picture>
            <source srcset={withBase(`/images/${src}.webp`)} type="image/webp" />
            <img src={withBase(`/images/${src}.jpg`)} alt={alt} width={w} height={h} loading="lazy" />
          </picture>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Dónde estamos</h2>
        <p>
          Calle de Espoz y Mina 7, 28012 Madrid — a un paseo corto de Puerta del Sol.
          Metro: Sol o Sevilla.
        </p>
        <picture>
          <source
            type="image/webp"
            srcset={`${withBase('/images/facade-sm.webp')} 800w, ${withBase('/images/facade.webp')} 1280w`}
            sizes="(max-width: 880px) 100vw, 45vw"
          />
          <img
            src={withBase('/images/facade.jpg')}
            alt="Fachada de Dubliners en Calle de Espoz y Mina"
            width="1280"
            height="720"
            loading="lazy"
            class="split-photo landscape"
            style="margin-bottom:1rem"
          />
        </picture>
        <CtaRow lang="es" />
      </div>
      <div class="map-frame">
        <iframe title="Mapa a Dubliners Madrid" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={SITE.mapsEmbed}></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
