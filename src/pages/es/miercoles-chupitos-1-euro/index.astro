---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import { SITE, withBase } from '../../../site';

const title = 'Miércoles chupitos a 1 € Madrid | Dubliners cerca de Sol';
const description =
  'Miércoles con chupitos a 1 € en Dubliners, cerca de Sol. Espoz y Mina 7. Four Corner After Party solo miércoles, Calle Victoria 6 hasta 05:30.';
---

<BaseLayout title={title} description={description} path="/es/miercoles-chupitos-1-euro/" lang="es" ogImage="/images/interior-vert.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Miércoles chupitos a 1 €" lang="es" />
        <span class="badge">Todos los miércoles</span>
        <h1>MIÉRCOLES · CHUPITOS A 1 €</h1>
        <p class="lead">
          Chupitos a 1 € en un pub irlandés a un paseo de Sol.
          Pregunta en barra al llegar.
        </p>
        <CtaRow lang="es" showWednesday={false} />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/interior-vert-sm.webp')} 506w, ${withBase('/images/interior-vert.webp')} 900w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img class="hero-photo portrait" src={withBase('/images/interior-vert.jpg')} alt="Interior de Dubliners un miércoles" width="900" height="1600" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>La promo</h3>
          <p>Chupitos a 1 € los miércoles. Pregunta en barra los detalles.</p>
        </article>
        <article class="card">
          <h3>Dónde</h3>
          <p>{SITE.address}, {SITE.postal} — Metro Sol o Sevilla.</p>
        </article>
        <article class="card">
          <h3>Horario del pub</h3>
          <p>Miércoles 12:00–02:00. Luego, si quieres, Four Corner hasta las 05:30.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Four Corner After Party — solo miércoles</h2>
      <p>
        <strong>Solo los miércoles</strong>, la noche puede seguir en Four Corner After Party,
        <strong>Calle Victoria 6</strong>, hasta las <strong>05:30</strong>.
      </p>
      <p>A pocos minutos de Dubliners — pregunta esa noche si te animas a continuar.</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Toda la noche</h2>
      <p>
        Empieza en Dubliners, mira lo que hay en pantallas y decide si Four Corner es el siguiente paso.
        También: <a href={withBase('/es/estudiantes-internacionales/')}>estudiantes internacionales</a>
        o <a href={withBase('/es/partidos/')}>Partidos</a>.
      </p>
      <div class="faq">
        <details>
          <summary>¿Hace falta entrada o lista?</summary>
          <p>No en Dubliners. Para Four Corner, pregunta esa noche.</p>
        </details>
        <details>
          <summary>¿Four Corner es todas las noches?</summary>
          <p>No — solo miércoles, Calle Victoria 6, hasta las 05:30.</p>
        </details>
        <details>
          <summary>Contacto</summary>
          <p><a href={SITE.instagram} rel="noopener noreferrer" target="_blank">{SITE.instagramHandle}</a></p>
        </details>
      </div>
      <div class="map-frame" style="margin-top:1.5rem">
        <iframe title="Mapa a Dubliners — miércoles chupitos" loading="lazy" src={SITE.mapsEmbed}></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
