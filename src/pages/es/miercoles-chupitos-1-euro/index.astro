---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import { SITE, withBase } from '../../../site';

const title = 'Miércoles chupitos a 1 € Madrid | Dubliners cerca de Sol';
const description =
  'Miércoles con chupitos a 1 € en Dubliners — promo propia del pub. Espoz y Mina 7, junto a Puerta del Sol.';
---

<BaseLayout title={title} description={description} path="/es/miercoles-chupitos-1-euro/" lang="es" ogImage="/images/interior-vert.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Miércoles chupitos a 1 €" lang="es" />
        <span class="badge">Todos los miércoles</span>
        <h1>MIÉRCOLES · CHUPITOS A 1 €</h1>
        <p class="lead">
          Chupitos a 1 € en un pub irlandés a un paseo de Sol.
          Pregunta en barra al llegar.
        </p>
        <CtaRow lang="es" showWednesday={false} />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/interior-vert-sm.webp')} 506w, ${withBase('/images/interior-vert.webp')} 900w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img class="hero-photo portrait" src={withBase('/images/interior-vert.jpg')} alt="Interior de Dubliners un miércoles" width="900" height="1600" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>La promo</h3>
          <p>Chupitos a 1 € los miércoles. Pregunta en barra los detalles.</p>
        </article>
        <article class="card">
          <h3>Dónde</h3>
          <p>{SITE.address}, {SITE.postal} — Metro Sol o Sevilla.</p>
        </article>
        <article class="card">
          <h3>Horario del pub</h3>
          <p>Miércoles 12:00–02:00 en Dubliners.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Evento aparte: Four Corner After Party</h2>
      <p>
        <strong>Four Corner no es la promo de chupitos a 1 €.</strong> Es un after-party distinto,
        en otro local: <strong>Calle Victoria 6</strong>, solo miércoles, hasta las <strong>05:30</strong>.
      </p>
      <p>Pregunta esa noche si quieres detalles — es independiente de la promo de Dubliners.</p>
      <div class="faq">
        <details>
          <summary>¿Four Corner forma parte de los chupitos a 1 €?</summary>
          <p>No. Los chupitos a 1 € son promo propia de Dubliners en Espoz y Mina 7. Four Corner es un evento aparte cerca.</p>
        </details>
        <details>
          <summary>¿Four Corner es todas las noches?</summary>
          <p>No — solo miércoles, Calle Victoria 6, hasta las 05:30. Pregunta esa noche por la entrada.</p>
        </details>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Toda la noche</h2>
      <p>
        Ven por los chupitos a 1 € de Dubliners y lo que haya en pantallas.
        También: <a href={withBase('/es/estudiantes-internacionales/')}>estudiantes internacionales</a>
        o <a href={withBase('/es/partidos/')}>Partidos</a>.
      </p>
      <div class="faq">
        <details>
          <summary>¿Hace falta entrada o lista en Dubliners?</summary>
          <p>No — entra y pregunta en barra por los chupitos a 1 €.</p>
        </details>
        <details>
          <summary>Contacto</summary>
          <p><a href={SITE.instagram} rel="noopener noreferrer" target="_blank">{SITE.instagramHandle}</a></p>
        </details>
      </div>
      <div class="map-frame" style="margin-top:1.5rem">
        <iframe title="Mapa a Dubliners — miércoles chupitos" loading="lazy" src={SITE.mapsEmbed}></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
