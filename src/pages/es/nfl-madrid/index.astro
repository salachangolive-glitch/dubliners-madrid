---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import MapEmbed from '../../../components/MapEmbed.astro';
import { withBase } from '../../../site';
const faqLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "¿Dónde y cuándo es el partido de la NFL en Madrid en 2026?", "acceptedAnswer": {"@type": "Answer", "text": "Bengals vs Falcons, domingo 8 de noviembre de 2026 a las 15:30 en el Estadio Santiago Bernabéu."}}, {"@type": "Question", "name": "¿Hace falta reservar?", "acceptedAnswer": {"@type": "Answer", "text": "No. Entra sin más, por orden de llegada."}}, {"@type": "Question", "name": "¿Cuál es el horario?", "acceptedAnswer": {"@type": "Answer", "text": "Lunes a jueves y domingo 12:00–02:00; viernes y sábado 12:00–02:30."}}, {"@type": "Question", "name": "¿Qué partidos de la NFL ponéis?", "acceptedAnswer": {"@type": "Answer", "text": "Los confirmamos en la página de Partidos con su hora en Madrid."}}]};
const eventLd = {"@context": "https://schema.org", "@type": "SportsEvent", "name": "Cincinnati Bengals vs Atlanta Falcons", "startDate": "2026-11-08T15:30:00+01:00", "eventStatus": "https://schema.org/EventScheduled", "location": {"@type": "Place", "name": "Estadio Santiago Bernabéu", "address": {"@type": "PostalAddress", "addressLocality": "Madrid", "addressCountry": "ES"}}};
const title = "NFL en Madrid: dónde verla en un pub cerca de Sol | Dubliners";
const description = "Pub irlandés deportivo junto a Puerta del Sol (Espoz y Mina 7) para fans de la NFL en Madrid. Partido Bengals–Falcons el 8 nov a las 15:30 en el Bernabéu.";
// POST-GAME block: hidden until NFL programming on our screens is confirmed. Set to true only after DG/owner sign-off.
const SHOW_POSTGAME = false;
---

<BaseLayout title={title} description={description} path="/es/nfl-madrid/" lang="es" hreflang={{ en: '/nfl-madrid/', es: '/es/nfl-madrid/' }} ogImage="/images/facade.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="NFL en Madrid" />
      <h1>NFL en Madrid: tu punto de encuentro cerca de Sol</h1>
      <p class="lead">Pub irlandés deportivo en Calle de Espoz y Mina 7, a un paso de Puerta del Sol. Un sitio para fans de la NFL y del fútbol americano que vienen o viven en Madrid.</p>
      <div class="cta-row">
        <a class="btn btn-gold" href={withBase('/es/visitar/')}>Cómo llegar</a>
        <a class="btn btn-secondary" href={withBase('/es/partidos/')}>Ver partidos</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <h2>La NFL en Madrid</h2><p>El domingo 8 de noviembre de 2026 los Cincinnati Bengals y los Atlanta Falcons juegan en el Estadio Santiago Bernabéu a las 15:30 (hora de Madrid). Es el segundo partido de temporada regular de la NFL en Madrid.</p>
      <h2>Calendario NFL (solo confirmado)</h2>
      <table><tbody><tr><td>Dom 8 nov</td><td>15:30</td><td>Bengals vs Falcons</td><td>Estadio Santiago Bernabéu, Madrid</td></tr></tbody></table>
      <p class="small">Horas en Madrid. Qué partidos se ponen en nuestras pantallas se confirma en Partidos. <a href={withBase('/es/partidos/')}>Ver partidos</a></p>
      <h2>Cómo llegar</h2><p>Calle de Espoz y Mina 7, 28012 Madrid. Metro Sol (L1, L2, L3) o Sevilla (L2).</p><p>Horario: lunes a jueves y domingo 12:00–02:00; viernes y sábado 12:00–02:30.</p>
      <div class="map-frame"><MapEmbed title="Mapa de Dubliners Madrid" lang="es" /></div>
      <h3>Del pub al Bernabéu en metro</h3><p>Desde Sol, Línea 1 hasta Tribunal y cambio a Línea 10 hasta Santiago Bernabéu.</p>
      <h2>Centro de Madrid</h2><p>Estamos entre Puerta del Sol, Plaza Mayor y el Barrio de las Letras: fácil de encontrar antes o después de visitar la ciudad.</p>
      <h2>NFL en directo</h2><p>Tenemos DAZN, Movistar y Premier Sports. Publicamos los partidos de la NFL en Partidos solo cuando la emisión está confirmada.</p>
      {SHOW_POSTGAME && (<div class="postgame"><h2>El partido no acaba en el Bernabéu: sigue tu domingo NFL en el centro de Madrid.</h2></div>)}
      <h2>FAQ</h2><dl class="faq"><dt><strong>¿Dónde y cuándo es el partido de la NFL en Madrid en 2026?</strong></dt><dd>Bengals vs Falcons, domingo 8 de noviembre de 2026 a las 15:30 en el Estadio Santiago Bernabéu.</dd><dt><strong>¿Hace falta reservar?</strong></dt><dd>No. Entra sin más, por orden de llegada.</dd><dt><strong>¿Cuál es el horario?</strong></dt><dd>Lunes a jueves y domingo 12:00–02:00; viernes y sábado 12:00–02:30.</dd><dt><strong>¿Qué partidos de la NFL ponéis?</strong></dt><dd>Los confirmamos en la página de Partidos con su hora en Madrid.</dd></dl>
      <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
      <script type="application/ld+json" set:html={JSON.stringify(eventLd)} />
    </div>
  </section>
</BaseLayout>
