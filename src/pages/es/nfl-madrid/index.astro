---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import MapEmbed from '../../../components/MapEmbed.astro';
import { SITE, withBase } from '../../../site';
import FanWeekendCtas from '../../../components/FanWeekendCtas.astro';
import FourBarsMeet from '../../../components/FourBarsMeet.astro';
import { isFanWeekendLive } from '../../../data/fourBars';
const fanWeekend = isFanWeekendLive();
const faqLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "¿Dónde y cuándo es el partido de la NFL en Madrid en 2026?", "acceptedAnswer": {"@type": "Answer", "text": "Bengals vs Falcons, domingo 8 de noviembre de 2026 a las 15:30 en el Estadio Santiago Bernabéu."}}, {"@type": "Question", "name": "¿Cuál es el horario?", "acceptedAnswer": {"@type": "Answer", "text": "Lunes a jueves y domingo 12:00–02:00; viernes y sábado 12:00–02:30."}}, {"@type": "Question", "name": "¿Qué partidos NFL ponéis en directo el domingo 8 de noviembre?", "acceptedAnswer": {"@type": "Answer", "text": "El domingo 8 de noviembre: Bengals vs Falcons a las 15:30 y todos los partidos NFL del domingo a las 19:00, 22:05 y 22:25, EN DIRECTO. Otras fechas, en Partidos cuando estén confirmadas."}}, {"@type": "Question", "name": "¿Dubliners es un bar NFL en Madrid?", "acceptedAnswer": {"@type": "Answer", "text": "Sí. Dubliners es un pub irlandés y bar deportivo cerca de Puerta del Sol — un bar NFL Madrid donde ver NFL en Madrid en pantallas. Listados con nombre: Partidos."}}]};
const eventLd = {"@context": "https://schema.org", "@type": "SportsEvent", "name": "Cincinnati Bengals vs Atlanta Falcons", "startDate": "2026-11-08T15:30:00+01:00", "eventStatus": "https://schema.org/EventScheduled", "location": {"@type": "Place", "name": "Estadio Santiago Bernabéu", "address": {"@type": "PostalAddress", "addressLocality": "Madrid", "addressCountry": "ES"}}};
const title = "Bar NFL Madrid | Ver NFL en Madrid cerca de Puerta del Sol — Dubliners";
const description = "Ver NFL en Madrid en un pub irlandés y bar deportivo junto a Puerta del Sol. Bar NFL Madrid, Espoz y Mina 7 — Bengals–Falcons y NFL del domingo EN DIRECTO. Four Corner está abierto desde las 14:00, pantallas de deporte.";
// POST-GAME block: hidden until NFL programming on our screens is confirmed. Set to true only after DG/owner sign-off.
const SHOW_POSTGAME = true; // desbloqueado 13 oct: dueño confirma todos los partidos NFL del domingo
---

<BaseLayout title={title} description={description} path="/es/nfl-madrid/" lang="es" hreflang={{ en: '/nfl-madrid/', es: '/es/nfl-madrid/' }} ogImage="/images/facade.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="NFL en Madrid" schema />
      <h1>Ver NFL en Madrid cerca de Puerta del Sol</h1>
      <p class="lead">Pub irlandés y bar deportivo en Calle de Espoz y Mina 7, a un paso de Puerta del Sol — un <strong>bar NFL en Madrid</strong> y punto de encuentro. Ver NFL en Madrid EN DIRECTO: Bengals vs Falcons el domingo 8 de noviembre desde las 15:30, y todos los partidos NFL del domingo en nuestras pantallas.</p>
      {fanWeekend ? (
        <FanWeekendCtas lang="es" />
      ) : (
        <div class="cta-row">
          <a class="btn btn-gold" href={withBase('/es/cuatro-bares-fin-de-semana/')}>VER LOS CUATRO BARES</a>
          <a class="btn btn-primary" href={withBase('/es/visitar/')}>CÓMO LLEGAR</a>
          <a class="btn btn-secondary" href={withBase('/es/partidos/')}>Ver partidos</a>
        </div>
      )}
    </div>
  </section>
  {fanWeekend && <FourBarsMeet lang="es" />}
  <section class="section">
    <div class="container prose">
      <h2>Bar NFL Madrid</h2>
      <p>Dubliners es un bar NFL en Madrid: los partidos del domingo en pantallas, en un pub irlandés a un paseo de Puerta del Sol. Los listados con nombre están en <a href={withBase('/es/partidos/')}>Partidos</a>. El resto de la semana es el mismo <a href={withBase('/es/bar-deportivo-madrid/')}>bar deportivo en Madrid</a>.</p>
      <h2>La NFL en Madrid</h2><p>El domingo 8 de noviembre de 2026 los Cincinnati Bengals y los Atlanta Falcons juegan en el Estadio Santiago Bernabéu a las 15:30 (hora de Madrid). Es el segundo partido de temporada regular de la NFL en Madrid.</p>
      <p>Si buscabas dónde ver NFL en Madrid, este pub irlandés junto a Puerta del Sol es la puerta. Las cuatro puertas hermanas alrededor de Sol están abiertas ahora; Four Corner está abierto desde las 14:00 con pantallas de deporte. Parrilla de tarde y noche: <a href={withBase('/es/nfl-tarde-noche-sol-8-nov/')}>NFL tarde y noche</a>.</p>
      <h2>Calendario NFL (solo confirmado)</h2>
      <table><tbody><tr><td>Dom 8 nov</td><td>15:30</td><td>Bengals vs Falcons</td><td>Estadio Santiago Bernabéu, Madrid</td></tr><tr><td>Dom 8 nov</td><td>19:00</td><td>Broncos at Panthers</td><td></td></tr><tr><td>Dom 8 nov</td><td>19:00</td><td>Cowboys at Colts</td><td></td></tr><tr><td>Dom 8 nov</td><td>19:00</td><td>Jets at Chiefs</td><td></td></tr><tr><td>Dom 8 nov</td><td>19:00</td><td>Lions at Dolphins</td><td></td></tr><tr><td>Dom 8 nov</td><td>19:00</td><td>Browns at Saints</td><td></td></tr><tr><td>Dom 8 nov</td><td>19:00</td><td>Giants at Eagles</td><td></td></tr><tr><td>Dom 8 nov</td><td>19:00</td><td>Rams at Commanders</td><td></td></tr><tr><td>Dom 8 nov</td><td>22:05</td><td>Texans at Chargers</td><td></td></tr><tr><td>Dom 8 nov</td><td>22:25</td><td>Raiders at 49ers</td><td></td></tr><tr><td>Dom 8 nov</td><td>22:25</td><td>Packers at Patriots</td><td></td></tr><tr><td>Dom 8 nov</td><td>22:25</td><td>Cardinals at Seahawks</td><td></td></tr></tbody></table>
      <p class="small">Horas de Madrid (CET). Todos los partidos de la tabla, EN DIRECTO en Dubliners. Fuente: calendario Week 9 de nfl.com. El partido del domingo noche (02:20 del lunes) queda fuera de horario. <a href={withBase('/es/partidos/')}>Ver partidos</a></p>
      <p class="small">¿Planificas todo el día? <a href={withBase('/es/guia-domingo-nfl-madrid/')}>Guía hora a hora del domingo NFL</a></p>
      <p class="small">Dónde ver la NFL junto a Puerta del Sol: <a href={withBase('/es/donde-ver-nfl-madrid/')}>Dónde ver la NFL en Madrid</a></p>
      <p class="small" data-show-until="2026-11-08">Domingo 8 nov en Sol: NFL 15:30, 19:00, 22:05/22:25 y Atlético–Barcelona 21:00 — <a href={withBase('/es/deportes-domingo-sol/')}>Deportes el domingo en Sol</a></p>
      <p class="small" data-show-until="2026-11-08">Fin de semana cerca de Sol: <a href={withBase('/es/cuatro-bares-fin-de-semana/')}>Cuatro bares. Un gran fin de semana deportivo</a> — cuatro bares hermanos: O&apos;Reilly&apos;s, Dubliners, O&apos;Connell St y Four Corner</p>
      <p class="small" data-show-until="2026-11-08"><a href={withBase('/es/nfl-madrid-cuatro-bares-hermanos/')}>NFL Madrid 2026: cuatro bares hermanos, un punto de encuentro cerca de la Puerta del Sol</a> · <a href={withBase('/es/sabado-domingo-sol-cuatro-bares/')}>Sábado y domingo en Sol: una ruta de aficionado por cuatro bares</a></p>
      <p class="small">El jueves de Thanksgiving: <a href={withBase('/es/thanksgiving-madrid/')}>NFL de Thanksgiving en Madrid</a> (26 de noviembre: 19:00 y 22:30)</p>
      <h2>Cómo llegar</h2><p>Calle de Espoz y Mina 7, 28012 Madrid. Metro Sol (L1, L2, L3) o Sevilla (L2).</p><p>Horario: lunes a jueves y domingo 12:00–02:00; viernes y sábado 12:00–02:30.</p>
      <div class="map-frame"><MapEmbed title="Mapa de Dubliners Madrid" lang="es" /></div>
      <p class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">CÓMO LLEGAR</a>
        <a class="btn btn-secondary" href={withBase('/es/visitar/')}>FIND US</a>
        <a class="btn btn-secondary" href={withBase('/es/bar-deportivo-madrid/')}>Bar deportivo Madrid</a>
      </p>
      <h3>Del pub al Bernabéu en metro</h3><p>Para ir al estadio, usa Concha Espina (Línea 9) o Cuzco (Línea 10), las estaciones de Metro que cita el plan de movilidad de la NFL del Ayuntamiento de Madrid. Consulta tu ruta desde Sol en crtm.es o en la app de Metro de Madrid.</p>
      <h3>En el Bernabéu: información práctica</h3><p>Según la página NFL del Real Madrid (<a href="https://bernabeu.realmadrid.com/nfl/" rel="noopener">bernabeu.realmadrid.com/nfl</a>): el partido empieza a las 15:30 y el perímetro del estadio abre a las 12:30. No hay parking en el estadio, así que conviene ir en transporte público; la estación de metro accesible es Nuevos Ministerios (L6, L8, L10), a unos 15 minutos andando de la entrada accesible. Rige la política de bolsas transparentes de la NFL: bolsas transparentes de hasta 30,5 × 15,25 × 30,5 cm o bolsos de mano de hasta 11,5 × 16,5 cm. Se puede llevar una botella reutilizable vacía y transparente (hasta 1 litro).</p>
      <h2>Centro de Madrid</h2><p>Estamos entre Puerta del Sol, Plaza Mayor y el Barrio de las Letras: fácil de encontrar antes o después de visitar la ciudad.</p><img class="split-photo tall" src={withBase('/images/dubliners-bar-counter-screen-madrid-1152.webp')} srcset={`${withBase('/images/dubliners-bar-counter-screen-madrid-800.webp')} 800w, ${withBase('/images/dubliners-bar-counter-screen-madrid-1152.webp')} 1152w`} sizes="(max-width: 800px) 100vw, 720px" width="1152" height="2048" loading="lazy" decoding="async" alt="Barra y pantalla de televisión dentro de Dubliners Madrid" />
      <h2>Semana NFL en Madrid: qué hay</h2><ul><li><strong>Domingo 8 de noviembre, 15:30:</strong> Bengals vs Falcons en el Santiago Bernabéu, EN DIRECTO en Dubliners en la pantalla grande y nuestras pantallas. Abrimos a las 12:00.</li></ul><p>¿Venís en grupo? <a href={withBase('/contact/#request-information')}>Pide información</a>.</p>
      <h2>Bengals vs Falcons EN DIRECTO</h2><p>El domingo 8 de noviembre Dubliners es punto de encuentro antes del pitido inicial: abrimos desde las 12:00, y el Bengals vs Falcons va EN DIRECTO a las 15:30 en la pantalla grande y nuestras pantallas.</p><p>En España el Madrid Game también se puede ver en DAZN (en abierto) y Cuatro; en Dubliners va en <strong>pantalla grande</strong> desde las 15:30. Info de emisión pública: <a href="https://www.nfl.com/news/donde-ver-el-2026-nfl-madrid-game-en-espana" rel="noopener">nfl.com</a>.</p><img class="split-photo tall" src={withBase('/images/dubliners-screens-sol-1200.webp')} srcset={`${withBase('/images/dubliners-screens-sol-800.webp')} 800w, ${withBase('/images/dubliners-screens-sol-1200.webp')} 1200w`} sizes="(max-width: 800px) 100vw, 720px" width="1200" height="1600" loading="lazy" decoding="async" alt="Pantalla grande y más pantallas en Dubliners, junto a Sol" />
      <h2>NFL RedZone EN DIRECTO</h2><p>Tras el partido del Bernabéu, Dubliners sigue como punto de encuentro con NFL RedZone EN DIRECTO desde las 19:00 (hora de Madrid; 13:00 ET), durante los partidos de las 19:00, 22:05 y 22:25, dentro de nuestro horario (cerramos a las 02:00).</p>
      {SHOW_POSTGAME && (<div class="postgame"><h2>El partido no acaba en el Bernabéu: todos los partidos NFL del domingo EN DIRECTO</h2><p>Tras el pitido final, Dubliners sigue con la NFL: NFL RedZone desde las 19:00 y todos los partidos NFL del domingo EN DIRECTO (hora de Madrid):</p><ul class="postgame-list"><li><strong>19:00</strong> — Broncos at Panthers · Cowboys at Colts · Jets at Chiefs · Lions at Dolphins · Browns at Saints · Giants at Eagles · Rams at Commanders</li><li><strong>22:05</strong> — Texans at Chargers</li><li><strong>22:25</strong> — Packers at Patriots · Raiders at 49ers · Cardinals at Seahawks</li></ul><p class="small">El Sunday Night Football (Buccaneers at Bears) empieza a las 02:20 del lunes, después de nuestro cierre a las 02:00, así que no se emite.</p></div>)}
      <h2>FAQ</h2><dl class="faq"><dt><strong>¿Dónde y cuándo es el partido de la NFL en Madrid en 2026?</strong></dt><dd>Bengals vs Falcons, domingo 8 de noviembre de 2026 a las 15:30 en el Estadio Santiago Bernabéu.</dd><dt><strong>¿Cuál es el horario?</strong></dt><dd>Lunes a jueves y domingo 12:00–02:00; viernes y sábado 12:00–02:30.</dd><dt><strong>¿Qué partidos NFL ponéis en directo el domingo 8 de noviembre?</strong></dt><dd>El domingo 8 de noviembre: Bengals vs Falcons a las 15:30 y todos los partidos NFL del domingo a las 19:00, 22:05 y 22:25, EN DIRECTO. Otras fechas, en Partidos cuando estén confirmadas.</dd><dt><strong>¿Dubliners es un bar NFL en Madrid?</strong></dt><dd>Sí. Dubliners es un pub irlandés y bar deportivo cerca de Puerta del Sol — un bar NFL Madrid donde ver NFL en Madrid en pantallas. Listados con nombre: <a href={withBase('/es/partidos/')}>Partidos</a>.</dd></dl>
      <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
      <script type="application/ld+json" set:html={JSON.stringify(eventLd)} />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
