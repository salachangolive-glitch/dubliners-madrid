---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { SITE, withBase } from '../../../site';

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿A qué hora cierra Dubliners?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A las 02:00 de lunes a jueves y domingo; a las 02:30 viernes y sábado."
      }
    },
    {
      "@type": "Question",
      "name": "¿Es fácil para visitantes que hablan inglés?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, Dubliners es un pub irlandés con atención en inglés."
      }
    },
    {
      "@type": "Question",
      "name": "¿Puedo entrar sin más?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sí, entra sin más, por orden de llegada."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué partidos hay hoy?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Los partidos confirmados y su hora (de Madrid) están en Partidos."
      }
    }
  ]
};
const title = "Salir de noche cerca de Sol, Madrid | Pub irlandés hasta las 02:30 — Dubliners";
const description = "Qué hacer de noche junto a Puerta del Sol: pub irlandés con atención en inglés, abierto hasta las 02:00 (02:30 vie–sáb), fútbol en directo y chupitos a 1 € los miércoles.";
---

<BaseLayout title={title} description={description} path="/es/noche-cerca-de-sol/" lang="es" ogImage="/images/facade.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Noche cerca de Sol" lang="es" />
      <h1>Salir de noche cerca de Sol: un pub irlandés que cierra tarde</h1>
      <p class="lead">¿Buscas plan para esta noche cerca de la Puerta del Sol? Dubliners, en Espoz y Mina 7, cierra tarde, pone deporte en directo y atiende en inglés.</p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
        <a class="btn btn-secondary" href={withBase('/es/partidos/')}>Partidos</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <h2>Abierto hasta tarde, todos los días</h2>
      <p>De lunes a jueves y domingo de 12:00 a 02:00; viernes y sábado de 12:00 a 02:30. Sin reserva, por orden de llegada.</p>
      <h2>Noches de partido</h2>
      <p>Fútbol y más en directo en DAZN, Movistar y Premier Sports. Mira <a href={withBase('/es/partidos/')}>Partidos</a> para los partidos confirmados en hora de Madrid.</p>
      <h2>Miércoles: chupitos a 1 €</h2>
      <p>Todos los miércoles hay chupitos a 1 € — mira <a href={withBase('/es/miercoles-chupitos-1-euro/')}>Miércoles chupitos a 1 €</a>.</p>
      <h2>¿Vas a un concierto? Pub irlandés en Sol para antes y después</h2>
      <p>¿Vas a un concierto en el Movistar Arena, como Fontaines D.C. el jueves 22 de octubre de 2026 (20:45, según el recinto)? Empieza o acaba la noche en Dubliners, pub irlandés en Calle de Espoz y Mina 7, junto a Puerta del Sol. Abierto hasta las 02:00 de lunes a jueves. Entra sin más.</p>
      <h2>Cómo llegar</h2>
      <p>Metro Sol (L1, L2, L3) o Sevilla (L2); desde la Puerta del Sol toma la calle de Espoz y Mina y busca el neón verde en el número 7.</p><p><a href={withBase('/es/visitar/')}>Mapa y cómo llegar</a> · <a href={withBase('/es/partidos/')}>Partidos</a> · <a href={withBase('/es/miercoles-chupitos-1-euro/')}>Miércoles chupitos a 1 €</a> · <a href={withBase('/es/estudiantes-internacionales/')}>Erasmus y estudiantes internacionales</a></p>
      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>¿A qué hora cierra Dubliners?</strong></dt>
        <dd>A las 02:00 de lunes a jueves y domingo; a las 02:30 viernes y sábado.</dd>
        <dt><strong>¿Es fácil para visitantes que hablan inglés?</strong></dt>
        <dd>Sí, Dubliners es un pub irlandés con atención en inglés.</dd>
        <dt><strong>¿Puedo entrar sin más?</strong></dt>
        <dd>Sí, entra sin más, por orden de llegada.</dd>
        <dt><strong>¿Qué partidos hay hoy?</strong></dt>
        <dd>Los partidos confirmados y su hora (de Madrid) están en Partidos.</dd>
      </dl>
      <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    </div>
  </section>
</BaseLayout>
