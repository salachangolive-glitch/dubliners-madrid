---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../../data/fourBars';

const PATH = '/es/parrilla-nfl-domingo-quedarse-sol/';
const PATH_EN = '/sunday-nfl-slate-stay-in-sol/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Parrilla NFL del domingo sin salir de Sol — de 12:00 a la madrugada',
  inLanguage: 'es',
  datePublished: '2026-11-07T18:40:00+01:00',
  dateModified: '2026-11-07T18:40:00+01:00',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Puedo quedarme en Sol toda la parrilla NFL del domingo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sí. O’Reilly’s desde las 11:30, Dubliners y O’Connell’s desde las 12:00, Four Corner desde las 14:00 con pantallas de deporte. NFL EN DIRECTO confirmada en Dubliners a las 15:30, 19:00, 22:05 y 22:25. Cierre 02:00.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Qué hay en medio de la parrilla del domingo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Atlético–Barcelona a las 21:00 va EN DIRECTO en Dubliners la misma noche que la NFL de tarde-noche. Preguntad qué pantalla es cuál. No todos los partidos van en todas las pantallas.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Four Corner forma parte de la parrilla desde el mediodía?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Four Corner abre a las 14:00 hasta la madrugada, con pantallas de deporte. No es una puerta de las 12:00.',
      },
    },
  ],
};
---

<BaseLayout
  title="Parrilla NFL del domingo sin salir de Sol | Dubliners"
  description="Quedaos en Sol para la parrilla del domingo 8 nov: Dubliners desde las 12:00, Four Corner desde las 14:00 con pantallas, NFL 15:30 / 19:00 / 22:05 / 22:25. Maps."
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Parrilla NFL del domingo en Sol" lang="es" schema />
      <h1>Parrilla NFL del domingo sin salir de Sol — de 12:00 a la madrugada</h1>
      <p class="lead">
        Podéis sentar toda la jornada del domingo en un solo rincón. Dubliners desde las 12:00, Four Corner desde las 14:00 (pantallas de deporte),
        O’Reilly’s desde las 11:30, O’Connell’s desde las 12:00. Los pitidos se apilan: 15:30, 19:00, 21:00 fútbol, 22:05, 22:25.
        Preguntad qué echan. Planeadlo esta noche — el sábado no hay NFL.
      </p>
      <p class="small">In English: <a href={withBase(PATH_EN)} hreflang="en" lang="en">Sunday NFL slate without leaving Sol</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners en Maps</a>
        <a class="btn btn-secondary" href={withBase('/es/cuatro-bares-fin-de-semana/')}>VER LOS CUATRO BARES</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>La parrilla, solo en este rincón</h2>
      <p>
        Esto no es una guía hora a hora de cada partido NFL. Es la decisión de <strong>no salir de Sol</strong> cuando empiece el domingo.
        EN DIRECTO confirmado en Dubliners: Bengals–Falcons 15:30 (pantalla grande), siete partidos desde las 19:00, Texans–Chargers 22:05, tres más a las 22:25, NFL RedZone desde las 19:00, Atlético–Barcelona 21:00.
        Cerramos a las 02:00.
      </p>
      <p>
        Four Corner es la puerta hermana de las 14:00 — pantallas de deporte, sin listados inventados — así el rincón tiene cuatro salas después de comer, no tres.
        Esta noche ya podéis quedar a las 18:00–19:00 en las tres del sábado, ver Valencia–RM a las 21:00 en Dubliners, y andar las mismas calles el domingo.
      </p>

      <OriginalFourBars lang="es" when="sunday" />

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>¿Puedo quedarme en Sol toda la parrilla del domingo?</strong></dt>
        <dd>Sí. Cuatro puertas, aperturas escalonadas. Pantallas NFL confirmadas en Dubliners hasta las 02:00.</dd>
        <dt><strong>¿Qué hay en medio de la parrilla?</strong></dt>
        <dd>Atlético–Barcelona 21:00 en Dubliners, la misma noche que la NFL de tarde-noche. Preguntad qué pantalla.</dd>
        <dt><strong>¿Four Corner es puerta de mediodía?</strong></dt>
        <dd>No. Domingo desde las 14:00 hasta la madrugada, pantallas de deporte.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Domingo en este rincón',
            until: SHOW_UNTIL,
            items: [
              { href: '/es/', label: 'Inicio Dubliners' },
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'VER LOS CUATRO BARES' },
              { href: '/es/guia-domingo-nfl-madrid/', label: 'Guía hora a hora del domingo' },
              { href: '/es/elige-reloj-nfl-domingo-sol/', label: 'Elige reloj del domingo' },
              { href: '/es/nfl-madrid/', label: 'NFL en Dubliners' },
              { href: PATH_EN, label: 'Sunday NFL slate in Sol', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
