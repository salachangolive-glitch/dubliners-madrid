---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import { SITE, withBase } from '../../../site';
import {
  fixturesForToday,
  fixturesForWeek,
  madridToday,
  sportLabelEs,
} from '../../../data/fixtures';
import { whenLabelEs } from '../../../i18n';

const title = 'Ver fútbol cerca de Sol | Partidos — Bar deportivo Dubliners';
const description =
  'Dónde ver fútbol en Madrid centro: deporte en pantallas de pub irlandés cerca de Puerta del Sol. Solo partidos verificados abajo — bar deportivo Espoz y Mina 7, miércoles chupitos a 1 €.';

const todayKey = madridToday();
const today = fixturesForToday();
const upcoming = fixturesForWeek().filter((f) => f.dateKey > todayKey);
---

<BaseLayout title={title} description={description} path="/es/partidos/" lang="es" ogImage="/images/screens-sports.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Partidos" lang="es" />
      <h1>Qué hay en Dubliners Madrid — Deportes en directo</h1>
      <p class="lead">
        Consulta el deporte en directo esta semana en Dubliners: fútbol, NFL, NBA, rugby, Fórmula 1, tenis y más.
        Horarios en hora de Madrid. Solo las emisiones marcadas como Confirmado se emiten en nuestras pantallas.
      </p>
      <CtaRow lang="es" showWhatsOn={false} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="fixture-board" data-fixture-board>
        <div class="fixture-col" data-fixture-slot="today">
          <h2>Hoy</h2>
          <p class="empty-slot" data-fixture-empty hidden={today.length > 0}>
            Nada listado para hoy — pregunta en barra qué hay en pantallas.
          </p>
          <ul class="fixture-list" hidden={today.length === 0}>
            {today.map((f) => (
              <li
                data-date-key={f.dateKey}
                data-madrid-time={f.madridTime}
                data-duration-min={String(f.approxDurationMin ?? 180)}
              >
                <span class="fx-time">{f.madridTime}</span>
                <span class="fx-body">
                  <strong>{f.teams}</strong>
                  <em>{sportLabelEs(f.competition)} · {f.competition}</em>
                  {f.confirmedOnScreens && <span class="fx-status fx-status-confirmed">Confirmado</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>
        <div class="fixture-col" data-fixture-slot="week">
          <h2>Próximos esta semana</h2>
          <p class="empty-slot" data-fixture-empty hidden={upcoming.length > 0}>
            La agenda de próximos partidos aparecerá aquí cuando estén listos.
          </p>
          <ul class="fixture-list" hidden={upcoming.length === 0}>
            {upcoming.map((f) => (
              <li
                data-date-key={f.dateKey}
                data-madrid-time={f.madridTime}
                data-duration-min={String(f.approxDurationMin ?? 180)}
              >
                <span class="fx-day">{whenLabelEs(f.dateKey)}</span>
                <span class="fx-time">{f.madridTime}</span>
                <span class="fx-body">
                  <strong>{f.teams}</strong>
                  <em>{sportLabelEs(f.competition)} · {f.competition}</em>
                  {f.confirmedOnScreens && <span class="fx-status fx-status-confirmed">Confirmado</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <FixtureAntiStale />
      <p class="fx-note">
        Horarios en hora de Madrid. Confirmado = se emite en nuestras pantallas.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
        <a class="btn btn-primary" href={withBase('/es/contacto/')}>Contacto</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Deportes en directo en Dubliners</h2>
      <p>
        Dubliners es un pub irlandés junto a Puerta del Sol — Espoz y Mina 7, Metro Sol o Sevilla.
        Ponemos grandes eventos deportivos en nuestras pantallas cuando están confirmados: fútbol, NFL, NBA,
        rugby, Fórmula 1, tenis y más. Consulta Partidos arriba para la agenda de esta semana, o pregunta
        en barra si buscas un partido concreto.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Explora el deporte en directo en Dubliners</h2>
      <p>
        ¿Buscas una competición en concreto? Más sobre la
        <a href={withBase('/es/premier-league-pub-madrid/')}>Premier League</a>,
        la <a href={withBase('/es/champions-league-bar-madrid/')}>Champions League</a>
        y <a href={withBase('/es/ver-futbol-madrid/')}>ver fútbol en directo en Madrid</a>,
        o consulta <a href={withBase('/es/partidos/')}>Partidos</a> para las emisiones confirmadas de esta semana.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div>
        <h2>Miércoles · chupitos a 1 €</h2>
        <p>
          Entre semana en Dubliners: chupitos a 1 €. Pregunta en barra los detalles.
        </p>
        <a class="btn btn-secondary" href={withBase('/es/miercoles-chupitos-1-euro/')}>Miércoles chupitos a 1 € →</a>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/bar-interior-sm.webp')} 800w, ${withBase('/images/bar-interior.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img src={withBase('/images/bar-interior.jpg')} alt="Interior del bar en Dubliners" class="split-photo landscape" width="1400" height="788" loading="lazy" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Visitar</h2>
      <p>{SITE.address}, {SITE.postal} · <a href={withBase('/es/visitar/')}>Horario y mapa</a></p>
    </div>
  </section>
</BaseLayout>
