---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import FixtureBoard from '../../../components/FixtureBoard.astro';
import { SITE, withBase, absUrl } from '../../../site';
import { agendaAt, sportsEventsJsonLd } from '../../../data/fixtures';

const title =
  'Pub irlandés en Sol · Premier League y Champions | Partidos — Dubliners';
const description =
  'Pub irlandés en Sol para ver la Premier League y la Champions. Partidos Confirmados en pantallas en Dubliners, Espoz y Mina 7 — bar deportivo Madrid centro.';

// One agenda for EN + ES (same filter, same range, Europe/Madrid).
const { todayKey, today, upcoming } = agendaAt();
const sportsEvents = sportsEventsJsonLd([...today, ...upcoming], {
  pageUrl: absUrl('/es/partidos/'),
  lang: 'es',
});
---

<BaseLayout
  title={title}
  description={description}
  path="/es/partidos/"
  lang="es"
  ogImage="/images/screens-sports.jpg"
  extraJsonLd={sportsEvents}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Partidos" lang="es" />
      <h1>Partidos en Dubliners — Pub irlandés en Sol para Premier League y Champions</h1>
      <p class="lead">
        Consulta el deporte en directo esta semana en Dubliners: fútbol, NFL, NBA, rugby, Fórmula 1, tenis y más.
        Horarios en hora de Madrid. Solo las emisiones marcadas como Confirmado se emiten en nuestras pantallas.
      </p>
      <CtaRow lang="es" showWhatsOn={false} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <FixtureBoard lang="es" today={today} upcoming={upcoming} />
      <p class="fx-note">
        Horarios en hora de Madrid. Confirmado = se emite en nuestras pantallas.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
        <a class="btn btn-primary" href={withBase('/es/contacto/')}>Contacto</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Deportes en directo en Dubliners</h2>
      <p>
        Dubliners es un pub irlandés junto a Puerta del Sol — Espoz y Mina 7, Metro Sol o Sevilla.
        Ponemos grandes eventos deportivos en nuestras pantallas cuando están confirmados: fútbol, NFL, NBA,
        rugby, Fórmula 1, tenis y más. Consulta Partidos arriba para la agenda de esta semana, o pregunta
        en barra si buscas un partido concreto.
      </p>
      {todayKey <= '2026-10-10' && (
        <p data-show-until="2026-10-10">
          El sábado en Dubliners viene cargado: Arsenal–Leeds 13:30, Rayo–Athletic 14:00, Alavés–Atlético 16:15, Man Utd–Spurs con Barça–Getafe y Ulster–Munster a las 18:30, luego Leinster–Cardiff 20:45 y Real Madrid–Villarreal 21:00 — Confirmados en pantallas; si coinciden, pantallas distintas. Entra cerca de Sol.
        </p>
      )}
      <p>
        ¿Vienes por el Atlético–Manchester United del mar 13 oct? Saque a las 21:00 en el Metropolitano —
        Confirmado en pantallas. Cañas de prepartido cerca de Sol o quédate en el centro y mira la noche UCL aquí. Sin reserva; pregunta en barra.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Explora el deporte en directo en Dubliners</h2>
      <p>
        ¿Buscas una competición en concreto? Más sobre la
        <a href={withBase('/es/premier-league-pub-madrid/')}>Premier League</a>,
        la <a href={withBase('/es/champions-league-bar-madrid/')}>Champions League</a>
        y <a href={withBase('/es/ver-futbol-madrid/')}>ver fútbol en directo en Madrid</a>,
        o consulta <a href={withBase('/es/partidos/')}>Partidos</a> para las emisiones confirmadas de esta semana.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div>
        <h2>Miércoles · chupitos a 1 €</h2>
        <p>
          Entre semana en Dubliners: chupitos a 1 €. Pregunta en barra los detalles.
        </p>
        <a class="btn btn-secondary" href={withBase('/es/miercoles-chupitos-1-euro/')}>Miércoles chupitos a 1 € →</a>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/bar-interior-sm.webp')} 800w, ${withBase('/images/bar-interior.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img
          src={withBase('/images/bar-interior.jpg')}
          alt="Pub irlandés en Sol — pantallas de Dubliners Madrid para Premier League y Champions"
          class="split-photo landscape"
          width="1400"
          height="788"
          loading="lazy"
        />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Visitar</h2>
      <p>{SITE.address}, {SITE.postal} · <a href={withBase('/es/visitar/')}>Horario y mapa</a></p>
    </div>
  </section>
</BaseLayout>
