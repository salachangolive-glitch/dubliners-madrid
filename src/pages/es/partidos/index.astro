---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import FixtureBoard from '../../../components/FixtureBoard.astro';
import LinkHub from '../../../components/LinkHub.astro';
import { SITE, withBase, absUrl } from '../../../site';
import { agendaAt, sportsEventsJsonLd } from '../../../data/fixtures';

const title =
  'Partidos: deporte en directo esta semana | Dubliners Madrid';
const description =
  'Deporte en directo esta semana en Dubliners, Espoz y Mina 7: fútbol, NFL, rugby, NBA y más en hora de Madrid, con lo que va EN DIRECTO.';

// One agenda for EN + ES (same filter, same range, Europe/Madrid).
const { todayKey, today, upcoming } = agendaAt();
const sportsEvents = sportsEventsJsonLd([...today, ...upcoming], {
  pageUrl: absUrl('/es/partidos/'),
  lang: 'es',
});
---

<BaseLayout
  title={title}
  description={description}
  path="/es/partidos/"
  lang="es"
  ogImage="/images/screens-sports.jpg"
  extraJsonLd={sportsEvents}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Partidos" lang="es" />
      <h1>Partidos en Dubliners — deporte en directo esta semana</h1>
      <p class="lead">
        Consulta el deporte en directo esta semana en Dubliners: fútbol, NFL, NBA, rugby, Fórmula 1, tenis y más.
        Horarios en hora de Madrid. Los partidos marcados EN DIRECTO se emiten en nuestras pantallas: un proyector grande y 8 pantallas.
      </p>
      <CtaRow lang="es" showWhatsOn={false} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <FixtureBoard lang="es" today={today} upcoming={upcoming} />
      <p class="fx-note">
        Horarios en hora de Madrid. EN DIRECTO = se emite en nuestras pantallas.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
        <a class="btn btn-primary" href={withBase('/es/contacto/')}>Contacto</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Deportes en directo en Dubliners</h2>
      <p>
        Dubliners es un pub irlandés junto a Puerta del Sol — Espoz y Mina 7, Metro Sol o Sevilla.
        Ponemos grandes eventos deportivos en nuestras pantallas cuando están confirmados: fútbol, NFL, NBA,
        rugby, Fórmula 1, tenis y más. Consulta Partidos arriba para la agenda de esta semana, o pregunta
        en barra si buscas un partido concreto.
      </p>
      <p>
        Cómo funcionan las pantallas y qué deportes ponemos: <a href={withBase('/es/bar-deportivo-madrid/')}>nuestro bar deportivo en Madrid</a>.
      </p>
      {todayKey <= '2026-11-01' && (
        <p data-show-until="2026-11-01">
          Deporte en directo esta semana (26 oct–1 nov, hora de Madrid): lunes Sevilla–Osasuna 21:00 · jueves 29 Real Madrid–Fenerbahçe (EuroLeague) 20:45 y la Copa del Rey Sporting Hortaleza–Sevilla 21:00 · viernes Villarreal–Espanyol 21:00 · el sábado 31 es Halloween en Dubliners desde las 19:00, con los partidos del día también en pantalla, entre ellos el Barça–Alavés 21:00 · domingo 1, víspera del festivo del lunes: Racing–Real Madrid 16:15, Liverpool–Arsenal 17:30, NFL desde las 19:00, GP de México de F1 21:00 y Athletic–Real Sociedad 21:00. Confirmados en pantallas; si coinciden, pantallas distintas.
        </p>
      )}
      {todayKey <= '2026-10-10' && (
        <p data-show-until="2026-10-10">
          El sábado en Dubliners viene cargado: Arsenal–Leeds 13:30, Rayo–Athletic 14:00, Alavés–Atlético 16:15, Man Utd–Spurs con Barça–Getafe y Ulster–Munster a las 18:30, luego Leinster–Cardiff 20:45 y Real Madrid–Villarreal 21:00 — Confirmados en pantallas; si coinciden, pantallas distintas. Entra cerca de Sol.
        </p>
      )}
    </div>
  </section>

  <section class="section band" id="guias-deporte">
    <div class="container">
      <h2>Explora el deporte en directo en Dubliners</h2>
      <LinkHub
        heading="h3"
        groups={[
          {
            title: 'Fútbol y rugby',
            id: 'futbol-rugby',
            items: [
              { href: '/es/premier-league-pub-madrid/', label: 'Premier League' },
              { href: '/es/champions-league-bar-madrid/', label: 'Champions League' },
              { href: '/es/bar-deportivo-madrid/', label: 'Fútbol, NFL y rugby en directo cerca de Sol' },
              { href: '/es/aficionados-brighton-madrid/', label: 'Aficionados del Brighton en Madrid' },
              { href: '/es/rugby-irlanda-madrid/', label: 'Rugby de Irlanda en Madrid', note: '6, 14 y 21 de noviembre' },
            ],
          },
          {
            title: 'NFL y deportes americanos',
            id: 'nfl-deportes-americanos',
            items: [
              { href: '/es/nfl-madrid/', label: 'NFL en Madrid' },
              { href: '/es/guia-domingo-nfl-madrid/', label: 'Guía del domingo NFL', note: 'Hora a hora, domingo 8 de noviembre' },
            ],
          },
          {
            title: 'Comida y bebida',
            id: 'comida-bebida',
            items: [{ href: '/es/carta/', label: 'Carta' }],
          },
        ]}
      />
    </div>
  </section>

  <section class="section" id="novedades">
    <div class="container">
      <h2>Novedades</h2>
      <LinkHub
        heading="h3"
        groups={[
          {
            title: 'Promociones y eventos',
            items: [
              { href: '/es/miercoles-chupitos-1-euro/', label: 'Miércoles chupitos a 1 €', note: 'Todos los miércoles · pregunta en barra' },
              { href: '/es/halloween-madrid-2026/', label: 'Halloween en Madrid junto a Sol: fiesta en Dubliners', note: 'Sábado 31 de octubre · desde las 19:00', until: '2026-10-31' },
              { href: '/es/oktoberfest-madrid-2026/', label: 'Temporada de Oktoberfest en Madrid', note: '22 oct–15 nov', until: '2026-11-15' },
              { href: '/de/oktoberfest-madrid-2026/', label: 'Oktoberfest-Zeit in Madrid', note: 'En alemán', hreflang: 'de', lang: 'de', until: '2026-11-15' },
            ],
          },
          {
            title: 'Visitar',
            items: [
              { href: '/es/visitar/', label: 'Horario y mapa', note: `${SITE.address}, ${SITE.postal}` },
              { href: '/es/pub-irlandes-plaza-mayor/', label: 'Pub irlandés cerca de Plaza Mayor' },
              { href: '/es/noche-cerca-de-sol/', label: 'Salir de noche cerca de Sol' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
