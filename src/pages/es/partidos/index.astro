---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import { SITE, withBase } from '../../../site';
import { FIXTURES, PREVIEW_TODAY } from '../../../data/fixtures';
import { whenLabelEs } from '../../../i18n';

const title = 'Partidos en Dubliners Madrid | Fútbol en directo';
const description =
  'Qué ver hoy en Dubliners: fútbol en pantallas y miércoles con chupitos a 1 €. Cerca de Puerta del Sol.';

const today = FIXTURES.filter((f) => f.dateKey === PREVIEW_TODAY);
const week = FIXTURES.filter((f) => f.dateKey >= PREVIEW_TODAY);
---

<BaseLayout title={title} description={description} path="/es/partidos/" lang="es" ogImage="/images/screens-sports.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Partidos" lang="es" />
      <h1>Partidos</h1>
      <p class="lead">
        Deporte en pantallas en el local — y miércoles con chupitos a 1 €.
        Pregunta en barra qué hay esta noche.
      </p>
      <CtaRow lang="es" showWhatsOn={false} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="fixture-board">
        <div class="fixture-col">
          <h2>Hoy</h2>
          {today.length === 0 ? (
            <p class="empty-slot">Nada listado para hoy — pregunta en barra qué hay en pantallas.</p>
          ) : (
            <ul class="fixture-list">
              {today.map((f) => (
                <li>
                  <span class="fx-time">{f.madridTime}</span>
                  <span class="fx-body">
                    <strong>{f.teams}</strong>
                    <em>{f.competition}</em>
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div class="fixture-col">
          <h2>Próximos partidos</h2>
          {week.length === 0 ? (
            <p class="empty-slot">La lista de esta semana aparecerá aquí cuando los partidos estén listos.</p>
          ) : (
            <ul class="fixture-list">
              {week.map((f) => (
                <li>
                  <span class="fx-day">{whenLabelEs(f.dateKey)}</span>
                  <span class="fx-time">{f.madridTime}</span>
                  <span class="fx-body">
                    <strong>{f.teams}</strong>
                    <em>{f.competition}</em>
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
      <p class="fx-note">
        Horarios en hora de Madrid (CEST). Las pantallas y la cobertura pueden cambiar — pregunta al equipo esa noche.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
        <a class="btn btn-primary" href={withBase('/es/contacto/')}>Contacto</a>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div>
        <h2>MIÉRCOLES · CHUPITOS A 1 €</h2>
        <p>
          Todos los miércoles en Dubliners. Four Corner After Party continúa en Calle Victoria 6
          (solo miércoles) hasta las 05:30.
        </p>
        <a class="btn btn-secondary" href={withBase('/es/miercoles-chupitos-1-euro/')}>Noches de miércoles →</a>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/bar-interior-sm.webp')} 800w, ${withBase('/images/bar-interior.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img src={withBase('/images/bar-interior.jpg')} alt="Interior del bar en Dubliners" class="split-photo landscape" width="1400" height="788" loading="lazy" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Más noches de partido</h2>
      <ul>
        <li><a href={withBase('/es/bar-deportivo-madrid/')}>Bar deportivo Madrid</a></li>
        <li><a href={withBase('/es/ver-futbol-madrid/')}>Ver fútbol en Madrid</a></li>
        <li><a href={withBase('/es/premier-league-pub-madrid/')}>Pub Premier League</a></li>
        <li><a href={withBase('/es/champions-league-bar-madrid/')}>Bar Champions League</a></li>
      </ul>
      <h2>Visitar</h2>
      <p>{SITE.address}, {SITE.postal} · <a href={withBase('/es/visitar/')}>Horario y mapa</a></p>
    </div>
  </section>
</BaseLayout>
