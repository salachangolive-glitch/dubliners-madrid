---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import { SITE, withBase } from '../../../site';
import { fixturesForToday, fixturesForWeek } from '../../../data/fixtures';
import { whenLabelEs } from '../../../i18n';

const title = 'Ver fútbol cerca de Sol | Partidos — Bar deportivo Dubliners';
const description =
  'Dónde ver fútbol en Madrid centro: deporte en pantallas de pub irlandés cerca de Puerta del Sol. Solo partidos verificados abajo — bar deportivo Espoz y Mina 7, miércoles chupitos a 1 €.';

const today = fixturesForToday();
const week = fixturesForWeek();
---

<BaseLayout title={title} description={description} path="/es/partidos/" lang="es" ogImage="/images/screens-sports.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Partidos" lang="es" />
      <h1>Ver fútbol cerca de Sol — partidos</h1>
      <p class="lead">
        Bar deportivo cerca de Sol con fútbol en pantallas interiores — y miércoles con chupitos a 1 €.
        El tablero lista partidos verificados; las filas marcadas «Confirmado en pantallas esta noche» están confirmadas por Dubliners.
      </p>
      <CtaRow lang="es" showWhatsOn={false} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="fixture-board" data-fixture-board>
        <div class="fixture-col" data-fixture-slot="today">
          <h2>Hoy</h2>
          <p class="empty-slot" data-fixture-empty hidden={today.length > 0}>
            Nada listado para hoy — pregunta en barra qué hay en pantallas.
          </p>
          <ul class="fixture-list" hidden={today.length === 0}>
            {today.map((f) => (
              <li
                data-date-key={f.dateKey}
                data-madrid-time={f.madridTime}
                data-duration-min={String(f.approxDurationMin ?? 180)}
              >
                <span class="fx-time">{f.madridTime}</span>
                <span class="fx-body">
                  <strong>{f.teams}</strong>
                  <em>{f.competition}</em>
                  {f.confirmedOnScreens && <span class="fx-status fx-status-confirmed">Confirmado en pantallas esta noche</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>
        <div class="fixture-col" data-fixture-slot="week">
          <h2>Próximos partidos</h2>
          <p class="empty-slot" data-fixture-empty hidden={week.length > 0}>
            La lista de esta semana aparecerá aquí cuando los partidos estén listos.
          </p>
          <ul class="fixture-list" hidden={week.length === 0}>
            {week.map((f) => (
              <li
                data-date-key={f.dateKey}
                data-madrid-time={f.madridTime}
                data-duration-min={String(f.approxDurationMin ?? 180)}
              >
                <span class="fx-day">{whenLabelEs(f.dateKey)}</span>
                <span class="fx-time">{f.madridTime}</span>
                <span class="fx-body">
                  <strong>{f.teams}</strong>
                  <em>{f.competition}</em>
                  {f.confirmedOnScreens && <span class="fx-status fx-status-confirmed">Confirmado en pantallas esta noche</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <FixtureAntiStale />
      <p class="fx-note">
        Horarios en hora de Madrid (CEST). «Confirmado en pantallas esta noche» indica confirmación de Dubliners para hoy; no se anuncian otros partidos como emisiones.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
        <a class="btn btn-primary" href={withBase('/es/contacto/')}>Contacto</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Dónde ver fútbol en Madrid (cerca de Sol)</h2>
      <p>
        Dubliners es un pub irlandés / bar deportivo junto a Puerta del Sol — Espoz y Mina 7, Metro Sol o Sevilla.
        Ponemos fútbol y otro deporte en pantallas cuando hay partido. Usa el tablero de arriba para
        hoy y esta semana; si un partido no está listado, no lo afirmamos — pregunta en barra.
      </p>
      <p>
        Más contexto:
        <a href={withBase('/es/bar-deportivo-madrid/')}>bar deportivo Madrid cerca de Sol</a> ·
        <a href={withBase('/es/champions-league-bar-madrid/')}>pantallas Champions League</a> ·
        <a href={withBase('/es/premier-league-pub-madrid/')}>noches de Premier League</a>.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div>
        <h2>MIÉRCOLES · CHUPITOS A 1 €</h2>
        <p>
          Promo propia de Dubliners: chupitos a 1 € en el pub. Pregunta en barra los detalles.
        </p>
        <a class="btn btn-secondary" href={withBase('/es/miercoles-chupitos-1-euro/')}>Miércoles chupitos a 1 € →</a>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/bar-interior-sm.webp')} 800w, ${withBase('/images/bar-interior.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img src={withBase('/images/bar-interior.jpg')} alt="Interior del bar en Dubliners" class="split-photo landscape" width="1400" height="788" loading="lazy" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Más noches de partido</h2>
      <ul>
        <li><a href={withBase('/es/bar-deportivo-madrid/')}>Bar deportivo Madrid</a></li>
        <li><a href={withBase('/es/ver-futbol-madrid/')}>Ver fútbol en Madrid</a></li>
        <li><a href={withBase('/es/premier-league-pub-madrid/')}>Pub Premier League</a></li>
        <li><a href={withBase('/es/champions-league-bar-madrid/')}>Bar Champions League</a></li>
      </ul>
      <h2>Visitar</h2>
      <p>{SITE.address}, {SITE.postal} · <a href={withBase('/es/visitar/')}>Horario y mapa</a></p>
    </div>
  </section>
</BaseLayout>
