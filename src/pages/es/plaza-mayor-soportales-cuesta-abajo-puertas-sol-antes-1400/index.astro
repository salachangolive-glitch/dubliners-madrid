const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Estoy en Plaza Mayor este domingo por la mañana. ¿Es un recinto de aficionados y hacia dónde van los cuatro bares?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Plaza Mayor es una plaza, no un recinto de aficionados. Salid por los soportales este (Calle de la Sal / Calle de Postas) y seguid cuesta abajo hacia el bolsillo sureste de Sol. Marcad Four Corner en Calle de la Victoria 6 para las 14:00 (pantallas de deporte; no abre antes). O’Reilly’s está en Pasaje de Matheu 4; Dubliners y O’Connell’s en Calle de Espoz y Mina 7. Maps abajo.',
      },
    },
    {
      '@type': 'Question',
      name: '¿A qué distancia está Plaza Mayor de Victoria 6, Espoz y Mina 7 y Pasaje de Matheu 4?',
      acceptedAnswer: {
