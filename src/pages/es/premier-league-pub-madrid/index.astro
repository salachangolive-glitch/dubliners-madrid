---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import { SITE, withBase } from '../../../site';

const title = 'Pub Premier League Madrid | Ver PL cerca de Sol — Dubliners';
const description =
  'Premier League en pantallas cerca de Sol. Pub irlandés, Espoz y Mina 7.';
---

<BaseLayout title={title} description={description} path="/es/premier-league-pub-madrid/" lang="es" ogImage="/images/screens-sports.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Pub Premier League Madrid" lang="es" />
        <h1>Premier League cerca de Sol</h1>
        <p class="lead">
          Fútbol inglés en pantallas en Dubliners cuando hay PL —
          Espoz y Mina 7, a un paseo de la plaza. Llega pronto en los partidos grandes.
        </p>
        <CtaRow lang="es" />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 45vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/screens-sports.jpg')} alt="Premier League en pantallas en Dubliners" width="1400" height="788" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>Dónde</h3>
          <p>A unos dos minutos de Puerta del Sol.</p>
        </article>
        <article class="card">
          <h3>Cómo</h3>
          <p>Metro Sol / Sevilla y a pie. Sin reserva de mesa.</p>
        </article>
        <article class="card">
          <h3>Qué ver hoy</h3>
          <p><a href={withBase('/es/partidos/')}>Lista de esta semana</a> · <a href={withBase('/es/contacto/')}>Contacto</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Fútbol inglés en el centro</h2>
      <p>
        Organiza el partido por Sol y míralo en Dubliners.
        Relacionado: <a href={withBase('/es/ver-futbol-madrid/')}>ver fútbol en Madrid</a>,
        <a href={withBase('/es/champions-league-bar-madrid/')}>Champions League</a>,
        <a href={withBase('/es/bar-deportivo-madrid/')}>bar deportivo</a>.
      </p>
      <div class="faq">
        <details>
          <summary>¿Hay que reservar?</summary>
          <p>No. Llega pronto en los partidos grandes.</p>
        </details>
        <details>
          <summary>Dirección</summary>
          <p>{SITE.address}, {SITE.postal}</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
