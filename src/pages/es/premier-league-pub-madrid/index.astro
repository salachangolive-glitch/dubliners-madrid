---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import { SITE, withBase } from '../../../site';

const title = 'Pub Premier League Madrid | Ver PL cerca de Sol — Dubliners';
const description =
  'Pub Premier League en Madrid cerca de Puerta del Sol. Fútbol inglés en pantallas indoor. Pub irlandés walk-in, Espoz y Mina 7.';
---

<BaseLayout title={title} description={description} path="/es/premier-league-pub-madrid/" lang="es" ogImage="/images/screens-sports.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Pub Premier League Madrid" lang="es" />
        <h1>Pub Premier League Madrid — cerca de Sol</h1>
        <p class="lead">
          Viajeros, residentes y fines de semana en la ciudad: Dubliners es un pub irlandés
          con pantallas indoor en Espoz y Mina 7. Premier League cuando se echa — llega pronto en los grandes.
        </p>
        <CtaRow lang="es" />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 45vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/screens-sports.jpg')} alt="Noches de Premier League en pantallas en Dubliners Madrid" width="1400" height="788" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>Dónde</h3>
          <p>A dos minutos de Puerta del Sol — perfecto si tu hotel ya está en el centro.</p>
        </article>
        <article class="card">
          <h3>Cómo</h3>
          <p>Metro Sol / Sevilla y a pie. Sin reserva de mesa.</p>
        </article>
        <article class="card">
          <h3>Qué ver hoy</h3>
          <p><a href={withBase('/es/partidos/')}>Lista de esta semana</a> · <a href={withBase('/es/contacto/')}>Contacto</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Fútbol inglés en un pub de Sol</h2>
      <p>
        Organiza el sábado o la media semana alrededor del pitido y haz de Dubliners tu punto de visionado.
        Relacionado: <a href={withBase('/es/ver-futbol-madrid/')}>ver fútbol en Madrid</a>,
        <a href={withBase('/es/champions-league-bar-madrid/')}>Champions League</a>,
        <a href={withBase('/es/bar-deportivo-madrid/')}>bar deportivo</a>.
      </p>
      <div class="faq">
        <details>
          <summary>¿Hay que reservar?</summary>
          <p>No — solo walk-in. Llega pronto en los partidos grandes.</p>
        </details>
        <details>
          <summary>Dirección</summary>
          <p>{SITE.address}, {SITE.postal}</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
