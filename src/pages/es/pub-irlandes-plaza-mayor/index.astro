---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import LinkHub from '../../../components/LinkHub.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import FanWeekendCtas from '../../../components/FanWeekendCtas.astro';
import FourBarsMeet from '../../../components/FourBarsMeet.astro';
import { SITE, withBase } from '../../../site';
import { isFanWeekendLive } from '../../../data/fourBars';

const fanWeekend = isFanWeekendLive();

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "¿A qué distancia está Dubliners de Plaza Mayor?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "A pocos pasos: por la Puerta del Sol hasta la calle de Espoz y Mina 7."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué horario tiene?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "De lunes a jueves y domingo de 12:00 a 02:00; viernes y sábado de 12:00 a 02:30."
      }
    },
    {
      "@type": "Question",
      "name": "¿Qué canales de deporte tenéis?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "DAZN, Movistar y Premier Sports. Los partidos confirmados y su hora de Madrid están en Partidos."
      }
    }
  ]
};
const title = "Pub irlandés Madrid cerca de Plaza Mayor y Puerta del Sol | Dubliners";
const description = "Pub irlandés Madrid y bar deportivo a pocos pasos de Plaza Mayor, junto a Puerta del Sol: Espoz y Mina 7. Bar irlandés en Madrid con deporte en directo. CÓMO LLEGAR.";
---

<BaseLayout title={title} description={description} path="/es/pub-irlandes-plaza-mayor/" lang="es" ogImage="/images/facade.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Cerca de Plaza Mayor" lang="es" />
      <h1>Pub irlandés Madrid cerca de Plaza Mayor y Puerta del Sol</h1>
      <p class="lead">¿De paseo por Plaza Mayor y Sol? Dubliners está a pocos pasos, en la calle de Espoz y Mina 7 — un pub irlandés Madrid y bar deportivo con atención en inglés y deporte en directo. Bar irlandés en Madrid, junto a la plaza.</p>
      {fanWeekend ? (
        <FanWeekendCtas lang="es" />
      ) : (
        <div class="cta-row">
          <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">CÓMO LLEGAR</a>
          <a class="btn btn-secondary" href={withBase('/es/partidos/')}>Partidos</a>
        </div>
      )}
    </div>
  </section>
  {fanWeekend && <FourBarsMeet lang="es" />}
  <section class="section">
    <div class="container prose">
      <h2>Andando desde Plaza Mayor</h2>
      <ol><li>Sal de Plaza Mayor hacia la calle Mayor y camina hasta la <strong>Puerta del Sol</strong>.</li><li>Desde Sol, entra en la <strong>calle de Espoz y Mina</strong>, hacia Carrera de San Jerónimo / Sevilla.</li><li>Busca el <strong>neón verde de Dubliners</strong> en el número 7 y entra.</li></ol>
      <h2>En metro</h2>
      <p>Sol (L1, L2, L3) o Sevilla (L2), ambas a un paseo corto.</p>
      <h2>Por qué pasar</h2>
      <p>
        Deporte en directo en DAZN, Movistar y Premier Sports, el techo pintado histórico de la antigua sastrería Barragán (1885) y chupitos a 1 € todos los miércoles.
        La misma puerta que las páginas de <a href={withBase('/es/bar-deportivo-madrid/')}>bar deportivo Sol Madrid</a>,
        <a href={withBase('/es/premier-league-pub-madrid/')}>pub Premier League Madrid</a> y
        <a href={withBase('/es/nfl-madrid/')}>bar NFL Madrid</a>. Listados con nombre: <a href={withBase('/es/partidos/')}>Partidos</a>.
      </p>
      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Planea tu visita',
            items: [
              { href: '/es/visitar/', label: 'FIND US — mapa y CÓMO LLEGAR' },
              { href: '/es/partidos/', label: 'Partidos' },
              { href: '/es/bar-deportivo-madrid/', label: 'Bar deportivo Sol Madrid' },
              { href: '/es/premier-league-pub-madrid/', label: 'Pub Premier League Madrid' },
              { href: '/es/miercoles-chupitos-1-euro/', label: 'Miércoles chupitos a 1 €' },
              { href: '/es/estudiantes-internacionales/', label: 'Erasmus y estudiantes internacionales' },
            ],
          },
        ]}
      />
      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>¿A qué distancia está Dubliners de Plaza Mayor?</strong></dt>
        <dd>A pocos pasos: por la Puerta del Sol hasta la calle de Espoz y Mina 7.</dd>
        <dt><strong>¿Qué horario tiene?</strong></dt>
        <dd>De lunes a jueves y domingo de 12:00 a 02:00; viernes y sábado de 12:00 a 02:30.</dd>
        <dt><strong>¿Qué canales de deporte tenéis?</strong></dt>
        <dd>DAZN, Movistar y Premier Sports. Los partidos confirmados y su hora de Madrid están en Partidos.</dd>
      </dl>
      <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    </div>
  </section>
</BaseLayout>
