---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../../data/fourBars';

const PATH = '/es/quedada-1800-pasaje-matheu-espoz-mina/';
const PATH_EN = '/meetup-1800-pasaje-matheu-espoz-mina/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Quedada 18:00–19:00: Pasaje de Matheu 4 a Espoz y Mina 7',
  inLanguage: 'es',
  datePublished: '2026-11-07T18:30:00+01:00',
  dateModified: '2026-11-07T18:30:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Dónde quedamos entre las 18:00 y las 19:00 esta noche?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Tres puertas, dos calles: O’Reilly’s en Pasaje de Matheu 4, luego Dubliners y O’Connell’s en Calle de Espoz y Mina 7. Four Corner en Calle de la Victoria 6 no abre esta noche.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Cuánto se tarda entre las puertas de la quedada?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Pasaje de Matheu 4 y Espoz y Mina 7 están en el mismo rincón al sureste de Sol. El paseo es de un par de minutos: un pasaje y la calle siguiente. No hace falta taxi.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Hay NFL en directo durante la quedada?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. El sábado 7 de noviembre no hay partido oficial de la NFL. Después de la quedada, Valencia–Real Madrid a las 21:00 va EN DIRECTO solo en Dubliners.',
      },
    },
  ],
};
---

<BaseLayout
  title="Quedada 18:00–19:00: Pasaje de Matheu a Espoz y Mina | Dubliners"
  description="Esta noche 18:00–19:00: anda de O’Reilly’s (Pasaje de Matheu 4) a Dubliners y O’Connell’s (Espoz y Mina 7). Hoy no hay NFL. Maps. Four Corner domingo 14:00."
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Quedada 18:00–19:00" lang="es" schema />
      <h1>Quedada 18:00–19:00: anda de Pasaje de Matheu 4 a Espoz y Mina 7</h1>
      <p class="lead">
        Esta noche las tres salas del sábado coinciden una hora. Empieza en la terraza de O’Reilly’s (Pasaje de Matheu 4)
        y en dos minutos estás en Dubliners y O’Connell’s (Espoz y Mina 7). <strong>Four Corner no es esta noche.</strong>
        Hoy no hay NFL oficial — quedaos para Valencia–Real Madrid a las 21:00 en Dubliners.
      </p>
      <p class="small">In English: <a href={withBase(PATH_EN)} hreflang="en" lang="en">Meetup 18:00–19:00: Pasaje de Matheu to Espoz y Mina</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's en Maps</a>
        <a class="btn btn-secondary" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners en Maps</a>
        <a class="btn btn-secondary" data-track-event="directions_click" href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell's en Maps</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>La hora en que las tres puertas del sábado están abiertas</h2>
      <p>
        O’Reilly’s lleva abierto desde las 11:30. Dubliners desde las 12:00. O’Connell’s desde las 15:00.
        De <strong>18:00 a 19:00</strong> podéis elegir cualquiera de los tres sin comprobar quién sigue cerrado.
        Usad esa hora para juntar al grupo que llega de distintos hoteles alrededor de Sol.
      </p>
      <ol>
        <li>
          <strong>18:00 — Pasaje de Matheu 4.</strong> La terraza de O’Reilly’s es el hito fácil si alguien llega tarde.
          Pin <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's en Maps</a>.
        </li>
        <li>
          <strong>Luego Espoz y Mina 7.</strong> Andad el pasaje hacia Santa Ana; Dubliners y O’Connell’s comparten número.
          Dos puertas, dos salas. Pin
          <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners</a>
          y <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell's</a>.
        </li>
        <li>
          <strong>Después de las 19:00.</strong> Si queréis asiento con pantalla para Valencia–Real Madrid a las 21:00, quedaos en Dubliners.
          Esa retransmisión está confirmada solo aquí.
        </li>
      </ol>
      <p>
        No mandéis a nadie a la Calle de la Victoria 6 esta noche. Four Corner abre el <strong>domingo desde las 14:00</strong> con pantallas de deporte.
      </p>

      <OriginalFourBars lang="es" when="tonight" findHref="#los-cuatro-bares-hermanos" />

      <h2 id="los-cuatro-bares-hermanos">Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>¿Dónde quedamos entre las 18:00 y las 19:00 esta noche?</strong></dt>
        <dd>O’Reilly’s (Pasaje de Matheu 4), luego Dubliners y O’Connell’s (Espoz y Mina 7). Four Corner es el domingo.</dd>
        <dt><strong>¿Cuánto se tarda entre las puertas de la quedada?</strong></dt>
        <dd>Un par de minutos en el mismo rincón al sureste de Sol. Sin taxi.</dd>
        <dt><strong>¿Hay NFL en directo durante la quedada?</strong></dt>
        <dd>No. El sábado no hay partido oficial de la NFL. Valencia–Real Madrid 21:00 EN DIRECTO solo en Dubliners.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Esta noche y el domingo',
            until: SHOW_UNTIL,
            items: [
              { href: '/es/', label: 'Inicio Dubliners' },
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'VER LOS CUATRO BARES', note: 'Hub de los cuatro' },
              { href: '/es/fin-de-semana-nfl-ya-se-vive/', label: 'El fin de semana NFL ya se vive', note: 'Quedada' },
              { href: '/es/sabado-noche-sol-valencia-real-madrid/', label: 'Valencia–Real Madrid 21:00', note: 'Solo Dubliners' },
              { href: '/es/andar-sol-cuatro-bares-hermanos/', label: 'Andar desde Sol a los cuatro bares' },
              { href: PATH_EN, label: 'Meetup 18:00–19:00', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
