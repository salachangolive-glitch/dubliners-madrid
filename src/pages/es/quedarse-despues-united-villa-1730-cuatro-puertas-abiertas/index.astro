import { withBase, absUrl } from '../../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../../data/fourBars';

const PATH = '/es/quedarse-despues-united-villa-1730-cuatro-puertas-abiertas/';
const PATH_EN = '/stay-after-united-villa-1730-four-open-doors/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Después de United–Villa 17:30: quedarse en las cuatro puertas abiertas de Sol para la NFL 19:00, luego Atlético–Barcelona 21:00',
  inLanguage: 'es',
  datePublished: '2026-11-08T17:00:00+01:00',
  dateModified: '2026-11-08T17:00:00+01:00',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'United vs Villa acaba a las 17:30. ¿Salimos de Sol antes de la NFL 19:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Quedaos en las cuatro puertas hermanas abiertas junto a Puerta del Sol. Four Corner, Calle de la Victoria 6, está abierto (desde las 14:00 hasta la madrugada, pantallas de deporte). Dubliners y O’Connell’s en Calle de Espoz y Mina 7. O’Reilly’s en Pasaje de Matheu 4. NFL 19:00 y Atlético–Barcelona 21:00 con nombre: solo Partidos de Dubliners. Preguntad qué echan. Premier 17:30 va a la vez; no sustituyáis.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Esto es la página de después del Madrid Game, la de RedZone o la parrilla de tarde-noche?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Después del Madrid Game es el pin de salida del estadio / silbato 15:30. RedZone es qué pantalla pedir a las 19:00. NFL tarde-noche son los relojes 15:30 y luego noche. United–Villa es la quedada de las 17:30. Esta página es solo el puente de quedarse sentados después de ese silbato Premier: ya en las cuatro puertas abiertas, siguientes relojes 19:00 y 21:00.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Quedarse después de las 17:30 sustituye Premier, NFL o Atlético–Barcelona?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Coordinad; no sustituyáis. United–Villa 17:30 está en Partidos de Dubliners con la NFL de después desde las 19:00 (RedZone desde las 19:00) y Atlético vs Barcelona 21:00. No asignamos esos partidos a O’Reilly’s, O’Connell’s ni Four Corner. Preguntad qué pantalla.',
      },
    },
  ],
};
---

<BaseLayout
  title="Después de United–Villa 17:30: quedarse en las cuatro puertas abiertas | Dubliners"
  description="Domingo 8 nov: United–Villa 17:30 ha acabado. Quedaos en las cuatro puertas abiertas de Sol — ya en servicio — para la NFL 19:00 y luego Atlético–Barcelona 21:00. Maps. FIND US."
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Después de United–Villa 17:30: quedarse en las cuatro puertas abiertas" schema />
      <h1>Después de United–Villa 17:30: quedarse en las cuatro puertas abiertas de Sol para la NFL 19:00, luego Atleti 21:00</h1>
      <p class="lead">
        El silbato Premier a las <strong>17:30</strong> no es para salir de Sol.
        Ya estáis en una de las cuatro puertas hermanas — todas <strong>abiertas AHORA</strong> —
        Four Corner en Calle de la Victoria 6 (desde las 14:00 hasta la madrugada, pantallas de deporte),
        Dubliners y O’Connell’s en Espoz y Mina 7, O’Reilly’s en Pasaje de Matheu 4.
        Quedaos sentados. Siguientes relojes con nombre en <a href={withBase('/es/partidos/')}>Partidos</a> de Dubliners: NFL desde las <strong>19:00</strong>, luego Atlético vs Barcelona <strong>21:00</strong>.
        Preguntad qué echan. Maps abajo.
      </p>
      <p class="small">In English: <a href={withBase(PATH_EN)} hreflang="en" lang="en">After United–Villa 17:30: stay at the four open Sol doors</a></p>
      <FanWeekendCtas lang="es" findHref="/es/visitar/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Este es el puente de las 17:30 — no salida del estadio, no RedZone, no la parrilla de tarde</h2>
      <p>
        <a href={withBase('/es/despues-madrid-game-seguir-cuatro-puertas-abiertas/')}>Después del Madrid Game</a> es para quien ya tiene
        el silbato 15:30 del estadio / pantalla grande detrás. <a href={withBase('/es/redzone-domingo-sol-dubliners/')}>RedZone el domingo</a>
        es qué pantalla pedir a las 19:00. <a href={withBase('/es/nfl-tarde-noche-sol-8-nov/')}>NFL tarde y noche</a>
        son los relojes 15:30 y luego noche. <a href={withBase('/es/man-utd-villa-sol-8-nov/')}>United–Villa junto a Sol</a>
        es la quedada de las 17:30.
        Esta página es solo el grupo <strong>que ya está sentado en United vs Villa</strong> y no debe levantarse y dispersarse.
        La quedada de tres bares del sábado ya ha acabado. El domingo son cuatro puertas. No re-promováis 18:00–19:00 como si siguiera.
      </p>

      <h2>El mismo pin — el hueco hasta las 19:00 sigue siendo estas dos calles</h2>
      <p>
        Escribid al grupo <strong>Victoria 6 / Espoz y Mina 7 / Pasaje de Matheu 4</strong>.
        Four Corner <strong>está abierto ahora</strong> (desde las 14:00 hasta la madrugada · pantallas de deporte). No listamos qué echan ahí.
        O’Reilly’s y O’Connell’s son puntos de encuentro del mismo clúster; no copiamos el cartel de Dubliners a esas puertas.
        Listados con nombre: solo Partidos de Dubliners. Preguntad qué pantalla. No está cada partido en cada pantalla.
      </p>
      <ol>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid.</strong>
          Abierto AHORA (desde las 14:00 hasta la madrugada · pantallas de deporte). Preguntad en la puerta.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          Domingo 12:00–02:00. Pantallas con nombre en Partidos. Preguntad qué echan.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (en Maps: O’Connell St).
          Mismo número, otra puerta, otro CID. Punto de encuentro; no inventamos su cartel.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Pasaje cubierto. Habitual desde las 11:30. Punto de encuentro; sin menú inventado.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
      </ol>

      <h2>Qué hay después de las 17:30 — Premier no sustituye NFL ni Atleti</h2>
      <p>
        <a href={withBase('/es/partidos/')}>Partidos</a> de Dubliners ya lista el domingo 8 de noviembre en hora de Madrid.
        Manchester United vs Aston Villa <strong>17:30</strong> va después del bloque Premier 15:00 y Bengals vs Falcons 15:30.
        NFL de después desde las <strong>19:00</strong> luego <strong>22:05</strong> / <strong>22:25</strong>, RedZone desde las 19:00, Atlético vs Barcelona <strong>21:00</strong>.
        Coordinad; no sustituyáis. Listados con nombre: solo Dubliners. No asignamos esos partidos a O’Reilly’s, O’Connell’s ni Four Corner.
      </p>
      <p>
        ¿Aún venís en Metro para las 19:00?
        <a href={withBase('/es/metro-tarde-gran-via-sevilla-a-puertas-sol-abiertas/')}>Metro de tarde desde Gran Vía o Sevilla a las cuatro puertas abiertas</a>.
        ¿Elección de pantalla a las 19:00 cuando os quedáis?
        <a href={withBase('/es/redzone-domingo-sol-dubliners/')}>RedZone o un partido a las 19:00 — preguntad qué pantalla</a>.
      </p>

      <OriginalFourBars lang="es" when="sunday" findHref="/es/visitar/" />

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>United–Villa acaba. ¿Salimos de Sol antes de las 19:00?</strong></dt>
        <dd>No. Quedaos en las cuatro puertas abiertas AHORA: Victoria 6, Espoz y Mina 7 dos veces, Pasaje de Matheu 4. Siguientes relojes 19:00 y 21:00. Preguntad qué echan.</dd>
        <dt><strong>¿Esto es después del Madrid Game, RedZone o la parrilla tarde-noche?</strong></dt>
        <dd>No. Esas páginas son el pin del silbato 15:30, qué pantalla a las 19:00 y los relojes 15:30-luego-noche. Esto es el puente de quedarse sentados después de Premier 17:30.</dd>
        <dt><strong>¿Las 17:30 sustituyen la NFL desde las 19:00 o Atleti 21:00?</strong></dt>
        <dd>No. Coordinad. Esos relojes van a la vez en Partidos de Dubliners. No copiamos ese cartel a las puertas hermanas.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Quedarse después de las 17:30 este domingo',
            until: SHOW_UNTIL,
            items: [
              { href: '/es/', label: 'FIND US — inicio Dubliners' },
              { href: '/es/visitar/', label: 'CÓMO LLEGAR — visitar / horario' },
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'VER LOS CUATRO BARES' },
              { href: '/es/metro-tarde-gran-via-sevilla-a-puertas-sol-abiertas/', label: 'Metro de tarde: Gran Vía o Sevilla a las cuatro puertas abiertas' },
              { href: '/es/partidos/', label: 'Partidos — pantallas con nombre' },
              { href: PATH_EN, label: 'After United–Villa 17:30: stay at the four open Sol doors', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
