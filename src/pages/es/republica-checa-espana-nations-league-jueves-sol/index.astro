---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import MapEmbed from '../../../components/MapEmbed.astro';
import { SITE, withBase, absUrl } from '../../../site';

const PATH = '/es/republica-checa-espana-nations-league-jueves-sol/';
const PATH_EN = '/czechia-spain-nations-league-thursday-sol/';
const title = 'República Checa–España jueves Nations League desde Sol | Dubliners';
const description =
  'España juega en Praga el jueves 12 de noviembre, 20:45, Nations League en La 1 en el pub irlandés Dubliners, Espoz y Mina 7, junto a Puerta del Sol.';
const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: 'República Checa vs España — UEFA Nations League (emisión en Dubliners Madrid)',
  description:
    'República Checa vs España (UEFA Nations League, Praga) en pantalla en Dubliners Irish Pub, Espoz y Mina 7, junto a Puerta del Sol, Madrid. Emisión: La 1.',
  startDate: '2026-11-12T20:45:00+01:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'BarOrPub',
    name: 'Dubliners Irish Pub',
    alternateName: 'Dubliners Madrid',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Calle de Espoz y Mina 7',
      addressLocality: 'Madrid',
      postalCode: '28012',
      addressCountry: 'ES',
    },
    geo: { '@type': 'GeoCoordinates', latitude: 40.4158342, longitude: -3.7022626 },
    hasMap: SITE.mapsUrl,
  },
  organizer: { '@type': 'BarOrPub', name: 'Dubliners Irish Pub', url: absUrl('/') },
  homeTeam: { '@type': 'SportsTeam', name: 'Spain' },
  awayTeam: { '@type': 'SportsTeam', name: 'Czechia' },
  url: absUrl(PATH),
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Cuándo es República Checa–España el jueves?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Jueves 12 de noviembre de 2026, saque 20:45 hora Madrid. El partido es en Praga; lo emitimos en La 1 cuando figura en Partidos.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Es la guía España–Inglaterra en el Metropolitano?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Aficionados ingleses cubre el domingo 15 de noviembre en estadio. Esta página es La Roja fuera en Praga, jueves por la noche desde nuestro pub junto a Sol.',
      },
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/dubliners-champions-night-screens-1200.webp"
  extraJsonLd={[eventLd, faqLd]}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="República Checa–España, jueves" lang="es" schema />
      <h1>La Roja en Praga — jueves desde Sol</h1>
      <p class="lead">
        Pausa de selecciones, pero el <strong>jueves 12 de noviembre</strong> hay partido de España:
        <strong>República Checa–España</strong>, Nations League, <strong>20:45</strong> hora Madrid, en Praga,
        <strong>La 1</strong> en nuestras pantallas cuando aparece en <a href={withBase('/es/partidos/')}>Partidos</a>.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">CÓMO LLEGAR</a>
        <a class="btn btn-secondary" href={withBase('/es/partidos/')}>Partidos</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Qué es (y qué no es)</h2>
      <p>
        Es una <strong>nota de emisión del jueves</strong> para quien está en el centro — no guía de estadio. El
        <a href={withBase('/england-fans-madrid/')}>España–Inglaterra del domingo 15 en el Metropolitano</a> es otro
        partido y otra página. Sin precios, sin entradas, sin canales no verificados.
      </p>

      <h2>Jueves 12 de noviembre · 20:45</h2>
      <p>
        <strong>República Checa–España</strong> (UEFA Nations League). Saque <strong>20:45</strong> Madrid. Se juega en
        <strong>Praga</strong> — síguelo dentro en Dubliners, Calle de Espoz y Mina 7, a dos calles de Puerta del Sol.
        Inglés en barra; público mezclado. Canal en cartel: <strong>La 1</strong> (como en Partidos).
      </p>

      <h2>Mismo jueves, otro reloj</h2>
      <p>
        Después, a las <strong>21:00</strong>, EuroLeague: Real Madrid–Crvena Zvezda (<strong>Movistar+ Baloncesto</strong>),
        Movistar Arena. Punto de encuentro en pantalla para visitantes de baloncesto:
        <a href={withBase('/red-star-fans-madrid/')}>aficionados del Estrella Roja en Madrid</a> (en inglés). Elige un saque o quédate a los dos — pregunta en barra qué pantalla es cada uno.
      </p>

      <h2>Martes 11 de noviembre</h2>
      <p>
        Esta noche no hay España. El midweek en la sala de la sastrería sigue valiendo —
        <a href={withBase('/es/martes-en-la-sastreria-barragan-junto-a-sol/')}>martes en la sastrería Barragán</a>.
        Mañana es miércoles de <a href={withBase('/es/miercoles-chupitos-1-euro/')}>chupitos a 1 €</a> (pregunta al llegar).
      </p>

      <div class="map-frame">
        <MapEmbed lang="es" title="Mapa a Dubliners — Nations League jueves" />
      </div>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Relacionado (no este partido del jueves)',
            items: [
              { href: '/england-fans-madrid/', label: 'Aficionados ingleses — dom 15', note: 'Estadio, no Praga' },
              { href: '/red-star-fans-madrid/', label: 'Estrella Roja — EuroLeague 21:00', note: 'Baloncesto, mismo jueves' },
              { href: '/irish-double-saturday-madrid/', label: 'Irlanda–Fiyi sábado', note: 'Rugby, no Nations League' },
              { href: '/es/bar-deportivo-madrid/', label: 'Bar deportivo junto a Sol', note: 'Cómo funcionan las pantallas' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
