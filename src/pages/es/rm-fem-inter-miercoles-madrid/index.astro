---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import MapEmbed from '../../../components/MapEmbed.astro';
import { SITE, withBase, absUrl } from '../../../site';
import { OPENING_HOURS } from '../../../data/hours';

const PATH = '/es/rm-fem-inter-miercoles-madrid/';
const PATH_EN = '/rm-fem-inter-wednesday-madrid/';
const wed = OPENING_HOURS.find((d) => d.day === 'Wednesday')!;

const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: 'Real Madrid Femenino vs Inter — UWCL (en directo en Dubliners Madrid)',
  description:
    'Real Madrid Femenino vs Inter de Milán (UEFA Women’s Champions League) en directo en las pantallas de Dubliners Irish Pub, Espoz y Mina 7, junto a Puerta del Sol, Madrid.',
  startDate: '2026-11-18T18:45:00+01:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'BarOrPub',
    name: 'Dubliners Irish Pub',
    alternateName: 'Dubliners Madrid',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Calle de Espoz y Mina 7',
      addressLocality: 'Madrid',
      postalCode: '28012',
      addressCountry: 'ES',
    },
    geo: { '@type': 'GeoCoordinates', latitude: 40.4158342, longitude: -3.7022626 },
    hasMap: SITE.mapsUrl,
  },
  organizer: { '@type': 'BarOrPub', name: 'Dubliners Irish Pub', url: absUrl('/') },
  homeTeam: { '@type': 'SportsTeam', name: 'Real Madrid Femenino' },
  awayTeam: { '@type': 'SportsTeam', name: 'Inter Milano' },
  url: absUrl(PATH),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Dónde ver Real Madrid Femenino–Inter en Madrid?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'En Dubliners Irish Pub, Calle de Espoz y Mina 7, junto a Puerta del Sol. Saque 18:45 hora Madrid el miércoles 18 de noviembre de 2026. EN DIRECTO en pantalla. Sin reservas.',
      },
    },
  ],
};
---

<BaseLayout
  title={'Dónde ver Real Madrid Femenino–Inter en Madrid | Dubliners'}
  description={'Miércoles 18 nov: Real Madrid Femenino–Inter, UWCL, 18:45 hora Madrid. EN DIRECTO en Dubliners junto a Sol — punto de encuentro para aficionados visitantes. Sin reservas.'}
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/dubliners-champions-night-screens-1200.webp"
  extraJsonLd={[eventLd, faqLd]}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="RM Fem–Inter, mié 18 nov" lang="es" schema />
      <h1>Dónde ver Real Madrid Femenino–Inter en Madrid</h1>
      <p class="lead">
        <strong>Miércoles 18 de noviembre de 2026</strong> — UEFA Women’s Champions League:
        <strong>Real Madrid Femenino–Inter</strong>, saque <strong>18:45 hora Madrid</strong>.
        Aficionados visitantes y locales en <strong>Dubliners</strong> como <strong>punto de encuentro</strong> junto a
        <strong>Puerta del Sol</strong>. Partido <strong>EN DIRECTO en nuestras pantallas</strong>. No nombramos marcas de emisión aquí.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">CÓMO LLEGAR</a>
        <a class="btn btn-secondary" href={withBase('/es/partidos/')}>Partidos</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>El partido (hora Madrid)</h2>
      <p>
        <strong>18:45</strong> — Real Madrid Femenino vs Inter de Milán, UEFA Women’s Champions League. Confirmado en pantalla en Dubliners cuando consta en
        <a href={withBase('/es/partidos/')}>Partidos</a>.
      </p>

      <h2>Punto de encuentro junto a Sol</h2>
      <p>
        Pub irlandés interior, inglés en barra, público internacional. Queda con aficionados del Inter o amigos antes del saque, o mira el partido completo aquí.
        <strong>Sin reservas de mesa</strong> — acceso por orden de llegada.
      </p>

      <h2>Cómo llegar</h2>
      <p>
        <strong>{SITE.address}</strong>, {SITE.postal}. Metro <strong>Sol</strong> (líneas 1, 2 y 3) o <strong>Sevilla</strong> (línea 2).
      </p>

      <h2>Horario (miércoles)</h2>
      <p>
        Abrimos <strong>{wed.opens}–{wed.closes}</strong> el miércoles.
      </p>

      <div class="map-frame">
        <MapEmbed lang="es" title="Mapa a Dubliners — UWCL miércoles junto a Sol" />
      </div>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Relacionado',
            items: [
              { href: '/es/partidos/', label: 'Partidos de esta semana' },
              { href: '/es/champions-league-bar-madrid/', label: 'Champions League junto a Sol' },
              { href: '/es/bar-deportivo-madrid/', label: 'Bar deportivo junto a Sol' },
              { href: '/es/visitar/', label: 'VISITAR' },
            ],
          },
        ]}
      />
      <p class="small">Dubliners es un pub independiente, sin vínculo con la UEFA ni los clubes.</p>
    </div>
  </section>
</BaseLayout>