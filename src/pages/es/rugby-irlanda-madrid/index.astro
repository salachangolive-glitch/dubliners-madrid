---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { SITE, withBase, absUrl } from '../../../site';

// Ireland men, November 2026 (Rugby Nations Championship). Rows already in src/data/fixtures.ts (confirmedOnScreens):
// Fri 6 Nov Ireland v Argentina 21:10, Sat 14 Nov Ireland v Fiji 21:10, Sat 21 Nov Ireland v South Africa 17:40 (Madrid, CET).
// Source per fixtures.ts: irishrugby.ie fixtures (20:10 / 16:40 Irish time) + World Rugby API, checked 20 Oct. Venue not stated (not in repo).
// Created 20 Oct (DG): Radar had checked this URL (404). Review after 21 Nov (PENDIENTES.md).
const path = '/es/rugby-irlanda-madrid/';
const games = [
  { name: 'Irlanda–Argentina', start: '2026-11-06T21:10:00+01:00', away: 'Argentina' },
  { name: 'Irlanda–Fiyi', start: '2026-11-14T21:10:00+01:00', away: 'Fiji' },
  { name: 'Irlanda–Sudáfrica', start: '2026-11-21T17:40:00+01:00', away: 'South Africa' },
];
const eventsLd = games.map((g) => ({
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${g.name} — Rugby Nations Championship (en Dubliners Madrid)`,
  description: `${g.name} (rugby) en directo en las pantallas de Dubliners Irish Pub, Espoz y Mina 7, junto a la Puerta del Sol, Madrid.`,
  startDate: g.start,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'BarOrPub',
    name: 'Dubliners Irish Pub',
    alternateName: 'Dubliners Madrid',
    address: { '@type': 'PostalAddress', streetAddress: 'Calle de Espoz y Mina 7', addressLocality: 'Madrid', postalCode: '28012', addressCountry: 'ES' },
    geo: { '@type': 'GeoCoordinates', latitude: 40.4158342, longitude: -3.7022626 },
    hasMap: SITE.gbpUrl,
  },
  organizer: { '@type': 'BarOrPub', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  homeTeam: { '@type': 'SportsTeam', name: 'Ireland' },
  awayTeam: { '@type': 'SportsTeam', name: g.away },
  url: absUrl(path),
}));
---

<BaseLayout title={'Rugby de Irlanda en Madrid: Argentina, Fiyi y Sudáfrica, nov 2026 | Dubliners'} description={'Ver a Irlanda en Madrid: contra Argentina (vie 6 nov, 21:10), Fiyi (sáb 14 nov, 21:10) y Sudáfrica (sáb 21 nov, 17:40). En directo en Dubliners, pub irlandés junto a la Puerta del Sol.'} path={path} lang="es" ogImage="/images/dubliners-projector-screens-sol-1200.webp" extraJsonLd={eventsLd}>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current={'Rugby de Irlanda en Madrid'} lang="es" schema />
      <h1>Rugby de Irlanda en Madrid: los partidos de noviembre</h1>
      <p class="lead">Tres partidos de Irlanda en noviembre, todos en directo en el proyector grande y las 8 pantallas de Dubliners, un pub irlandés en el centro de Madrid, junto a la Puerta del Sol. Madrid va una hora por delante de Irlanda.</p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.gbpUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
        <a class="btn btn-primary" href={withBase('/es/partidos/')}>Partidos</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <div class="prose">
<h2>Horarios (hora de Madrid)</h2>
<ul>
  <li><strong>Viernes 6 de noviembre:</strong> Irlanda–Argentina, 21:10 (20:10 en Irlanda).</li>
  <li><strong>Sábado 14 de noviembre:</strong> Irlanda–Fiyi, 21:10 (20:10 en Irlanda).</li>
  <li><strong>Sábado 21 de noviembre:</strong> Irlanda–Sudáfrica, 17:40 (16:40 en Irlanda).</li>
</ul>
<h2>Punto de encuentro de aficionados irlandeses</h2>
<p>¿Vives en Madrid, estás de Erasmus o has venido a pasar el fin de semana? Dubliners es un punto de encuentro de aficionados irlandeses y de quien siga el rugby: cerveza en la barra, el partido en todas las pantallas y gente de Irlanda, de España y de muchos otros sitios. Los grupos son bienvenidos; si tienes alguna pregunta, escríbenos desde la <a href={withBase('/es/contacto/')}>página de contacto</a>.</p>
<h2>Horario y dirección</h2>
<p>Lunes a jueves y domingo de 12:00 a 02:00. Viernes y sábado de 12:00 a 02:30.<br />{SITE.address}, {SITE.postal}, junto a la Puerta del Sol. <a href={withBase('/es/visitar/')}>Horario y mapa</a></p>
      </div>
      <picture><img class="split-photo tall" src={withBase('/images/dubliners-projector-screens-sol-1200.webp')} srcset={`${withBase('/images/dubliners-projector-screens-sol-800.webp')} 800w, ${withBase('/images/dubliners-projector-screens-sol-1200.webp')} 1200w`} sizes="(max-width: 800px) 100vw, 720px" width="1200" height="1600" loading="lazy" decoding="async" alt="Proyector grande y pantallas en la sala principal de Dubliners, junto a Sol" /></picture>
    </div>
  </section>
  <section class="section band">
    <div class="container prose">
<h2>Preguntas frecuentes</h2>
<dl class="faq">
  <dt><strong>¿Ponéis los tres partidos de Irlanda?</strong></dt><dd>Sí: Irlanda–Argentina (6 nov), Irlanda–Fiyi (14 nov) e Irlanda–Sudáfrica (21 nov), en directo.</dd>
  <dt><strong>¿A qué hora abrís?</strong></dt><dd>Todos los días desde las 12:00. Viernes y sábado hasta las 02:30.</dd>
  <dt><strong>¿Dónde estáis?</strong></dt><dd>{SITE.address}, {SITE.postal}, junto a la Puerta del Sol.</dd>
  <dt><strong>¿Cuántas pantallas tenéis?</strong></dt><dd>Un proyector grande y 8 pantallas.</dd>
  <dt><strong>¿Cómo llego?</strong></dt><dd>Metro Sol (L1, L2, L3) o Sevilla (L2) y un paseo corto hasta la Calle de Espoz y Mina 7.</dd>
</dl>
<script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "¿Ponéis los tres partidos de Irlanda?", "acceptedAnswer": {"@type": "Answer", "text": "Sí: Irlanda–Argentina (6 nov), Irlanda–Fiyi (14 nov) e Irlanda–Sudáfrica (21 nov), en directo."}}, {"@type": "Question", "name": "¿A qué hora abrís?", "acceptedAnswer": {"@type": "Answer", "text": "Todos los días desde las 12:00. Viernes y sábado hasta las 02:30."}}, {"@type": "Question", "name": "¿Dónde estáis?", "acceptedAnswer": {"@type": "Answer", "text": "Calle de Espoz y Mina 7, 28012 Madrid, junto a la Puerta del Sol."}}, {"@type": "Question", "name": "¿Cuántas pantallas tenéis?", "acceptedAnswer": {"@type": "Answer", "text": "Un proyector grande y 8 pantallas."}}, {"@type": "Question", "name": "¿Cómo llego?", "acceptedAnswer": {"@type": "Answer", "text": "Metro Sol (L1, L2, L3) o Sevilla (L2) y un paseo corto hasta la Calle de Espoz y Mina 7."}}]})} />
<p>In English: <a href={withBase('/ireland-rugby-madrid/')} hreflang="en">Ireland rugby in Madrid</a> · Todo el deporte que ponemos: <a href={withBase('/es/partidos/')}>Partidos</a></p>
    </div>
  </section>
</BaseLayout>
