---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../../components/OriginalFourBars.astro';
import FanWeekendCtas from '../../../components/FanWeekendCtas.astro';
import { withBase, absUrl } from '../../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../../data/fourBars';

const PATH = '/es/salida-bernabeu-a-las-cuatro-puertas-sol/';
const PATH_EN = '/from-bernabeu-exit-to-four-sol-doors/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const FROM_BERNABEU = {
  fourCorner:
    'https://www.google.com/maps/dir/?api=1&origin=Estadio+Santiago+Bernab%C3%A9u&destination=Calle+de+la+Victoria+6,+28012+Madrid',
  oreillys:
    'https://www.google.com/maps/dir/?api=1&origin=Estadio+Santiago+Bernab%C3%A9u&destination=Pasaje+de+Matheu+4,+28012+Madrid',
  dubliners:
    'https://www.google.com/maps/dir/?api=1&origin=Estadio+Santiago+Bernab%C3%A9u&destination_place_id=ChIJLdKNhYAoQg0RE6Nxotwa1zw',
  oconnell:
    'https://www.google.com/maps/dir/?api=1&origin=Estadio+Santiago+Bernab%C3%A9u&destination=Calle+de+Espoz+y+Mina+7,+28012+Madrid',
} as const;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Salida del estadio: del Santiago Bernabéu a las cuatro puertas abiertas de Sol',
  inLanguage: 'es',
  datePublished: '2026-11-08T15:00:00+01:00',
  dateModified: '2026-11-08T15:00:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Salgo del Santiago Bernabéu. ¿Cómo llego a las cuatro puertas hermanas junto a Sol?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Abrid Google Maps desde Estadio Santiago Bernabéu hacia Calle de la Victoria 6, Calle de Espoz y Mina 7 o Pasaje de Matheu 4. Seguid el trayecto en vivo que muestre Maps (Metro, taxi o a pie). No publicamos minutos ni kilómetros. Las cuatro puertas están abiertas ahora: Four Corner desde las 14:00 con pantallas de deporte; O’Reilly’s habitual 11:30; Dubliners y O’Connell’s desde las 12:00. Pines abajo.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Four Corner está abierto cuando salgo del estadio?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sí. Four Corner, Calle de la Victoria 6, está abierto el domingo 8 de noviembre desde las 14:00 hasta la madrugada, con pantallas de deporte. Las tres puertas hermanas también están abiertas. Preguntad qué echan. Listados con nombre: Partidos de Dubliners solamente. No listamos la programación de Four Corner, O’Reilly’s ni O’Connell’s.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Esto es la página de antes y después de Bengals?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Esa página es la quedada en Sol antes de las 15:30 y la vuelta después. Esta es solo la guía de salida del estadio: Maps del Bernabéu a las cuatro puertas abiertas. Los relojes confirmados siguen en Partidos: Bengals–Falcons 15:30, Premier 15:00 / 17:30, NFL después desde las 19:00, Atlético–Barcelona 21:00. Coordinad; no sustituyáis.',
      },
    },
  ],
};
---

<BaseLayout
  title="Salida del Bernabéu a las cuatro puertas abiertas de Sol | Dubliners"
  description="Domingo 8 nov: ¿salís del Santiago Bernabéu? Google Maps del estadio a Victoria 6, Espoz y Mina 7 y Pasaje de Matheu 4. Las cuatro puertas están abiertas (Four Corner desde las 14:00, pantallas de deporte). FIND US."
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Salida del estadio: del Bernabéu a las cuatro puertas abiertas de Sol" schema />
      <h1>Salida del estadio: del Santiago Bernabéu a las cuatro puertas abiertas de Sol</h1>
      <p class="lead">
        Estáis <strong>saliendo del Santiago Bernabéu</strong> — no del hotel en Sol, no de Atocha, no andando Plaza Mayor.
        Marcad las cuatro puertas hermanas junto a Puerta del Sol. <strong>Four Corner está abierto</strong> (desde las 14:00 hasta la madrugada, pantallas de deporte) en Calle de la Victoria 6.
        Dubliners y O’Connell’s en Espoz y Mina 7, O’Reilly’s en Pasaje de Matheu 4 — las cuatro puertas sirven.
        Abrid Google Maps desde el estadio. No inventamos minutos, kilómetros ni un reloj de saque. Maps abajo.
      </p>
      <p class="small">In English: <a href={withBase(PATH_EN)} hreflang="en" lang="en">Stadium exit: Santiago Bernabéu to the four open Sol doors</a></p>
      <FanWeekendCtas lang="es" findHref="/es/visitar/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Esto es la guía de salida del estadio, no la quedada antes y después de Bengals</h2>
      <p>
        La página en vivo <a href={withBase('/es/antes-despues-bengals-falcons-sol/')}>Antes y después de Bengals–Falcons junto a Sol</a>
        es la quedada en Sol antes de las 15:30 y la vuelta después. Esta página es solo para quien
        <strong>sale del estadio</strong> y necesita Maps desde Estadio Santiago Bernabéu a las cuatro puertas abiertas.
        No es la parrilla NFL del domingo, no el reloj a elegir, no el primer Metro a Sol, no Barajas, no la primera calle del hotel.
        No re-promocionéis el sábado 18:00–19:00 como si siguiera.
      </p>

      <h2>Abrid Google Maps desde el estadio — trayecto en vivo, sin reloj inventado</h2>
      <p>
        Origen: <strong>Estadio Santiago Bernabéu</strong>. Destino: una de las cuatro direcciones de abajo.
        Usad el enlace “desde el Bernabéu” para que Maps rellene origen y destino. Seguid el Metro, taxi o paseo
        que Maps muestre <em>ahora</em>. La salida y el domingo cambian la ruta — por eso no imprimimos minutos ni kilómetros.
      </p>
      <ul>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid.</strong>
          Abierto ahora (desde las 14:00 hasta la madrugada · pantallas de deporte). No listamos qué echan — preguntad en la puerta.
          {' '}<a href={FROM_BERNABEU.fourCorner} rel="noopener noreferrer" target="_blank">Maps desde el Bernabéu</a>
          {' · '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Pin en Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          Domingo desde las 12:00 (hasta las 02:00). Pantallas con nombre en <a href={withBase('/es/partidos/')}>Partidos</a> — preguntad qué echan.
          {' '}<a href={FROM_BERNABEU.dubliners} rel="noopener noreferrer" target="_blank">Maps desde el Bernabéu</a>
          {' · '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Pin en Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (en Maps: O’Connell St).
          Mismo número que Dubliners, otra puerta. Punto de encuentro; no inventamos su cartel.
          {' '}<a href={FROM_BERNABEU.oconnell} rel="noopener noreferrer" target="_blank">Maps desde el Bernabéu</a>
          {' · '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Pin en Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Pasaje cubierto desde Espoz y Mina. Habitual desde las 11:30. Punto de encuentro; no inventamos la carta.
          {' '}<a href={FROM_BERNABEU.oreillys} rel="noopener noreferrer" target="_blank">Maps desde el Bernabéu</a>
          {' · '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Pin en Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
      </ul>

      <h2>Los relojes confirmados siguen en Partidos — no inventamos el pitido</h2>
      <p>
        <a href={withBase('/es/partidos/')}>Partidos</a> de Dubliners ya lista el domingo 8 de noviembre en hora de Madrid:
        Bengals vs Falcons a las <strong>15:30</strong> en el Santiago Bernabéu (también EN DIRECTO en la pantalla grande de Dubliners),
        Premier League desde las <strong>15:00</strong> y United–Villa a las <strong>17:30</strong>, NFL después desde las <strong>19:00</strong>
        luego <strong>22:05</strong> / <strong>22:25</strong>, Atlético vs Barcelona a las <strong>21:00</strong>.
        Esos relojes van a la vez — coordinad, no sustituyáis. Preguntad qué pantalla. No todos los partidos van en todas las pantallas.
        Listados con nombre: solo Dubliners. No asignamos Palace–Liverpool, Sunderland–Chelsea, Brighton–Brentford,
        Ipswich–Bournemouth ni la NFL posterior a O’Reilly’s, O’Connell’s o Four Corner.
      </p>
      <p>
        Seguid cuando os sentéis:
        <a href={withBase('/es/despues-madrid-game-seguir-cuatro-puertas-abiertas/')}>punto de encuentro después del partido en las cuatro puertas abiertas</a>
        (NFL de después, luego Atlético–Barcelona 21:00).
      </p>

      <OriginalFourBars lang="es" when="sunday" findHref="/es/visitar/" />

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>Salgo del Bernabéu. ¿Cómo llego a las cuatro puertas de Sol?</strong></dt>
        <dd>Google Maps desde Estadio Santiago Bernabéu a Victoria 6, Espoz y Mina 7 o Pasaje de Matheu 4. Seguid el trayecto en vivo. No publicamos minutos ni kilómetros. Las cuatro puertas están abiertas.</dd>
        <dt><strong>¿Four Corner está abierto?</strong></dt>
        <dd>Sí. Desde las 14:00 hasta la madrugada, pantallas de deporte, Calle de la Victoria 6. Preguntad qué echan. No listamos su programación.</dd>
        <dt><strong>¿Esto es la página de antes y después de Bengals?</strong></dt>
        <dd>No. Esa es la quedada en Sol antes de las 15:30 y después. Esto es Maps de salida del estadio a las cuatro puertas abiertas.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Desde el Bernabéu este domingo',
            until: SHOW_UNTIL,
            items: [
              { href: '/es/', label: 'FIND US — inicio Dubliners' },
              { href: '/es/visitar/', label: 'CÓMO LLEGAR — visitar / horario' },
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'VER LOS CUATRO BARES' },
              { href: '/es/despues-madrid-game-seguir-cuatro-puertas-abiertas/', label: 'Después del Madrid Game: cuatro puertas abiertas, NFL luego Atleti' },
              { href: '/es/partidos/', label: 'Partidos — pantallas con nombre' },
              { href: PATH_EN, label: 'Stadium exit: Santiago Bernabéu to the four open Sol doors', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
