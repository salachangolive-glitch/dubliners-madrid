---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import MapEmbed from '../../../components/MapEmbed.astro';
import { SITE, withBase } from '../../../site';

const PATH = '/es/si-pediste-soccer-futbol-cerca-de-sol/';
const PATH_EN = '/if-you-asked-for-soccer-near-sol/';
const title = 'Si pediste soccer cerca de Sol | Pub irlandés con fútbol en pantalla';
const description =
  '¿Visitante en Madrid y dijiste “soccer”? Aquí es fútbol. Pub irlandés de interior en Espoz y Mina 7, junto a Sol — mira Partidos y pregunta en barra. CÓMO LLEGAR.';
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: '¿Dónde ver soccer / fútbol cerca de Puerta del Sol?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Dubliners es un pub irlandés en la calle de Espoz y Mina 7, 28012 Madrid, junto a Puerta del Sol, con pantallas de interior para fútbol cuando hay listado. “Soccer” en inglés es fútbol aquí. Los partidos con nombre están en Partidos; pregunta en barra qué echan.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Es la página de NFL del domingo?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. La página de NFL es fútbol americano. Esta página es lenguaje de visitante: pediste soccer, es decir fútbol en pantalla.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Es el hub general de bar deportivo Madrid?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. El bar deportivo es la página hub de Premier y deporte en vivo junto a Sol. Esta página es el momento turístico: dijiste soccer en un pub irlandés.',
      },
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/bar-interior.jpg"
  extraJsonLd={[faqLd]}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Si pediste soccer cerca de Sol" lang="es" schema />
      <h1>Si pediste soccer cerca de Sol</h1>
      <p class="lead">
        Estás en Madrid, quieres el partido en pantalla y dijiste <em>soccer</em>.
        Aquí es <strong>fútbol</strong> — LaLiga, Champions, Premier cuando figure en la lista.
        Dubliners es un pub irlandés de interior en Espoz y Mina 7, a dos calles de Puerta del Sol, con inglés en barra.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">CÓMO LLEGAR</a>
        <a class="btn btn-secondary" href={withBase('/es/partidos/')}>Partidos</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Dijiste soccer, en pantalla va fútbol</h2>
      <p>
        En barra entienden las dos palabras. Las pantallas miran a las mesas en la sala de interior junto a Sol.
        No es la guía de NFL —
        <a href={withBase('/es/nfl-madrid/')}>NFL en Madrid</a> —
        ni el resumen de bar deportivo —
        <a href={withBase('/es/bar-deportivo-madrid/')}>bar deportivo cerca de Sol</a>.
        Es la pregunta turística: “¿Dónde hay soccer?” → este pub irlandés, y luego pregunta qué ponen.
      </p>
      <p>
        No el paseo del Prado, no la plaza mojada, no el teatro en Gran Vía, no la primera noche del avión.
        Estás de visita o alojado junto a Sol y quieres fútbol con una pinta.
      </p>

      <h2>Encuentra la puerta</h2>
      <ol>
        <li>Desde <strong>Puerta del Sol</strong>, entra en la <strong>calle de Espoz y Mina</strong> hacia Carrera de San Jerónimo.</li>
        <li>Busca el <strong>neón verde de Dubliners</strong> en el número 7.</li>
        <li>Pregunta en barra: qué pantalla, qué competición — no asumas un horario que no esté en
          <a href={withBase('/es/partidos/')}>Partidos</a>.
        </li>
      </ol>
      <p>
        Metro Sol (L1, L2, L3) o Sevilla (L2).
        NAP: <strong>{SITE.address}</strong>, {SITE.postal}.
      </p>

      <h2>Solo listados con nombre</h2>
      <p>
        Los partidos confirmados están en Partidos en hora de Madrid.
        Si la lista está vacía, puedes sentarte igual con una pinta irlandesa de interior.
        Sin retransmisiones inventadas; sin entrada al Bernabéu o al Metropolitano en este texto.
      </p>

      <div class="map-frame">
        <MapEmbed lang="es" title="Mapa a Dubliners — soccer / fútbol cerca de Sol" />
      </div>
      <p class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">CÓMO LLEGAR</a>
        <a class="btn btn-secondary" href={withBase('/es/visitar/')}>FIND US</a>
      </p>

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>¿Dónde ver soccer / fútbol cerca de Puerta del Sol?</strong></dt>
        <dd>Espoz y Mina 7, pub irlandés de interior junto a Sol. Fútbol cuando hay listado; pregunta en barra.</dd>
        <dt><strong>¿Es la página de NFL del domingo?</strong></dt>
        <dd>No. NFL es fútbol americano. Soccer aquí es fútbol.</dd>
        <dt><strong>¿Es el hub general de bar deportivo Madrid?</strong></dt>
        <dd>No. Ese hub cubre Premier y deporte todo el año. Esto es el momento “pedí soccer”.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Relacionado (no esta página de soccer)',
            items: [
              { href: '/es/bar-deportivo-madrid/', label: 'Bar deportivo cerca de Sol', note: 'Hub evergreen, no pregunta turística soccer' },
              { href: '/es/nfl-madrid/', label: 'NFL en Madrid', note: 'Fútbol americano, no soccer' },
              { href: '/es/visitar/', label: 'FIND US', note: 'Maps, Metro Sol, CÓMO LLEGAR' },
              { href: '/es/partidos/', label: 'Partidos', note: 'Solo listados con nombre' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
