---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import { SITE, withBase } from '../../../site';
import { OPENING_HOURS } from '../../../data/hours';
import { TG } from '../../../data/thanksgiving';

// THANKSGIVING-DUB (DG 25 Oct): página permanente y reutilizable. Actualizar src/data/thanksgiving.ts cada año (solo datos verificados por Radar).
const thu = OPENING_HOURS.find((d) => d.day === 'Thursday')!;
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: `¿A qué hora es la NFL de Thanksgiving en Madrid en ${TG.year}?`, acceptedAnswer: { '@type': 'Answer', text: `Thanksgiving ${TG.year}: ${TG.games.map((g) => `${g.away} at ${g.home} a las ${g.madridTime}${g.dayNoteEs ? ` (${g.dayNoteEs})` : ''}`).join('; ')} (hora de Madrid). Los dos confirmados en directo en nuestras pantallas en Dubliners.` } },
    { '@type': 'Question', name: '¿Ponéis los dos partidos del jueves de Thanksgiving?', acceptedAnswer: { '@type': 'Answer', text: 'Sí — Bears contra Lions y Eagles contra Cowboys van en directo en nuestras pantallas en Dubliners. Consulta Partidos.' } },
    { '@type': 'Question', name: '¿Dónde está Dubliners?', acceptedAnswer: { '@type': 'Answer', text: `Calle de Espoz y Mina 7, 28012 Madrid, a un paso de Puerta del Sol. Metro Sol (líneas 1, 2 y 3) o Sevilla (línea 2). Jueves ${thu.opens}–${thu.closes}.` } },
  ],
};
---

<BaseLayout title={`NFL de Thanksgiving en Madrid ${TG.year}: horarios cerca de Sol | Dubliners`} description={`Thanksgiving en Madrid: Bears–Lions y Eagles–Cowboys (hora de Madrid). En directo en nuestras pantallas en Dubliners, O’Connell’s y O’Reilly’s junto a Puerta del Sol.`} path="/es/thanksgiving-madrid/" lang="es" hreflang={{ en: '/thanksgiving-madrid/', es: '/es/thanksgiving-madrid/' }} ogImage="/images/screens-sports.jpg" extraJsonLd={[faqLd]}>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Thanksgiving en Madrid" lang="es" schema />
      <h1>Thanksgiving en Madrid: horarios NFL cerca de Puerta del Sol</h1>
      <p class="lead">Si vienes de EE. UU. y pasas Thanksgiving en Madrid, el {TG.dateEs} tocan Bears–Lions y Eagles–Cowboys. Dubliners, O’Connell’s y O’Reilly’s comparten las mismas calles junto a Puerta del Sol. <strong>Los dos partidos del jueves van en directo en nuestras pantallas</strong> en Dubliners. Cartel: <a href={withBase('/es/partidos/')}>Partidos</a>.</p>
      <p class="small">{TG.dateEs} · hora de Madrid · Actualizado el {TG.updatedEs}</p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Cómo llegar</a>
        <a class="btn btn-primary" href={withBase('/contact/#request-information')}>Pedir información</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <h2>Esta noche — horarios NFL de Thanksgiving (Madrid)</h2>
      <p>
        <strong>{TG.dateEs}</strong>: {TG.games.map((g) => (<><strong>{g.madridTime}</strong> — {g.away} at {g.home}{' '}</>))}
        Puedes pasar por Dubliners, O’Connell’s y O’Reilly’s junto a Puerta del Sol. Estos partidos NFL de Thanksgiving van <strong>en directo en nuestras pantallas</strong> en Dubliners — <a href={withBase('/es/partidos/')}>Partidos</a>.
      </p>
      <h2>Rugby Nations Championship — vie–dom 27–29 noviembre</h2>
      <p>
        El mismo punto de encuentro sigue el fin de semana de las finales: seis pruebas, horario de Madrid desde el viernes hasta el domingo, todas <strong>en directo en nuestras pantallas</strong> en Dubliners, O’Connell’s y O’Reilly’s. Cartel y horarios: <a href={withBase('/es/rugby-nations-finals-fin-de-semana-sol/')}>finales del Nations Championship</a> · <a href={withBase('/es/partidos/')}>Partidos</a>.
      </p>
      <h2>Thanksgiving {TG.year}: partidos NFL (hora de Madrid)</h2>
      <ul>
        {TG.games.map((g) => (<li><strong>{g.madridTime}</strong> — {g.away} at {g.home}{g.dayNoteEs ? ` · ${g.dayNoteEs}` : ''}</li>))}
      </ul>
      <p class="small">Horarios según el calendario NFL (<a href="https://www.nfl.com/schedules/2026/REG11/" rel="noopener noreferrer" target="_blank">nfl.com</a>). Cuadro: <a href={withBase('/es/partidos/')}>Partidos</a>.</p>
      <picture><source type="image/webp" srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`} sizes="(max-width: 800px) 100vw, 720px" /><img class="split-photo landscape" src={withBase('/images/screens-sports.jpg')} width="1400" height="788" loading="lazy" decoding="async" alt="Deporte en las pantallas de Dubliners Madrid" /></picture>
      <h2>El jueves de Thanksgiving, cada año</h2>
      <p>Thanksgiving es el cuarto jueves de noviembre. En Madrid es un día laborable normal, así que el primer partido suele empezar al final de la tarde y el segundo ya por la noche: un buen plan después del trabajo. Actualizamos esta página cada año en cuanto se confirman los horarios.</p>
      <h2>Dónde estamos</h2>
      <p>Dubliners Irish Pub, Calle de Espoz y Mina 7, 28012 Madrid, entre Puerta del Sol, Plaza Mayor y el Barrio de las Letras. Metro Sol (líneas 1, 2 y 3) o Sevilla (línea 2). Los jueves abrimos de {thu.opens} a {thu.closes}. ¿Venís en grupo? Escríbenos en <a href={withBase('/contact/#request-information')}>Pedir información</a>.</p>
      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        {faqLd.mainEntity.map((q) => (<><dt><strong>{q.name}</strong></dt><dd>{q.acceptedAnswer.text}</dd></>))}
      </dl>
      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Más NFL en Dubliners',
            items: [
              { href: '/es/nfl-madrid/', label: 'NFL en Madrid', note: 'Guía NFL cerca de Sol' },
              { href: '/es/guia-domingo-nfl-madrid/', label: 'Guía del domingo NFL', note: 'Hora a hora' },
              { href: '/es/partidos/', label: 'Partidos', note: 'Todo lo que emitimos' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
