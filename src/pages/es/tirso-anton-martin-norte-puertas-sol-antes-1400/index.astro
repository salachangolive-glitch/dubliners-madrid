import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../../components/OriginalFourBars.astro';
import FanWeekendCtas from '../../../components/FanWeekendCtas.astro';
import { withBase, absUrl } from '../../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../../data/fourBars';

const PATH = '/es/tirso-anton-martin-norte-puertas-sol-antes-1400/';
const PATH_EN = '/tirso-anton-martin-north-sol-doors-before-1400/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Tirso de Molina / Antón Martín: al norte, las cuatro puertas de Sol antes de las 14:00',
  inLanguage: 'es',
  datePublished: '2026-11-08T13:00:00+01:00',
  dateModified: '2026-11-08T13:00:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Estoy en Tirso de Molina o Antón Martín, al sur de Sol en la L1. ¿Hacia dónde van los cuatro bares antes de las 14:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Andad al norte por Calle de la Magdalena, seguid por Calle de la Cruz y luego Espoz y Mina. Marcad Espoz y Mina 7, Pasaje de Matheu 4 y Calle de la Victoria 6 antes de las 14:00. Es un paseo de calle desde dos plazas de la L1 al sur de Sol — no bajáis dentro de la estación de Sol, no es Atocha Cercanías, no es Callao–Preciados, no es Plaza Mayor. Four Corner desde las 14:00 (pantallas de deporte; no abre antes). Maps abajo.',
      },
    },
    {
      '@type': 'Question',
      name: '¿A qué distancia están Tirso de Molina y Antón Martín de Victoria 6, Espoz y Mina 7 y Pasaje de Matheu 4?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Desde Plaza de Tirso de Molina al norte por Magdalena / Cruz: Espoz y Mina 7 unos 6–8 min / 450–600 m; Pasaje de Matheu 4 unos 7–9 min / 500–650 m; Victoria 6 unos 7–9 min / 500–680 m. Desde Plaza de Antón Martín sumad unos 4–6 min / 300–400 m (Espoz y Mina 7 unos 10–13 min / 750–950 m; Matheu 4 y Victoria 6 unos 11–14 min / 800–1000 m). No esperéis en Victoria 6 antes de las 14:00.',
      },
    },
    {
      '@type': 'Question',
      name: 'Son alrededor de las 13:00. ¿Puedo ir ahora a Four Corner?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Four Corner abre el domingo 8 de noviembre desde las 14:00 hasta la madrugada, con pantallas de deporte — una hora desde las 13:00, no antes. Andad al norte ahora; sentaos en O’Reilly’s (habitual 11:30) o Dubliners (habitual domingo 12:00). Premier League desde las 15:00, NFL tarde/noche y Atlético–Barcelona 21:00 van en las mismas calles después — coordinad, no sustituyáis. Listados con nombre: Partidos de Dubliners solamente.',
      },
    },
  ],
};
---

<BaseLayout
  title="Tirso / Antón Martín al norte, cuatro puertas de Sol antes de las 14:00 | Dubliners"
  description="Domingo 8 nov ~13:00: ¿ya estáis en Tirso de Molina o Antón Martín (L1, al sur de Sol)? Andad al norte por Magdalena / Cruz / Espoz y Mina a Victoria 6, Espoz y Mina 7 y Pasaje de Matheu 4 antes de las 14:00. Paseo de calle, metros, Maps."
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Tirso / Antón Martín: al norte a las cuatro puertas de Sol" schema />
      <h1>Tirso de Molina / Antón Martín: al norte, las cuatro puertas de Sol antes de las 14:00</h1>
      <p class="lead">
        El sábado ya ha acabado. No estáis en Plaza Mayor, no en Preciados con bolsas, no en el vestíbulo de Atocha ni saliendo dentro del Metro de Sol.
        <strong>Ya estáis al sur de Sol</strong> — Plaza de Tirso de Molina o Plaza de Antón Martín, línea 1.
        Andad <strong>al norte por Calle de la Magdalena, luego Calle de la Cruz, luego Espoz y Mina</strong>.
        Marcad las cuatro puertas hermanas antes de que Four Corner abra a las 14:00 con pantallas de deporte (una hora desde las 13:00; no abre antes). Maps abajo.
      </p>
      <p class="small">In English: <a href={withBase(PATH_EN)} hreflang="en" lang="en">Tirso de Molina / Antón Martín: walk north to the four Sol doors before 14:00</a></p>
      <FanWeekendCtas lang="es" findHref="/es/visitar/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Esto es un paseo al norte desde dos plazas de la L1, no la estación de Sol, no Atocha, no Callao, no Plaza Mayor</h2>
      <p>
        Otras páginas ya cubren el primer Metro <em>hacia</em> Sol (andén a puerta en la plaza), Atocha Cercanías una parada,
        Callao–Preciados al sur, los soportales este de Plaza Mayor, la primera calle desde un hotel en Sol y Barajas.
        Esta página es solo para quien <strong>ya está en la calle en Tirso de Molina o Antón Martín</strong>
        y necesita rumbo norte, metros y qué puerta marcar antes de las 14:00.
        No re-promocionéis el sábado 18:00–19:00 como si siguiera.
      </p>

      <h2>Tirso o Antón Martín → Magdalena al norte → Cruz → Espoz y Mina</h2>
      <p>
        Quedaos en superficie. No subáis a la L1 una parada más hasta Sol salvo que queráis la página de estación a puerta.
        Desde <strong>Plaza de Tirso de Molina</strong> andad <strong>al norte por Calle de la Magdalena</strong>.
        Magdalena enlaza con <strong>Calle de la Cruz</strong> — seguid al norte hacia Sol.
        Luego Espoz y Mina (número 7 dos veces), Pasaje de Matheu (el atajo cubierto de esa calle) y Calle de la Victoria.
        Desde <strong>Plaza de Antón Martín</strong> la misma Magdalena es la calle norte; pasáis Tirso de camino.
      </p>
      <ul>
        <li>
          <strong>Desde Plaza de Tirso de Molina, norte por Magdalena / Cruz.</strong>
          Espoz y Mina 7: <strong>6–8 min / 450–600 m</strong>.
          Pasaje de Matheu 4: <strong>7–9 min / 500–650 m</strong>.
          Victoria 6: <strong>7–9 min / 500–680 m</strong>.
        </li>
        <li>
          <strong>Desde Plaza de Antón Martín, norte por Magdalena pasando Tirso.</strong>
          Sumad unos <strong>4–6 min / 300–400 m</strong>.
          Espoz y Mina 7: <strong>10–13 min / 750–950 m</strong>.
          Matheu 4 y Victoria 6: <strong>11–14 min / 800–1000 m</strong>.
        </li>
      </ul>
      <p>
        Desde alrededor de las 13:00 falta <strong>una hora</strong> hasta que Four Corner abra a las 14:00.
        Os da tiempo a andar. Marcad Victoria 6 para esa hora. No acampéis una puerta cerrada en Calle de la Victoria antes.
      </p>

      <h2>Antes de las 14:00 — qué puerta está siquiera abierta</h2>
      <p>
        Four Corner abre el <strong>domingo 8 de noviembre desde las 14:00 hasta la madrugada, con pantallas de deporte</strong>.
        No antes de las 14:00. No listamos qué partido hay ahí — preguntad en la puerta.
        O’Reilly’s habitual desde las 11:30 (Pasaje de Matheu 4). Dubliners habitual domingo desde las 12:00 (Espoz y Mina 7).
        Andad Magdalena ahora; sentaos en la primera hermana que esté abierta; estad en Victoria para la apertura de las 14:00.
        La puerta habitual de domingo de O’Connell’s es a las 14:00 (el listado de hoy también desde las 12:00 — no inventamos).
        Premier League desde las 15:00 (Palace–Liverpool, Sunderland–Chelsea, Brighton–Brentford, Ipswich–Bournemouth),
        United–Villa 17:30, NFL tarde/noche y Atlético–Barcelona 21:00 van en las mismas calles después — coordinad, no sustituyáis.
        Listados con nombre: <a href={withBase('/es/partidos/')}>Partidos</a> de Dubliners solamente. Preguntad qué pantalla — no todos los partidos van en todas las pantallas.
      </p>

      <h2>Del sur de Sol a tres calles — direcciones</h2>
      <ol>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid</strong> (marcar para las 14:00; pantallas de deporte; no abre antes).
          Unos 7–9 min desde Tirso / 11–14 min desde Antón Martín.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Pasaje cubierto desde Espoz y Mina. Habitual desde las 11:30. Unos 7–9 min desde Tirso.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          Unos 6–8 min desde Tirso. Domingo desde las 12:00. Pantallas con nombre en Partidos — preguntad qué hay.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (en Maps: O’Connell St).
          Mismo número que Dubliners, otra puerta. Habitual domingo 14:00 (hoy también listado desde las 12:00). Punto de encuentro; no inventamos su cartel.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Cómo llegar andando</a>.
        </li>
      </ol>

      <OriginalFourBars lang="es" when="sunday" findHref="/es/visitar/" />

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>En Tirso o Antón Martín esta tarde. ¿Hacia dónde antes de las 14:00?</strong></dt>
        <dd>Norte por Magdalena, luego Cruz, luego Espoz y Mina. Marcad Victoria 6 para las 14:00. Luego Matheu 4 y Espoz y Mina 7 dos veces. Paseo de calle — no subáis al Metro hasta Sol salvo que queráis la página de estación.</dd>
        <dt><strong>¿A qué distancia de Tirso / Antón Martín a las cuatro puertas?</strong></dt>
        <dd>Tirso al norte: Espoz y Mina 7 6–8 min / 450–600 m; Matheu 4 7–9 min / 500–650 m; Victoria 6 7–9 min / 500–680 m. Antón Martín sumad 4–6 min / 300–400 m. No esperéis en Victoria 6 antes de las 14:00.</dd>
        <dt><strong>Son ~13:00. ¿Abre Four Corner?</strong></dt>
        <dd>No. Desde las 14:00, pantallas de deporte — una hora desde ahora. O’Reilly’s desde las 11:30; Dubliners desde las 12:00. No esperéis en Victoria 6 antes de las 14:00.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Desde Tirso / Antón Martín este domingo',
            until: SHOW_UNTIL,
            items: [
              { href: '/es/', label: 'FIND US — inicio Dubliners' },
              { href: '/es/visitar/', label: 'CÓMO LLEGAR — visitar / horario' },
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'VER LOS CUATRO BARES' },
              { href: '/es/ultima-hora-antes-four-corner-1400/', label: 'Última hora: O’Reilly’s y Dubliners ahora, andad a las 14:00' },
              { href: '/es/four-corner-abre-domingo-1400/', label: 'Four Corner domingo 14:00' },
              { href: PATH_EN, label: 'Tirso / Antón Martín: walk north to the four Sol doors', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
