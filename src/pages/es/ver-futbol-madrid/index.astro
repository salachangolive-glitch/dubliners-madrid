---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import { SITE, withBase } from '../../../site';

const title = 'Ver fútbol en Madrid | Pub cerca de Sol — Dubliners';
const description =
  'Dónde ver fútbol en Madrid cerca de Puerta del Sol. Pub irlandés con pantallas indoor para Premier, Champions y LaLiga. Espoz y Mina 7.';
---

<BaseLayout
  title={title}
  description={description}
  path="/es/ver-futbol-madrid/"
  lang="es"
  ogImage="/images/screens-sports.jpg"
>
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Ver fútbol Madrid" lang="es" />
        <h1>Ver fútbol en Madrid — a un paso de Sol</h1>
        <p class="lead">
          ¿Fin de semana en la ciudad o hotel ya en la plaza?
          Dubliners es un pub irlandés walk-in con pantallas indoor en Calle de Espoz y Mina 7 —
          un sitio fácil en el centro para noches de Premier League, Champions League y LaLiga.
        </p>
        <CtaRow lang="es" />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 45vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/screens-sports.jpg')} alt="Ver fútbol en pantallas grandes en Dubliners cerca de Sol" width="1400" height="788" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>Dónde</h3>
          <p>{SITE.address} — unos dos minutos desde Puerta del Sol. Metro Sol o Sevilla.</p>
        </article>
        <article class="card">
          <h3>Cómo llegar</h3>
          <p>A pie desde la plaza o en Metro hasta Sol. Sin reserva — solo entra.</p>
        </article>
        <article class="card">
          <h3>Qué ver hoy</h3>
          <p>Mira los <a href={withBase('/es/partidos/')}>próximos partidos</a> o pregunta en barra qué echan esta noche.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Fútbol en directo en el centro</h2>
      <p>
        Sol es el hub natural si recorres Madrid a pie. Si te alojas cerca,
        entras en Dubliners para el pitido sin un taxi largo al otro lado de la ciudad.
      </p>
      <p>
        Echamos Premier League, Champions League, LaLiga y otros deportes cuando están en nuestras pantallas.
        En noches grandes, llega un poco antes — la sala se llena.
      </p>
      <ul>
        <li><a href={withBase('/es/premier-league-pub-madrid/')}>Pub Premier League Madrid</a></li>
        <li><a href={withBase('/es/champions-league-bar-madrid/')}>Bar Champions League Madrid</a></li>
        <li><a href={withBase('/es/bar-futbol-puerta-del-sol/')}>Bar de fútbol cerca de Puerta del Sol</a></li>
        <li><a href={withBase('/es/bar-deportivo-madrid/')}>Bar deportivo Madrid</a></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Después del Bernabéu</h2>
      <p>
        Estamos en Sol / centro — no al lado del estadio. Tras un día de partido, Metro de vuelta a Sol
        y entra a por una cerveza o otro partido si lo están echando.
      </p>
      <div class="faq">
        <details>
          <summary>¿Hay terraza?</summary>
          <p>No — solo interior con pantallas.</p>
        </details>
        <details>
          <summary>¿Echáis todos los partidos de Premier o Champions?</summary>
          <p>Ponemos partidos cuando se echan aquí. Mira Partidos o pregunta en barra.</p>
        </details>
        <details>
          <summary>¿Hay que reservar?</summary>
          <p>No. Es walk-in. En partidos grandes, mejor llegar pronto.</p>
        </details>
        <details>
          <summary>Dirección</summary>
          <p>{SITE.address}, {SITE.postal}</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
