---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import { SITE, withBase } from '../../../site';

const title = 'Ver fútbol en Madrid | Pub cerca de Sol — Dubliners';
const description =
  'Ver fútbol cerca de Puerta del Sol. Pantallas en sala para Premier, Champions y LaLiga cuando se echan. Espoz y Mina 7.';
---

<BaseLayout
  title={title}
  description={description}
  path="/es/ver-futbol-madrid/"
  lang="es"
  ogImage="/images/screens-sports.jpg"
>
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Ver fútbol Madrid" lang="es" />
        <h1>Ver fútbol cerca de Sol</h1>
        <p class="lead">
          Pub irlandés en Espoz y Mina 7 — Premier League, Champions League y LaLiga
          cuando están en pantallas. Unos dos minutos desde la plaza.
        </p>
        <CtaRow lang="es" />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 45vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/screens-sports.jpg')} alt="Fútbol en pantallas grandes en Dubliners" width="1400" height="788" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>Dónde</h3>
          <p>{SITE.address} — Metro Sol o Sevilla.</p>
        </article>
        <article class="card">
          <h3>Cómo llegar</h3>
          <p>A pie desde la plaza o Metro hasta Sol. Sin reserva online.</p>
        </article>
        <article class="card">
          <h3>Qué ver hoy</h3>
          <p>Mira los <a href={withBase('/es/partidos/')}>próximos partidos</a> o pregunta en barra.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Base en el centro para el partido</h2>
      <p>
        Si ya estás alojado cerca de Sol, lo tienes a mano. Ponemos partidos cuando se echan —
        en noches grandes, llega un poco antes.
      </p>
      <ul>
        <li><a href={withBase('/es/premier-league-pub-madrid/')}>Pub Premier League Madrid</a></li>
        <li><a href={withBase('/es/champions-league-bar-madrid/')}>Bar Champions League Madrid</a></li>
        <li><a href={withBase('/es/bar-futbol-puerta-del-sol/')}>Bar de fútbol cerca de Puerta del Sol</a></li>
        <li><a href={withBase('/es/bar-deportivo-madrid/')}>Bar deportivo Madrid</a></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Después del Bernabéu</h2>
      <p>
        Estamos en Sol / centro — no al lado del estadio. Metro de vuelta a Sol y entra
        a por una cerveza u otro partido si lo están echando.
      </p>
      <div class="faq">
        <details>
          <summary>¿Hay terraza?</summary>
          <p>No — solo interior con pantallas.</p>
        </details>
        <details>
          <summary>¿Echáis todos los partidos de Premier o Champions?</summary>
          <p>Ponemos partidos cuando se echan aquí. Mira Partidos o pregunta en barra.</p>
        </details>
        <details>
          <summary>¿Hay que reservar?</summary>
          <p>No. En partidos grandes, mejor llegar pronto.</p>
        </details>
        <details>
          <summary>Dirección</summary>
          <p>{SITE.address}, {SITE.postal}</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
