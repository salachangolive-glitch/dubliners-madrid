---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import CtaRow from '../../../components/CtaRow.astro';
import { SITE, withBase } from '../../../site';
import { HOURS_ES } from '../../../i18n';
import { hoursSummary } from '../../../data/hours';

const title = 'Visitar Dubliners Madrid | Cerca de Puerta del Sol — Dirección, Metro y mapa';
const description =
  `Espoz y Mina 7, junto a Puerta del Sol. Metro Sol (L1, L2, L3) o Sevilla (L2). Horario ${hoursSummary('es', '; ').replace(/^L/, 'l').replace('; V', '; v')}. Neón verde en fachada.`;
---

<BaseLayout title={title} description={description} path="/es/visitar/" lang="es" ogImage="/images/facade.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Visitar" lang="es" />
        <h1>Cómo llegar desde Puerta del Sol</h1>
        <p class="lead">
          Pub irlandés en Espoz y Mina 7 — junto a Puerta del Sol.
          Metro Sol (L1, L2, L3) o Sevilla (L2); busca el neón verde de Dubliners.
        </p>
        <CtaRow lang="es" />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/facade-sm.webp')} 800w, ${withBase('/images/facade.webp')} 1280w`}
          sizes="(max-width: 880px) 100vw, 45vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/facade.jpg')} alt="Fachada de Dubliners con neón verde en Espoz y Mina 7" width="1280" height="720" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Dirección</h2>
      <div class="card">
        <p style="color:var(--text);margin:0">
          <strong>{SITE.name}</strong><br />
          {SITE.address}<br />
          {SITE.postal}<br />
          España<br /><br />
          Instagram: <a href={SITE.instagram} rel="noopener noreferrer" target="_blank">{SITE.instagramHandle}</a>
        </p>
      </div>

      <h2>Horario</h2>
      <table class="hours-table">
        <thead>
          <tr><th>Día</th><th>Horario</th></tr>
        </thead>
        <tbody>
          {HOURS_ES.map((h) => (
            <tr>
              <th scope="row">{h.day}</th>
              <td>{h.hours}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p>{hoursSummary('es')}.</p>

      <h2>Cómo llegar desde Sol</h2>
      <ul>
        <li><strong>Referencia:</strong> Puerta del Sol — estamos en Calle de Espoz y Mina, saliendo de la plaza hacia Carrera de San Jerónimo / Sevilla</li>
        <li><strong>A pie:</strong> a un paseo corto del kilómetro cero / Puerta del Sol</li>
        <li><strong>Metro:</strong> Sol (L1, L2, L3) o Sevilla (L2) — ambos a un paseo corto</li>
        <li>Pub en sala — entra cuando quieras; sin reserva</li>
      </ul>
      <p>
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Abrir Cómo llegar en Google Maps</a>
      </p>

      <div class="map-frame">
        <iframe title="Mapa de Google — Dubliners Madrid" loading="lazy" src={SITE.mapsEmbed}></iframe>
      </div>

      <h2>Reconócenos desde la calle</h2>
      <p>Busca el neón verde de Dubliners y el escaparate vintage en Espoz y Mina.</p>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/window-display-sm.webp')} 800w, ${withBase('/images/window-display.webp')} 1600w`}
          sizes="(max-width: 880px) 100vw, 70vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/window-display.jpg')} alt="Curiosidades vintage en el escaparate de Dubliners" width="1600" height="902" loading="lazy" />
      </picture>
      <picture style="margin-top:1rem;display:block">
        <source
          type="image/webp"
          srcset={`${withBase('/images/window-display-2-sm.webp')} 800w, ${withBase('/images/window-display-2.webp')} 1600w`}
          sizes="(max-width: 880px) 100vw, 70vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/window-display-2.jpg')} alt="Caja de Jameson y antigüedades en el escaparate de Dubliners" width="1600" height="902" loading="lazy" />
      </picture>

      <h2>Enlaces útiles</h2>
      <ul>
        <li><a href={withBase('/es/partidos/')}>Partidos — agenda de hoy</a></li>
        <li><a href={withBase('/es/premier-league-pub-madrid/')}>Noches de Premier League cerca de Sol</a></li>
        <li><a href={withBase('/es/champions-league-bar-madrid/')}>Pantallas Champions League</a></li>
        <li><a href={withBase('/es/bar-deportivo-madrid/')}>Bar deportivo Madrid</a></li>
        <li><a href={withBase('/es/estudiantes-internacionales/')}>Erasmus y estudiantes internacionales</a></li>
        <li><a href={withBase('/es/miercoles-chupitos-1-euro/')}>Miércoles chupitos a 1 €</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
