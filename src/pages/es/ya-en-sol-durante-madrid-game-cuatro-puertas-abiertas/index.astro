---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import LinkHub from '../../../components/LinkHub.astro';
import FixtureAntiStale from '../../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../../components/OriginalFourBars.astro';
import FanWeekendCtas from '../../../components/FanWeekendCtas.astro';
import { withBase, absUrl } from '../../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../../data/fourBars';

const PATH = '/es/ya-en-sol-durante-madrid-game-cuatro-puertas-abiertas/';
const PATH_EN = '/already-in-sol-during-madrid-game-four-open-doors/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Ya en Sol durante el Madrid Game: las cuatro puertas abiertas como punto de encuentro en la ciudad',
  inLanguage: 'es',
  datePublished: '2026-11-08T15:05:00+01:00',
  dateModified: '2026-11-08T15:05:00+01:00',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/es/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Ya estamos en Sol mientras Bengals–Falcons se juega en el Bernabéu. ¿Dónde es el punto de encuentro en la ciudad?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Las cuatro puertas hermanas junto a Puerta del Sol — todas abiertas ahora. Four Corner, Calle de la Victoria 6, está abierto (desde las 14:00 hasta la madrugada, pantallas de deporte). Dubliners y O’Connell’s en Calle de Espoz y Mina 7. O’Reilly’s en Pasaje de Matheu 4. Mantened ese clúster mientras el partido del estadio sigue, y después reuníos con quienes salgan del estadio. Listados con nombre: solo Partidos de Dubliners. Preguntad qué echan.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Esto es la página de antes y después de Bengals o la de seguir después del partido?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Antes y después es la quedada en Sol antes de las 15:30 y el regreso. Seguir después del partido es el pin de NFL de después y Atlético–Barcelona 21:00 cuando el Madrid Game ya ha acabado. Maps de salida del estadio es para quien sale del Bernabéu. Esta página es solo para quien ya está sentado en Sol mientras el estadio sigue jugando.',
      },
    },
    {
      '@type': 'Question',
      name: '¿Quedarse en Sol durante el Madrid Game sustituye Premier 15:00 / 17:30 o Atlético–Barcelona 21:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Coordinad; no sustituyáis. Premier League desde las 15:00 y United–Villa 17:30 van a la vez que el Madrid Game 15:30 en Partidos de Dubliners. La NFL de después desde las 19:00 y Atlético vs Barcelona 21:00 siguen en las mismas dos calles. No asignamos esos partidos a O’Reilly’s, O’Connell’s ni Four Corner. Preguntad qué pantalla.',
      },
    },
  ],
};
---

<BaseLayout
  title="Ya en Sol durante el Madrid Game: cuatro puertas abiertas AHORA | Dubliners"
  description="Domingo 8 nov: ya en Sol, no en el Bernabéu. Las cuatro puertas hermanas están abiertas AHORA mientras el Madrid Game se juega en el estadio. Mantened el pin de la ciudad y reuníos después con quienes salgan del estadio. Maps. FIND US."
  path={PATH}
  lang="es"
  hreflang={{ en: PATH_EN, es: PATH }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Ya en Sol durante el Madrid Game: cuatro puertas abiertas AHORA" schema />
      <h1>Ya en Sol durante el Madrid Game: las cuatro puertas abiertas como punto de encuentro en la ciudad</h1>
      <p class="lead">
        <strong>No</strong> habéis ido al Santiago Bernabéu. Ya estáis junto a Puerta del Sol mientras Bengals vs Falcons se juega en el estadio.
        <strong>Las cuatro puertas hermanas están abiertas AHORA</strong> — Four Corner en Calle de la Victoria 6 (desde las 14:00 hasta la madrugada, pantallas de deporte),
        Dubliners y O’Connell’s en Espoz y Mina 7, O’Reilly’s en Pasaje de Matheu 4.
        Mantened este clúster como pin de la ciudad. Quienes salgan del estadio se os unen después. Listados con nombre: solo Partidos de Dubliners. Preguntad qué echan. Maps abajo.
      </p>
      <p class="small">In English: <a href={withBase(PATH_EN)} hreflang="en" lang="en">Already in Sol during the Madrid Game: four doors open NOW</a></p>
      <FanWeekendCtas lang="es" findHref="/es/visitar/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Este es el pin de la ciudad durante el partido — no antes-después, no salida del estadio, no seguir después</h2>
      <p>
        <a href={withBase('/es/antes-despues-bengals-falcons-sol/')}>Antes y después de Bengals–Falcons</a> es la quedada
        en Sol antes de las 15:30 y el regreso. <a href={withBase('/es/salida-bernabeu-a-las-cuatro-puertas-sol/')}>Maps de salida del estadio</a>
        es para quien sale del Bernabéu. <a href={withBase('/es/despues-madrid-game-seguir-cuatro-puertas-abiertas/')}>Después del Madrid Game</a>
        es el pin de NFL de después y Atleti cuando ya ha pitado.
        Esta página es solo para quien <strong>ya está sentado en Sol mientras el estadio sigue jugando</strong>.
        No es la última hora antes de las 14:00. No es un paseo por Plaza Mayor, Atocha, Callao o Tirso. No re-promocionéis el sábado 18:00–19:00 como si siguiera.
      </p>

      <h2>Mantened el pin de las cuatro puertas mientras el estadio sigue</h2>
      <p>
        Escribid al grupo <strong>Victoria 6 / Espoz y Mina 7 / Pasaje de Matheu 4</strong> — no un barrio al otro lado de la ciudad.
        Four Corner <strong>está abierto ahora</strong> (desde las 14:00 hasta la madrugada · pantallas de deporte). No listamos qué echan allí.
        O’Reilly’s y O’Connell’s son puntos de encuentro del mismo clúster; no copiamos el cartel de Dubliners a esas puertas.
        Bengals vs Falcons va EN DIRECTO a las 15:30 en <a href={withBase('/es/partidos/')}>Partidos</a> de Dubliners (también el partido del Bernabéu).
        Preguntad qué pantalla. No está cada partido en cada pantalla.
      </p>
      <ol>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid.</strong>
          Abierto AHORA (desde las 14:00 hasta la madrugada · pantallas de deporte). Preguntad en la puerta.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          Domingo 12:00–02:00. Pantallas con nombre en Partidos. Preguntad qué echan.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (en Maps: O’Connell St).
          Mismo número, otra puerta, otro CID. Punto de encuentro; no inventamos su cartel.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Pasaje cubierto. Habitual desde las 11:30. Punto de encuentro; sin menú inventado.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Cómo llegar a pie</a>.
        </li>
      </ol>

      <h2>Qué hay en las pantallas de la ciudad a las 15:30 — luego el público del estadio</h2>
      <p>
        <a href={withBase('/es/partidos/')}>Partidos</a> de Dubliners ya lista el domingo 8 de noviembre en hora de Madrid.
        Premier League desde las <strong>15:00</strong> (Crystal Palace vs Liverpool · Sunderland vs Chelsea · Brighton vs Brentford · Ipswich Town vs Bournemouth)
        va a la vez que Bengals vs Falcons <strong>15:30</strong> EN DIRECTO. United–Villa es a las <strong>17:30</strong>.
        NFL de después desde las <strong>19:00</strong> luego <strong>22:05</strong> / <strong>22:25</strong>, RedZone desde las 19:00, Atlético vs Barcelona <strong>21:00</strong>.
        Coordinad; no sustituyáis. Listados con nombre: solo Dubliners. No asignamos esos partidos a O’Reilly’s, O’Connell’s ni Four Corner.
      </p>
      <p>
        Cuando se vacíe el estadio, el pin es el mismo. Quienes salgan del Bernabéu usan
        <a href={withBase('/es/salida-bernabeu-a-las-cuatro-puertas-sol/')}>Maps del estadio a estas cuatro puertas abiertas</a>.
        Cuando se sienten, el pin de NFL de después y Atleti es
        <a href={withBase('/es/despues-madrid-game-seguir-cuatro-puertas-abiertas/')}>seguir después del Madrid Game en las cuatro puertas abiertas</a>.
        ¿Camisetas partidas en Espoz y Mina 7?
        <a href={withBase('/es/bengals-falcons-reparte-dos-puertas-espoz-mina-7/')}>Afición Bengals y Falcons, dos puertas, un número</a>.
      </p>

      <OriginalFourBars lang="es" when="sunday" findHref="/es/visitar/" />

      <h2>Preguntas frecuentes</h2>
      <dl class="faq">
        <dt><strong>Ya en Sol mientras el Madrid Game se juega en el estadio. ¿Dónde quedamos?</strong></dt>
        <dd>Las cuatro puertas abiertas AHORA: Victoria 6, Espoz y Mina 7 dos veces, Pasaje de Matheu 4. Mantened ese pin. Quienes salgan del estadio se unen después. Preguntad qué echan.</dd>
        <dt><strong>¿Esto es antes-después o seguir después del partido?</strong></dt>
        <dd>No. Esas páginas son la quedada antes de las 15:30 / el regreso, y el pin de NFL de después y Atleti cuando ya ha pitado. Esto es durante: ya en Sol, el estadio sigue.</dd>
        <dt><strong>¿Sustituye Premier 15:00 / 17:30 o Atleti 21:00?</strong></dt>
        <dd>No. Coordinad. Esos relojes van a la vez en Partidos de Dubliners. No copiamos ese cartel a las puertas hermanas.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Ya en Sol este domingo',
            until: SHOW_UNTIL,
            items: [
              { href: '/es/', label: 'FIND US — inicio Dubliners' },
              { href: '/es/visitar/', label: 'CÓMO LLEGAR — visitar / horario' },
              { href: '/es/cuatro-bares-fin-de-semana/', label: 'VER LOS CUATRO BARES' },
              { href: '/es/bengals-falcons-reparte-dos-puertas-espoz-mina-7/', label: 'Bengals y Falcons: dos puertas en Espoz y Mina 7' },
              { href: '/es/partidos/', label: 'Partidos — pantallas con nombre' },
              { href: PATH_EN, label: 'Already in Sol during the Madrid Game: four doors open NOW', note: 'In English', hreflang: 'en', lang: 'en' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
