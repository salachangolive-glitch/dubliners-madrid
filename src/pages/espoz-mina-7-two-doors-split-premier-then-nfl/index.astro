import OriginalFourBars from '../../components/OriginalFourBars.astro';
import FanWeekendCtas from '../../components/FanWeekendCtas.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/espoz-mina-7-two-doors-split-premier-then-nfl/';
const PATH_ES = '/es/espoz-mina-7-dos-puertas-reparte-premier-luego-nfl/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Espoz y Mina 7: two doors, one number — split Premier 15:00 vs NFL later',
  inLanguage: 'en',
  datePublished: '2026-11-08T07:00:00+01:00',
  dateModified: '2026-11-08T07:00:00+01:00',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Our group splits: some want Premier League at 15:00, others NFL later. Do we leave Espoz y Mina 7?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Dubliners and O’Connell’s share Calle de Espoz y Mina 7 — same number, two doors, two Maps pins. Keep that number as the reunion. Named Premier and NFL listings sit on Dubliners What’s On only. We do not assign Palace–Liverpool, Sunderland–Chelsea, Brighton–Brentford, Ipswich–Bournemouth or the NFL Game to a specific sister door. Ask which screen.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where do O’Reilly’s and Four Corner sit if we split at Espoz y Mina 7?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'O’Reilly’s Restaurant Bar is Pasaje de Matheu 4 — the covered cut-through, about 1–2 minutes from number 7. Four Corner is Calle de la Victoria 6, about 2 minutes, from 14:00 with sports screens (not open before). Overflow pins, not substitutes. Maps below.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does splitting Premier vs NFL replace Atlético–Barcelona at 21:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Coordinate; do not substitute. United–Villa is 17:30 on Dubliners What’s On. NFL afternoon (Bengals–Falcons 15:30 LIVE) and evening from 19:00 sit alongside. Atlético vs Barcelona is 21:00 on the same Dubliners board. Not every game on every screen.',
      },
    },
  ],
};
---

<BaseLayout
  title="Espoz y Mina 7 two doors — split Premier 15:00 vs NFL later | Dubliners"
  description="Sunday 8 Nov: Dubliners and O’Connell’s share Calle de Espoz y Mina 7. Same number, two doors when a group splits Premier 15:00 vs NFL later. Then O’Reilly’s Matheu 4 and Four Corner Victoria 6. Maps."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Espoz y Mina 7: two doors, one number" schema />
      <h1>Espoz y Mina 7: two doors, one number — split Premier 15:00 vs NFL later</h1>
      <p class="lead">
        Saturday is over. Half the table wants English kick-offs at 15:00. The other half wants NFL later.
        <strong>You do not need two neighbourhoods.</strong>
        Dubliners and O’Connell’s share <strong>Calle de Espoz y Mina 7</strong> — same street number, two doors, two Maps CIDs.
        Pin the number. Then O’Reilly’s in Pasaje de Matheu and Four Corner on Victoria 6 (from 14:00, sports screens).
        Named listings: Dubliners What’s On only. Ask which screen.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Espoz y Mina 7: dos puertas, un número — Premier 15:00 frente a NFL después</a></p>
      <FanWeekendCtas lang="en" findHref="/visit/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Same building number, not a which-bar personality quiz</h2>
      <p>
        Other pages already pick a Sunday door by terrace vs screens, walk you through waking to the 15:00 Premier block,
        keep you on two streets all day, or list the four 15:00s against the 15:30 NFL Game.
        This page is only the <strong>split group that still wants one pin</strong>:
        Premier shirts through one door of number 7, NFL shirts through the other — without losing each other across Madrid.
        We do not claim which of those two doors shows which match.
      </p>

      <h2>One number, two Maps pins</h2>
      <p>
        <strong>Dubliners</strong> and <strong>O’Connell’s</strong> both read Calle de Espoz y Mina 7, 28012 Madrid.
        They are distinct listings (O’Connell’s appears on Maps as O’Connell St). Sunday 8 Nov both from 12:00
        (O’Connell’s usual Sunday is 14:00; today is the exception).
        If the table splits at 15:00, keep <strong>Espoz y Mina 7</strong> as the reunion text.
        Step outside; the other door is the same façade line.
      </p>
      <p>
        Named on Dubliners <a href={withBase('/whats-on/')}>What’s On</a> (ask which screen — not every game on every screen):
      </p>
      <ul>
        <li><strong>15:00</strong> — Crystal Palace vs Liverpool · Sunderland vs Chelsea · Brighton vs Brentford · Ipswich Town vs Bournemouth</li>
        <li><strong>15:30</strong> — Bengals vs Falcons LIVE (NFL Madrid Game)</li>
        <li><strong>17:30</strong> — Manchester United vs Aston Villa</li>
        <li><strong>from 19:00</strong> — NFL evening / RedZone · <strong>21:00</strong> — Atlético vs Barcelona</li>
      </ul>
      <p>
        We do not copy that board onto O’Connell’s, O’Reilly’s or Four Corner. Ask at each door.
      </p>

      <h2>Then the other two pins — overflow, not substitutes</h2>
      <p>
        Four Corner, Calle de la Victoria 6, opens <strong>14:00 until late with sports screens</strong> — one hour before the 15:00s; not open before 14:00.
        O’Reilly’s, Pasaje de Matheu 4, is the covered cut-through (usual from 11:30). About <strong>1–2 minutes</strong> from number 7 to Matheu;
        about <strong>2 minutes</strong> from number 7 to Victoria 6.
        Use them when number 7 is full — not as a reason to send half the group across the city.
        Premier, NFL and Atleti sit alongside; coordinate screens, do not substitute.
      </p>
      <ol>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          One of the two doors at this number. Sunday from 12:00. Named Premier, NFL and Atleti listings on What’s On. Ask which screen.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (Maps listing: O’Connell St).
          The other door at the same number. From 12:00 today (usual Sunday 14:00). Meeting point; we do not invent its board.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Passage overflow, 1–2 min from number 7. Terrace restaurant-bar. We do not list its board.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid.</strong>
          Opens 14:00 until late · sports screens. Not open before 14:00. About 2 min from number 7. Ask which game is on.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
      </ol>

      <OriginalFourBars lang="en" when="sunday" findHref="/visit/" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Group splits Premier 15:00 vs NFL later. Leave Espoz y Mina 7?</strong></dt>
        <dd>No. Same number, two doors. Pin Espoz y Mina 7. Named listings: Dubliners What’s On. We do not assign a match to a sister door. Ask which screen.</dd>
        <dt><strong>Where are O’Reilly’s and Four Corner from number 7?</strong></dt>
        <dd>Matheu 4 is the covered cut-through, 1–2 min. Victoria 6 is ~2 min, from 14:00 with sports screens (not before). Overflow, not substitutes.</dd>
        <dt><strong>Does this replace Atleti–Barça 21:00?</strong></dt>
        <dd>No. Coordinate. United–Villa 17:30, NFL 15:30 / from 19:00, Atleti 21:00 sit alongside on Dubliners What’s On.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Same number, two doors this Sunday',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'FIND US — Dubliners home' },
              { href: '/visit/', label: 'GET DIRECTIONS — visit / hours' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/whats-on/', label: 'What’s On — named screens' },
              { href: '/plaza-mayor-arcade-downhill-sol-doors-before-1400/', label: 'Plaza Mayor east arcade downhill before 14:00' },
              { href: PATH_ES, label: 'Espoz y Mina 7: dos puertas, un número', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
