---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../components/OriginalFourBars.astro';
import FanWeekendCtas from '../../components/FanWeekendCtas.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/evening-metro-gran-via-sevilla-to-open-sol-doors/';
const PATH_ES = '/es/metro-tarde-gran-via-sevilla-a-puertas-sol-abiertas/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Evening Metro into Sol: Gran Vía or Sevilla to Victoria 6 and Espoz y Mina 7 (four doors already open)',
  inLanguage: 'en',
  datePublished: '2026-11-08T17:00:00+01:00',
  dateModified: '2026-11-08T17:00:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'I am on evening Metro toward Sol for 19:00 NFL. Gran Vía or Sevilla — which door?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'All four sister doors are open NOW. Four Corner, Calle de la Victoria 6 (from 14:00 until late, sports screens). Dubliners and O’Connell’s, Calle de Espoz y Mina 7. O’Reilly’s, Pasaje de Matheu 4. Sevilla (L2) is already the east pocket — pin Victoria 6 and Espoz y Mina 7. Gran Vía (L1/L5): follow live Maps south toward Sol, then south-east to those same pins, or ride L1 one stop to Sol. Named 19:00 NFL and Atlético–Barcelona 21:00: Dubliners What’s On only. Ask which game.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is this the first Sunday Metro page, Callao–Preciados, Tirso, or Barajas?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. First Metro is early Sunday, when Four Corner is not yet open. Callao–Preciados is a shopping-street walk with bags before 14:00. Tirso / Antón Martín is walking north from L1 south of Sol before 14:00. Barajas is a late airport landing. Saturday 21:00 Metro Sol was three Saturday doors for Valencia. This page is evening inbound Metro on Sunday, four doors already open, Gran Vía station or Sevilla to Victoria 6 and Espoz y Mina 7.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are the four doors open if I surface at Gran Vía or Sevilla after 17:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Sunday is four bars. Four Corner is open from 14:00 until late, sports screens. Saturday’s three-bar meetup is over. Follow live Maps; we do not invent a Gran Vía-station clock. From the east side of Sol, Victoria 6 is about 2–3 minutes / 180–220 m (already published). Ask which game is on. Premier sits alongside NFL and Atleti; do not substitute.',
      },
    },
  ],
};
---

<BaseLayout
  title="Evening Metro: Gran Vía or Sevilla to Victoria 6 and Espoz y Mina 7 | Dubliners"
  description="Sunday 8 Nov evening Metro into Sol. Gran Vía (L1/L5) or Sevilla (L2) to Victoria 6 and Espoz y Mina 7. All four doors are open NOW. 19:00 NFL then Atleti 21:00. Maps. FIND US."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Evening Metro: Gran Vía or Sevilla to the four open doors" schema />
      <h1>Evening Metro into Sol: Gran Vía or Sevilla to Victoria 6 and Espoz y Mina 7</h1>
      <p class="lead">
        You are not on the first Sunday train. You are not shopping Callao with bags. You are not landing at Barajas.
        <strong>Evening Metro inbound</strong> — Gran Vía (L1/L5) or Sevilla (L2) — for 19:00 NFL then Atlético–Barcelona 21:00.
        <strong>All four sister doors are open NOW.</strong> Four Corner, Calle de la Victoria 6, is open (from 14:00 until late, sports screens).
        Pin Victoria 6 and Espoz y Mina 7. Saturday’s three-bar meetup is over. Follow live Maps. Ask which game.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Metro de tarde: Gran Vía o Sevilla a Victoria 6 y Espoz y Mina 7</a></p>
      <FanWeekendCtas lang="en" findHref="/visit/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Evening inbound — not first Metro, not Callao bags, not Tirso, not Barajas</h2>
      <p>
        <a href={withBase('/first-metro-into-sol-sunday-station-to-door/')}>First Sunday Metro</a> is station-to-door when Metro starts,
        with Four Corner not open yet. <a href={withBase('/callao-preciados-shop-south-sol-doors-before-1400/')}>Callao–Preciados</a>
        is a shopping street south before 14:00. <a href={withBase('/tirso-anton-martin-north-sol-doors-before-1400/')}>Tirso / Antón Martín</a>
        is walking north from L1 south of Sol before 14:00. <a href={withBase('/barajas-small-hours-into-sol-until-1400/')}>Barajas small hours</a>
        is an airport landing. <a href={withBase('/sol-metro-2100-which-saturday-door/')}>Metro Sol at 21:00 Saturday</a>
        was three Saturday doors for Valencia–RM.
        This page is only <strong>Sunday evening Metro</strong> into the east Sol pocket, four doors already serving.
      </p>

      <h2>Gran Vía (L1/L5) or Sevilla (L2) — then Victoria 6 and Espoz y Mina 7</h2>
      <p>
        <strong>Sevilla (L2).</strong> You are already on the east pocket of Sol. Surface and pin
        Calle de la Victoria 6 and Calle de Espoz y Mina 7. From the east side of Sol, Victoria 6 is about
        <strong>2–3 minutes / 180–220 m</strong> (already published). Espoz y Mina 7 is the nearest number-7 pair.
        Follow live Maps for the last metres; we do not invent a new clock.
      </p>
      <p>
        <strong>Gran Vía (L1/L5).</strong> This is the Metro station, not a shopping crawl and not a Saturday three-door night.
        Follow live Google Maps south toward Puerta del Sol, then south-east to Victoria 6 / Espoz y Mina 7 / Pasaje de Matheu 4 —
        or ride <strong>L1 one stop to Sol</strong> and use the same east-side pins. We do not invent minutes from the Gran Vía platforms.
        Do not wait on Gran Vía itself. The four open doors are the meeting point, not the station.
      </p>
      <ol>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid.</strong>
          Open NOW (from 14:00 until late · sports screens). Closest Victoria pin from Sevilla.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          Sunday 12:00–02:00. Named 19:00 NFL and Atleti 21:00 on What’s On. Ask which game is on.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (Maps listing: O’Connell St).
          Same number, different door, different CID. Meeting point; we do not invent its board.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Covered cut-through from Victoria / Espoz y Mina. Usual from 11:30. Meeting point; no invented menu.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
      </ol>

      <h2>What you are riding in for — Premier sits alongside, it does not replace</h2>
      <p>
        Dubliners <a href={withBase('/whats-on/')}>What’s On</a> already lists Sunday 8 November in Madrid time.
        If you surface after United–Villa <strong>17:30</strong>, stay at these four open doors:
        NFL from <strong>19:00</strong> then <strong>22:05</strong> / <strong>22:25</strong>, RedZone from 19:00, Atlético vs Barcelona <strong>21:00</strong>.
        Coordinate; do not substitute. Named listings: Dubliners only. We do not assign those matches to O’Reilly’s, O’Connell’s or Four Corner.
        Ask which screen.
      </p>
      <p>
        Already through 17:30 at a door, not still on the train?
        <a href={withBase('/stay-after-united-villa-1730-four-open-doors/')}>Stay at the four open doors for 19:00 then 21:00</a>.
      </p>

      <OriginalFourBars lang="en" when="sunday" findHref="/visit/" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Evening Metro, Gran Vía or Sevilla. Where do we walk?</strong></dt>
        <dd>Victoria 6 and Espoz y Mina 7 (Matheu 4 is the covered cut-through). All four doors open NOW. Sevilla is already the east pocket. Gran Vía: live Maps south to Sol, or L1 one stop. Ask which game.</dd>
        <dt><strong>Is this first Metro, Callao, Tirso or Barajas?</strong></dt>
        <dd>No. Those are early Sunday, shopping-before-14:00, south-of-Sol before 14:00, and the airport. This is Sunday evening inbound, four doors already open.</dd>
        <dt><strong>Does arriving by Metro replace Premier, NFL or Atleti?</strong></dt>
        <dd>No. Coordinate. Named clocks sit alongside on Dubliners What’s On. We do not copy that board onto sister doors.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Evening Metro this Sunday',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'FIND US — Dubliners home' },
              { href: '/visit/', label: 'GET DIRECTIONS — visit / hours' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/stay-after-united-villa-1730-four-open-doors/', label: 'After United–Villa 17:30: stay at the four open doors' },
              { href: '/whats-on/', label: 'What’s On — named screens only' },
              { href: PATH_ES, label: 'Metro de tarde: Gran Vía o Sevilla a Victoria 6 y Espoz y Mina 7', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
