---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/fifteen-hours-sol-until-four-corner-1400/';
const PATH_ES = '/es/quince-horas-sol-hasta-four-corner-1400/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Overnight clock near Sol: ~15 hours until Four Corner 14:00, ~16 until Premier 15:00',
  inLanguage: 'en',
  datePublished: '2026-11-07T23:00:00+01:00',
  dateModified: '2026-11-07T23:00:00+01:00',
  image: absUrl('/images/screens-sports.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'From late Saturday (~23:00), how many hours until Four Corner 14:00 and Premier League 15:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'About 15 hours until Four Corner, Calle de la Victoria 6, opens Sunday 8 November from 14:00 with sports screens. About 16 hours until the English 15:00s. Stay near Sol tonight so Sunday is a walk, not a commute.',
      },
    },
    {
      '@type': 'Question',
      name: 'Should English tourists leave Sol after the Saturday last pint?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Sleep in the same pocket. O’Reilly’s (Pasaje de Matheu 4) until 01:30, Dubliners until 02:30, O’Connell’s until 03:30 — then a gap until Sunday. Four Corner is not tonight. Named Premier League listings sit on Dubliners’ live What’s On. Ask which game is on.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does staying for Premier 15:00 replace NFL or Atlético–Barcelona?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Sunday’s English clocks sit alongside NFL afternoon/evening and Atlético vs Barcelona 21:00. Named listings are at Dubliners. Coordinate; do not treat Sunday as Premier-only. We do not invent sister-bar boards.',
      },
    },
  ],
};
---

<BaseLayout
  title="Overnight clock: 15 hours until Four Corner 14:00 | Dubliners"
  description="Late Saturday near Sol: ~15 hours until Four Corner 14:00, ~16 until Premier 15:00. Stay in the pocket. Maps. Ask which game is on. FIND US / GET DIRECTIONS."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/screens-sports.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Overnight clock until Sunday 14:00" schema />
      <h1>Overnight clock near Sol: ~15 hours until Four Corner 14:00, ~16 until Premier 15:00</h1>
      <p class="lead">
        It is late Saturday. English football is tomorrow, not now.
        From <strong>~23:00 Europe/Madrid</strong> you have about
        <strong>15 hours until Four Corner, Victoria 6, opens 14:00</strong>
        and about <strong>16 hours until the English 15:00s</strong>.
        Sleep in Sol. Do not start Sunday from another neighbourhood.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Reloj de madrugada: ~15 horas hasta Four Corner 14:00</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Four Corner on Maps (Sunday)</a>
        <a class="btn btn-secondary" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Maps</a>
        <a class="btn btn-secondary" href={withBase('/4-bars-one-fan-weekend/')}>MEET US NEAR SOL</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>This is a countdown, not a leftover-Saturday listing</h2>
      <p>
        Other pages already cover what Saturday night is still for, Sunday lunch then screens,
        and the four-bar stack from Victoria 6. This page is only the overnight clock:
        hours left until the fourth door and the English 15:00s, and why that clock only works
        if you <strong>stay near Sol tonight</strong>. The 18:00–19:00 meetup is over.
        There is <strong>no official NFL Saturday</strong>.
      </p>
      <ul>
        <li>
          <strong>~15 hours → 14:00 Sunday — Four Corner, Calle de la Victoria 6.</strong>
          Sports screens. Ask which game is on. We do not invent its board.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>.
        </li>
        <li>
          <strong>~16 hours → 15:00 Sunday — English clocks on Dubliners’ live What’s On.</strong>
          Palace–Liverpool, Sunderland–Chelsea, Brighton–Brentford, Ipswich–Bournemouth sit at that hour.
          Named Premier League listings stay at Dubliners. Not every game on every sister screen.
        </li>
        <li>
          <strong>Tonight’s remaining Saturday doors close first.</strong>
          O’Reilly’s, Pasaje de Matheu 4, until 01:30 (~2.5 hours from 23:00).
          Dubliners, Espoz y Mina 7, until 02:30. O’Connell’s, same number, until 03:30.
          Then a gap until Sunday midday. Four Corner is not a Saturday overnight door.
        </li>
      </ul>

      <h2>Stay in Sol so Sunday is a walk, not a commute</h2>
      <p>
        If you hotel or sleep ten Metro stops away, you burn the 14:00–15:00 hour on the train.
        The fourth sister door exists so you can be in the block <em>before</em> English kick-off:
      </p>
      <ol>
        <li>
          <strong>14:00 — Four Corner opens</strong> (sports screens). One hour of buffer.
        </li>
        <li>
          <strong>15:00 — English 15:00s</strong> named at Dubliners. The same hour sits alongside
          Bengals vs Falcons 15:30 LIVE on Dubliners’ big screen — coordinate, do not substitute.
        </li>
        <li>
          <strong>17:30 — United–Villa</strong> on that same Dubliners board, before NFL from 19:00
          and Atlético vs Barcelona 21:00 at Dubliners. Sunday is not Premier-only.
        </li>
      </ol>
      <p>
        O’Reilly’s from 11:30 and Dubliners / O’Connell’s from 12:00 are already in the same two streets
        if you want a pint before Victoria 6 opens. Ask which game is on. Independent pubs.
        Not an official NFL event. No invented discounts or bookings.
      </p>

      <OriginalFourBars lang="en" when="sunday" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>From ~23:00, how long until Four Corner 14:00 and Premier 15:00?</strong></dt>
        <dd>About 15 hours to Victoria 6 14:00 (sports screens). About 16 hours to the English 15:00s. Stay near Sol tonight.</dd>
        <dt><strong>Leave Sol after the last pint?</strong></dt>
        <dd>No. Three Saturday doors until 01:30 / 02:30 / 03:30, then sleep in the pocket. Four Corner is Sunday 14:00.</dd>
        <dt><strong>Does Premier 15:00 replace NFL or Atleti–Barça?</strong></dt>
        <dd>No. Named English listings are at Dubliners. They sit alongside NFL afternoon/evening and Atleti 21:00. Ask at the bar.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Overnight clock, then Sunday screens',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'FIND US — Dubliners home' },
              { href: '/visit/', label: 'GET DIRECTIONS — visit / hours' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/hop-two-streets-last-pint-after-derby/', label: 'Last pint: hop the two streets still open' },
              { href: '/premier-league-sunday-sol-8-nov/', label: 'Premier League Sunday near Sol' },
              { href: '/four-corner-opens-sunday-1400/', label: 'Four Corner Sunday 14:00' },
              { href: PATH_ES, label: 'Reloj de madrugada: horas hasta el 14:00', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
