---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/first-metro-into-sol-sunday-station-to-door/';
const PATH_ES = '/es/primer-metro-a-sol-domingo-estacion-a-puerta/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'First Sunday Metro into Sol: station to Victoria 6, Espoz y Mina 7, Pasaje de Matheu 4',
  inLanguage: 'en',
  datePublished: '2026-11-08T05:00:00+01:00',
  dateModified: '2026-11-08T05:00:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'I will ride the first Sunday Metro into Sol. Which station, and which door is first?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ride into Metro Sol (L1, L2, L3) or Sevilla (L2). Saturday’s meetup and Valencia–Real Madrid are finished. This is a station-to-door hop, not a hotel checkout and not a Barajas landing. Surface and walk south-east — not Gran Vía. Four Corner, Calle de la Victoria 6, opens 14:00 with sports screens (not before). O’Reilly’s is Pasaje de Matheu 4; Dubliners and O’Connell’s are Calle de Espoz y Mina 7. Pin Victoria 6 for 14:00; do not wait at a closed door.',
      },
    },
    {
      '@type': 'Question',
      name: 'When does Sunday Metro start, and how long until Four Corner opens?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Ride when Sunday Metro starts — we do not invent a clock here. From early Sunday morning it is about nine hours until Four Corner opens at 14:00. Victoria 6 is 2–3 minutes / 180–220 m from the east side of Sol. From Sevilla (L2) you are already on that east pocket; Espoz y Mina 7 is the nearest pin.',
      },
    },
    {
      '@type': 'Question',
      name: 'If I get off Metro Sol before 14:00, can I go to Four Corner now?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Four Corner opens Sunday 8 November from 14:00 until late, with sports screens. If you surface before 11:30, wait near Sol — not on Victoria 6. O’Reilly’s usual from 11:30; Dubliners and O’Connell’s from 12:00 today. Be on Victoria for the 14:00 open, then hop the three sister doors.',
      },
    },
  ],
};
---

<BaseLayout
  title="First Sunday Metro into Sol — station to Victoria, Espoz y Mina, Matheu | Dubliners"
  description="Sunday 8 Nov: first Metro into Sol. Station-to-door to Victoria 6 (14:00), Espoz y Mina 7, Pasaje de Matheu 4. Not a hotel or airport walk. Maps. FIND US."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="First Sunday Metro into Sol: station to door" schema />
      <h1>First Sunday Metro into Sol: station to Victoria 6, Espoz y Mina 7, Pasaje de Matheu 4</h1>
      <p class="lead">
        Saturday is over. The meetup and Valencia–Real Madrid are finished.
        <strong>You are not at Barajas and you are not checking out of a Sol hotel.</strong>
        You will ride the first Sunday Metro <em>into</em> Sol, then walk platform to door.
        Four Corner, Calle de la Victoria 6, opens 14:00 with sports screens — about nine hours from early Sunday morning, not open before then.
        Then Pasaje de Matheu 4 and Espoz y Mina 7 twice. Maps below.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Primer Metro a Sol el domingo: de la estación a la puerta</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Walk Victoria 6 (from 14:00)</a>
        <a class="btn btn-secondary" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">GET DIRECTIONS</a>
        <a class="btn btn-secondary" href={withBase('/4-bars-one-fan-weekend/')}>MEET US NEAR SOL</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>This is a station-to-door hop, not a hotel walk and not an airport landing</h2>
      <p>
        Other pages already cover the Sol hotel checkout, the late Barajas taxi, the generic square-to-four-bars stroll,
        and Four Corner’s 14:00 opening itself.
        This page is only the rider who <strong>boards Sunday Metro somewhere else in Madrid and alights at Sol</strong>:
        which station, which heading off the platform, which door to pin first.
        Do not re-promote Saturday 18:00–19:00 or Valencia–RM 21:00 as still on.
      </p>

      <h2>When Sunday Metro starts — Sol or Sevilla</h2>
      <p>
        Ride <strong>when Sunday Metro starts</strong>. We do not invent a clock for that first train.
        Aim the last stop at:
      </p>
      <ul>
        <li>
          <strong>Metro Sol (L1, L2, L3).</strong> You surface on the square. Face
          <strong>south-east toward Carrera de San Jerónimo / Calle de la Victoria</strong> — not Gran Vía.
          Victoria 6 is then <strong>2–3 minutes / 180–220 m</strong>. Pin it. Do not walk there to wait before 14:00.
        </li>
        <li>
          <strong>Sevilla (L2).</strong> You are already on the east pocket of Sol.
          Espoz y Mina 7 (Dubliners and O’Connell’s) is the nearest pin; Pasaje de Matheu 4 is the next passage;
          Victoria 6 is the 14:00 sports door.
        </li>
      </ul>
      <p>
        From early Sunday morning it is <strong>about nine hours</strong> until Four Corner opens at 14:00.
        If you surface before the first sister door, stay near Sol (Carretas, Victoria, Espoz y Mina, Mayor). Do not camp a closed Four Corner door.
      </p>

      <h2>If you get off before 14:00</h2>
      <p>
        Four Corner opens <strong>Sunday 8 November from 14:00 until late, with sports screens</strong>.
        Not before 14:00. We do not list which game is on there — ask at the door.
        O’Reilly’s usual from 11:30 (Pasaje de Matheu 4). Dubliners and O’Connell’s from 12:00 (Espoz y Mina 7).
        Use those if you are up before 14:00, then be on Victoria for the open.
        Premier League from 15:00, NFL afternoon/evening, and Atlético–Barcelona 21:00 sit on the same streets after that; this page does not replace those clocks.
        Named listings: Dubliners <a href={withBase('/whats-on/')}>What’s On</a> only.
      </p>

      <h2>Platform to three streets — addresses</h2>
      <ol>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid</strong> (first Sunday sports door from this station hop, from 14:00).
          Sports screens. Until late. Not open before 14:00.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          About <strong>2 minutes / 120–150 m</strong> from Victoria 6. Terrace restaurant-bar, usual from 11:30.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          About <strong>2 minutes / 150–180 m</strong> from Victoria 6. Sunday from 12:00. Named screens on What’s On — ask which game is on.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (Maps listing: O’Connell St).
          Same street number as Dubliners, different door. Sunday 8 Nov from 12:00 (usual Sunday 14:00). Meeting point; we do not invent its board.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
      </ol>

      <OriginalFourBars lang="en" when="sunday" findHref="/visit/" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>First Sunday Metro into Sol. Which station, first door?</strong></dt>
        <dd>Metro Sol (L1, L2, L3) or Sevilla (L2). Walk south-east. Pin Four Corner, Victoria 6, for 14:00. Then Matheu 4 and Espoz y Mina 7 twice. Saturday is finished.</dd>
        <dt><strong>When does Sunday Metro start, and how long until 14:00?</strong></dt>
        <dd>Ride when Sunday Metro starts — no clock invented here. About nine hours from early Sunday morning until Four Corner opens. Victoria 6 is 2–3 min from east Sol.</dd>
        <dt><strong>Is Four Corner open when I get off?</strong></dt>
        <dd>Only from 14:00, with sports screens. Do not wait on Victoria 6 before then. O’Reilly’s from 11:30; Dubliners and O’Connell’s from 12:00.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'From the first Sunday Metro into Sol',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'FIND US — Dubliners home' },
              { href: '/visit/', label: 'GET DIRECTIONS — visit / hours' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/brighton-ipswich-1500-sol-skip-liverpool-chelsea-united/', label: 'Quieter 15:00s: Brighton and Ipswich, not Liverpool/Chelsea/United' },
              { href: '/four-corner-opens-sunday-1400/', label: 'Four Corner Sunday 14:00' },
              { href: PATH_ES, label: 'Primer Metro a Sol el domingo: de la estación a la puerta', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
