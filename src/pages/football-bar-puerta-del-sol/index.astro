---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, withBase } from '../../site';

const title = 'Football Bar near Puerta del Sol | Dubliners Madrid';
const description =
  'Football bar near Puerta del Sol. Dubliners on Espoz y Mina 7 — about a 2-minute walk from the plaza. Indoor screens, walk-in.';
---

<BaseLayout title={title} description={description} path="/football-bar-puerta-del-sol/" ogImage="/images/photo-01.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Football bar Puerta del Sol" />
        <h1>Football bar near Puerta del Sol</h1>
        <p class="lead">
          Staying by the plaza? You’re already almost there.
          Dubliners is about a two-minute walk from Puerta del Sol — indoor screens, walk-in, no booking.
        </p>
        <CtaRow />
      </div>
      <picture>
        <source srcset={withBase('/images/photo-01.webp')} type="image/webp" />
        <img class="hero-photo" src={withBase('/images/photo-01.jpg')} alt="Dubliners just off Puerta del Sol" width="700" height="560" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>How to walk from Puerta del Sol</h2>
      <p>
        From the plaza, head toward Calle de Espoz y Mina. Number 7 is a short stroll.
        Metro Sol or Sevilla both work — ideal if your hotel is already in centro.
      </p>
      <h2>What’s on near Sol</h2>
      <p>
        Premier League, Champions League, LaLiga and more when they’re on the screens.
        Start with <a href={withBase('/whats-on/')}>What’s on</a>,
        or browse <a href={withBase('/watch-football-madrid/')}>watch football Madrid</a>.
      </p>
      <div class="faq">
        <details>
          <summary>Hotel near Sol — can I walk?</summary>
          <p>Yes. Most Sol-area hotels are a short walk to Espoz y Mina 7.</p>
        </details>
        <details>
          <summary>Address & phone</summary>
          <p>{SITE.address}, {SITE.postal} · <a href={SITE.phoneHref}>{SITE.phone}</a></p>
        </details>
      </div>
      <div class="map-frame" style="margin-top:1.5rem">
        <iframe title="Map from Puerta del Sol to Dubliners" loading="lazy" src={SITE.mapsEmbed}></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
