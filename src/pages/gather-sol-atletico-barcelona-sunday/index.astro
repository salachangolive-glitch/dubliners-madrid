---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FanWeekendCtas from '../../components/FanWeekendCtas.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import LinkHub from '../../components/LinkHub.astro';
import SundayFourVenues from '../../components/SundayFourVenues.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/gather-sol-atletico-barcelona-sunday/';
const PATH_ES = '/es/quedada-sol-atletico-barcelona-domingo/';
const PATH_VISITORS = '/nfl-visitors-sol-atletico-barcelona/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Where local fans gather for Atlético–Barcelona near Sol on Sunday 8 November',
  inLanguage: 'en',
  datePublished: '2026-11-07',
  dateModified: '2026-11-07',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Where do we meet near Sol for Atlético–Barcelona at 21:00 on Sunday 8 November?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Pin a street, not a screen. O’Reilly’s (Pasaje de Matheu 4), Dubliners and O’Connell’s (Espoz y Mina 7, from 12:00), Four Corner (Victoria 6, from 14:00, sports screens). Confirmed LIVE match screens: Dubliners. Sister bars are the meeting point — ask which game is on. We do not claim they are showing Atlético–Barcelona.',
      },
    },
    {
      '@type': 'Question',
      name: 'Should we arrive at 21:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Better before. NFL from 19:00 is already on at Dubliners. Say you want Atlético–Barcelona when you sit down. Full time fits inside Dubliners’ Sunday 12:00–02:00 hours.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is this El Clásico?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Sunday 8 November is Atlético de Madrid vs FC Barcelona, not Real Madrid vs Barcelona.',
      },
    },
  ],
};
---

<BaseLayout
  title="Gather near Sol for Atlético–Barcelona, Sunday 21:00 | Dubliners"
  description="Sunday 8 Nov, 21:00: where Atleti and Barça fans meet near Sol. Four bars, maps. LIVE screens confirmed at Dubliners. NFL already on from 19:00 — ask which game is on."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Gather for Atlético–Barcelona near Sol" schema />
      <h1>Where local fans gather for Atlético–Barcelona near Sol (Sunday 8 Nov, 21:00)</h1>
      <p class="lead">
        Sunday 8 November, <strong>21:00 Madrid time</strong>: Atlético de Madrid vs FC Barcelona.
        If the group is already in the centre, you do not need to leave Sol. Four sister bars sit
        two to four minutes from the square. Confirmed LIVE screens for this match: <strong>Dubliners</strong>,
        Espoz y Mina 7. The same night is an NFL Sunday — say you want the football.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Quedada para el Atlético–Barcelona junto a Sol</a></p>
      <FanWeekendCtas lang="en" findHref="#pin-the-street" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <div data-show-until={SHOW_UNTIL}>
        <h2>Not El Clásico — and not a quiet 21:00</h2>
        <p>
          Real Madrid vs Barcelona is a different fixture (the evergreen El Clásico page on this site).
          This Sunday is Atlético vs Barcelona at the Riyadh Air Metropolitano, on our screens at Dubliners.
          It starts while NFL from 19:00 is already running, and 22:05 / 22:25 NFL follows. That is why
          a “see you at 21:00 in front of a TV” plan fails: the room is already a sports pub in mid-slate.
        </p>
        <p>
          Practical rule for Atleti or Barça people: <strong>meet on a street, then ask for the football.</strong>
          Dubliners confirms this match LIVE. O’Reilly’s, O’Connell’s and Four Corner are the overflow
          and the food stop. Four Corner has sports screens from 14:00; we still do not list which game
          is on there. Do not assume every sister bar is showing Atlético–Barcelona.
        </p>

        <h2 id="pin-the-street">Pin one of four doors (all with Maps)</h2>
        <p>Metro Sol or Sevilla. Walking, not a night bus.</p>
        <ul>
          <li>
            <strong>Eat first — O’Reilly’s, Pasaje de Matheu 4.</strong>
            Terrace, restaurant-bar, usual 11:30–01:30. Good pin if people arrive in ones and twos from 19:00.
            Meeting point, not a listed broadcast.
            <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Maps</a>
          </li>
          <li>
            <strong>Confirmed match screen — Dubliners, Espoz y Mina 7.</strong>
            Sunday 12:00–02:00. Atlético–Barcelona LIVE. Also Bengals–Falcons 15:30 and the NFL windows.
            Tell the bar you want the 21:00 football before you sit under a 19:00 NFL screen.
            <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Maps</a>
          </li>
          <li>
            <strong>Same street overflow — O’Connell’s, Espoz y Mina 7.</strong>
            Sunday 8 Nov from 12:00. If Dubliners is standing-room, the group can still text “Espoz y Mina 7”
            and peel into the next door. We do not list its games.
            <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Maps</a>
          </li>
          <li>
            <strong>From 14:00 — Four Corner, Calle de la Victoria 6.</strong>
            Sports screens, open until late this Sunday. Use it as the early pin or the extra room.
            Ask which game is on. We do not invent its grid.
            <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Maps</a>
          </li>
        </ul>

        <h2>Arrive speaking football, because NFL is already on</h2>
        <p>
          A sensible local plan: eat at O’Reilly’s or hold the group at Four Corner after 14:00,
          then walk to Dubliners <strong>before 21:00</strong> — 20:15 is kinder than kick-off.
          If the mixed group also includes NFL visitors, send them the sister note
          <a href={withBase(PATH_VISITORS)}>NFL visitors sharing Sol this Sunday</a>
          rather than promising every American game on the same screen as the derby.
        </p>
        <p>
          Live cover of the fixture:
          <a href={withBase('/atletico-barcelona-sol-8-nov/')}>Atlético–Barcelona near Sol, 21:00</a>.
          Clocks for the whole Sunday:
          <a href={withBase('/sunday-sports-sol/')}>Sunday sports in Sol</a>.
        </p>
        <p>
          Independent pubs — no link to LaLiga or the clubs. Not an official NFL event.
        </p>
      </div>

      <SundayFourVenues lang="en" />

      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">GET DIRECTIONS</a>
        <a class="btn btn-primary" href={withBase('/4-bars-one-fan-weekend/')}>MEET US NEAR SOL</a>
        <a class="btn btn-secondary" href={withBase('/whats-on/')}>What's On</a>
      </div>

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Where do we meet near Sol for Atlético–Barcelona at 21:00?</strong></dt>
        <dd>Four sister bars. Confirmed LIVE screens: Dubliners. The others are the meeting point — ask which game is on; we do not claim they are showing this match.</dd>
        <dt><strong>Should we arrive at 21:00?</strong></dt>
        <dd>Arrive earlier. NFL from 19:00 is already on. Say you want the football. Dubliners is open until 02:00.</dd>
        <dt><strong>Is this El Clásico?</strong></dt>
        <dd>No. This Sunday is Atlético vs Barcelona, not Real Madrid vs Barcelona.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Sunday 8 November near Sol',
            until: SHOW_UNTIL,
            items: [
              { href: PATH_VISITORS, label: 'NFL visitors sharing Sol this Sunday', note: 'Visitor sister page' },
              { href: '/atletico-barcelona-sol-8-nov/', label: 'Atlético–Barcelona near Sol, 21:00', note: 'Live cover' },
              { href: '/sunday-sports-sol/', label: 'Sunday sports in Sol', note: 'Kick-off table' },
              { href: '/four-corner-opens-sunday-1400/', label: 'Four Corner opens 14:00' },
              { href: '/4-bars-one-fan-weekend/', label: '4 Bars. One Fan Weekend' },
              { href: PATH_ES, label: 'Quedada para el Atlético–Barcelona junto a Sol', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
