              { href: '/whats-on/', label: 'What’s On — named screens' },
              { href: '/atocha-cercanias-one-stop-into-sol-doors-before-1400/', label: 'Atocha Cercanías: one stop into Sol before 14:00' },
              { href: PATH_ES, label: 'Pasaje de Matheu 4: galería acristalada, primera pinta', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
