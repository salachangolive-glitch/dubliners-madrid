const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'It is a November Sunday and I want a first pint under cover before 15:00. Which door?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'O’Reilly’s Restaurant Bar at Pasaje de Matheu 4 — the glass-roofed shopping arcade between Espoz y Mina and Victoria. Usual from 11:30. Pin the arcade now even if the bar is still shut; wait under glass, not on Victoria 6. Four Corner (Calle de la Victoria 6) opens 14:00 with sports screens, not before. Then hop out to Espoz y Mina 7 (Dubliners and O’Connell’s). Maps below.',
      },
    },
    {
      '@type': 'Question',
      name: 'How far from Pasaje de Matheu 4 to Espoz y Mina 7 and Victoria 6?',
      acceptedAnswer: {
