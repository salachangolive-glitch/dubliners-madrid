const PATH = '/glass-arcade-matheu-4-first-pint-before-sunday-kickoff/';
const PATH_ES = '/es/galeria-acristalada-matheu-4-primera-pinta-antes-saque-domingo/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Pasaje de Matheu 4: covered glass arcade, first pint, then hop before Sunday kick-off',
  inLanguage: 'en',
  datePublished: '2026-11-08T09:00:00+01:00',
  dateModified: '2026-11-08T09:00:00+01:00',
