---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/hop-two-streets-last-pint-after-derby/';
const PATH_ES = '/es/saltar-dos-calles-ultima-pinta-despues-derbi/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Last pint after Valencia–RM: hop the two streets still open',
  inLanguage: 'en',
  datePublished: '2026-11-07T23:00:00+01:00',
  dateModified: '2026-11-07T23:00:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'The Valencia–Real Madrid whistle has gone. Which Saturday doors are still on the same two streets?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Three Saturday doors, two streets only: O’Reilly’s at Pasaje de Matheu 4, then Dubliners and O’Connell’s both at Calle de Espoz y Mina 7. Four Corner on Calle de la Victoria 6 is not tonight — Sunday 8 November from 14:00 with sports screens.',
      },
    },
    {
      '@type': 'Question',
      name: 'How far is the hop between the three Saturday doors?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Pasaje de Matheu 4 to Espoz y Mina 7 is about 1 minute / 90 m. Dubliners and O’Connell’s share the same street number — different doors, a few seconds apart. You do not need a taxi or a new neighbourhood for a last pint.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there Saturday NFL after Valencia–Real Madrid?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. There is no official NFL game on Saturday 7 November. The named 21:00 listing was Valencia vs Real Madrid at Dubliners only. Next NFL screen is Sunday 15:30.',
      },
    },
  ],
};
---

<BaseLayout
  title="Last pint after Valencia–RM: two streets still open | Dubliners"
  description="After Valencia–RM: three Saturday doors on two streets. Hop Matheu 4 ↔ Espoz y Mina 7. Maps. Four Corner Sunday 14:00. FIND US / GET DIRECTIONS."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Last pint on two streets after Valencia–RM" schema />
      <h1>Last pint after Valencia–RM: hop the two streets still open</h1>
      <p class="lead">
        The 21:00 listing is done or emptying. You are already in the pocket.
        <strong>Three Saturday doors sit on two streets</strong> — Pasaje de Matheu and Calle de Espoz y Mina —
        not a new barrio, not Gran Vía, not a taxi.
        <strong>Valencia vs Real Madrid was LIVE at Dubliners only.</strong>
        No official NFL tonight. Four Corner stays shut until Sunday 14:00.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Última pinta después de Valencia–RM: las dos calles que siguen</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walk Espoz y Mina 7</a>
        <a class="btn btn-secondary" data-track-event="directions_click" href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O’Reilly’s on Maps</a>
        <a class="btn btn-secondary" href={withBase('/4-bars-one-fan-weekend/')}>MEET US NEAR SOL</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>This is a door-to-door hop, not a station exit</h2>
      <p>
        Other pages already cover arriving from Metro Sol at 21:00, the Valencia broadcast itself,
        holding Espoz y Mina until kick-off, and late rooms after the whistle.
        This page is only the last pint: which of the three Saturday pins still sit on the
        <strong>same two streets</strong>, how many metres between doors, which Maps CID.
        Stay inside Pasaje de Matheu and Espoz y Mina. Do not walk Victoria 6 tonight.
      </p>

      <h2>Two streets, three open doors — metres, not a neighbourhood change</h2>
      <ol>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4.</strong>
          Street one. About <strong>1 minute / 90 m</strong> from Espoz y Mina 7.
          Terrace if Dubliners is still emptying after Valencia–RM. Saturday until 01:30.
          Not the named Valencia listing.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7.</strong>
          Street two, same block. Saturday until 02:30.
          If you watched Valencia vs Real Madrid LIVE here, you can stay; screens stay up after the whistle.
          We do not invent a Saturday NFL board.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7</strong> (Maps listing: O’Connell St).
          Same street number as Dubliners, different door — a few seconds, not a walk.
          Saturday until 03:30, the latest of the three. Meeting point; we do not copy Dubliners’ 21:00 listing onto this pin.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
      </ol>
      <p>
        <strong>Four Corner, Calle de la Victoria 6</strong> is a third street in the same pocket (~2 minutes from Espoz y Mina) —
        and it is <strong>not a Saturday last-pint door</strong>. Sunday 8 November from 14:00 until late, sports screens.
        Pin it; do not hop there tonight.
        {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Pin it for Sunday</a>
        {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Walking directions (Sunday)</a>.
      </p>
      <p>
        Practical hop if Dubliners is full after the match: Matheu 4 for a terrace pint, then back to Espoz y Mina 7
        for the later rooms (02:30 / 03:30). Two streets. One last pint. No taxi.
      </p>

      <OriginalFourBars lang="en" when="tonight" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Whistle gone. Which Saturday doors are still on the same two streets?</strong></dt>
        <dd>O’Reilly’s on Pasaje de Matheu 4; Dubliners and O’Connell’s on Espoz y Mina 7. Four Corner (Victoria 6) is Sunday 14:00 only.</dd>
        <dt><strong>How far between the three Saturday doors?</strong></dt>
        <dd>Matheu 4 ↔ Espoz y Mina 7 ~1 min / 90 m. Dubliners and O’Connell’s: same number, different doors. No taxi.</dd>
        <dt><strong>Saturday NFL after Valencia–RM?</strong></dt>
        <dd>No. No official NFL Saturday. Named 21:00 was Valencia–RM at Dubliners only. Next NFL screen: Sunday 15:30.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Last pint tonight, then Sunday',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'FIND US — Dubliners home' },
              { href: '/visit/', label: 'GET DIRECTIONS — visit / hours' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/saturday-night-sol-valencia-real-madrid/', label: 'Valencia–RM 21:00 at Dubliners' },
              { href: '/fifteen-hours-sol-until-four-corner-1400/', label: 'Overnight clock: hours until Sunday 14:00' },
              { href: PATH_ES, label: 'Última pinta: las dos calles que siguen', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
