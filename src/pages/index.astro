---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaRow from '../components/CtaRow.astro';
import { SITE, withBase } from '../site';

const title = 'Dubliners Madrid | Irish Pub near Puerta del Sol';
const description =
  'Irish pub just off Puerta del Sol at Espoz y Mina 7. Live sport on the screens, Wednesday €1 shots.';
---

<BaseLayout title={title} description={description} path="/" ogImage="/images/mural-hero.jpg">
  <section class="hero-artwork" aria-label="Ceiling mural">
    <picture>
      <source
        type="image/webp"
        srcset={`${withBase('/images/mural-hero-sm.webp')} 900w, ${withBase('/images/mural-hero.webp')} 1872w`}
        sizes="100vw"
      />
      <img
        class="hero-artwork__img"
        src={withBase('/images/mural-hero.jpg')}
        alt="Historic painted ceiling at Dubliners Madrid"
        width="1872"
        height="1056"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </section>

  <div class="home-rail">
    <div class="home-rail__inner">
      <nav class="home-rail__links" aria-label="Quick links">
        <a href={withBase('/whats-on/')}>What's on</a>
        <span class="home-rail__dot" aria-hidden="true">·</span>
        <a href={withBase('/about/')}>About</a>
        <span class="home-rail__dot" aria-hidden="true">·</span>
        <a href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
      </nav>
      <a class="home-wed" href={withBase('/wednesday-1-euro-shots-madrid/')}>
        <span class="home-wed__day">Wednesday</span>
        <span class="home-wed__price"><span class="home-wed__euro">€1</span> <span class="home-wed__shots">SHOTS</span></span>
      </a>
    </div>
  </div>

  <section class="section home-intro">
    <div class="container">
      <span class="badge">Espoz y Mina 7 · near Sol</span>
      <h1>An Irish pub in the heart of Madrid</h1>
      <p class="lead">
        Two minutes from Puerta del Sol, on Calle de Espoz y Mina 7.
        Come in for a pint, the match, or a Wednesday night.
      </p>
      <p class="nap-line">
        <strong>{SITE.address}</strong>, {SITE.postal}
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>A place with history</h2>
      <p>
        Before Dubliners, these premises were home to the historic Barragán tailor shop, established in 1885.
        Part of the original structure and decoration remains today, including its distinctive painted ceiling.
      </p>
      <p class="brand-line"><strong>Where suits were once made, stories are now shared.</strong></p>
      <p>
        <a href={withBase('/about/')}>Discover our story</a>
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div>
        <h2>The pub today</h2>
        <p>
          Walk in. Staff speak English. You’ll find people who live in Madrid and people just passing through.
        </p>
        <p>
          Screens for Premier League, Champions League, LaLiga and other sport — check
          <a href={withBase('/whats-on/')}>What’s on</a> or ask at the bar.
        </p>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/bar-interior-sm.webp')} 800w, ${withBase('/images/bar-interior.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img
          src={withBase('/images/bar-interior.jpg')}
          alt="Bar counter and checkered floor inside Dubliners"
          width="1400"
          height="788"
          loading="lazy"
          class="split-photo landscape"
        />
      </picture>
    </div>
  </section>

  <section class="section band-gold">
    <div class="container split reverse">
      <div>
        <span class="badge">Every Wednesday</span>
        <h2>Wednesday · €1 SHOTS</h2>
        <p>
          €1 shots at Dubliners. On Wednesdays only, the night can continue at Four Corner After Party,
          Calle Victoria 6, until 05:30.
        </p>
        <p>Ask at the bar when you arrive.</p>
        <a class="btn btn-gold" href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday €1 shots</a>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/interior-vert-sm.webp')} 506w, ${withBase('/images/interior-vert.webp')} 900w`}
          sizes="(max-width: 880px) 100vw, 35vw"
        />
        <img
          src={withBase('/images/interior-vert.jpg')}
          alt="Seating doorway with neon and TVs at Dubliners"
          width="900"
          height="1600"
          loading="lazy"
          class="split-photo tall"
        />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <h2>The rooms</h2>
      <div class="photo-grid">
        {[
          { src: 'facade', alt: 'Dubliners storefront with green neon and Irish flags', w: 1280, h: 720 },
          { src: 'bar-interior', alt: 'Bar counter and checkered floor inside Dubliners', w: 1400, h: 788 },
          { src: 'screens-sports', alt: 'Sports screens and projector at Dubliners', w: 1400, h: 788 },
          { src: 'window-display', alt: 'Vintage window display outside Dubliners', w: 1600, h: 902 },
        ].map(({ src, alt, w, h }) => (
          <picture>
            <source srcset={withBase(`/images/${src}.webp`)} type="image/webp" />
            <img src={withBase(`/images/${src}.jpg`)} alt={alt} width={w} height={h} loading="lazy" />
          </picture>
        ))}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div>
        <h2>Find us</h2>
        <p>
          Calle de Espoz y Mina 7, 28012 Madrid — a short walk from Puerta del Sol.
          Metro: Sol or Sevilla.
        </p>
        <p>
          International students: <a href={withBase('/international-students-pub-madrid/')}>Wednesday nights near Sol</a>.
        </p>
        <picture>
          <source
            type="image/webp"
            srcset={`${withBase('/images/facade-sm.webp')} 800w, ${withBase('/images/facade.webp')} 1280w`}
            sizes="(max-width: 880px) 100vw, 45vw"
          />
          <img
            src={withBase('/images/facade.jpg')}
            alt="Dubliners facade on Calle de Espoz y Mina"
            width="1280"
            height="720"
            loading="lazy"
            class="split-photo landscape"
            style="margin-bottom:1rem"
          />
        </picture>
        <CtaRow />
      </div>
      <div class="map-frame">
        <iframe title="Map to Dubliners Madrid" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={SITE.mapsEmbed}></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
