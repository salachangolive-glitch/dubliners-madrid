---
import MapEmbed from '../components/MapEmbed.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaRow from '../components/CtaRow.astro';
import LinkHub from '../components/LinkHub.astro';
import HomeFixtureCards from '../components/HomeFixtureCards.astro';
import FixtureAntiStale from '../components/FixtureAntiStale.astro';
import { SITE, withBase } from '../site';
import { hoursSummary } from '../data/hours';

const title = 'Irish Pub Madrid near Sol | Live Football Screens — Dubliners';
const description =
  'Irish pub Madrid just off Puerta del Sol at Espoz y Mina 7: live sport on indoor screens and an international crowd. Metro Sol or Sevilla.';
---

<BaseLayout title={title} description={description} path="/" ogImage="/images/bar-interior.jpg" website>
  <!-- 1. Hero -->
  <section class="hero-photo-band" aria-label="Dubliners Madrid">
    <picture>
      <source
        type="image/webp"
        srcset={`${withBase('/images/facade-queue-sm.webp')} 640w, ${withBase('/images/facade-queue.webp')} 1320w`}
        sizes="100vw"
      />
      <img
        class="hero-photo-band__img"
        src={withBase('/images/facade-queue.jpg')}
        alt="People queuing at the door of Dubliners at night, Espoz y Mina 7, off Puerta del Sol"
        width="1320"
        height="986"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </section>

  <div class="home-identity">
    <div class="home-identity__inner">
      <p class="home-identity__name">Dubliners Madrid</p>
      <p class="home-identity__tag">Your Irish pub in the heart of Madrid</p>
    </div>
  </div>

  <!-- 2. Presentation (short and natural; guides live in the sections below) -->
  <section class="section home-intro">
    <div class="container">
      <h1>An Irish pub near Puerta del Sol, in the heart of Madrid</h1>
      <p class="lead">
        Dubliners is just off Puerta del Sol, with live sport on our screens, cold drinks and an international crowd throughout the week.
      </p>
      <p class="home-intro__text">
        Drop in for a drink, meet friends or catch the game. Locals, visitors and Madrid’s international crowd all end up here, in a room that still keeps the painted ceiling of a 19th-century tailor shop.
      </p>
      <p class="nap-line">
        <strong>{SITE.address}</strong>, {SITE.postal} · Metro Sol (L1, L2, L3) or Sevilla (L2)
      </p>
      <CtaRow showWednesday={false} />
    </div>
  </section>

  <!-- 3. Live sports -->
  <section class="section band" id="live-sports">
    <div class="container split">
      <div>
        <h2>Live sports</h2>
        <p>
          Football, NFL, rugby, NBA and more on a big projector and 8 screens. We only list what is confirmed, always in Madrid time, and the staff can tell you what is on tonight.
        </p>
        <div class="cta-row">
          <a class="btn btn-gold" data-track-event="whats_on_cta_click" href={withBase('/whats-on/')}>What’s On this week</a>
          <a class="btn btn-secondary" href={withBase('/sports-bar-madrid/')}>Our sports bar</a>
        </div>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/dubliners-match-screens-room-800.webp')} 800w, ${withBase('/images/dubliners-match-screens-room-1200.webp')} 1200w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img
          src={withBase('/images/dubliners-match-screens-room-800.webp')}
          alt="Football on the projector and screens in the main room at Dubliners Madrid"
          width="1200"
          height="1600"
          loading="lazy"
          class="split-photo"
        />
      </picture>
    </div>
  </section>

  <!-- 4. Upcoming matches (confirmed agenda only) -->
  <section class="section" id="upcoming-matches">
    <div class="container">
      <div class="section-head">
        <h2>Upcoming matches</h2>
        <a href={withBase('/whats-on/')} data-track-event="whats_on_cta_click">Full schedule →</a>
      </div>
      <HomeFixtureCards lang="en" />
    </div>
  </section>

  <!-- 5. Sport guides & food (organised links) -->
  <section class="section band" id="sport-guides">
    <div class="container">
      <LinkHub
        label="Sport guides and menu"
        groups={[
          {
            title: 'Football & rugby',
            id: 'football-rugby',
            items: [
              { href: '/premier-league-pub-madrid/', label: 'Premier League', note: 'English football weekends' },
              { href: '/champions-league-bar-madrid/', label: 'Champions League', note: 'European nights on the big screen' },
              { href: '/watch-football-madrid/', label: 'Where to watch football in Madrid' },
              { href: '/ireland-rugby-madrid/', label: 'Ireland rugby in Madrid', note: 'November Tests' },
            ],
          },
          {
            title: 'NFL & American sports',
            id: 'nfl-american-sports',
            items: [
              { href: '/nfl-madrid/', label: 'NFL in Madrid', note: 'Sunday games on the projector' },
              { href: '/nfl-sunday-madrid-guide/', label: 'NFL Sunday guide', note: 'Hour by hour, Sunday 8 November' },
            ],
          },
          {
            title: 'Food & drinks',
            id: 'food-drinks',
            intro: 'Pub food to go with the match, and drinks at the bar.',
            items: [{ href: '/menu/', label: 'Food menu' }],
          },
        ]}
      />
    </div>
  </section>

  <!-- 6. What’s new (promotions and temporary events) -->
  <section class="section band-gold" id="whats-new">
    <div class="container">
      <div>
        <h2>What’s new</h2>
        <h3>Wednesdays — €1 shots</h3>
        <p>
          Every Wednesday: €1 shots at the pub. Ask at the bar when you arrive.
        </p>
        <a class="btn btn-gold" href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday €1 shots</a>
        <LinkHub
          heading="h3"
          compact
          groups={[
            {
              title: 'Coming up',
              until: '2026-11-15',
              items: [
                { href: '/whats-on/', label: 'Halloween party at Dubliners', note: 'Saturday 31 October · from 19:00', until: '2026-10-31' },
                { href: '/oktoberfest-madrid-2026/', label: 'Oktoberfest season in Madrid', note: '22 Oct–15 Nov · beer and live sport, Thursday to Sunday', until: '2026-11-15' },
                { href: '/de/oktoberfest-madrid-2026/', label: 'Oktoberfest-Zeit in Madrid', note: 'Auf Deutsch', hreflang: 'de', lang: 'de', until: '2026-11-15' },
                { href: '/de/bayern-fans-madrid/', label: 'Bayern-Fans in Madrid', note: 'Atlético vs Bayern · Tuesday 3 November, 21:00 · auf Deutsch', hreflang: 'de', lang: 'de', until: '2026-11-03' },
              ],
            },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- 7. Inside -->
  <section class="section">
    <div class="container">
      <h2>Inside Dubliners</h2>
      <div class="photo-grid">
        {[
          { src: 'window-display', alt: 'Vintage window display outside Dubliners', w: 1600, h: 902 },
          { src: 'window-display-2', alt: 'Window display detail at Dubliners', w: 1600, h: 902 },
        ].map(({ src, alt, w, h }) => (
          <picture>
            <source srcset={withBase(`/images/${src}.webp`)} type="image/webp" />
            <img src={withBase(`/images/${src}.jpg`)} alt={alt} width={w} height={h} loading="lazy" />
          </picture>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Historia (lower) -->
  <section class="section band home-about" id="our-pub">
    <div class="container">
      <div class="home-about__copy prose">
        <h2>Our pub · a place with history</h2>
        <p>
          Before Dubliners, these premises were home to the historic Barragán tailor shop, established in 1885.
          Part of the original structure and decoration remains today, including its distinctive painted ceiling.
        </p>
        <p class="brand-line"><strong>Where suits were once made, stories are now shared.</strong></p>
        <p>
          <a href={withBase('/about/')}>Discover our story</a>
        </p>
      </div>
      <figure class="home-mural">
        <picture>
          <source
            type="image/webp"
            srcset={`${withBase('/images/mural-hero-sm.webp')} 900w, ${withBase('/images/mural-hero.webp')} 1872w`}
            sizes="(max-width: 880px) 100vw, 70vw"
          />
          <img
            class="home-mural__img"
            src={withBase('/images/mural-hero.jpg')}
            alt="Historic painted ceiling at Dubliners Madrid"
            width="1872"
            height="1056"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="home-mural__cap">The painted ceiling — a remnant of the old Barragán tailor shop</figcaption>
      </figure>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="section band">
    <div class="container prose">
      <h2>Quick answers</h2>
      <div class="faq">
        <details>
          <summary>What are your opening hours?</summary>
          <p>{hoursSummary('en')}.</p>
        </details>
        <details>
          <summary>Are you close to Puerta del Sol?</summary>
          <p>
            Yes — we’re at Calle de Espoz y Mina 7, a short walk from Puerta del Sol.
          </p>
        </details>
        <details>
          <summary>Do you show live sports?</summary>
          <p>
            Yes — major football, NFL, NBA, rugby, Formula 1 and tennis when confirmed.
            See <a href={withBase('/whats-on/')}>What’s On</a> for this week’s schedule.
          </p>
        </details>
        <details>
          <summary>How do I get there from Metro Sol?</summary>
          <p>
            A short walk from Puerta del Sol. Metro Sol (L1, L2, L3) or Sevilla (L2).
            Address: {SITE.address}, {SITE.postal}.
            <a href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Open Directions</a>.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- 8. Find us -->
  <section class="section">
    <div class="container split">
      <div>
        <h2>Find us</h2>
        <p>
          Calle de Espoz y Mina 7, 28012 Madrid — a short walk from Sol.
          Metro: Sol or Sevilla.
        </p>
        <p>
          Studying in Madrid? See our
          <a href={withBase('/international-students-pub-madrid/')}>student &amp; Erasmus nights</a>.
        </p>
        <picture>
          <source
            type="image/webp"
            srcset={`${withBase('/images/facade-sm.webp')} 800w, ${withBase('/images/facade.webp')} 1280w`}
            sizes="(max-width: 880px) 100vw, 45vw"
          />
          <img
            src={withBase('/images/facade.jpg')}
            alt="Dubliners facade on Calle de Espoz y Mina"
            width="1280"
            height="720"
            loading="lazy"
            class="split-photo landscape"
            style="margin-bottom:1rem"
          />
        </picture>
        <CtaRow />
      </div>
      <div class="map-frame">
        <MapEmbed lang="en" title="Map to Dubliners Madrid" referrerpolicy="no-referrer-when-downgrade" />
      </div>
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
