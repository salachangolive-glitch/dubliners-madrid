---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaRow from '../components/CtaRow.astro';
import { SITE, withBase } from '../site';

const title = 'Irish Pub Madrid near Sol | Live Football Screens — Dubliners';
const description =
  'Irish pub Madrid just off Puerta del Sol at Espoz y Mina 7. Guinness, live football on indoor screens, international crowd — Metro Sol (L1, L2, L3) or Sevilla (L2). Walk in, no booking.';
---

<BaseLayout title={title} description={description} path="/" ogImage="/images/bar-interior.jpg">
  <!-- 1. Hero -->
  <section class="hero-photo-band" aria-label="Bar interior">
    <picture>
      <source
        type="image/webp"
        srcset={`${withBase('/images/bar-interior-sm.webp')} 800w, ${withBase('/images/bar-interior.webp')} 1400w`}
        sizes="100vw"
      />
      <img
        class="hero-photo-band__img"
        src={withBase('/images/bar-interior.jpg')}
        alt="Bar counter and checkered floor inside Dubliners Madrid"
        width="1400"
        height="788"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </section>

  <div class="home-identity">
    <div class="home-identity__inner">
      <p class="home-identity__name">Dubliners Madrid</p>
      <p class="home-identity__tag">Irish pub Madrid · Sol · Live sports</p>
      <nav class="home-identity__links" aria-label="Quick links">
        <a href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
        <span class="home-identity__sep" aria-hidden="true">·</span>
        <a href={withBase('/whats-on/')}>What’s On</a>
        <span class="home-identity__sep" aria-hidden="true">·</span>
        <a href={withBase('/contact/')}>Contact</a>
        <span class="home-identity__sep" aria-hidden="true">·</span>
        <a href={withBase('/sports-bar-madrid/')}>Sports bar</a>
      </nav>
    </div>
  </div>

  <!-- 2. Presentación -->
  <section class="section home-intro">
    <div class="container">
      <h1>An Irish pub near Puerta del Sol, in the heart of Madrid</h1>
      <p class="lead">
        Dubliners is just off Puerta del Sol, with live sport on our screens, cold drinks and an international crowd throughout the week.
      </p>
      <p class="nap-line">
        <strong>{SITE.address}</strong>, {SITE.postal} · Metro Sol (L1, L2, L3) or Sevilla (L2)
      </p>
      <CtaRow showWednesday={false} />
    </div>
  </section>

  <!-- 3. LIVE SPORTS / What’s On (before history) -->
  <section class="section band" id="live-sports">
    <div class="container split">
      <div>
        <h2>The pub today</h2>
        <p>
          Drop in for a drink, meet friends or catch the game on our screens. Dubliners brings together locals, visitors and Madrid’s international crowd throughout the week.
        </p>
        <h2>Live sports</h2>
        <p>
          We show major live sport throughout the week —
          <a href={withBase('/sports-bar-madrid/')}>football</a>, NFL, NBA, rugby, Formula 1 and tennis when confirmed.
          Check <a href={withBase('/whats-on/')}>What’s On</a> for this week’s schedule.
        </p>
        <p>
          For football, see our <a href={withBase('/premier-league-pub-madrid/')}>Premier League</a> and <a href={withBase('/champions-league-bar-madrid/')}>Champions League</a> pages, and check <a href={withBase('/whats-on/')}>What’s On</a> for this week’s confirmed fixtures.
        </p>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img
          src={withBase('/images/screens-sports.jpg')}
          alt="Sports screens and projector at Dubliners"
          width="1400"
          height="788"
          loading="lazy"
          class="split-photo landscape"
        />
      </picture>
    </div>
  </section>

  <!-- 4. Inside -->
  <section class="section">
    <div class="container">
      <h2>Inside Dubliners</h2>
      <div class="photo-grid">
        {[
          { src: 'window-display', alt: 'Vintage window display outside Dubliners', w: 1600, h: 902 },
          { src: 'window-display-2', alt: 'Window display detail at Dubliners', w: 1600, h: 902 },
        ].map(({ src, alt, w, h }) => (
          <picture>
            <source srcset={withBase(`/images/${src}.webp`)} type="image/webp" />
            <img src={withBase(`/images/${src}.jpg`)} alt={alt} width={w} height={h} loading="lazy" />
          </picture>
        ))}
      </div>
    </div>
  </section>

  <!-- 5. Miércoles €1 -->
  <section class="section band-gold">
    <div class="container split reverse">
      <div>
        <h2>Wednesdays at Dubliners — €1 shots</h2>
        <p>
          Every Wednesday: €1 shots at the pub. Ask at the bar when you arrive.
        </p>
        <a class="btn btn-gold" href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday €1 shots</a>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/interior-vert-sm.webp')} 506w, ${withBase('/images/interior-vert.webp')} 900w`}
          sizes="(max-width: 880px) 100vw, 35vw"
        />
        <img
          src={withBase('/images/interior-vert.jpg')}
          alt="Seating doorway with neon and TVs at Dubliners"
          width="900"
          height="1600"
          loading="lazy"
          class="split-photo tall"
        />
      </picture>
    </div>
  </section>

  <!-- 6. Historia (lower) -->
  <section class="section band home-about" id="our-pub">
    <div class="container">
      <div class="home-about__copy prose">
        <h2>Our pub · a place with history</h2>
        <p>
          Before Dubliners, these premises were home to the historic Barragán tailor shop, established in 1885.
          Part of the original structure and decoration remains today, including its distinctive painted ceiling.
        </p>
        <p class="brand-line"><strong>Where suits were once made, stories are now shared.</strong></p>
        <p>
          <a href={withBase('/about/')}>Discover our story</a>
        </p>
      </div>
      <figure class="home-mural">
        <picture>
          <source
            type="image/webp"
            srcset={`${withBase('/images/mural-hero-sm.webp')} 900w, ${withBase('/images/mural-hero.webp')} 1872w`}
            sizes="(max-width: 880px) 100vw, 70vw"
          />
          <img
            class="home-mural__img"
            src={withBase('/images/mural-hero.jpg')}
            alt="Historic painted ceiling at Dubliners Madrid"
            width="1872"
            height="1056"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="home-mural__cap">The painted ceiling — a remnant of the old Barragán tailor shop</figcaption>
      </figure>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="section band">
    <div class="container prose">
      <h2>Quick answers</h2>
      <div class="faq">
        <details>
          <summary>What are your opening hours?</summary>
          <p>Mon–Thu &amp; Sun 12:00–02:00 · Fri–Sat 12:00–02:30.</p>
        </details>
        <details>
          <summary>Are you close to Puerta del Sol?</summary>
          <p>
            Yes — we’re at Calle de Espoz y Mina 7, a short walk from Puerta del Sol.
          </p>
        </details>
        <details>
          <summary>Do you show live sports?</summary>
          <p>
            Yes — major football, NFL, NBA, rugby, Formula 1 and tennis when confirmed.
            See <a href={withBase('/whats-on/')}>What’s On</a> for this week’s schedule.
          </p>
        </details>
        <details>
          <summary>Do I need to book a table?</summary>
          <p>No booking — walk in, first come, first served. Arrive early for popular match nights.</p>
        </details>
        <details>
          <summary>How do I get there from Metro Sol?</summary>
          <p>
            A short walk from Puerta del Sol. Metro Sol (L1, L2, L3) or Sevilla (L2).
            Address: {SITE.address}, {SITE.postal}.
            <a href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Open Directions</a>.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- 8. Find us -->
  <section class="section">
    <div class="container split">
      <div>
        <h2>Find us</h2>
        <p>
          Calle de Espoz y Mina 7, 28012 Madrid — a short walk from Sol.
          Metro: Sol or Sevilla.
        </p>
        <p>
          Studying in Madrid? See our
          <a href={withBase('/international-students-pub-madrid/')}>student &amp; Erasmus nights</a>.
        </p>
        <picture>
          <source
            type="image/webp"
            srcset={`${withBase('/images/facade-sm.webp')} 800w, ${withBase('/images/facade.webp')} 1280w`}
            sizes="(max-width: 880px) 100vw, 45vw"
          />
          <img
            src={withBase('/images/facade.jpg')}
            alt="Dubliners facade on Calle de Espoz y Mina"
            width="1280"
            height="720"
            loading="lazy"
            class="split-photo landscape"
            style="margin-bottom:1rem"
          />
        </picture>
        <CtaRow />
      </div>
      <div class="map-frame">
        <iframe title="Map to Dubliners Madrid" loading="lazy" referrerpolicy="no-referrer-when-downgrade" src={SITE.mapsEmbed}></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
