---
import MapEmbed from '../components/MapEmbed.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaRow from '../components/CtaRow.astro';
import LinkHub from '../components/LinkHub.astro';
import HomeFixtureCards from '../components/HomeFixtureCards.astro';
import FixtureAntiStale from '../components/FixtureAntiStale.astro';
import { SITE, withBase } from '../site';
import { hoursSummary } from '../data/hours';

import { madridToday } from '../data/fixtures';
const todayKey = madridToday();
const title = 'Irish Pub Madrid near Sol | Sports bar, NFL & Rugby — Dubliners';
const description =
  'Irish pub and sports bar in the former Barragán tailor shop (1885), just off Puerta del Sol: Premier League, Champions League and LaLiga football, NFL and rugby on our screens, international crowd, open from 12:00.';
---

<BaseLayout title={title} description={description} path="/" ogImage="/images/bar-interior.jpg" website>
  <!-- 1. Hero -->
  <section class="hero-photo-band" aria-label="Dubliners Madrid">
    <picture>
      <source
        type="image/webp"
        srcset={`${withBase('/images/facade-queue-480.webp')} 480w, ${withBase('/images/facade-queue-sm.webp')} 640w, ${withBase('/images/facade-queue-768.webp')} 768w, ${withBase('/images/facade-queue-1200.webp')} 1200w, ${withBase('/images/facade-queue.webp')} 1320w`}
        sizes="100vw"
      />
      <img
        class="hero-photo-band__img"
        src={withBase('/images/facade-queue.jpg')}
        alt="People queuing at the door of Dubliners at night, Espoz y Mina 7, off Puerta del Sol"
        width="1320"
        height="986"
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    </picture>
  </section>

  <div class="home-identity">
    <div class="home-identity__inner">
      <p class="home-identity__name">Dubliners Madrid</p>
      <p class="home-identity__tag">Irish pub and sports bar in the heart of Madrid</p>
    </div>
  </div>

  <!-- 2. Presentation (short and natural; guides live in the sections below) -->
  <section class="section home-intro">
    <div class="container">
      <h1>An Irish pub near Puerta del Sol, in the heart of Madrid</h1>
      <p class="lead">
        Dubliners is an Irish pub just off Puerta del Sol, in the former Barragán tailor shop (1885): Premier League, Champions League and LaLiga football, NFL Sundays and rugby Tests on our screens, English-speaking staff and an international crowd, open every day from 12:00.
      </p>
      <p class="home-intro__text">
        Drop in for a drink, meet friends or catch the game at a sports bar near Puerta del Sol. Locals, visitors and Madrid’s international crowd all end up here — an Irish bar in Madrid that also works as an NFL bar Madrid on Sundays — in a room that still keeps the painted ceiling of a 19th-century tailor shop.
      </p>
      <p class="nap-line">
        <strong>{SITE.address}</strong>, {SITE.postal} · Metro Sol (L1, L2, L3) or Sevilla (L2)
      </p>
      <CtaRow showWednesday={false} />
    </div>
  </section>


  <!-- 2b. Football (DG 27 Oct: football + international crowd) -->
  <section class="section" id="football">
    <div class="container prose">
      <h2>Football near Sol: Premier League, Champions League and LaLiga</h2>
      <p>
        Football is what fills the room most weeks. Premier League weekends — a Premier League pub in Madrid for English football — Champions League nights and the big LaLiga games go on our screens,
        with Madrid’s international crowd watching together: Erasmus and international students, visitors staying around Sol and fans from abroad following their club.
        Every kick-off we list is confirmed and in Madrid time.
      </p>
      <ul>
        <li><a href={withBase('/premier-league-pub-madrid/')}>Premier League pub in Madrid</a> — English football, Saturday and Sunday</li>
        <li><a href={withBase('/champions-league-bar-madrid/')}>Champions League in Madrid</a> — European nights near Sol</li>
        <li>LaLiga — the main games of each round; see <a href={withBase('/whats-on/')} data-track-event="whats_on_cta_click">What’s On</a> for this week</li>
      </ul>
    </div>
  </section>

  <!-- 3. Live sports -->
  <section class="section band" id="live-sports">
    <div class="container split">
      <div>
        <h2>Live sports</h2>
        <p>
          Football, NFL, rugby, NBA and more on our screens. We only list what is confirmed, always in Madrid time, and the staff can tell you what is on tonight.
          This sports bar in Madrid, next to Puerta del Sol, is also where we watch NFL Madrid.
        </p>
        {todayKey <= '2026-10-31' && (
          <p data-show-until="2026-10-31"><strong>Halloween at Dubliners: Saturday 31 October, from 19:00.</strong> Costumes, decorations and music. <a href={withBase('/halloween-madrid-2026/')}>Halloween in Madrid near Sol</a></p>
        )}
        {todayKey <= '2026-11-15' && (
          <p data-show-until="2026-11-15">
            This week’s live sports (Mon 9–Sun 15 Nov, Madrid time): Thursday Real Madrid–Crvena Zvezda (EuroLeague) 21:00 · Saturday Spain–Chile rugby 17:00 at Estadio Ontime Butarque, Leganés (Movistar Plus) · Saturday Ireland–Fiji rugby 21:10 (Movistar Plus) — <a href={withBase('/irish-double-saturday-madrid/')}>Ireland v Fiji in Madrid</a> · Sunday NFL from 15:30, then 19:00, 22:05 and 22:25 · Sunday Spain–England 20:45 at the Metropolitano (La 1). Confirmed on our screens; clashes go on different screens.
          </p>
        )}
        <div class="cta-row">
          <a class="btn btn-gold" data-track-event="whats_on_cta_click" href={withBase('/whats-on/')}>What’s On this week</a>
          <a class="btn btn-secondary" href={withBase('/sports-bar-madrid/')}>Sports bar Madrid</a>
          <a class="btn btn-secondary" href={withBase('/nfl-madrid/')}>NFL bar Madrid</a>
        </div>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/dubliners-match-screens-room-480.webp')} 480w, ${withBase('/images/dubliners-match-screens-room-768.webp')} 768w, ${withBase('/images/dubliners-match-screens-room-800.webp')} 800w, ${withBase('/images/dubliners-match-screens-room-1200.webp')} 1200w`}
          sizes="(max-width: 879px) calc(100vw - 2rem), 40vw"
        />
        <img
          src={withBase('/images/dubliners-match-screens-room-800.webp')}
          alt="Football on the screens in the main room at Dubliners Madrid"
          width="1200"
          height="1600"
          loading="lazy"
          class="split-photo"
        />
      </picture>
    </div>
  </section>

  <!-- 4. Upcoming matches (confirmed agenda only) -->
  <section class="section" id="upcoming-matches">
    <div class="container">
      <div class="section-head">
        <h2>Upcoming matches</h2>
        <a href={withBase('/whats-on/')} data-track-event="whats_on_cta_click">Full schedule →</a>
      </div>
      <HomeFixtureCards lang="en" />
    </div>
  </section>

  <!-- 5. Sport guides & food (organised links) -->
  <section class="section band" id="sport-guides">
    <div class="container">
      <LinkHub
        label="Sport guides and menu"
        groups={[
          {
            title: 'Football & rugby',
            id: 'football-rugby',
            items: [
              { href: '/premier-league-pub-madrid/', label: 'Premier League', note: 'English football weekends' },
              { href: '/champions-league-bar-madrid/', label: 'Champions League', note: 'European nights on our screens' },
              { href: '/sports-bar-madrid/', label: 'Sports bar near Sol', note: 'Football, NFL and rugby on our screens' },
              { href: '/ireland-rugby-madrid/', label: 'Ireland rugby in Madrid', note: 'November Tests' },
            ],
          },
          {
            title: 'NFL & American sports',
            id: 'nfl-american-sports',
            items: [
              { href: '/nfl-madrid/', label: 'Watch NFL Madrid', note: 'NFL bar Madrid · Sunday screens' },
              { href: '/where-to-watch-nfl-madrid/', label: 'Where to watch NFL in Madrid', note: 'Irish pub near Puerta del Sol' },
            ],
          },
          {
            title: 'Food & drinks',
            id: 'food-drinks',
            intro: 'Pub food to go with the match, and drinks at the bar.',
            items: [{ href: '/menu/', label: 'Food menu' }],
          },
          {
            title: 'When Plaza Mayor is wet',
            items: [
              { href: '/indoor-pint-when-plaza-mayor-is-wet/', label: 'Indoor pint off the wet plaza', note: 'Covered Irish room, Espoz y Mina 7' },
            ],
          },
          {
            title: 'After the Prado',
            items: [
              { href: '/from-the-prado-steps-to-espoz-mina-7/', label: 'From the Prado steps to Espoz y Mina 7', note: 'Letras walk to this Irish pub' },
            ],
          },
          {
            title: 'First night in Madrid',
            items: [
              { href: '/english-at-the-bar-after-you-land/', label: 'English at the bar after you land', note: 'Irish pint near Sol before the hotel' },
            ],
          },
          {
            title: 'After the theatre on Gran Vía',
            items: [
              { href: '/gran-via-curtain-down-then-espoz-mina-7/', label: 'Curtain down, then Espoz y Mina 7', note: 'Walk Gran Vía east to this Irish pub' },
            ],
          },
          {
            title: 'If you asked for soccer',
            items: [
              { href: '/if-you-asked-for-soccer-near-sol/', label: 'Soccer near Sol', note: 'Football on screens at this Irish pub' },
            ],
          },
          {
            title: 'Tuesday in the tailor shop',
            items: [
              { href: '/tuesday-in-the-barragan-tailor-shop-near-sol/', label: 'Barragán tailor room near Sol', note: 'Midweek Irish pint under the painted ceiling' },
            ],
          },
          {
            title: 'Birthday near Sol',
            items: [
              { href: '/mixed-language-birthday-table-near-sol/', label: 'Mixed-language birthday table', note: 'Irish pub group toast at Espoz y Mina 7' },
            ],
          },
          {
            title: 'Before tomorrow’s class',
            items: [
              { href: '/afternoon-pint-before-tomorrows-class-near-sol/', label: 'Afternoon pint near Sol', note: 'Erasmus break, Irish pub indoors' },
            ],
          },
          {
            title: 'Sunday without a ticket',
            items: [
              { href: '/sunday-without-stadium-ticket-near-sol/', label: 'No stadium ticket, near Sol', note: 'Irish pub screens when listed' },
            ],
          },
          {
            title: 'From Palacio Real & Ópera',
            items: [
              { href: '/royal-palace-opera-walk-to-espoz-mina-7/', label: 'Palace & Ópera walk to Espoz y Mina 7', note: 'West of Sol → this Irish pub' },
            ],
          },
          {
            title: 'Sol Christmas lights',
            items: [
              { href: '/sol-christmas-lights-evening-walk/', label: 'Lights at Sol, indoor pint', note: 'From Sat 21 Nov — not Plaza Mayor market' },
            ],
          },
          {
            title: 'International break',
            until: '2026-11-13',
            items: [
              {
                href: '/czechia-spain-nations-league-thursday-sol/',
                label: 'Czechia v Spain Thu 20:45 (La 1)',
                note: 'La Roja away in Prague — from Sol',
                until: '2026-11-13',
              },
            ],
          },
          {
            title: 'Thursday 12 November',
            until: '2026-11-13',
            items: [
              {
                href: '/thursday-12-november-2045-then-2100-basketball-sol/',
                label: '20:45 football, 21:00 basketball',
                note: 'La 1 then Movistar+ Baloncesto — one pub',
                until: '2026-11-13',
              },
            ],
          },
        ]}
      />
    </div>
  </section>

  <!-- 6. What’s new (promotions and temporary events) -->
  <section class="section band-gold" id="whats-new">
    <div class="container">
      <div>
        <h2>What’s new</h2>
        <h3>Wednesdays — €1 shots</h3>
        <p>
          Every Wednesday: €1 shots at the pub. Ask at the bar when you arrive.
        </p>
        <a class="btn btn-gold" href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday €1 shots</a>
        <LinkHub
          heading="h3"
          compact
          groups={[
            {
              title: 'Coming up',
              until: '2026-11-15',
              items: [
                { href: '/oktoberfest-madrid-2026/', label: 'Oktoberfest season in Madrid', note: '22 Oct–15 Nov · beer and live sport, Thursday to Sunday', until: '2026-11-15' },
                { href: '/de/oktoberfest-madrid-2026/', label: 'Oktoberfest-Zeit in Madrid', note: 'Auf Deutsch', hreflang: 'de', lang: 'de', until: '2026-11-15' },
              ],
            },
          ]}
        />
      </div>
    </div>
  </section>

  <!-- 6b. Owner gallery preview -->
  <section class="section band" id="gallery-preview">
    <div class="container gallery-preview">
      <div class="prose">
        <h2>Photos and video</h2>
        <p>
          A recent look inside Dubliners — the room near Puerta del Sol, screens and crowd. More owner footage on the
          gallery page; fixtures stay on <a href={withBase('/whats-on/')}>What’s On</a>.
        </p>
        <a class="btn btn-primary" href={withBase('/gallery/')}>Gallery</a>
      </div>
      <a class="gallery-preview__link" href={withBase('/gallery/')} aria-label="Open the Dubliners gallery">
        <picture>
          <source type="image/webp" srcset={withBase('/images/gallery/dubliners-ambiente-01.webp')} />
          <img
            class="gallery-preview__thumb"
            src={withBase('/images/gallery/dubliners-ambiente-01.jpg')}
            alt="Guests inside Dubliners watching sport on wall screens"
            width="900"
            height="1600"
            loading="lazy"
            decoding="async"
          />
        </picture>
      </a>
    </div>
  </section>

  <!-- 7. Inside -->
  <section class="section">
    <div class="container">
      <h2>Inside Dubliners</h2>
      <div class="photo-grid">
        {[
          { src: 'window-display', alt: 'Vintage window display outside Dubliners', w: 1600, h: 902 },
          { src: 'window-display-2', alt: 'Window display detail at Dubliners', w: 1600, h: 902 },
        ].map(({ src, alt, w, h }) => (
          <picture>
            <source
              type="image/webp"
              srcset={`${withBase(`/images/${src}-480.webp`)} 480w, ${withBase(`/images/${src}-768.webp`)} 768w, ${withBase(`/images/${src}-sm.webp`)} 800w, ${withBase(`/images/${src}.webp`)} 1600w`}
              sizes="(max-width: 799px) calc(50vw - 1.5rem), 25vw"
            />
            <img src={withBase(`/images/${src}.jpg`)} alt={alt} width={w} height={h} loading="lazy" decoding="async" />
          </picture>
        ))}
      </div>
    </div>
  </section>

  <!-- 6. Historia (lower) -->
  <section class="section band home-about" id="our-pub">
    <div class="container">
      <div class="home-about__copy prose">
        <h2>Our pub · a place with history</h2>
        <p>
          Before Dubliners, these premises were home to the historic Barragán tailor shop, established in 1885.
          Part of the original structure and decoration remains today, including its distinctive painted ceiling.
        </p>
        <p class="brand-line"><strong>Where suits were once made, stories are now shared.</strong></p>
        <p>
          <a href={withBase('/about/')}>Discover our story</a>
        </p>
      </div>
      <figure class="home-mural">
        <picture>
          <source
            type="image/webp"
            srcset={`${withBase('/images/mural-hero-480.webp')} 480w, ${withBase('/images/mural-hero-768.webp')} 768w, ${withBase('/images/mural-hero-sm.webp')} 900w, ${withBase('/images/mural-hero-1200.webp')} 1200w, ${withBase('/images/mural-hero.webp')} 1872w`}
            sizes="(max-width: 899px) calc(100vw - 2rem), 55vw"
          />
          <img
            class="home-mural__img"
            src={withBase('/images/mural-hero.jpg')}
            alt="Historic painted ceiling at Dubliners Madrid"
            width="1872"
            height="1056"
            loading="lazy"
            decoding="async"
          />
        </picture>
        <figcaption class="home-mural__cap">The painted ceiling — a remnant of the old Barragán tailor shop</figcaption>
      </figure>
    </div>
  </section>

  <!-- 7. FAQ -->
  <section class="section band">
    <div class="container prose">
      <h2>Quick answers</h2>
      <div class="faq">
        <details>
          <summary>What are your opening hours?</summary>
          <p>{hoursSummary('en')}.</p>
        </details>
        <details>
          <summary>Are you close to Puerta del Sol?</summary>
          <p>
            Yes — we’re at Calle de Espoz y Mina 7, a short walk from Puerta del Sol.
          </p>
        </details>
        <details>
          <summary>Do you show live sports?</summary>
          <p>
            Yes — major football, NFL, NBA, rugby, Formula 1 and tennis when confirmed.
            See <a href={withBase('/whats-on/')}>What’s On</a> for this week’s schedule.
          </p>
        </details>
        <details>
          <summary>Is this an Irish pub and sports bar?</summary>
          <p>
            Yes — Dubliners is an Irish pub and sports bar just off Puerta del Sol, Espoz y Mina 7.
            Irish bar Madrid, football and NFL on the screens. Named listings: <a href={withBase('/whats-on/')}>What’s On</a>.
          </p>
        </details>
        <details>
          <summary>Can I watch NFL Madrid here?</summary>
          <p>
            Yes — Dubliners is an NFL bar in Madrid near Puerta del Sol. Sunday NFL is LIVE on our screens when listed on What’s On.
            <a href={withBase('/nfl-madrid/')}>Watch NFL Madrid</a>.
          </p>
        </details>
        <details>
          <summary>How do I get there from Metro Sol?</summary>
          <p>
            A short walk from Puerta del Sol. Metro Sol (L1, L2, L3) or Sevilla (L2).
            Address: {SITE.address}, {SITE.postal}.
            <a href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Open Directions</a>.
          </p>
        </details>
      </div>
    </div>
  </section>

  <!-- 8. Find us -->
  <section class="section">
    <div class="container split">
      <div>
        <h2 id="find-us">FIND US</h2>
        <p>
          Calle de Espoz y Mina 7, 28012 Madrid — a short walk from Sol.
          Metro: Sol or Sevilla.
        </p>
        <p>
          Studying in Madrid? See our
          <a href={withBase('/international-students-pub-madrid/')}>student &amp; Erasmus nights</a>.
        </p>
        <picture>
          <source
            type="image/webp"
            srcset={`${withBase('/images/facade-480.webp')} 480w, ${withBase('/images/facade-768.webp')} 768w, ${withBase('/images/facade-sm.webp')} 800w, ${withBase('/images/facade.webp')} 1280w`}
            sizes="(max-width: 879px) calc(100vw - 2rem), 45vw"
          />
          <img
            src={withBase('/images/facade.jpg')}
            alt="Dubliners facade on Calle de Espoz y Mina"
            width="1280"
            height="720"
            loading="lazy"
            class="split-photo landscape"
            style="margin-bottom:1rem"
          />
        </picture>
        <CtaRow />
      </div>
      <div class="map-frame">
        <MapEmbed lang="en" title="Map to Dubliners Madrid" referrerpolicy="no-referrer-when-downgrade" />
      </div>
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
