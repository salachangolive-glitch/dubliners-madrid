---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE, withBase } from '../../site';

const title = 'Irish Pub with History near Sol | Dubliners Madrid';
const description =
  'Dubliners sits two minutes from Puerta del Sol in the historic Barragán tailor-shop premises (from 1885). Live sport, international atmosphere and €1 shots on Wednesdays — a favourite with Erasmus and international students.';
---

<BaseLayout title={title} description={description} path="/international-students-pub-madrid/" ogImage="/images/mural-hero.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="International students" />
      <h1>An Irish pub with a story to tell</h1>
      <p class="lead">
        Just two minutes from Puerta del Sol, Dubliners occupies a historic Madrid premises that still retains part of its original character.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
      </div>
    </div>
  </section>

  <section class="hero-artwork" aria-label="Painted ceiling">
    <picture>
      <source
        type="image/webp"
        srcset={`${withBase('/images/mural-hero-sm.webp')} 900w, ${withBase('/images/mural-hero.webp')} 1872w`}
        sizes="100vw"
      />
      <img
        class="hero-artwork__img"
        src={withBase('/images/mural-hero.jpg')}
        alt="Historic painted ceiling at Dubliners Madrid"
        width="1872"
        height="1056"
        loading="eager"
        decoding="async"
      />
    </picture>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>A piece of Madrid history</h2>
      <p>
        Before Dubliners, the premises were home to the historic Barragán tailor shop, established in 1885.
        Part of the original structure and decoration remains today, including the distinctive painted ceiling.
      </p>
      <h2>Dubliners today</h2>
      <p>
        Today, Dubliners brings together that historic setting with the atmosphere of an Irish pub, live sport
        and an international crowd just off Puerta del Sol — including Erasmus and international students.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>WEDNESDAY · €1 SHOTS</h2>
      <p>
        €1 shots every Wednesday at Dubliners. Afterwards, Four Corner After Party continues at Calle Victoria 6 until 05:30.
      </p>
      <p>
        <a class="btn btn-secondary" href={withBase('/wednesday-1-euro-shots-madrid/')}>More about Wednesday</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Location</h2>
      <p>
        Calle de Espoz y Mina 7<br />
        28012 Madrid
      </p>
      <p>
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
      </p>

      <h2>FAQ</h2>
      <div class="faq">
        <details>
          <summary>Where is Dubliners?</summary>
          <p>Calle de Espoz y Mina 7, 28012 Madrid, around a two-minute walk from Puerta del Sol.</p>
        </details>
        <details>
          <summary>What are the nearest Metro stations?</summary>
          <p>Sol and Sevilla.</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
