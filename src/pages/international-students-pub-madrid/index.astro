---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, withBase } from '../../site';

const title = 'International Students Pub Madrid | Near Sol — Dubliners';
const description =
  'Irish pub near Sol for Erasmus and international students. Wednesday €1 shots. Espoz y Mina 7, Madrid.';
---

<BaseLayout title={title} description={description} path="/international-students-pub-madrid/" ogImage="/images/interior-vert.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="International students pub" />
        <h1>English-friendly pub near Sol</h1>
        <p class="lead">
          A handy meeting point for Erasmus and international students —
          Espoz y Mina 7, a short walk from Puerta del Sol.
        </p>
        <CtaRow />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/interior-vert-sm.webp')} 506w, ${withBase('/images/interior-vert.webp')} 900w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img class="hero-photo portrait" src={withBase('/images/interior-vert.jpg')} alt="Seating doorway and neon signs inside Dubliners" width="900" height="1600" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>International atmosphere</h3>
          <p>English-friendly staff in the centre of Madrid.</p>
        </article>
        <article class="card">
          <h3>Right by Sol</h3>
          <p>Calle de Espoz y Mina 7 — close after class or before a night out.</p>
        </article>
        <article class="card">
          <h3>Wednesday · €1 SHOTS</h3>
          <p>Weekly ritual. Wednesdays only: Four Corner After Party, Calle Victoria 6, until 05:30.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Midweek near Sol</h2>
      <p>
        Bring your group or come solo. On Wednesdays: €1 shots, then optional Four Corner After Party,
        Calle Victoria 6, Wednesdays only, until 05:30.
      </p>
      <p>
        Other nights: live sport when it’s on the screens.
        <a href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday €1 shots</a> ·
        <a href={withBase('/whats-on/')}>What’s on</a>.
      </p>
      <CtaRow />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>FAQ</h2>
      <div class="faq">
        <details>
          <summary>Is English spoken?</summary>
          <p>Yes — English-friendly Irish pub with an international crowd.</p>
        </details>
        <details>
          <summary>Where are you?</summary>
          <p>{SITE.address}, {SITE.postal}</p>
        </details>
        <details>
          <summary>Best night for students?</summary>
          <p>Wednesdays for €1 shots.</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
