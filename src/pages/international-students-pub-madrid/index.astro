---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, withBase } from '../../site';

const title = 'International Students Pub Madrid | English-speaking near Sol';
const description =
  'English-speaking Irish pub near Sol for Erasmus and international students. Walk-in meeting point, Wednesday €1 shots. Calle de Espoz y Mina 7, Madrid.';
---

<BaseLayout title={title} description={description} path="/international-students-pub-madrid/" ogImage="/images/photo-02.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="International students pub" />
        <h1>Meet people. Speak English. Stay in Sol.</h1>
        <p class="lead">
          Dubliners is the easy meeting point for Erasmus and international students —
          an Irish pub a stone’s throw from Puerta del Sol, where the room already feels like home.
        </p>
        <CtaRow />
      </div>
      <picture>
        <source srcset={withBase('/images/photo-02.webp')} type="image/webp" />
        <img class="hero-photo" src={withBase('/images/photo-02.jpg')} alt="International crowd vibe inside Dubliners Madrid" width="500" height="700" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>International vibe</h3>
          <p>English-friendly staff and a mixed crowd of students, travellers and locals.</p>
        </article>
        <article class="card">
          <h3>Right by Sol</h3>
          <p>Calle de Espoz y Mina 7 — easy to find after class, after sightseeing, or before a night out.</p>
        </article>
        <article class="card">
          <h3>Wednesday €1 shots</h3>
          <p>The weekly ritual. Walk in, then (Wednesdays only) Four Corner on Victoria 6 until 05:30.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Your midweek meeting point</h2>
      <p>
        New in Madrid? Bring your group, or come solo and settle in with a pint.
        Wednesdays are the loudest — €1 shots and the option to continue at Four Corner After Party
        (Calle Victoria 6, Wednesdays only, until 05:30).
      </p>
      <p>
        Other nights, catch live sport when it’s on the screens, or just use us as your centro base.
        Details: <a href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday €1 shots</a> ·
        <a href={withBase('/whats-on/')}>What’s on</a>.
      </p>
      <CtaRow />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>FAQ</h2>
      <div class="faq">
        <details>
          <summary>Is English spoken?</summary>
          <p>Yes — English-friendly Irish pub with an international crowd.</p>
        </details>
        <details>
          <summary>Where are you?</summary>
          <p>{SITE.address}, {SITE.postal} · <a href={SITE.phoneHref}>{SITE.phone}</a></p>
        </details>
        <details>
          <summary>Best night for students?</summary>
          <p>Wednesdays for €1 shots — arrive when it suits you; the room gets busy.</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
