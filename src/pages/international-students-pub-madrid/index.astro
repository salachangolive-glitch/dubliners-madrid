---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE, withBase } from '../../site';

const title = 'Dubliners for International Students & Erasmus in Madrid | Near Sol';
const description =
  'Irish pub two minutes from Puerta del Sol. International atmosphere, live sport and €1 shots on Wednesdays — popular with Erasmus and international students.';
---

<BaseLayout title={title} description={description} path="/international-students-pub-madrid/" ogImage="/images/interior-vert.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="International students" />
        <h1>Dubliners for international students in Madrid</h1>
        <p class="lead">
          Dubliners is an Irish pub just two minutes from Puerta del Sol, with an international atmosphere,
          live sport and €1 shots every Wednesday.
        </p>
        <div class="cta-row">
          <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
        </div>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/interior-vert-sm.webp')} 506w, ${withBase('/images/interior-vert.webp')} 900w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img class="hero-photo portrait" src={withBase('/images/interior-vert.jpg')} alt="Inside Dubliners Irish pub near Sol, Madrid" width="900" height="1600" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <p>International atmosphere, with English-speaking staff.</p>
      <h2>Location</h2>
      <p>
        Calle de Espoz y Mina 7<br />
        28012 Madrid
      </p>
      <p>
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>WEDNESDAY · €1 SHOTS</h2>
      <p>
        €1 shots every Wednesday at Dubliners. Afterwards, Four Corner After Party continues at Calle Victoria 6 until 05:30.
      </p>
      <p>
        <a class="btn btn-secondary" href={withBase('/wednesday-1-euro-shots-madrid/')}>More about Wednesday</a>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>FAQ</h2>
      <div class="faq">
        <details>
          <summary>Where is Dubliners?</summary>
          <p>Calle de Espoz y Mina 7, 28012 Madrid, around a two-minute walk from Puerta del Sol.</p>
        </details>
        <details>
          <summary>What are the nearest Metro stations?</summary>
          <p>Sol and Sevilla.</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
