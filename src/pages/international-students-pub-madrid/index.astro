---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE, withBase } from '../../site';

const faqLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "Where is Dubliners Irish Pub in Madrid?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Calle de Espoz y Mina 7, 28012 Madrid, just off Puerta del Sol. Nearest metro: Sol (L1, L2, L3) or Sevilla (L2)."
      }
    },
    {
      "@type": "Question",
      "name": "What are the opening hours?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Monday to Thursday and Sunday 12:00–02:00; Friday and Saturday 12:00–02:30."
      }
    },
    {
      "@type": "Question",
      "name": "Can I watch football in English-friendly company?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes. Dubliners is an English-speaking Irish pub with live sport on DAZN, Movistar and Premier Sports. Check What’s On for confirmed matches and kick-off times (Madrid time)."
      }
    },
    {
      "@type": "Question",
      "name": "Is there a student night?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every Wednesday the pub runs its €1 shots promo. See the Wednesday €1 page for details."
      }
    }
  ]
};
const title = 'Erasmus Bar & Irish Pub Madrid near Sol | Football in English | Dubliners';
const description =
  'English-speaking Irish pub for Erasmus students and visitors by Puerta del Sol. Football on DAZN, Movistar and Premier Sports. Walk in, open daily from 12:00.';
---

<BaseLayout title={title} description={description} path="/international-students-pub-madrid/" ogImage="/images/mural-hero.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="International students" schema />
      <h1>Erasmus &amp; international students pub near Sol</h1>
      <p class="lead">
        Dubliners welcomes Erasmus and international students just off Puerta del Sol —
        English-friendly staff, live sport on screens, and Wednesday €1 shots.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
        <a class="btn btn-secondary" href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday €1 shots</a>
        <a class="btn btn-secondary" href={withBase('/whats-on/')}>What’s On</a>
      </div>
    </div>
  </section>

  <section class="hero-artwork" aria-label="Painted ceiling">
    <picture>
      <source
        type="image/webp"
        srcset={`${withBase('/images/mural-hero-sm.webp')} 900w, ${withBase('/images/mural-hero.webp')} 1872w`}
        sizes="100vw"
      />
      <img
        class="hero-artwork__img"
        src={withBase('/images/mural-hero.jpg')}
        alt="Historic painted ceiling at Dubliners Madrid"
        width="1872"
        height="1056"
        loading="eager"
        decoding="async"
      />
    </picture>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>International atmosphere</h2>
      <p>
        Locals, travellers and Erasmus students share the same bar — Guinness, live football and an easy English-speaking welcome in Madrid centro.
        Walk in, grab a seat, ask what’s on the screens.
      </p>
      <p>
        Useful next steps:
        <a href={withBase('/whats-on/')}>What’s on tonight</a>,
        <a href={withBase('/sports-bar-madrid/')}>sports screens near Sol</a>,
        <a href={withBase('/visit/')}>how to find us</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Your first night in Madrid: getting here from Sol metro</h2>
      <ol>
        <li>Take the metro to <strong>Sol</strong> (L1, L2, L3) and exit to Puerta del Sol, or use <strong>Sevilla</strong> (L2).</li>
        <li>From Puerta del Sol, walk onto <strong>Calle de Espoz y Mina</strong>, toward Carrera de San Jerónimo / Sevilla — a short walk.</li>
        <li>Look for the <strong>green Dubliners neon</strong> at number 7 and walk in.</li>
        <li>Ask at the bar what’s on the screens tonight, or check <a href={withBase('/whats-on/')}>What’s On</a> before you go.</li>
      </ol>
      <p>More: <a href={withBase('/visit/')}>map &amp; directions</a> · <a href={withBase('/whats-on/')}>What’s On (matches, Madrid time)</a> · <a href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday €1 shots</a> · <a href={withBase('/watch-football-madrid/')}>where to watch football in Madrid</a> · <a href={withBase('/night-out-near-sol-madrid/')}>night out near Sol</a> · <a href={withBase('/irish-pub-near-plaza-mayor/')}>from Plaza Mayor</a>.</p>

      <h2>FAQ for Erasmus students &amp; visitors</h2>
      <dl class="faq">
        <dt><strong>Where is Dubliners Irish Pub in Madrid?</strong></dt>
        <dd>Calle de Espoz y Mina 7, 28012 Madrid, just off Puerta del Sol. Nearest metro: Sol (L1, L2, L3) or Sevilla (L2).</dd>
        <dt><strong>What are the opening hours?</strong></dt>
        <dd>Monday to Thursday and Sunday 12:00–02:00; Friday and Saturday 12:00–02:30.</dd>
        <dt><strong>Can I watch football in English-friendly company?</strong></dt>
        <dd>Yes. Dubliners is an English-speaking Irish pub with live sport on DAZN, Movistar and Premier Sports. Check What’s On for confirmed matches and kick-off times (Madrid time).</dd>
        <dt><strong>Is there a student night?</strong></dt>
        <dd>Every Wednesday the pub runs its €1 shots promo. See the Wednesday €1 page for details.</dd>
      </dl>
      <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>WEDNESDAY · €1 SHOTS</h2>
      <p>
        Dubliners’ own promo: €1 shots every Wednesday at the pub. Ask at the bar for details.
      </p>
      <p>
        <a class="btn btn-secondary" href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday €1 shots</a>
      </p>

      <h2>A piece of Madrid history</h2>
      <p>
        Before Dubliners, the premises were home to the historic Barragán tailor shop, established in 1885.
        Part of the original structure and decoration remains today, including its distinctive painted ceiling.
      </p>
      <p class="brand-line"><strong>Where suits were once made, stories are now shared.</strong></p>

      <h2>Location</h2>
      <p>
        Calle de Espoz y Mina 7<br />
        28012 Madrid · Metro Sol or Sevilla
      </p>
      <p>
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
      </p>
    </div>
  </section>
</BaseLayout>
