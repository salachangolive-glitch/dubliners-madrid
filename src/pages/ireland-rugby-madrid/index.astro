---
import GettingHere from '../../components/GettingHere.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE, withBase, absUrl } from '../../site';

// Ireland men, November 2026 (Rugby Nations Championship). Rows already in src/data/fixtures.ts (confirmedOnScreens):
// Fri 6 Nov Ireland v Argentina 21:10, Sat 14 Nov Ireland v Fiji 21:10, Sat 21 Nov Ireland v South Africa 17:40 (Madrid, CET).
// Source per fixtures.ts: irishrugby.ie fixtures (20:10 / 16:40 Irish time) + World Rugby API, checked 20 Oct. Venue not stated (not in repo).
// Created 20 Oct (DG): Radar had checked this URL (404). 23 Nov (DG): past tense, all three games played; no score (no official result in repo).
const path = '/ireland-rugby-madrid/';
const games = [
  { name: 'Ireland v Argentina', start: '2026-11-06T21:10:00+01:00', end: '2026-11-06T23:10:00+01:00', away: 'Argentina' },
  { name: 'Ireland v Fiji', start: '2026-11-14T21:10:00+01:00', end: '2026-11-14T23:10:00+01:00', away: 'Fiji' },
  { name: 'Ireland v South Africa', start: '2026-11-21T17:40:00+01:00', end: '2026-11-21T19:40:00+01:00', away: 'South Africa' },
];
const eventsLd = games.map((g) => ({
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${g.name} — Rugby Nations Championship (played, November 2026; screened at Dubliners Madrid)`,
  description: `${g.name} (rugby) was played in November 2026 and was shown on the screens at Dubliners Irish Pub, Espoz y Mina 7, by Puerta del Sol, Madrid. Past event.`,
  startDate: g.start,
  endDate: g.end,
  // schema.org has no 'completed' EventStatusType: EventScheduled + past start/endDate marks a held event.
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'BarOrPub',
    name: 'Dubliners Irish Pub',
    alternateName: 'Dubliners Madrid',
    address: { '@type': 'PostalAddress', streetAddress: 'Calle de Espoz y Mina 7', addressLocality: 'Madrid', postalCode: '28012', addressCountry: 'ES' },
    geo: { '@type': 'GeoCoordinates', latitude: 40.4158342, longitude: -3.7022626 },
    hasMap: SITE.gbpUrl,
  },
  organizer: { '@type': 'BarOrPub', name: 'Dubliners Irish Pub', url: absUrl('/') },
  homeTeam: { '@type': 'SportsTeam', name: 'Ireland' },
  awayTeam: { '@type': 'SportsTeam', name: g.away },
  url: absUrl(path),
}));
---

<BaseLayout title={'Ireland Rugby in Madrid: November 2026 Games Played | Dubliners'} description={'Ireland’s November 2026 games — v Argentina (Fri 6 Nov), v Fiji (Sat 14 Nov) and v South Africa (Sat 21 Nov) — were shown at Dubliners Irish pub, by Puerta del Sol. Next sport on What’s On.'} path={path} lang="en" ogImage="/images/dubliners-screens-sol-1200.webp" extraJsonLd={eventsLd}>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current={'Ireland rugby in Madrid'} schema />
      <h1>Ireland rugby in Madrid: the November games (played)</h1>
      <p class="lead">Ireland played three games in November 2026, and we showed all three on the screens at Dubliners, an Irish pub in the centre of Madrid, by Puerta del Sol. The last one, Ireland v South Africa, was played on Saturday 21 November. For the next sport we show, see What’s On.</p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.gbpUrl} rel="noopener noreferrer" target="_blank">Directions</a>
        <a class="btn btn-primary" href={withBase('/whats-on/')}>What’s On</a>
      </div>
    </div>
  </section>
  <GettingHere lang="en" />
  <section class="section">
    <div class="container split">
      <div class="prose">
<h2>The November games (Madrid time)</h2>
<ul>
  <li><strong>Friday 6 November:</strong> Ireland v Argentina was played at 21:10 (20:10 in Ireland), at the Aviva Stadium.</li>
  <li><strong>Saturday 14 November:</strong> Ireland v Fiji was played at 21:10 (20:10 in Ireland).</li>
  <li><strong>Saturday 21 November:</strong> Ireland v South Africa was played at 17:40 (16:40 in Ireland).</li>
</ul>
<p>We showed all three games on our screens, with Irish fans and rugby followers at the bar. Ireland v Fiji: <a href={withBase('/irish-double-saturday-madrid/')}>Ireland v Fiji in Madrid</a>.</p>
<h2>Spain rugby in Madrid: Los Leones v Uruguay</h2>
<p>Saturday 7 November, 16:00 Madrid time: Spain v Uruguay (World Rugby Nations Cup) was played at the Estadio Nacional Complutense, Madrid, and we showed it on our screens too. Upcoming sport: <a href={withBase('/whats-on/')}>What's On</a>.</p>
<h2>Watch the next match with other Irish fans</h2>
<p>Living in Madrid, on Erasmus or here for a weekend? Dubliners is a place where Irish fans and anyone who follows rugby watch the match together: beer at the bar, the match on every screen and a mixed crowd from Ireland, Spain and beyond. Groups are welcome; questions before you come: <a href={withBase('/contact/#request-information')}>Request information</a>.</p>
<h2>Opening hours and address</h2>
<p>Monday to Thursday and Sunday 12:00–02:00. Friday and Saturday 12:00–02:30.<br />{SITE.address}, {SITE.postal}, by Puerta del Sol. <a href={withBase('/visit/')}>Hours &amp; map</a></p>
      </div>
      <picture><img class="split-photo tall" src={withBase('/images/dubliners-screens-sol-1200.webp')} srcset={`${withBase('/images/dubliners-screens-sol-800.webp')} 800w, ${withBase('/images/dubliners-screens-sol-1200.webp')} 1200w`} sizes="(max-width: 800px) 100vw, 720px" width="1200" height="1600" loading="lazy" decoding="async" alt="Screens in the main room at Dubliners, near Sol" /></picture>
    </div>
  </section>
  <section class="section band">
    <div class="container prose">
<h2>FAQ</h2>
<dl class="faq">
  <dt><strong>Did you show all three Ireland games?</strong></dt><dd>Yes: Ireland v Argentina (6 Nov), Ireland v Fiji (14 Nov) and Ireland v South Africa (21 Nov) were all shown on our screens. The next games are on What’s On.</dd>
  <dt><strong>What time do you open?</strong></dt><dd>From 12:00 every day. Friday and Saturday until 02:30.</dd>
  <dt><strong>Where are you?</strong></dt><dd>{SITE.address}, {SITE.postal}, by Puerta del Sol.</dd>
  <dt><strong>How many screens do you have?</strong></dt><dd>Screens around the pub, plus a big screen.</dd>
  <dt><strong>How do I get there?</strong></dt><dd>Metro Sol (L1, L2, L3) or Sevilla (L2), then a short walk to Calle de Espoz y Mina 7.</dd>
</dl>
<script type="application/ld+json" set:html={JSON.stringify({"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "Did you show all three Ireland games?", "acceptedAnswer": {"@type": "Answer", "text": "Yes: Ireland v Argentina (6 Nov), Ireland v Fiji (14 Nov) and Ireland v South Africa (21 Nov) were all shown on our screens. The next games are on What’s On."}}, {"@type": "Question", "name": "What time do you open?", "acceptedAnswer": {"@type": "Answer", "text": "From 12:00 every day. Friday and Saturday until 02:30."}}, {"@type": "Question", "name": "Where are you?", "acceptedAnswer": {"@type": "Answer", "text": "Calle de Espoz y Mina 7, 28012 Madrid, by Puerta del Sol."}}, {"@type": "Question", "name": "How many screens do you have?", "acceptedAnswer": {"@type": "Answer", "text": "Screens around the pub, plus a big screen."}}, {"@type": "Question", "name": "How do I get there?", "acceptedAnswer": {"@type": "Answer", "text": "Metro Sol (L1, L2, L3) or Sevilla (L2), then a short walk to Calle de Espoz y Mina 7."}}]})} />
<p>En español: <a href={withBase('/es/rugby-irlanda-madrid/')} hreflang="es">Rugby de Irlanda en Madrid</a> · All the sport we show: <a href={withBase('/whats-on/')}>What’s On</a></p>
    </div>
  </section>
</BaseLayout>
