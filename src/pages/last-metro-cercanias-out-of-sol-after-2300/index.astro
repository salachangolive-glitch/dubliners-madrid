import { withBase, absUrl } from '../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/last-metro-cercanias-out-of-sol-after-2300/';
const PATH_ES = '/es/ultimo-metro-cercanias-salida-sol-despues-2300/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Last Metro / Cercanías out of Sol after 23:00 from Victoria 6, Espoz y Mina 7 and Matheu 4',
  inLanguage: 'en',
  datePublished: '2026-11-08T23:00:00+01:00',
  dateModified: '2026-11-08T23:00:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'It is after 23:00. How do I leave Sol by last Metro or Cercanías from the four open doors?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Walk outbound from the four open sister doors — Four Corner, Calle de la Victoria 6; Dubliners and O’Connell’s, Calle de Espoz y Mina 7; O’Reilly’s, Pasaje de Matheu 4 — to Metro Sol (L1/L2/L3), Sevilla (L2), or Cercanías Sol (C3/C4). From east Sol, Victoria 6 is about 2–3 minutes / 180–220 m (already published). Catch the train when the last Sunday Metro / Cercanías leaves; we do not invent that clock. Named late NFL 22:05 / 22:25: Dubliners What’s On only. Ask which game.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is this first Metro into Sol, Barajas inbound, Atocha Cercanías one stop in, or Saturday last pint after the derby?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. First Metro is inbound, early Sunday, station-to-door. Barajas is a late airport landing into Sol. Atocha Cercanías is one stop inbound before 14:00. Saturday last pint is three doors hopping after Valencia–RM. This page is outbound after 23:00: door-to-station from Victoria 6 / Espoz y Mina 7 / Pasaje de Matheu 4 when the last Sunday Metro / Cercanías leaves.',
      },
    },
    {
      '@type': 'Question',
      name: 'What time is the last Sunday Metro or Cercanías out of Sol?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'We do not invent that clock. Leave when the last Sunday Metro / Cercanías leaves. Follow live Maps from the four open doors to Sol, Sevilla, or the Cercanías concourse. The four doors stay the meeting point until you walk out; Four Corner is open from 14:00 until late, sports screens. Premier sits alongside late NFL; do not substitute.',
      },
    },
  ],
};
---

<BaseLayout
  title="Last Metro / Cercanías out of Sol after 23:00 | Dubliners"
  description="Sunday 8 Nov after 23:00: walk outbound from Victoria 6 / Espoz y Mina 7 / Pasaje de Matheu 4 to Sol Metro, Sevilla, or Cercanías. When the last Sunday train leaves. Maps. FIND US."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Last Metro / Cercanías out of Sol after 23:00" schema />
      <h1>Last Metro / Cercanías out of Sol after 23:00 from Victoria 6, Espoz y Mina 7 and Matheu 4</h1>
      <p class="lead">
        You are not arriving. You are <strong>leaving Sol after 23:00</strong> —
        outbound from the four open doors to Metro Sol (L1/L2/L3), Sevilla (L2), or Cercanías Sol (C3/C4).
        Catch the train <strong>when the last Sunday Metro / Cercanías leaves</strong>. We do not invent that clock.
        <strong>All four sister doors are open NOW.</strong> Four Corner, Calle de la Victoria 6, is open (from 14:00 until late, sports screens).
        Pin the walk from Victoria 6 / Espoz y Mina 7 / Pasaje de Matheu 4. Saturday’s three-bar meetup is over. Follow live Maps.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Último Metro / Cercanías de salida de Sol después de las 23:00</a></p>
      <FanWeekendCtas lang="en" findHref="/visit/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>This is outbound after 23:00 — not first Metro in, not Barajas, not Atocha inbound, not Saturday last pint</h2>
      <p>
        <a href={withBase('/first-metro-into-sol-sunday-station-to-door/')}>First Sunday Metro</a> is inbound, station-to-door, when Metro starts.
        <a href={withBase('/barajas-small-hours-into-sol-until-1400/')}>Barajas small hours</a> is a late airport landing into Sol.
        <a href={withBase('/atocha-cercanias-one-stop-into-sol-doors-before-1400/')}>Atocha Cercanías one stop</a> is inbound before 14:00.
        <a href={withBase('/hop-two-streets-last-pint-after-derby/')}>Last pint after the derby</a> is three Saturday doors hopping after Valencia–RM.
        This page is only <strong>door-to-station outbound</strong> after 23:00, four doors already open, Sunday last trains out of Sol.
      </p>

      <h2>From the four open doors to Sol, Sevilla, or Cercanías — reverse of the inbound metres</h2>
      <p>
        <strong>Metro Sol (L1, L2, L3).</strong> Walk north-west toward the square — not a new neighbourhood.
        From east Sol, Victoria 6 is about <strong>2–3 minutes / 180–220 m</strong> (already published inbound; the walk out is the same metres).
        Espoz y Mina 7 and Pasaje de Matheu 4 sit on that same east pocket. Follow live Maps for the last metres; we do not invent a new clock.
      </p>
      <p>
        <strong>Sevilla (L2).</strong> Already the east pocket. Nearest outbound pin from Victoria 6 and Espoz y Mina 7 if you want L2 without crossing the square.
        Follow live Maps; we do not invent minutes from the door to that platform.
      </p>
      <p>
        <strong>Cercanías Sol (C3/C4).</strong> Same Sol station complex, concourse toward Carrera de San Jerónimo / Calle de Carretas (already published inbound from Atocha).
        Reverse that heading when you leave. Catch Cercanías <strong>when the last Sunday Cercanías leaves</strong>. We do not invent that clock.
      </p>
      <ol>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid.</strong>
          Open NOW (from 14:00 until late · sports screens). Closest Victoria pin to east Sol / Sevilla.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          Sunday 12:00–02:00. Named late NFL 22:05 / 22:25 on What’s On. Ask which game is on.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (Maps listing: O’Connell St).
          Same number, different door, different CID. Meeting point; we do not invent its board.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Covered cut-through from Victoria / Espoz y Mina. Usual from 11:30. Meeting point; no invented menu.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
      </ol>

      <h2>Leave when the last Sunday train leaves — late NFL sits alongside, it does not invent a timetable</h2>
      <p>
        Dubliners <a href={withBase('/whats-on/')}>What’s On</a> already lists Sunday 8 November in Madrid time.
        Late NFL from <strong>22:05</strong> then <strong>22:25</strong> is on now at the four open doors.
        That board does not publish Metro or Cercanías last trains. Leave <strong>when the last Sunday Metro / Cercanías leaves</strong>.
        Premier 15:00 / 17:30 and Atlético vs Barcelona 21:00 already sat alongside; they do not stand in for this walk out.
        Coordinate; do not substitute. Named listings: Dubliners only. We do not assign those matches to O’Reilly’s, O’Connell’s or Four Corner.
        Ask which screen before you walk to the station.
      </p>
      <p>
        Still watching, not leaving?
        <a href={withBase('/late-nfl-on-now-2205-2225-four-open-sol-doors/')}>Late NFL is on NOW: 22:05 / 22:25 at the four open doors</a>.
        Need the inbound evening ride from earlier?
        <a href={withBase('/evening-metro-gran-via-sevilla-to-open-sol-doors/')}>Evening Metro Gran Vía or Sevilla was inbound</a>.
      </p>

      <OriginalFourBars lang="en" when="sunday" findHref="/visit/" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>After 23:00. How do I leave Sol by last Metro or Cercanías?</strong></dt>
        <dd>Walk outbound from Victoria 6 / Espoz y Mina 7 / Matheu 4 to Metro Sol, Sevilla (L2), or Cercanías Sol. When the last Sunday Metro / Cercanías leaves. Live Maps. We do not invent that clock.</dd>
        <dt><strong>Is this first Metro in, Barajas, Atocha inbound, or Saturday last pint?</strong></dt>
        <dd>No. Those are inbound early Sunday, airport, inbound Cercanías before 14:00, and three Saturday doors after Valencia. This is outbound after 23:00.</dd>
        <dt><strong>What time is the last Sunday train?</strong></dt>
        <dd>Unpublished here. Leave when the last Sunday Metro / Cercanías leaves. Do not wait on a clock we did not print.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Outbound after 23:00 this Sunday',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'FIND US — Dubliners home' },
              { href: '/visit/', label: 'GET DIRECTIONS — visit / hours' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/late-nfl-on-now-2205-2225-four-open-sol-doors/', label: 'Late NFL is on NOW: 22:05 / 22:25 at the four open Sol doors' },
              { href: '/whats-on/', label: 'What’s On — named screens only' },
              { href: PATH_ES, label: 'Último Metro / Cercanías de salida de Sol después de las 23:00', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
