---
import GettingHere from '../../components/GettingHere.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import LinkHub from '../../components/LinkHub.astro';
import { SITE, withBase, absUrl } from '../../site';
import { OPENING_HOURS } from '../../data/hours';
import {
  CHAMPIONS_CUP_GUIDE_EN,
  CHAMPIONS_CUP_GUIDE_ES,
  CHAMPIONS_CUP_R2_DATE,
  CHAMPIONS_CUP_R2_MATCHES,
} from '../../data/champions-cup-r2-2026';

const PATH = CHAMPIONS_CUP_GUIDE_EN;
const mapsCta =
  'https://www.google.com/maps/dir/?api=1&destination=Dubliners+Madrid&destination_place_id=ChIJLdKNhYAoQg0RE6Nxotwa1zw';
const sat = OPENING_HOURS.find((d) => d.day === 'Saturday')!;

const sportsEventsLd = CHAMPIONS_CUP_R2_MATCHES.map((m) => ({
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: `${m.en} — Champions Cup (screening at Dubliners Madrid)`,
  description: `${m.en} (Champions Cup) shown LIVE on the screens at Dubliners Irish Pub, Espoz y Mina 7, by Puerta del Sol, Madrid.`,
  startDate: `${CHAMPIONS_CUP_R2_DATE}T${m.timeMadrid}:00+01:00`,
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'BarOrPub',
    name: 'Dubliners Irish Pub',
    alternateName: 'Dubliners Madrid',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Calle de Espoz y Mina 7',
      addressLocality: 'Madrid',
      postalCode: '28012',
      addressCountry: 'ES',
    },
    geo: { '@type': 'GeoCoordinates', latitude: 40.4158342, longitude: -3.7022626 },
    hasMap: mapsCta,
  },
  organizer: { '@type': 'BarOrPub', name: 'Dubliners Irish Pub', url: absUrl('/') },
  url: absUrl(PATH),
}));
---

<BaseLayout
  title={'Champions Cup rugby near Sol: Leinster & Munster, Sat 12 Dec | Dubliners'}
  description={'Meeting point for Irish provincial rugby fans in Madrid: Leinster v Sale Sharks and Bristol Bears v Munster, Saturday 12 December, LIVE on our screens at Dubliners by Puerta del Sol.'}
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: CHAMPIONS_CUP_GUIDE_ES }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={sportsEventsLd}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Champions Cup rugby near Sol" schema />
      <h1>Meeting point for Irish provincial rugby — Champions Cup Saturday 12 December</h1>
      <p class="lead">
        <strong>Dubliners</strong> is a <strong>meeting point for Leinster and Munster fans in Madrid</strong>, less than a minute from <strong>Puerta del Sol</strong>. On <strong>Saturday 12 December</strong> we show both Irish Champions Cup Tests <strong>LIVE on our screens</strong> — we do not name a TV channel.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={mapsCta} rel="noopener noreferrer" target="_blank">Get directions</a>
        <a class="btn btn-secondary" href={withBase('/whats-on/')}>What’s On</a>
      </div>
    </div>
  </section>
  <GettingHere lang="en" />

  <section class="section band">
    <div class="container prose">
      <h2>Saturday 12 December — Madrid time</h2>
      <ul>
        {CHAMPIONS_CUP_R2_MATCHES.map((m) => (
          <li>
            <strong>{m.timeMadrid}</strong> — {m.en} ({m.venueEn}; kick-off {m.kickOffLocal} local time)
          </li>
        ))}
      </ul>
      <p class="small">
        Times checked 26 November 2026: Leinster v Sale Sharks kick-off 17:30 at Laya Arena (leinsterrugby.ie fixture/view/169); Bristol Bears v Munster kick-off 20:00 at Ashton Gate (munsterrugby.ie fixture/view/1440), converted to Madrid (CET).
      </p>

      <h2>Double header at the bar</h2>
      <p>
        <strong>Leinster v Sale</strong> at <strong>18:30</strong> opens the evening; <strong>Bristol Bears v Munster</strong> follows at <strong>21:00</strong>. On Saturday we are open {sat.opens}–{sat.closes}. English at the bar, screens around the pub, and Irish fans from Dublin, Cork and Limerick welcome in the same room.
      </p>

      <p>
        Practical plan for the day: <a href={withBase('/leinster-munster-champions-cup-madrid/irish-provinces-saturday-12-december/')}>Irish provinces on Saturday 12 December near Sol</a>. More Irish rugby: <a href={withBase('/ireland-rugby-madrid/')}>Ireland rugby in Madrid</a>.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="map-frame">
        <MapEmbed lang="en" title="Map to Dubliners — Champions Cup rugby near Sol" />
      </div>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'More rugby near Sol',
            items: [
              {
                href: '/leinster-munster-champions-cup-madrid/irish-provinces-saturday-12-december/',
                label: 'Irish provinces Saturday 12 December: your plan near Sol',
              },
              { href: '/ireland-rugby-madrid/', label: 'Ireland rugby in Madrid' },
              { href: '/rugby-nations-finals-weekend-madrid/', label: 'Nations Championship finals weekend' },
              { href: '/visit/', label: 'FIND US' },
            ],
          },
        ]}
      />
      <p>
        En español:{' '}
        <a href={withBase(CHAMPIONS_CUP_GUIDE_ES)} hreflang="es">
          Champions Cup rugby — Leinster y Munster junto a Sol
        </a>
      </p>
      <p class="small">Dubliners is an independent pub, not affiliated with the URC, EPCR or the clubs.</p>
    </div>
  </section>
</BaseLayout>