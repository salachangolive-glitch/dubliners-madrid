---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { SITE, withBase, absUrl } from '../../../site';

// Lithuanian pair of /zalgiris-fans-madrid/ (T22). Same verified kick-off as EN (EuroLeague E2026_139).
const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: 'Real Madrid – Žalgiris Kaunas — Eurolyga (tiesiogiai Dubliners Madridas)',
  description: 'Real Madrid – Žalgiris Kaunas (Eurolygos krepšinis, Movistar Arena) tiesiogiai rodoma Dubliners Irish Pub ekranuose, Espoz y Mina 7, prie Puerta del Sol, Madridas.',
  inLanguage: 'lt',
  startDate: '2026-11-25T20:45:00+01:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'BarOrPub',
    name: 'Dubliners Irish Pub',
    alternateName: 'Dubliners Madrid',
    address: { '@type': 'PostalAddress', streetAddress: 'Calle de Espoz y Mina 7', addressLocality: 'Madrid', postalCode: '28012', addressCountry: 'ES' },
    geo: { '@type': 'GeoCoordinates', latitude: 40.4158342, longitude: -3.7022626 },
    hasMap: SITE.mapsUrl,
  },
  organizer: { '@type': 'BarOrPub', name: 'Dubliners Irish Pub', url: absUrl('/') },
  homeTeam: { '@type': 'SportsTeam', name: 'Real Madrid' },
  awayTeam: { '@type': 'SportsTeam', name: 'Žalgiris Kaunas' },
  url: absUrl('/lt/zalgiris-fans-madrid/'),
};
---

<BaseLayout title={'Žalgirio sirgaliai Madride: Real Madrid – Žalgiris, lapk. 25 | Dubliners'} description={'Real Madrid – Žalgiris Kaunas (Eurolygos krepšinis), trečiadienį, lapkričio 25 d., 20:45 Madrido laiku, Movistar Arena. Susitikimo vieta Žalgirio sirgaliams Dubliners, prie Puerta del Sol.'} path="/lt/zalgiris-fans-madrid/" lang="en" htmlLang="lt" hreflang={{ en: '/zalgiris-fans-madrid/', es: '/es/aficionados-zalgiris-madrid/', lt: '/lt/zalgiris-fans-madrid/' }} ogImage="/images/dubliners-champions-night-screens-1200.webp" extraJsonLd={eventLd}>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current={'Žalgirio sirgaliai Madride'} schema />
      <h1>Žalgirio sirgaliai Madride: Real Madrid – Žalgiris</h1>
      <p class="lead">Trečiadienį, 2026 m. lapkričio 25 d., rungtynių pradžia 20:45 Madrido laiku. Eurolyga, 14 turas, Movistar Arena. Dubliners — susitikimo vieta Žalgirio sirgaliams miesto centre, keli žingsniai nuo Puerta del Sol, prieš areną arba žiūrėti rungtynes TIESIOGIAI mūsų ekranuose.</p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Kaip nuvykti</a>
        <a class="btn btn-primary" href={withBase('/whats-on/')}>Programa (EN)</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container split">
      <div class="prose">
<h2>Rungtynės</h2>
<p>Žalgiris Kaunas atvyksta į Madridas rungtyniauti Eurolygoje prieš Real Madrid. Su bilietu ar be jo — čia galite sekti rungtynes: rodoma TIESIOGIAI mūsų ekranuose, kai nurodyta <a href={withBase('/whats-on/')}>What’s On</a> (anglų k.).</p>
<h2>Susitikimo vieta Žalgirio sirgaliams</h2>
<p>Miško rytą atidarome nuo 12.00 (trečiadienį 12.00–02.00), todėl yra laiko susitikti centre prieš Movistar Areną arba kartu stebėti rungtynes.</p>
<h2>Kaip mus rasti</h2>
<p>Calle de Espoz y Mina 7, 28012 Madrid, prie Puerta del Sol. Metro Sol (1, 2, 3 linijos) arba Sevilla (2 linija).</p>
<h2>Movistar Arena</h2>
<p>Tikslią maršrutą nuo Sol tą dieną patikrinkite Metro de Madrid programėlėje arba <a href="https://www.crtm.es/" rel="noopener noreferrer" target="_blank">crtm.es</a>.</p>
      </div>
      <picture><img class="split-photo tall" src={withBase('/images/dubliners-champions-night-screens-1200.webp')} srcset={`${withBase('/images/dubliners-champions-night-screens-800.webp')} 800w, ${withBase('/images/dubliners-champions-night-screens-1200.webp')} 1200w`} sizes="(max-width: 800px) 100vw, 720px" width="1200" height="1600" loading="lazy" decoding="async" alt="Krepšinis ekrane Dubliners pub'e" /></picture>
    </div>
  </section>
  <section class="section band">
    <div class="container prose">
<p>Angliškai: <a href={withBase('/zalgiris-fans-madrid/')} hreflang="en">Žalgiris fans in Madrid</a> · Ispaniškai: <a href={withBase('/es/aficionados-zalgiris-madrid/')} hreflang="es">Aficionados del Žalgiris</a></p>
<p class="small">Dubliners yra nepriklausomas pub'as, ne susijęs su Eurolyga, Real Madrid ar BC Žalgiris.</p>
    </div>
  </section>
</BaseLayout>
