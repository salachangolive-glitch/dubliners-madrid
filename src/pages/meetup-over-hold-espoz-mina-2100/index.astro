---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/meetup-over-hold-espoz-mina-2100/';
const PATH_ES = '/es/quedada-cerrada-espoz-mina-2100/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Meetup hour is over: hold Espoz y Mina until Valencia 21:00',
  inLanguage: 'en',
  datePublished: '2026-11-07T19:00:00+01:00',
  dateModified: '2026-11-07T19:00:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'The 18:00–19:00 meetup just ended. Where do I go now?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Stay on Espoz y Mina 7. Dubliners and O’Connell’s are still open. Walk two minutes if you are still at O’Reilly’s, Pasaje de Matheu 4. Valencia vs Real Madrid is 21:00 LIVE at Dubliners only. Four Corner is not open tonight.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there live NFL in these two hours?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. There is no official NFL game on Saturday 7 November. The next NFL screen is Sunday 15:30. Tonight’s confirmed kick-off is Valencia vs Real Madrid at 21:00 at Dubliners.',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I wait at Four Corner until 21:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Four Corner, Calle de la Victoria 6, opens Sunday 8 November from 14:00 with sports screens. It is not a Saturday door.',
      },
    },
  ],
};
---

<BaseLayout
  title="Meetup over: hold Espoz y Mina until Valencia 21:00 | Dubliners"
  description="18:00–19:00 is over. Stay on Espoz y Mina 7 until Valencia–Real Madrid 21:00 LIVE at Dubliners. No NFL Saturday. Four Corner Sunday 14:00. Four bars, Maps."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Meetup over — hold until 21:00" schema />
      <h1>Meetup hour is over: hold Espoz y Mina until Valencia 21:00</h1>
      <p class="lead">
        The 18:00–19:00 window has closed. You do not need a new street. Sit Dubliners or O’Connell’s at
        <strong>Espoz y Mina 7</strong> until 21:00. Valencia vs Real Madrid is LIVE here only.
        No official NFL tonight. Four Corner stays shut until Sunday 14:00.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Quedada cerrada: quedaos en Espoz y Mina hasta las 21:00</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Maps</a>
        <a class="btn btn-secondary" data-track-event="directions_click" href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell's on Maps</a>
        <a class="btn btn-secondary" href={withBase('/4-bars-one-fan-weekend/')}>MEET US NEAR SOL</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Two hours, three Saturday doors — not a fourth</h2>
      <p>
        This is not the walking-order meetup page and not the 21:00 broadcast page. It is the gap after 19:00:
        groups still in Sol, kick-off still two hours away. If you are at O’Reilly’s (Pasaje de Matheu 4),
        the passage is two minutes to Espoz y Mina 7. O’Reilly’s stays open until 01:30 if you want to eat first.
        Dubliners Saturday until 02:30. O’Connell’s until 03:30. Come to Dubliners before 21:00 if you want a seat
        facing a screen — we list Valencia–RM LIVE here only, not at the other three.
      </p>
      <p>
        Do not walk to Victoria 6 tonight. Four Corner is Sunday: 14:00 until late, sports screens, ask which game is on.
        Tomorrow’s stack from that door: Premier League 15:00, NFL 15:30 and evening, Atlético–Barcelona 21:00 at Dubliners.
      </p>

      <OriginalFourBars lang="en" when="tonight" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Meetup just ended. Where now?</strong></dt>
        <dd>Hold Espoz y Mina 7. Dubliners for 21:00 Valencia–RM LIVE. O’Connell’s next door. O’Reilly’s two minutes back if you still want the terrace.</dd>
        <dt><strong>Live NFL in these two hours?</strong></dt>
        <dd>No. No official NFL Saturday. Sunday 15:30 is the first NFL screen.</dd>
        <dt><strong>Four Corner until 21:00?</strong></dt>
        <dd>No. Sunday from 14:00, Victoria 6, sports screens. Not a Saturday wait.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'After 19:00, then Sunday',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'Dubliners home' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/saturday-night-sol-valencia-real-madrid/', label: 'Valencia–RM 21:00 at Dubliners' },
              { href: '/after-tonight-sunday-starts-victoria-6/', label: 'Sunday starts at Victoria 6' },
              { href: PATH_ES, label: 'Quedada cerrada, hasta Valencia', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
