---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { withBase } from '../../site';
import { MENU } from '../../data/menu';
const title = 'Food & Drinks Menu near Sol, Madrid | Dubliners Irish Pub';
const description = 'Pub food near Sol: the Dubliners menu — rice dishes, raciones & tapas, salads, burgers, pizza and desserts. Calle de Espoz y Mina 7, Madrid.';
---
<BaseLayout title={title} description={description} path="/menu/" lang="en" hreflang={{ en: '/menu/', es: '/es/carta/' }} ogImage="/images/bar-interior.jpg">
  <section class="hero hero-compact"><div class="container">
    <Breadcrumb current="Menu" />
    <h1>Food & drinks menu — pub food near Sol</h1>
    <p class="lead">Our food menu at the pub, from rice dishes and tapas to burgers and desserts. Ask the staff for today’s options.</p>
    <div class="cta-row"><a class="btn btn-gold" href={withBase('/visit/')}>How to get here</a><a class="btn btn-secondary" href={withBase('/whats-on/')}>See what's on</a></div>
  </div></section>
  <section class="section"><div class="container prose">
    <h2>Menu</h2>
    {MENU.map((sec) => (
      <div class="menu-sec">
        <h3>{sec.en}</h3>
        <ul class="menu-list">
          {sec.items.map((it) => (
            <li><span class="mi-name"><strong>{(it.en ?? it.es)}</strong>{(it.en ? it.es : null) && <span class="mi-sub"> · {(it.en ? it.es : null)}</span>}{(it.descEn ?? it.descEs) && <span class="mi-desc">{(it.descEn ?? it.descEs)}</span>}</span></li>
          ))}
        </ul>
      </div>
    ))}
    <p class="small">Prices in euros as shown on the pub's menu. For allergens, please ask our staff.</p>
  </div></section>
  <style>
    .menu-photos { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); }
    .menu-photo { margin: 0; }
    .menu-photo img { width: 100%; height: auto; display: block; border-radius: 8px; }
    .menu-photo figcaption { font-size: .85rem; opacity: .8; margin-top: .3rem; }
    .menu-list { list-style: none; padding: 0; margin: 0 0 1.5rem; }
    .menu-list li { display: flex; justify-content: space-between; gap: 1rem; padding: .5rem 0; border-bottom: 1px solid rgba(255,255,255,.12); }
    .mi-sub { opacity: .8; }
    .mi-desc { display: block; font-size: .85rem; opacity: .75; }
  </style>
</BaseLayout>
