---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

// Approved Saturday EN message, adapted for Dubliners. No NFL today. No third-party venues.
const path = '/nfl-fans-madrid-this-saturday/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'NFL fans in Madrid this Saturday',
  inLanguage: 'en',
  datePublished: '2026-11-07T15:00:00+01:00',
  dateModified: '2026-11-07T16:15:00+01:00',
  image: [absUrl('/images/facade.jpg')],
  mainEntityOfPage: absUrl(path),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is there live NFL today, Saturday 7 November?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. There is no official NFL game on Saturday. The Madrid Game is Sunday 8 November at the Bernabéu (Bengals vs Falcons, 15:30). Today is the meetup near Sol.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which bars are open today?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "O'Reilly's Restaurant Bar (Pasaje de Matheu 4) usual hours 11:30–01:30. Dubliners (Espoz y Mina 7) Saturday 12:00–02:30. O'Connell's (Espoz y Mina 7) usual Saturday 15:00–03:30. Four Corner (Calle de la Victoria 6) is Sunday 8 November from 14:00 until late — not listed as open today.",
      },
    },
    {
      '@type': 'Question',
      name: 'Are these bars an official NFL event?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Independent sister bars near Puerta del Sol. Not an official NFL event.',
      },
    },
  ],
};
---

<BaseLayout
  title="NFL fans in Madrid this Saturday | Dubliners near Sol"
  description="NFL fans in Madrid this Saturday: meet at O'Reilly's, Dubliners and O'Connell's near Sol. No NFL game today. Four Corner Sunday from 14:00. Maps."
  path={path}
  lang="en"
  hreflang={{ en: path, es: '/es/fin-de-semana-nfl-ya-se-vive/' }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="NFL fans in Madrid this Saturday" schema />
      <h1>NFL fans in Madrid this Saturday</h1>
      <p class="lead">
        The weekend is already here. <strong>There is no official NFL game today</strong> —
        Sunday is the Madrid Game at the Bernabéu. Saturday 7 November is the meetup
        <strong>18:00–19:00</strong> at O’Reilly’s, Dubliners and O’Connell’s:
        an international crowd, English-speaking rooms, screens, afternoon into evening, a few minutes from Puerta del Sol.
      </p>
      <p class="small">4 BARS. ONE FAN WEEKEND. Independent sister bars. Not an official NFL event.</p>
      <p class="small">En español: <a href={withBase('/es/fin-de-semana-nfl-ya-se-vive/')} hreflang="es" lang="es">El fin de semana NFL ya se vive</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's on Maps</a>
        <a class="btn btn-secondary" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Maps</a>
        <a class="btn btn-secondary" data-track-event="directions_click" href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell's on Maps</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Tonight 18:00–19:00</h2>
      <p>
        Meet <strong>18:00–19:00</strong> at O’Reilly’s (Pasaje de Matheu 4), Dubliners or O’Connell’s (Espoz y Mina 7) —
        three rooms, one pocket south-east of Sol. All three are already open by then
        (O’Reilly’s from 11:30, Dubliners from 12:00, O’Connell’s from 15:00).
        Four Corner is <strong>not open Saturday</strong>. Sunday’s kick-off can wait until tomorrow.
      </p>

      <h2>Today: three bars near Sol</h2>
      <p>
        Lead with the rooms that have Saturday hours. Meet in one pocket, not four separate plans.
      </p>

      <h3>O'Reilly's Restaurant Bar</h3>
      <p>
        Pasaje de Matheu 4, 28012 Madrid. Restaurant-bar with terrace, first to open of the three.<br />
        Usual hours: daily 11:30–01:30.<br />
        <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's on Google Maps</a>
      </p>

      <h3>Dubliners</h3>
      <p>
        Calle de Espoz y Mina 7, 28012 Madrid. Irish pub, English-speaking, screens this afternoon and evening.
        Saturday <strong>12:00–02:30</strong>. We do not advertise live NFL today — there isn’t one.
        Confirmed tonight on these screens: Valencia vs Real Madrid at 21:00.<br />
        <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Google Maps</a>
      </p>

      <h3>O'Connell's</h3>
      <p>
        Calle de Espoz y Mina 7, 28012 Madrid — same street as Dubliners (listed on Maps as O'Connell St).<br />
        Usual Saturday hours: 15:00–03:30.<br />
        <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell's on Google Maps</a>
      </p>

      <h2>Four Corner — Sunday from 14:00</h2>
      <p>
        Four Corner, Calle de la Victoria 6, 28012 Madrid, is part of the same meeting point.
        Confirmed: <strong>Sunday 8 November from 14:00 until late</strong>, with sports screens.
        We do not list Saturday hours or which games it shows.
        <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Four Corner on Google Maps</a>
      </p>

      <h2>Before Sunday</h2>
      <p>
        Tomorrow: Dubliners from 12:00, Four Corner from 14:00, Bengals vs Falcons at 15:30 at the Bernabéu
        (and on Dubliners’ big screen). That day has its own guides.
        Today is the international crowd in Sol — walk, meet, stay.
      </p>

      <p>
        Maps:
        <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's</a>
        · <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners</a>
        · <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell's</a>
        · <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Four Corner (Sunday 14:00)</a>
      </p>

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Is there live NFL today?</strong></dt>
        <dd>No. No official NFL game on Saturday. The Madrid Game is Sunday 15:30.</dd>
        <dt><strong>When is tonight’s meetup?</strong></dt>
        <dd>18:00–19:00 at O’Reilly’s, Dubliners or O’Connell’s. Four Corner is not open Saturday.</dd>
        <dt><strong>Which bars are open today?</strong></dt>
        <dd>O'Reilly's 11:30–01:30, Dubliners 12:00–02:30, O'Connell's Saturday 15:00–03:30. Four Corner: Sunday from 14:00 (sports screens).</dd>
        <dt><strong>Are these bars official NFL?</strong></dt>
        <dd>No. Independent sister bars. Not an official NFL event.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Saturday near Sol',
            items: [
              { href: '/saturday-in-sol-today/', label: 'Saturday in Sol today', note: 'Hours and Maps from Puerta del Sol', until: SHOW_UNTIL },
              { href: '/saturday-night-sol-valencia-real-madrid/', label: 'Saturday night: Valencia–Real Madrid', note: '21:00 confirmed at Dubliners', until: SHOW_UNTIL },
              { href: '/4-bars-one-fan-weekend/', label: '4 Bars. One Fan Weekend' },
              { href: '/es/fin-de-semana-nfl-ya-se-vive/', label: 'El fin de semana NFL ya se vive', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
