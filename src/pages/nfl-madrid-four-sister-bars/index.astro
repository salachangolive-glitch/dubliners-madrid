---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import { withBase, absUrl } from '../../site';
import { OPENING_HOURS } from '../../data/hours';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

// New article (owner 6 Nov 2026): four sister bars as one NFL Madrid meeting point near Sol.
const path = '/nfl-madrid-four-sister-bars/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'NFL Madrid 2026: four sister bars, one fan meeting point near Puerta del Sol',
  inLanguage: 'en',
  datePublished: '2026-11-06T16:00:00+01:00',
  dateModified: '2026-11-06T16:00:00+01:00',
  image: [absUrl('/images/facade.jpg')],
  mainEntityOfPage: absUrl(path),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Where is the fan meeting point for NFL Madrid near Sol?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Four sister bars in the same area: O\'Reilly\'s Restaurant Bar (Pasaje de Matheu 4), Dubliners and O\'Connell St (Calle de Espoz y Mina 7), and Four Corner (Calle de la Victoria 6).',
      },
    },
    {
      '@type': 'Question',
      name: 'When does Dubliners open on Sunday 8 November?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'From 12:00. Usual hours: Monday–Thursday and Sunday 12:00–02:00; Friday and Saturday 12:00–02:30.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are the four bars part of the NFL Experience or NFL House?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. The four bars are independent of the league’s events at Plaza de España and Casa de las Alhajas.',
      },
    },
  ],
};
---

<BaseLayout
  title="NFL Madrid 2026: four sister bars near Puerta del Sol | Dubliners"
  description="Four sister bars, one fan meeting point near Puerta del Sol for NFL Madrid 2026: O'Reilly's, Dubliners, O'Connell St and Four Corner. Name, address and Maps for each."
  path={path}
  lang="en"
  hreflang={{ en: path, es: '/es/nfl-madrid-cuatro-bares-hermanos/' }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Four sister bars near Sol" schema />
      <h1>NFL Madrid 2026: four sister bars, one fan meeting point near Puerta del Sol</h1>
      <p class="lead">
        One collective idea for 7 and 8 November: four sister bars in the same streets around Puerta del Sol,
        so fans share <strong>one meeting point</strong> rather than four disconnected stops.
      </p>
      <p class="small">En español: <a href={withBase('/es/nfl-madrid-cuatro-bares-hermanos/')} hreflang="es" lang="es">NFL Madrid 2026: cuatro bares hermanos junto a Sol</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Maps</a>
        <a class="btn btn-secondary" href={withBase('/4-bars-one-fan-weekend/')}>4 Bars. One Fan Weekend</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>One meeting point, four sister bars</h2>
      <p>
        NFL Madrid weekend sits in the city centre. The useful move is to treat the cluster around Sol as a single area:
        eat, meet and follow the games without crossing the city between venues. O'Reilly's Restaurant Bar, Dubliners,
        O'Connell St and Four Corner are sister bars a short walk from Puerta del Sol and from each other.
      </p>
      <p>
        This page is the map of that idea: each bar with its name, street address and a Google Maps link.
        The four bars are independent of the league’s own events.
      </p>

      <h2>The four bars</h2>

      <h3>O'Reilly's Restaurant Bar</h3>
      <p>
        Pasaje de Matheu 4, 28012 Madrid.<br />
        Restaurant-bar with terrace, a short walk from Sol.<br />
        <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Google Maps</a>
      </p>

      <h3>Dubliners</h3>
      <p>
        Calle de Espoz y Mina 7, 28012 Madrid.<br />
        Irish pub. Sunday 8 November: open from 12:00. Usual hours: Monday–Thursday and Sunday 12:00–02:00; Friday and Saturday 12:00–02:30.<br />
        <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Google Maps</a>
      </p>

      <h3>O'Connell St</h3>
      <p>
        Calle de Espoz y Mina 7, 28012 Madrid (same street as Dubliners).<br />
        Irish sports pub in the same cluster.<br />
        <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Google Maps</a>
      </p>

      <h3>Four Corner</h3>
      <p>
        Calle de la Victoria 6, 28012 Madrid.<br />
        Sister bar in the same area. Hours to be confirmed.<br />
        <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Google Maps</a>
      </p>

      <h2>Independent of the league’s events</h2>
      <p>
        On Friday 6 and Saturday 7 the NFL runs its own programme elsewhere: NFL Experience at Plaza de España (10:00–19:00)
        and NFL House at Casa de las Alhajas, Calle de San Martín 1 (12:00–20:00). Those events are the league’s.
        The four sister bars are a separate meeting point near Sol — useful before, after, or instead of those venues.
      </p>

      <h2 data-show-until={SHOW_UNTIL}>Sunday 8 November at Dubliners</h2>
      <div data-show-until={SHOW_UNTIL}>
        <p>
          Dubliners opens from 12:00. Kick-off facts below are Madrid time. At Dubliners, Bengals vs Falcons is LIVE on the
          <strong>big screen</strong> from 15:30; Sunday NFL continues from 19:00 within opening hours (we close at 02:00).
        </p>
        <ul>
          <li><strong>15:30</strong> — Cincinnati Bengals vs Atlanta Falcons (Madrid Game). In Spain: DAZN and Cuatro.</li>
          <li><strong>19:00</strong> — seven NFL games (Broncos–Panthers, Cowboys–Colts, Jets–Chiefs, Lions–Dolphins, Browns–Saints, Giants–Eagles, Rams–Commanders).</li>
          <li><strong>21:00</strong> — Atlético de Madrid vs FC Barcelona.</li>
          <li><strong>22:05</strong> — Houston Texans vs Los Angeles Chargers.</li>
          <li><strong>22:25</strong> — three NFL games (Raiders–49ers, Packers–Patriots, Cardinals–Seahawks).</li>
        </ul>
        <p class="small">Saturday 7 November, 21:00: Valencia vs Real Madrid (Orange TV and DAZN) — LIVE at Dubliners.</p>
      </div>

      <h2>Opening hours at Dubliners</h2>
      <ul>{OPENING_HOURS.map((d) => <li>{d.day}: {d.opens}–{d.closes}</li>)}</ul>

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Where is the fan meeting point for NFL Madrid near Sol?</strong></dt>
        <dd>Four sister bars in the same area: O'Reilly's Restaurant Bar (Pasaje de Matheu 4), Dubliners and O'Connell St (Espoz y Mina 7), and Four Corner (Calle de la Victoria 6).</dd>
        <dt><strong>When does Dubliners open on Sunday 8 November?</strong></dt>
        <dd>From 12:00. Usual hours: Monday–Thursday and Sunday 12:00–02:00; Friday and Saturday 12:00–02:30.</dd>
        <dt><strong>Are the four bars part of the NFL Experience or NFL House?</strong></dt>
        <dd>No. The four bars are independent of the league’s events at Plaza de España and Casa de las Alhajas.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'More for this weekend',
            items: [
              { href: '/4-bars-one-fan-weekend/', label: '4 Bars. One Fan Weekend', note: 'Central hub with all four bars' },
              { href: '/saturday-sunday-sol-four-bars/', label: 'Saturday and Sunday in Sol', note: 'A fan’s route through four bars', until: SHOW_UNTIL },
              { href: '/nfl-madrid/', label: 'NFL in Madrid', note: 'Sunday schedule LIVE' },
              { href: '/whats-on/', label: "What's On" },
              { href: '/es/nfl-madrid-cuatro-bares-hermanos/', label: 'Cuatro bares hermanos junto a Sol', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
