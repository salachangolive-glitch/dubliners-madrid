---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import { withBase } from '../../site';
const faqLd = {"@context": "https://schema.org", "@type": "FAQPage", "mainEntity": [{"@type": "Question", "name": "When and where is the 2026 NFL game in Madrid?", "acceptedAnswer": {"@type": "Answer", "text": "Bengals vs Falcons, Sunday 8 November 2026 at 15:30 Madrid time, Santiago Bernabéu Stadium."}}, {"@type": "Question", "name": "What are your opening hours?", "acceptedAnswer": {"@type": "Answer", "text": "Monday–Thursday and Sunday 12:00–02:00; Friday and Saturday 12:00–02:30."}}, {"@type": "Question", "name": "Which NFL games are live on Sunday 8 November?", "acceptedAnswer": {"@type": "Answer", "text": "On Sunday 8 November: Bengals vs Falcons at 15:30 and all Sunday NFL games at 19:00, 22:05 and 22:25, LIVE. Other dates are listed on What's On once confirmed."}}]};
const eventLd = {"@context": "https://schema.org", "@type": "SportsEvent", "name": "Cincinnati Bengals vs Atlanta Falcons", "startDate": "2026-11-08T15:30:00+01:00", "eventStatus": "https://schema.org/EventScheduled", "location": {"@type": "Place", "name": "Estadio Santiago Bernabéu", "address": {"@type": "PostalAddress", "addressLocality": "Madrid", "addressCountry": "ES"}}};
const title = "NFL Bar Madrid: Where to Watch NFL near Sol | Dubliners";
const description = "NFL bar in Madrid by Puerta del Sol, Espoz y Mina 7. NFL games LIVE on a big projector and 8 screens: see What's On.";
// POST-GAME block: hidden until NFL programming on our screens is confirmed. Set to true only after DG/owner sign-off.
const SHOW_POSTGAME = true; // unlocked 13 Oct: owner confirmed all Sunday NFL games live
---

<BaseLayout title={title} description={description} path="/nfl-madrid/" lang="en" hreflang={{ en: '/nfl-madrid/', es: '/es/nfl-madrid/' }} ogImage="/images/facade.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="NFL in Madrid" schema />
      <h1>NFL in Madrid: watch it with other fans near Puerta del Sol</h1>
      <p class="lead">Irish sports pub on Calle de Espoz y Mina 7, steps from Puerta del Sol. Watch Bengals vs Falcons LIVE on Sunday 8 November from 15:30 — and every Sunday NFL game that day LIVE on our screens.</p>
      <div class="cta-row">
        <a class="btn btn-gold" href={withBase('/visit/')}>How to get here</a>
        <a class="btn btn-secondary" href={withBase('/whats-on/')}>See what's on</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <h2>NFL in Madrid</h2><p>On Sunday 8 November 2026 the Cincinnati Bengals and the Atlanta Falcons play at the Santiago Bernabéu Stadium at 15:30 Madrid time (9:30 a.m. ET). It is the NFL's second regular-season game in Madrid.</p>
      <h2>NFL schedule (confirmed only)</h2>
      <table><tbody><tr><td>Sun 8 Nov</td><td>15:30</td><td>Bengals vs Falcons</td><td>Santiago Bernabéu Stadium, Madrid</td></tr><tr><td>Sun 8 Nov</td><td>19:00</td><td>Broncos at Panthers</td><td></td></tr><tr><td>Sun 8 Nov</td><td>19:00</td><td>Cowboys at Colts</td><td></td></tr><tr><td>Sun 8 Nov</td><td>19:00</td><td>Jets at Chiefs</td><td></td></tr><tr><td>Sun 8 Nov</td><td>19:00</td><td>Lions at Dolphins</td><td></td></tr><tr><td>Sun 8 Nov</td><td>19:00</td><td>Browns at Saints</td><td></td></tr><tr><td>Sun 8 Nov</td><td>19:00</td><td>Giants at Eagles</td><td></td></tr><tr><td>Sun 8 Nov</td><td>19:00</td><td>Rams at Commanders</td><td></td></tr><tr><td>Sun 8 Nov</td><td>22:05</td><td>Texans at Chargers</td><td></td></tr><tr><td>Sun 8 Nov</td><td>22:05</td><td>Raiders at 49ers</td><td></td></tr><tr><td>Sun 8 Nov</td><td>22:25</td><td>Packers at Patriots</td><td></td></tr><tr><td>Sun 8 Nov</td><td>22:25</td><td>Cardinals at Seahawks</td><td></td></tr></tbody></table>
      <p class="small">Madrid times (CET). All games above are LIVE at Dubliners. Source: nfl.com Week 9 schedule. The Sunday night game (02:20 Monday Madrid) is after closing time. <a href={withBase('/whats-on/')}>See what's on</a></p>
      <p class="small">Planning the whole day? <a href={withBase('/nfl-sunday-madrid-guide/')}>NFL Sunday hour-by-hour guide</a></p>
      <p class="small">Thanksgiving Thursday: <a href={withBase('/thanksgiving-madrid/')}>Thanksgiving NFL in Madrid</a> (26 November: 19:00 and 22:30)</p>
      <p class="small">The Sunday before: <a href={withBase('/nfl-sunday-madrid-1-november/')}>NFL Sunday, 1 November</a> (19:00, 22:05 and 22:25, bank holiday Monday)</p>
      <h2>How to find us</h2><p>Calle de Espoz y Mina 7, 28012 Madrid. Metro Sol (L1, L2, L3) or Sevilla (L2).</p><p>Opening hours: Monday–Thursday and Sunday 12:00–02:00; Friday and Saturday 12:00–02:30.</p>
      <div class="map-frame"><MapEmbed title="Map of Dubliners Madrid" lang="en" /></div>
      <h3>From the pub to the Bernabéu by metro</h3><p>Santiago Bernabéu metro station (Line 10) is closed for works between Cuzco and Nuevos Ministerios until the end of 2026, per CRTM. From Sol, take Line 1 to Tribunal, change to Line 10 to Nuevos Ministerios, then take the free S10 replacement bus to the Santiago Bernabéu stop on Paseo de la Castellana.</p>
      <h3>At the Bernabéu: practical info</h3><p>From Real Madrid's NFL page (<a href="https://bernabeu.realmadrid.com/nfl/" rel="noopener">bernabeu.realmadrid.com/nfl</a>): kick-off is at 15:30 and the stadium perimeter opens at 12:30. There is no parking at the stadium, so plan on public transport; the accessible metro station is Nuevos Ministerios (L6, L8, L10), about 15 minutes on foot from the accessible entrance. The NFL clear-bag policy applies: clear bags up to 30.5 × 15.25 × 30.5 cm or small clutch bags up to 11.5 × 16.5 cm. You can bring an empty, clear reusable bottle (up to 1 litre).</p>
      <h2>Central Madrid</h2><p>We're between Puerta del Sol, Plaza Mayor and the Barrio de las Letras — easy to find before or after exploring the city.</p><img class="split-photo tall" src={withBase('/images/dubliners-bar-counter-screen-madrid-1152.webp')} srcset={`${withBase('/images/dubliners-bar-counter-screen-madrid-800.webp')} 800w, ${withBase('/images/dubliners-bar-counter-screen-madrid-1152.webp')} 1152w`} sizes="(max-width: 800px) 100vw, 720px" width="1152" height="2048" loading="lazy" decoding="async" alt="Bar counter and a TV screen inside Dubliners Madrid" />
      <h2>Watch Bengals vs Falcons LIVE</h2><p>On Sunday 8 November Dubliners is open for fans from 12:00: come by before the game, then watch Bengals vs Falcons LIVE at 15:30 Madrid time on a big projector and 8 screens.</p><img class="split-photo tall" src={withBase('/images/dubliners-projector-screens-sol-1200.webp')} srcset={`${withBase('/images/dubliners-projector-screens-sol-800.webp')} 800w, ${withBase('/images/dubliners-projector-screens-sol-1200.webp')} 1200w`} sizes="(max-width: 800px) 100vw, 720px" width="1200" height="1600" loading="lazy" decoding="async" alt="Projector and screens at Dubliners near Sol" />
      <h2>NFL RedZone LIVE</h2><p>NFL RedZone LIVE on Sunday 8 November from 19:00 Madrid time (1:00 p.m. ET), across the 19:00, 22:05 and 22:25 games, within our opening hours (we close at 02:00).</p>
      {SHOW_POSTGAME && (<div class="postgame"><h2>The game doesn't end at the Bernabéu — all Sunday NFL games LIVE</h2><p>After the final whistle, Dubliners keeps the NFL on for fans: NFL RedZone from 19:00 and every Sunday NFL game LIVE (Madrid time):</p><ul class="postgame-list"><li><strong>19:00</strong> — Broncos at Panthers · Cowboys at Colts · Jets at Chiefs · Lions at Dolphins · Browns at Saints · Giants at Eagles · Rams at Commanders</li><li><strong>22:05</strong> — Texans at Chargers · Raiders at 49ers</li><li><strong>22:25</strong> — Packers at Patriots · Cardinals at Seahawks</li></ul><p class="small">Sunday Night Football (Buccaneers at Bears) starts at 02:20 Monday Madrid time, after we close at 02:00, so it isn't shown.</p></div>)}
      <h2>FAQ</h2><dl class="faq"><dt><strong>When and where is the 2026 NFL game in Madrid?</strong></dt><dd>Bengals vs Falcons, Sunday 8 November 2026 at 15:30 Madrid time, Santiago Bernabéu Stadium.</dd><dt><strong>What are your opening hours?</strong></dt><dd>Monday–Thursday and Sunday 12:00–02:00; Friday and Saturday 12:00–02:30.</dd><dt><strong>Which NFL games are live on Sunday 8 November?</strong></dt><dd>On Sunday 8 November: Bengals vs Falcons at 15:30 and all Sunday NFL games at 19:00, 22:05 and 22:25, LIVE. Other dates are listed on What's On once confirmed.</dd></dl>
      <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
      <script type="application/ld+json" set:html={JSON.stringify(eventLd)} />
    </div>
  </section>
</BaseLayout>
