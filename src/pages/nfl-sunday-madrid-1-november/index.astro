---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import { SITE, withBase } from '../../site';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'When was NFL Sunday 1 November 2026 at Dubliners?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sunday 1 November 2026. Kick-offs were at 19:00, 22:05 and 22:25 Madrid time. That Sunday has passed. Named Sundays now live on What’s On.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do you still show NFL at Dubliners?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Sunday NFL is on the screens when listed on What’s On, within opening hours (Sunday 12:00–02:00). See Watch NFL Madrid.',
      },
    },
  ],
};
---

<BaseLayout
  title="NFL Sunday in Madrid, 1 November 2026 (archive) | Dubliners"
  description="Archive. NFL Sunday 1 November 2026 at Dubliners by Puerta del Sol has passed. Kick-offs were 19:00, 22:05 and 22:25 Madrid time. Ongoing Sunday NFL: Watch NFL Madrid."
  path="/nfl-sunday-madrid-1-november/"
  lang="en"
  hreflang={{ en: '/nfl-sunday-madrid-1-november/' }}
  ogImage="/images/screens-sports.jpg"
  extraJsonLd={[faqLd]}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="NFL Sunday, 1 November 2026" schema />
      <h1>NFL Sunday in Madrid on 1 November 2026</h1>
      <p class="lead">
        This page covered NFL Sunday 1 November 2026 at Dubliners, Espoz y Mina 7, near Puerta del Sol.
        Kick-offs that day were 19:00, 22:05 and 22:25 Madrid time. That Sunday has passed.
        For Sunday NFL from here on, see <a href={withBase('/nfl-madrid/')}>Watch NFL Madrid</a>.
        For this week’s confirmed sport, see <a href={withBase('/whats-on/')}>What’s On</a>.
      </p>
      <p class="small">Archive · Sunday 1 November 2026 · updated 9 November 2026</p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">GET DIRECTIONS</a>
        <a class="btn btn-secondary" href={withBase('/whats-on/')}>What’s On this week</a>
        <a class="btn btn-secondary" href={withBase('/nfl-madrid/')}>Watch NFL Madrid</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <h2>That Sunday</h2>
      <p>
        Monday 2 November 2026 was a public holiday in the Community of Madrid, so 1 November was a long-weekend night.
        The US was on winter time, so the early NFL window started at 19:00 Madrid time.
      </p>
      <h2>Where we are</h2>
      <p>Dubliners Irish Pub, Calle de Espoz y Mina 7, 28012 Madrid. Metro Sol (lines 1, 2 and 3) or Sevilla (line 2).</p>
      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>When was NFL Sunday 1 November 2026 at Dubliners?</strong></dt>
        <dd>Sunday 1 November 2026. Kick-offs were at 19:00, 22:05 and 22:25 Madrid time. That Sunday has passed. Named Sundays now live on <a href={withBase('/whats-on/')}>What’s On</a>.</dd>
        <dt><strong>Do you still show NFL at Dubliners?</strong></dt>
        <dd>Yes. Sunday NFL is on the screens when listed on What’s On, within opening hours (Sunday 12:00–02:00). See <a href={withBase('/nfl-madrid/')}>Watch NFL Madrid</a>.</dd>
      </dl>
      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'NFL at Dubliners',
            items: [
              { href: '/nfl-madrid/', label: 'Watch NFL Madrid', note: 'Sunday screens when listed' },
              { href: '/whats-on/', label: "What's On", note: 'This week’s confirmed sport' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
