---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import { SITE, withBase, absUrl } from '../../site';
import { OPENING_HOURS } from '../../data/hours';

// DU2 (Radar eventos-madrid-2026-10-24): NFL Sunday 1 Nov 2026 + bank-holiday Monday 2 Nov.
// Kick-off slots 19:00 / 22:05 / 22:25 Madrid time: cross-checked with src/data/fixtures.ts (11 NFL rows, dateKey 2026-11-01)
// and Radar 2026-10-19-profundo.md l.67 (NFL Ops; US back on standard time that day). Matchups NOT named here:
// Radar 19–21 Oct files verify only the times. Liverpool v Arsenal 17:30: fixtures.ts + Radar 19 Oct l.67.
// Mon 2 Nov regional holiday: BOCM 24/12/2025. Showing: owner permanent rule 24 Oct via DG (all NFL live).
// NFL Madrid 8 Nov is covered by /nfl-madrid/ and /nfl-sunday-madrid-guide/ — only linked here.
const sun = OPENING_HOURS.find((d) => d.day === 'Sunday')!;
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What time are the NFL games on Sunday 1 November in Madrid?', acceptedAnswer: { '@type': 'Answer', text: 'Kick-offs are at 19:00, 22:05 and 22:25 Madrid time. The US changes to winter time that day, so the early games start at 19:00, not 18:00 as on 25 October.' } },
    { '@type': 'Question', name: 'Is Monday 2 November a holiday in Madrid?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. Monday 2 November 2026 is a public holiday in the Community of Madrid (BOCM, 24 December 2025), so Sunday night is a long-weekend night.' } },
    { '@type': 'Question', name: 'Do you show the NFL at Dubliners?', acceptedAnswer: { '@type': 'Answer', text: 'Yes, all the NFL games are LIVE on our screens, within our opening hours (Sunday 12:00–02:00).' } },
    { '@type': 'Question', name: 'When is the NFL game in Madrid?', acceptedAnswer: { '@type': 'Answer', text: 'Bengals vs Falcons, Sunday 8 November 2026 at 15:30 Madrid time, at the Santiago Bernabéu. 1 November is the last NFL Sunday before it.' } },
  ],
};
---

<BaseLayout title={'NFL Sunday in Madrid, 1 November: Live by Sol | Dubliners'} description={'NFL Sunday in Madrid on 1 November: games LIVE at 19:00, 22:05 and 22:25 at Dubliners by Puerta del Sol, with a bank holiday Monday. One week to NFL Madrid.'} path="/nfl-sunday-madrid-1-november/" lang="en" hreflang={{ en: '/nfl-sunday-madrid-1-november/' }} ogImage="/images/screens-sports.jpg" extraJsonLd={[faqLd]}>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current={'NFL Sunday, 1 November'} schema />
      <h1>NFL Sunday in Madrid on 1 November, with a bank holiday Monday</h1>
      <p class="lead">The last NFL Sunday before the NFL comes to Madrid, with a bank holiday on Monday in Madrid. Watch the games LIVE at Dubliners, an English-speaking Irish pub a few steps from Puerta del Sol, and start the 7-day countdown to Bengals vs Falcons at the Bernabéu.</p>
      <p class="small">Sunday 1 November 2026 · kick-offs 19:00, 22:05 and 22:25 Madrid time · Updated 24 October 2026</p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
        <a class="btn btn-primary" href={withBase('/contact/#request-information')}>Request information</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <h2>Kick-off times (Madrid time)</h2>
      <ul>
        <li><strong>19:00</strong> — early games</li>
        <li><strong>22:05</strong> — late games</li>
        <li><strong>22:25</strong> — late games</li>
      </ul>
      <p>Heads-up: the US goes back to winter time on 1 November, so the early games start at 19:00 Madrid time, not 18:00 as the week before. All the NFL games are LIVE on our screens within our opening hours. For the full list of games, see <a href={withBase('/whats-on/')}>What's On</a>.</p>
      <picture><source type="image/webp" srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`} sizes="(max-width: 800px) 100vw, 720px" /><img class="split-photo landscape" src={withBase('/images/screens-sports.jpg')} width="1400" height="788" loading="lazy" decoding="async" alt="Sports on the screens inside Dubliners Madrid" /></picture>
      <h2>A long-weekend Sunday night</h2>
      <p>Monday 2 November 2026 is a public holiday in the Community of Madrid (BOCM, 24 December 2025). That makes Sunday the perfect night to stay for the late games without watching the clock. Getting in early? Liverpool vs Arsenal is LIVE at 17:30, a good warm-up before the NFL.</p>
      <h2>7 days to NFL Madrid</h2>
      <p>One week later, on Sunday 8 November 2026, the Cincinnati Bengals and the Atlanta Falcons play at the Santiago Bernabéu at 15:30 Madrid time. Everything for that day is on our <a href={withBase('/nfl-madrid/')}>NFL in Madrid</a> page and in the <a href={withBase('/nfl-sunday-madrid-guide/')}>NFL Sunday hour-by-hour guide</a>.</p>
      <h2>Where we are</h2>
      <p>Dubliners Irish Pub, Calle de Espoz y Mina 7, 28012 Madrid, between Puerta del Sol, Plaza Mayor and the Barrio de las Letras. Metro Sol (lines 1, 2 and 3) or Sevilla (line 2). On Sunday we are open {sun.opens}–{sun.closes}. Come early, and if you are coming with a group, send us a message through <a href={withBase('/contact/#request-information')}>Request information</a>.</p>
      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>What time are the NFL games on Sunday 1 November in Madrid?</strong></dt><dd>Kick-offs are at 19:00, 22:05 and 22:25 Madrid time. The US changes to winter time that day, so the early games start at 19:00, not 18:00 as on 25 October.</dd>
        <dt><strong>Is Monday 2 November a holiday in Madrid?</strong></dt><dd>Yes. Monday 2 November 2026 is a public holiday in the Community of Madrid (BOCM, 24 December 2025), so Sunday night is a long-weekend night.</dd>
        <dt><strong>Do you show the NFL at Dubliners?</strong></dt><dd>Yes, all the NFL games are LIVE on our screens, within our opening hours (Sunday 12:00–02:00).</dd>
        <dt><strong>When is the NFL game in Madrid?</strong></dt><dd>Bengals vs Falcons, Sunday 8 November 2026 at 15:30 Madrid time, at the Santiago Bernabéu. 1 November is the last NFL Sunday before it.</dd>
      </dl>
      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'More NFL at Dubliners',
            items: [
              { href: '/nfl-madrid/', label: 'NFL in Madrid', note: 'Bengals vs Falcons, 8 November' },
              { href: '/nfl-sunday-madrid-guide/', label: 'NFL Sunday guide', note: 'Hour by hour, Sunday 8 November' },
              { href: '/whats-on/', label: "What's On", note: 'Every game we show' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
