---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FanWeekendCtas from '../../components/FanWeekendCtas.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import LinkHub from '../../components/LinkHub.astro';
import SundayFourVenues from '../../components/SundayFourVenues.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/nfl-visitors-sol-atletico-barcelona/';
const PATH_ES = '/es/visitantes-nfl-sol-atletico-barcelona/';
const PATH_LOCAL = '/gather-sol-atletico-barcelona-sunday/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'NFL visitors: how to share Sol on Sunday with Atlético–Barcelona',
  inLanguage: 'en',
  datePublished: '2026-11-07',
  dateModified: '2026-11-07',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'I am in Madrid for NFL Sunday. Does Atlético–Barcelona change the night near Sol?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Sunday 8 November is both an NFL slate and Atlético de Madrid vs FC Barcelona at 21:00 Madrid time. Confirmed LIVE screens for that football match are at Dubliners, Espoz y Mina 7. NFL windows at 15:30, 19:00, 22:05 and 22:25 sit on the same night. Ask which game is on. Not every game is on every screen.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where should an NFL group meet near Puerta del Sol if some people want the 21:00 football?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Four sister bars, two to four minutes from Sol: O’Reilly’s Restaurant Bar (Pasaje de Matheu 4), Dubliners and O’Connell’s (Espoz y Mina 7), Four Corner (Calle de la Victoria 6, from 14:00, sports screens). Dubliners is the confirmed screen for Atlético–Barcelona. Sister bars are meeting points — ask which game is on; we do not list their broadcasts.',
      },
    },
    {
      '@type': 'Question',
      name: 'Will every NFL game still be on at 21:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Kick-offs overlap. Name the team you care about when you sit down. A pub is not a broadcast centre.',
      },
    },
  ],
};
---

<BaseLayout
  title="NFL visitors: share Sol with Atlético–Barcelona Sunday | Dubliners"
  description="Sunday 8 Nov near Sol: NFL visitors and Atlético–Barcelona at 21:00 share four sister bars. Confirmed football screens at Dubliners. Maps, hours, ask which game is on."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="NFL visitors share Sol on Sunday" schema />
      <h1>NFL visitors: how to share Sol on Sunday with Atlético–Barcelona</h1>
      <p class="lead">
        If you flew in for NFL Sunday, 8 November near Puerta del Sol is not only the Madrid Game.
        At <strong>21:00</strong> Atlético de Madrid vs FC Barcelona starts — a LaLiga night in the same
        streets as the 15:30, 19:00, 22:05 and 22:25 NFL windows. Confirmed LIVE football screens:
        Dubliners, Espoz y Mina 7. Four sister doors. Ask which game is on.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Visitantes NFL: cómo compartir Sol con el Atlético–Barcelona</a></p>
      <FanWeekendCtas lang="en" findHref="#four-doors-from-sol" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <div data-show-until={SHOW_UNTIL}>
        <h2>Two crowds, one set of streets</h2>
        <p>
          Visitors here for Bengals–Falcons at the Bernabéu (15:30) often come back to Sol afterwards.
          Locals and travelling football fans arrive for 21:00. That overlap is the point of this page:
          you can keep the group in the same two-minute radius without pretending every screen will stay
          on your NFL game through the football kick-off.
        </p>
        <p>
          This is <strong>not El Clásico</strong> (Real Madrid vs Barcelona). Sunday is Atlético vs Barcelona.
          Dubliners has it confirmed LIVE. Sister bars are meeting points with confirmed hours — and Four Corner
          has sports screens from 14:00 — but we do not invent which match they put on. Ask at each door.
        </p>
        <p>
          Independent Irish pubs. Not an official NFL event. No stadium tickets sold here.
        </p>

        <h2 id="four-doors-from-sol">Walk the four doors from Sol</h2>
        <p>
          Metro Sol (L1, L2, L3) or Sevilla (L2). You do not need a taxi between these rooms.
          A practical loop if the group is mixing NFL and football:
        </p>
        <ol>
          <li>
            <strong>Four Corner — Calle de la Victoria 6.</strong> From Sol walk east along Victoria.
            Sunday 8 Nov this door opens at <strong>14:00 until late</strong> (not 12:00). Sports screens
            are confirmed; listings are not. Hold people here after 15:30 or as overflow when Espoz y Mina is packed.
            <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Four Corner on Maps</a>.
          </li>
          <li>
            <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4.</strong> Covered passage, terrace, food.
            Usual hours 11:30–01:30. A place to eat and pin the meeting point before you pick a screen.
            We do not list its match grid.
            <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">O’Reilly’s on Maps</a>.
          </li>
          <li>
            <strong>Dubliners — Calle de Espoz y Mina 7.</strong> Open Sunday <strong>12:00–02:00</strong>.
            Confirmed LIVE: Bengals–Falcons 15:30 (big screen), NFL from 19:00 then 22:05 and 22:25,
            <strong>Atlético–Barcelona 21:00</strong>. Name the game when you sit down.
            <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">Dubliners on Maps</a>.
          </li>
          <li>
            <strong>O’Connell’s — Espoz y Mina 7</strong> (same street; Maps listing: O’Connell St).
            Sunday 8 Nov from 12:00 (usual Sunday 14:00). Second door on the same block if the group splits.
            Meeting point; we do not list its broadcasts.
            <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">O’Connell’s on Maps</a>.
          </li>
        </ol>

        <h2>Sunday clocks that compete for the same screens</h2>
        <ul>
          <li><strong>15:30</strong> — Bengals vs Falcons (Bernabéu; also LIVE on Dubliners’ big screen)</li>
          <li><strong>19:00</strong> — seven more NFL games, plus RedZone at Dubliners</li>
          <li><strong>21:00</strong> — Atlético vs Barcelona (confirmed LIVE at Dubliners)</li>
          <li><strong>22:05</strong> — Texans at Chargers</li>
          <li><strong>22:25</strong> — three more NFL games</li>
        </ul>
        <p>
          If your group cares about a 19:00 or 22:25 NFL side <em>and</em> someone wants the 21:00 football,
          split across two doors rather than arguing over one TV. Dubliners for the confirmed football screen;
          Four Corner from 14:00 or O’Connell’s on the same street as the overflow meeting point. Still:
          <strong>ask which game is on. Not every game is on every screen.</strong>
        </p>
        <p>
          Kick-off table and team names:
          <a href={withBase('/sunday-sports-sol/')}>Sunday sports in Sol</a>.
          Hour-by-hour NFL:
          <a href={withBase('/nfl-sunday-madrid-guide/')}>NFL Sunday guide</a>.
          The live Atlético–Barcelona cover (do not confuse it with this visitor note):
          <a href={withBase('/atletico-barcelona-sol-8-nov/')}>Atlético–Barcelona near Sol, 21:00</a>.
        </p>
      </div>

      <SundayFourVenues lang="en" />

      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">GET DIRECTIONS</a>
        <a class="btn btn-primary" href={withBase('/4-bars-one-fan-weekend/')}>MEET US NEAR SOL</a>
        <a class="btn btn-secondary" href={withBase('/whats-on/')}>What's On</a>
      </div>

      <p class="small">
        Not an official NFL event. Independent of LaLiga and the clubs. The meeting point is these four bars.
      </p>

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>I am in Madrid for NFL Sunday. Does Atlético–Barcelona change the night near Sol?</strong></dt>
        <dd>Yes. 21:00 football shares the night with NFL windows. Confirmed LIVE football screens: Dubliners. Ask which game is on.</dd>
        <dt><strong>Where should an NFL group meet if some people want the 21:00 football?</strong></dt>
        <dd>Four sister bars two to four minutes from Sol. Dubliners for the confirmed screen. Sister bars: meeting points / sports screens where confirmed — ask; we do not list their games.</dd>
        <dt><strong>Will every NFL game still be on at 21:00?</strong></dt>
        <dd>No. Kick-offs overlap. Name the team. A pub is not a broadcast centre.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Sunday 8 November near Sol',
            until: SHOW_UNTIL,
            items: [
              { href: PATH_LOCAL, label: 'Where local fans gather for Atlético–Barcelona', note: 'Football-first sister page' },
              { href: '/atletico-barcelona-sol-8-nov/', label: 'Atlético–Barcelona near Sol, 21:00', note: 'Live cover' },
              { href: '/sunday-nfl-near-sol-8-nov/', label: 'Sunday NFL near Sol' },
              { href: '/afternoon-evening-nfl-sol-8-nov/', label: 'Afternoon and evening NFL' },
              { href: '/four-corner-opens-sunday-1400/', label: 'Four Corner opens 14:00' },
              { href: '/4-bars-one-fan-weekend/', label: '4 Bars. One Fan Weekend' },
              { href: PATH_ES, label: 'Visitantes NFL: compartir Sol', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
