---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/nfl-weekend-madrid-screens-only/';
const PATH_ES = '/es/fin-semana-nfl-madrid-en-pantalla/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'NFL weekend in Madrid without the stadium — stay on screens near Sol',
  inLanguage: 'en',
  datePublished: '2026-11-07T18:30:00+01:00',
  dateModified: '2026-11-07T18:30:00+01:00',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Can I follow the NFL Madrid weekend without going to the Bernabéu?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Stay in the Sol pocket. Saturday is a meetup and Valencia vs Real Madrid at 21:00 at Dubliners (no NFL Saturday). Sunday Bengals vs Falcons is LIVE on Dubliners’ big screen at 15:30, then more NFL from 19:00.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where do I watch if I am not going to the stadium on Sunday?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Confirmed LIVE NFL screens this Sunday are at Dubliners, Espoz y Mina 7, from 12:00. Four Corner opens 14:00 with sports screens; we do not list its games. Ask which game is on.',
      },
    },
    {
      '@type': 'Question',
      name: 'Do I need to leave Sol between Saturday night and Sunday kick-off?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Dubliners Saturday close is 02:30; Sunday reopen 12:00. O’Reilly’s is daily 11:30–01:30. Four Corner joins Sunday 14:00.',
      },
    },
  ],
};
---

<BaseLayout
  title="NFL weekend in Madrid without the stadium | Dubliners"
  description="Stay near Sol all weekend: tonight 18:00–19:00 meetup, Valencia–RM 21:00 at Dubliners, Sunday screens from 12:00. Four Corner 14:00. No Saturday NFL."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="NFL weekend on screens near Sol" schema />
      <h1>NFL weekend in Madrid without the stadium — stay on screens near Sol</h1>
      <p class="lead">
        You do not need a Bernabéu ticket to spend this weekend with other fans.
        Tonight is the meetup and LaLiga at Dubliners. Sunday the Madrid Game is also on our big screen at 15:30.
        Four sister bars, one pocket. Independent pubs — not an official NFL event.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Fin de semana NFL en Madrid en pantalla, sin estadio</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Maps</a>
        <a class="btn btn-secondary" href={withBase('/4-bars-one-fan-weekend/')}>MEET US NEAR SOL</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Saturday: no NFL, still a fan night</h2>
      <p>
        There is <strong>no official NFL game on Saturday 7 November</strong>. If you are already in Madrid, do not wait until Sunday noon.
        Meetup <strong>18:00–19:00</strong> at O’Reilly’s, Dubliners and O’Connell’s. Then Valencia vs Real Madrid at <strong>21:00, LIVE at Dubliners only</strong>.
        Four Corner stays shut until Sunday.
      </p>

      <h2>Sunday: the game on a screen in Sol</h2>
      <p>
        Bengals vs Falcons is 15:30 Madrid time (9:30 a.m. ET) at the Bernabéu — and LIVE on Dubliners’ big screen if you stay here.
        Dubliners 12:00–02:00. Four Corner from 14:00 until late, with sports screens (no invented listings).
        Evening NFL from 19:00, then 22:05 and 22:25, plus Atlético vs Barcelona at 21:00. Ask which game is on. Not every game on every screen.
      </p>
      <p>
        This page is for people who are <strong>not</strong> going to the stadium. If your group is splitting, the screens stay in these streets either way.
      </p>

      <OriginalFourBars lang="en" when="sunday" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Can I follow the weekend without the Bernabéu?</strong></dt>
        <dd>Yes. Saturday meetup + Valencia 21:00 at Dubliners. Sunday Bengals–Falcons LIVE on our big screen at 15:30.</dd>
        <dt><strong>Where do I watch if I skip the stadium?</strong></dt>
        <dd>Confirmed Sunday NFL screens: Dubliners, Espoz y Mina 7. Four Corner has sports screens from 14:00; we do not list its games.</dd>
        <dt><strong>Do I leave Sol overnight?</strong></dt>
        <dd>No. Saturday close 02:30 at Dubliners, Sunday from 12:00. Four Corner from 14:00.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Stay in Sol',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'Dubliners home' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/meetup-1800-pasaje-matheu-espoz-mina/', label: 'Tonight 18:00–19:00 walking order' },
              { href: '/before-after-bengals-falcons-sol/', label: 'Before and after if you do go to the game' },
              { href: '/nfl-madrid/', label: 'Sunday NFL list at Dubliners' },
              { href: PATH_ES, label: 'En pantalla, sin estadio', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
