import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../components/OriginalFourBars.astro';
import FanWeekendCtas from '../../components/FanWeekendCtas.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/plaza-mayor-arcade-downhill-sol-doors-before-1400/';
const PATH_ES = '/es/plaza-mayor-soportales-cuesta-abajo-puertas-sol-antes-1400/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Plaza Mayor east arcade downhill to the four Sol doors before 14:00',
  inLanguage: 'en',
  datePublished: '2026-11-08T07:00:00+01:00',
  dateModified: '2026-11-08T07:00:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'I am on Plaza Mayor this Sunday morning. Is that a fan venue, and which way to the four bars?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Plaza Mayor is a plaza, not a fan venue. Leave through the east arcade (Calle de la Sal / Calle de Postas), then keep downhill toward the south-east pocket of Sol. Pin Four Corner at Calle de la Victoria 6 for 14:00 (sports screens, not open before). O’Reilly’s is Pasaje de Matheu 4; Dubliners and O’Connell’s are Calle de Espoz y Mina 7. Maps below.',
      },
    },
    {
      '@type': 'Question',
      name: 'How far is Plaza Mayor from Victoria 6, Espoz y Mina 7 and Pasaje de Matheu 4?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'From the east arcade: Espoz y Mina 7 is about 5–7 minutes / 380–450 m; Pasaje de Matheu 4 about 6–8 minutes / 420–500 m; Victoria 6 about 7–8 minutes / 480–560 m. Optional Gran Vía start via Calle de Preciados south is about 11–14 minutes / 750–900 m to the same doors. Do not wait on Victoria 6 before 14:00.',
      },
    },
    {
      '@type': 'Question',
      name: 'It is about 07:00. Can I go to Four Corner now?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Four Corner opens Sunday 8 November from 14:00 until late, with sports screens — about seven hours from 07:00, not before. O’Reilly’s usual from 11:30; Dubliners and O’Connell’s from 12:00. Walk the arcade now, pin the doors, then sit the first sister that is open.',
      },
    },
  ],
};
---

<BaseLayout
  title="Plaza Mayor east arcade downhill to four Sol doors before 14:00 | Dubliners"
  description="Sunday 8 Nov: walk Plaza Mayor’s east arcade downhill to Victoria 6, Espoz y Mina 7 and Pasaje de Matheu 4 before 14:00. Tourist street route, Maps, distances. Plaza Mayor is a plaza, not a fan venue."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Plaza Mayor arcade downhill to the four Sol doors" schema />
      <h1>Plaza Mayor east arcade downhill to the four Sol doors before 14:00</h1>
      <p class="lead">
        Saturday is over. You are not at a hotel checkout, not on a Metro platform, and not landing at Barajas.
        <strong>You are already on Plaza Mayor</strong> — a plaza for photos and coffee, not a fan venue.
        Leave through the east arcade, walk downhill toward the south-east pocket of Sol, and pin the four sister doors before Four Corner opens at 14:00 with sports screens (about seven hours from 07:00; not open before).
        Optional start: Gran Vía, then south on Preciados. Maps below.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Soportales este de Plaza Mayor, cuesta abajo a las cuatro puertas de Sol antes de las 14:00</a></p>
      <FanWeekendCtas lang="en" findHref="/visit/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>This is a tourist street route, not a Sol-square stroll and not a hotel walk</h2>
      <p>
        Other pages already cover walking out from Puerta del Sol itself, a Sol hotel’s first Sunday street,
        the first Metro into the station, and a late Barajas taxi.
        This page is only for the person <strong>already standing under Plaza Mayor’s soportales</strong>
        (or coming south from Gran Vía on Calle de Preciados) who needs street names, metres, and which door to pin before 14:00.
        Do not re-promote Saturday 18:00–19:00 or Valencia–Real Madrid as still on.
      </p>

      <h2>East arcade, then downhill — street names</h2>
      <p>
        Leave Plaza Mayor through the <strong>east arcade</strong> — Calle de la Sal into Calle de Postas, toward Plaza de Pontejos.
        That heading is downhill toward Sol’s south-west edge. Do not stop on the square.
        Continue south-east: Calle de Carretas, then Calle de Espoz y Mina and Calle de la Victoria.
        Pasaje de Matheu is the covered cut-through between those two.
      </p>
      <ul>
        <li>
          <strong>From the east arcade.</strong>
          Espoz y Mina 7: <strong>5–7 min / 380–450 m</strong>.
          Pasaje de Matheu 4: <strong>6–8 min / 420–500 m</strong>.
          Victoria 6: <strong>7–8 min / 480–560 m</strong>.
        </li>
        <li>
          <strong>Optional Gran Vía start.</strong>
          Walk <strong>south</strong> on Calle de Preciados (pedestrian) to Sol, then the same south-east hop.
          About <strong>11–14 min / 750–900 m</strong> to the doors. Gran Vía is a shopping street here, not a fan strip.
        </li>
      </ul>
      <p>
        From about 07:00 it is <strong>about seven hours</strong> until Four Corner opens at 14:00.
        Pin Victoria 6 for that hour. Do not camp a closed door on Calle de la Victoria before then.
      </p>

      <h2>Before 14:00 — which door is even open</h2>
      <p>
        Four Corner opens <strong>Sunday 8 November from 14:00 until late, with sports screens</strong>.
        Not before 14:00. We do not list which game is on there — ask at the door.
        O’Reilly’s usual from 11:30 (Pasaje de Matheu 4). Dubliners and O’Connell’s from 12:00 (Espoz y Mina 7).
        Walk the arcade now; sit the first sister that is open; be on Victoria for the 14:00 open.
        Premier League from 15:00, NFL afternoon/evening, and Atlético–Barcelona 21:00 sit on the same streets after that — coordinate, do not substitute.
        Named listings: Dubliners <a href={withBase('/whats-on/')}>What’s On</a> only.
      </p>

      <h2>Arcade to three streets — addresses</h2>
      <ol>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid</strong> (pin for 14:00; sports screens; not open before).
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Covered passage off Espoz y Mina. Usual from 11:30. About 6–8 min from the east arcade.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          About 5–7 min from the east arcade. Sunday from 12:00. Named screens on What’s On — ask which game is on.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (Maps listing: O’Connell St).
          Same street number as Dubliners, different door. Sunday 8 Nov from 12:00 (usual Sunday 14:00). Meeting point; we do not invent its board.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
      </ol>

      <OriginalFourBars lang="en" when="sunday" findHref="/visit/" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>On Plaza Mayor this morning. Fan venue? Which way?</strong></dt>
        <dd>Plaza Mayor is a plaza, not a fan venue. East arcade (Calle de la Sal / Postas), downhill to the south-east Sol pocket. Pin Victoria 6 for 14:00. Then Matheu 4 and Espoz y Mina 7 twice.</dd>
        <dt><strong>How far from Plaza Mayor to the four doors?</strong></dt>
        <dd>Espoz y Mina 7: 5–7 min / 380–450 m. Matheu 4: 6–8 min / 420–500 m. Victoria 6: 7–8 min / 480–560 m. Gran Vía via Preciados: 11–14 min / 750–900 m.</dd>
        <dt><strong>It is ~07:00. Is Four Corner open?</strong></dt>
        <dd>No. From 14:00, sports screens — about seven hours from now. O’Reilly’s from 11:30; Dubliners and O’Connell’s from 12:00. Do not wait on Victoria 6 before 14:00.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'From Plaza Mayor’s east arcade this Sunday',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'FIND US — Dubliners home' },
              { href: '/visit/', label: 'GET DIRECTIONS — visit / hours' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/espoz-mina-7-two-doors-split-premier-then-nfl/', label: 'Same number, two doors: split Premier 15:00 vs NFL later' },
              { href: '/four-corner-opens-sunday-1400/', label: 'Four Corner Sunday 14:00' },
              { href: PATH_ES, label: 'Soportales de Plaza Mayor cuesta abajo a las cuatro puertas', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
