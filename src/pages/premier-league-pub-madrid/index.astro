---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, withBase } from '../../site';

const title = 'Premier League Pub Madrid | Watch PL near Sol — Dubliners';
const description =
  'Premier League pub in Madrid near Puerta del Sol. Watch English football on indoor screens. Walk-in Irish pub, Espoz y Mina 7.';
---

<BaseLayout title={title} description={description} path="/premier-league-pub-madrid/" ogImage="/images/screens-sports.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Premier League pub Madrid" />
        <h1>Premier League pub Madrid — near Sol</h1>
        <p class="lead">
          UK and Irish travellers, expats and weekend visitors: Dubliners is an English-friendly Irish pub
          with indoor screens on Espoz y Mina 7. Premier League when it’s on — walk in early for the big ones.
        </p>
        <CtaRow />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 45vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/screens-sports.jpg')} alt="Premier League nights on screens at Dubliners Madrid" width="1400" height="788" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>Where</h3>
          <p>Two minutes from Puerta del Sol — perfect if your hotel is already in centro.</p>
        </article>
        <article class="card">
          <h3>How</h3>
          <p>Metro Sol / Sevilla, then walk. No table booking.</p>
        </article>
        <article class="card">
          <h3>What’s on</h3>
          <p><a href={withBase('/whats-on/')}>This week’s list</a> · <a href={withBase('/contact/')}>Contact</a></p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>English football in a Sol pub</h2>
      <p>
        Plan your Saturday or midweek around kick-off, then make Dubliners your watch spot.
        Related: <a href={withBase('/watch-football-madrid/')}>watch football Madrid</a>,
        <a href={withBase('/champions-league-bar-madrid/')}>Champions League</a>,
        <a href={withBase('/sports-bar-madrid/')}>sports bar</a>.
      </p>
      <div class="faq">
        <details>
          <summary>Do I need to book?</summary>
          <p>No — walk-in only. Arrive early for big games.</p>
        </details>
        <details>
          <summary>Address</summary>
          <p>{SITE.address}, {SITE.postal}</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
