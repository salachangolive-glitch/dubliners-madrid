---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import FanWeekendCtas from '../../components/FanWeekendCtas.astro';
import FourBarsMeet from '../../components/FourBarsMeet.astro';
import LinkHub from '../../components/LinkHub.astro';
import MapEmbed from '../../components/MapEmbed.astro';
import { SITE, withBase } from '../../site';
import { isFanWeekendLive } from '../../data/fourBars';

const fanWeekend = isFanWeekendLive();
const title = 'Premier League pub Madrid | Irish sports bar near Puerta del Sol';
const description =
  'Premier League pub Madrid: watch English football at an Irish pub and sports bar just off Puerta del Sol. Espoz y Mina 7. Named listings on What’s On. GET DIRECTIONS.';
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Is this a Premier League pub in Madrid?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Dubliners is a Premier League pub in Madrid: an Irish pub and sports bar just off Puerta del Sol. Named listings are on What’s On.',
      },
    },
    {
      '@type': 'Question',
      name: 'How do I get here?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Espoz y Mina 7, 28012 Madrid. Metro Sol (L1, L2, L3) or Sevilla (L2). Walk from the plaza toward Carrera de San Jerónimo and look for the green neon. GET DIRECTIONS uses Google Maps CID 4384002297188950803.',
      },
    },
    {
      '@type': 'Question',
      name: 'Where are named Premier League listings?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Only confirmed English kick-offs on What’s On in Madrid time. If the list is empty, ask at the bar which screen is on.',
      },
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  path="/premier-league-pub-madrid/"
  hreflang={{ en: '/premier-league-pub-madrid/', es: '/es/premier-league-pub-madrid/' }}
  ogImage="/images/screens-sports.jpg"
  extraJsonLd={[faqLd]}
>
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Premier League pub Madrid" schema />
        <h1>Premier League pub Madrid near Puerta del Sol</h1>
        <p class="lead">
          Dubliners is a Premier League pub in Madrid and an Irish sports bar on Espoz y Mina 7 — a short walk from Puerta del Sol.
          English football goes on the indoor screens when it is showing. Named kick-offs live on
          <a href={withBase('/whats-on/')}>What’s On</a>.
        </p>
        {fanWeekend ? <FanWeekendCtas lang="en" /> : <CtaRow showWednesday={false} />}
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 45vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/screens-sports.jpg')} alt="Premier League on screens at Dubliners" width="1400" height="788" loading="eager" />
      </picture>
    </div>
  </section>

  {fanWeekend && <FourBarsMeet lang="en" />}

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>Where</h3>
          <p>Irish pub just off Puerta del Sol — Espoz y Mina 7. Metro Sol or Sevilla.</p>
        </article>
        <article class="card">
          <h3>How</h3>
          <p>Walk from the plaza toward Carrera de San Jerónimo. Look for the green neon.</p>
        </article>
        <article class="card">
          <h3>What’s on</h3>
          <p>Named English games: <a href={withBase('/whats-on/')}>this week’s list</a>. Ask which screen.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Premier League pub Madrid</h2>
      <p>
        English football in the centre: Saturday and Sunday Premier League on the screens when confirmed,
        with an international crowd around Sol. We do not invent boards — named listings stay on What’s On.
      </p>
      <p>
        The same sports bar also carries NFL and LaLiga when they sit alongside. Coordinate; do not substitute.
        This week’s named English kick-offs: <a href={withBase('/whats-on/')}>What’s On</a>.
      </p>

      <h2>Sunday English football near Sol</h2>
      <p>
        Saturday and Sunday English football go on the indoor screens when confirmed. Ask which screen if two kick-offs clash.
        Named listings stay on <a href={withBase('/whats-on/')}>What’s On</a> — we do not invent a board here.
      </p>

      <h2>Irish pub and sports bar near Sol</h2>
      <p>
        Plan kick-off around Sol, then make this Irish bar in Madrid your watch spot.
        Related:
        <a href={withBase('/whats-on/')}>What’s On</a>,
        <a href={withBase('/sports-bar-madrid/')}>sports bar Madrid</a>,
        <a href={withBase('/nfl-madrid/')}>NFL bar Madrid</a>,
        <a href={withBase('/champions-league-bar-madrid/')}>Champions League</a>.
      </p>

      <h2 id="how-to-get">How to get here</h2>
      <p>
        <strong>NAP:</strong> Dubliners · <strong>{SITE.address}</strong> · {SITE.postal} ·
        <a href="https://dublinersmadrid.es/premier-league-pub-madrid/">dublinersmadrid.es</a>.
        Metro Sol (L1, L2, L3) or Sevilla (L2). From Puerta del Sol, walk Calle de Espoz y Mina to the green neon.
        Walking notes: <a href={withBase('/visit/')}>FIND US</a>.
      </p>

      <div class="map-frame">
        <MapEmbed lang="en" title="Map to Dubliners — Premier League pub Madrid" />
      </div>
      <p class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">GET DIRECTIONS</a>
        <a class="btn btn-secondary" href={withBase('/visit/')}>FIND US</a>
      </p>

      <div class="faq">
        <details>
          <summary>Is this a Premier League pub in Madrid?</summary>
          <p>
            Yes — Dubliners is a Premier League pub Madrid: an Irish pub and sports bar just off Puerta del Sol.
            Named listings: <a href={withBase('/whats-on/')}>What’s On</a>.
          </p>
        </details>
        <details>
          <summary>How do I get directions?</summary>
          <p>
            {SITE.address}, {SITE.postal}. Use
            <a href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank" data-track-event="directions_click">GET DIRECTIONS</a>
            (CID 4384002297188950803) or <a href={withBase('/visit/')}>FIND US</a>.
          </p>
        </details>
        <details>
          <summary>Are kick-offs invented on this page?</summary>
          <p>No. Named fixtures only on <a href={withBase('/whats-on/')}>What’s On</a> in Madrid time.</p>
        </details>
        <details>
          <summary>Groups or questions?</summary>
          <p><a href={withBase('/contact/#request-information')}>Request information</a> through our contact form.</p>
        </details>
      </div>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Related hubs',
            items: [
              { href: '/whats-on/', label: 'What’s On', note: 'Named Premier kick-offs only' },
              { href: '/sports-bar-madrid/', label: 'Sports bar Madrid', note: 'Broader live sport near Sol' },
              { href: '/champions-league-bar-madrid/', label: 'Champions League nights' },
              { href: '/visit/', label: 'Visit', note: 'GET DIRECTIONS, Metro Sol' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
