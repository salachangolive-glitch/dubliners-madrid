---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE, withBase } from '../../site';

const title = 'Privacy note | Dubliners Madrid';
const description = 'How Dubliners Madrid uses contact-form details. Short privacy note for website enquiries.';
---

<BaseLayout title={title} description={description} path="/privacy/" ogImage="/images/facade.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Privacy" />
      <h1>Privacy note</h1>
      <p class="lead">How we handle details you send through the website contact form.</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Who we are</h2>
      <p>
        This website is for <strong>Dubliners</strong>, an Irish pub at {SITE.address}, {SITE.postal}.
      </p>
      <p class="contact-note">
        Full legal entity name, tax ID (CIF/NIF), and registered office for privacy notices:
        <strong>PENDING INTERNAL</strong> — not published until confirmed by the owner.
      </p>

      <h2>What we collect via the contact form</h2>
      <ul>
        <li>Name</li>
        <li>Email address</li>
        <li>Reason for contact</li>
        <li>Message content</li>
      </ul>
      <p>We do not ask for payment card details on this form.</p>

      <h2>Why we use it</h2>
      <p>Only to read and reply to your enquiry about Dubliners (information, groups, sports nights, events, or other questions you raise).</p>

      <h2>Where messages go</h2>
      <p>
        Messages are delivered to the Dubliners operations mailbox configured for this venue.
        We do not publish that internal address on the website.
      </p>

      <h2>How long we keep it</h2>
      <p>Enquiry emails are kept only as long as needed to handle your request and ordinary follow-up, then deleted or archived under normal business practice.</p>

      <h2>Your rights</h2>
      <p>
        Under applicable EU/Spanish data rules you may ask to access, correct, or delete personal data in an enquiry,
        or object to processing, via the <a href={withBase('/contact/')}>contact form</a> when it is active,
        or through Instagram ({SITE.instagramHandle}).
      </p>
      <p>
        You may also lodge a complaint with the Spanish AEPD (<a href="https://www.aepd.es" rel="noopener noreferrer" target="_blank">aepd.es</a>).
      </p>

      <h2>Cookies</h2>
      <p>This static preview site does not set marketing cookies for the contact form. If analytics are added later, this note will be updated before activation.</p>

      <p><a href={withBase('/contact/')}>Back to Contact</a></p>
    </div>
  </section>
</BaseLayout>
