---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumb from '../../../components/Breadcrumb.astro';
import { SITE, withBase, absUrl } from '../../../site';
import { OPENING_HOURS } from '../../../data/hours';
import { RUGBY_FINALS_GUIDE_EN, RUGBY_FINALS_WEEKEND } from '../../../data/rugby-nations-finals-2026';

const PATH = '/rugby-nations-finals-weekend-madrid/france-south-africa-final-sunday-plan/';
const PATH_ES = '/es/rugby-nations-finals-fin-de-semana-sol/final-francia-sudafrica-domingo-plan/';
const mapsCta =
  'https://www.google.com/maps/dir/?api=1&destination=Dubliners+Madrid&destination_place_id=ChIJLdKNhYAoQg0RE6Nxotwa1zw';
const sun = OPENING_HOURS.find((d) => d.day === 'Sunday')!;
const sunDay = RUGBY_FINALS_WEEKEND.find((d) => d.dateKey === '2026-11-29')!;

const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'France v South Africa final on Sunday near Sol: your plan for the rugby weekend',
  datePublished: '2026-11-26',
  inLanguage: 'en',
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub' },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  mainEntityOfPage: absUrl(PATH),
};
---

<BaseLayout
  title={'France v South Africa Final Sunday near Sol | Dubliners'}
  description={'France v South Africa final, Sunday 29 November, 17:40 Madrid time, LIVE on our screens at Dubliners, less than a minute from Sol. Scotland v Argentina at 14:10 — your Sunday plan near Sol.'}
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={articleLd}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current={'France v South Africa: Sunday final plan'} schema />
      <h1>France v South Africa final on Sunday near Sol: your plan for the rugby weekend</h1>
      <p class="small">Guide · 26 November 2026 · three days to the final</p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={mapsCta} rel="noopener noreferrer" target="_blank">Get directions</a>
        <a class="btn btn-primary" href={withBase(RUGBY_FINALS_GUIDE_EN)}>Full rugby weekend</a>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p>
        Sunday <strong>29 November</strong> closes the Nations Championship finals weekend with the <strong>France v South Africa final at 17:40 Madrid time</strong>, LIVE on our screens. Dubliners, {SITE.address}, is <strong>less than a minute from Sol</strong> — meeting point for French, South African and every other visiting nation that has been in Madrid all weekend.
      </p>

      <h2>Sunday in Madrid time</h2>
      <ul>
        {sunDay.matches.map((m) => (
          <li>
            <strong>{m.time}</strong> — {m.en}
            {m.final && ' — final'}
          </li>
        ))}
      </ul>
      <p class="small">Kick-offs from the World Rugby match centre and the Allianz Stadium Twickenham programme, converted to Madrid time. We do not name a TV channel.</p>

      <h2>From Scotland v Argentina to the final</h2>
      <p>
        <strong>Scotland v Argentina</strong> at <strong>14:10</strong> warms up the afternoon; the <strong>France v South Africa final</strong> follows at <strong>17:40</strong>. On Sunday we are open {sun.opens}–{sun.closes}. Come for the earlier Test and stay for the trophy match if you want one long rugby afternoon.
      </p>

      <h2>Meeting point for French and South African fans</h2>
      <p>
        Supporters français et sud-africains : rendez-vous au néon vert du numéro 7 — English at the bar, cold beer, and every screen on the final. Welsh, English, Irish, Scottish, Italian, Australian, Japanese, Fijian, Argentine and New Zealand fans who have been with us since Friday are welcome too.
      </p>

      <h2>Earlier in the weekend</h2>
      <p>
        Saturday’s headline is <a href={withBase('/rugby-nations-finals-weekend-madrid/england-new-zealand-saturday-plan/')}>England v New Zealand at 17:40</a>. Friday night was <a href={withBase('/rugby-nations-finals-weekend-madrid/ireland-australia-friday-night-plan/')}>Ireland v Australia</a>. All six Tests on one hub: <a href={withBase(RUGBY_FINALS_GUIDE_EN)}>Nations Championship finals weekend near Sol</a>.
      </p>

      <h2>How to get here from Sol</h2>
      <p>
        Metro <strong>Sol</strong> (lines 1, 2 and 3), Metro Sevilla (line 2) or Cercanías Sol. Open the route on your phone with <a href={mapsCta} rel="noopener noreferrer" target="_blank">Get directions</a>.
      </p>

      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={mapsCta} rel="noopener noreferrer" target="_blank">Get directions</a>
      </div>

      <p>En español: <a href={withBase(PATH_ES)} hreflang="es">Final Francia–Sudáfrica el domingo junto a Sol</a>.</p>
      <p class="small">Dubliners is an independent pub, not affiliated with World Rugby or the teams.</p>
    </div>
  </section>
</BaseLayout>