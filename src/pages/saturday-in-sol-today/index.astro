---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

// Saturday 7 Nov: find the three bars open today from Sol. Four Corner = Sunday 14:00 only.
const path = '/saturday-in-sol-today/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Saturday in Sol today: O’Reilly’s, Dubliners, O’Connell’s',
  inLanguage: 'en',
  datePublished: '2026-11-07T15:00:00+01:00',
  dateModified: '2026-11-07T16:15:00+01:00',
  image: [absUrl('/images/facade.jpg')],
  mainEntityOfPage: absUrl(path),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'I am at Puerta del Sol now. Where do I walk?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "South-east of Sol: O'Reilly's Restaurant Bar, Pasaje de Matheu 4 (from 11:30). Dubliners and O'Connell's share Calle de Espoz y Mina 7 (Dubliners from 12:00, O'Connell's usual Saturday from 15:00). Four Corner on Calle de la Victoria 6 is Sunday from 14:00.",
      },
    },
    {
      '@type': 'Question',
      name: 'Is there live NFL on Saturday?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. There is no official NFL game today. Sunday 8 November is Bengals vs Falcons at 15:30.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is confirmed on Dubliners screens tonight?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Valencia vs Real Madrid at 21:00 Madrid time is confirmed LIVE at Dubliners only. We do not list that match for the other bars.',
      },
    },
  ],
};
---

<BaseLayout
  title="Saturday in Sol today: O’Reilly’s, Dubliners, O’Connell’s | Dubliners"
  description="NFL fans in Madrid this Saturday: walk from Sol to O'Reilly's, Dubliners and O'Connell's. No NFL game today. Four Corner Sunday from 14:00. Maps."
  path={path}
  lang="en"
  hreflang={{ en: path, es: '/es/sabado-en-sol-hoy/' }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Saturday in Sol today" schema />
      <h1>Saturday in Sol today: O’Reilly’s, Dubliners, O’Connell’s</h1>
      <p class="lead">
        NFL fans in Madrid this Saturday — you are already in the centre.
        <strong>No official NFL game today.</strong> Walk south-east of Puerta del Sol to the three sister bars with Saturday hours.
        Meetup window <strong>18:00–19:00</strong> when all three are open.
      </p>
      <p class="small">Independent pubs. Not an official NFL event.</p>
      <p class="small">En español: <a href={withBase('/es/sabado-en-sol-hoy/')} hreflang="es" lang="es">Sábado en Sol hoy: O’Reilly’s, Dubliners, O’Connell’s</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's on Maps</a>
        <a class="btn btn-secondary" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Maps</a>
        <a class="btn btn-secondary" data-track-event="directions_click" href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell's on Maps</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>From Puerta del Sol, this afternoon</h2>
      <p>
        Look south-east, toward Plaza de Santa Ana, not Gran Vía.
        Pasaje de Matheu and Calle de Espoz y Mina sit in that pocket.
        One meeting point for the international crowd already here — screens, afternoon and evening — before Sunday.
      </p>

      <h2>Tonight 18:00–19:00</h2>
      <p>
        From 18:00 all three Saturday rooms overlap: O’Reilly’s (open since 11:30), Dubliners (since 12:00) and O’Connell’s (since 15:00).
        Meet in that hour, then stay on for Valencia vs Real Madrid at 21:00 at Dubliners.
        Four Corner is Sunday from 14:00, with sports screens — not tonight.
      </p>

      <h2>Open today</h2>

      <h3>O'Reilly's Restaurant Bar</h3>
      <p>
        Pasaje de Matheu 4, 28012 Madrid. Restaurant-bar with terrace. First stop if you are out from late morning.<br />
        Usual hours: daily 11:30–01:30.<br />
        <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's on Google Maps</a>
      </p>

      <h3>Dubliners</h3>
      <p>
        Calle de Espoz y Mina 7, 28012 Madrid. Irish pub. Saturday <strong>12:00–02:30</strong>.
        Screens this afternoon and evening. No live NFL today.
        Valencia vs Real Madrid at 21:00 is confirmed on these screens only.<br />
        <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Google Maps</a>
      </p>

      <h3>O'Connell's</h3>
      <p>
        Calle de Espoz y Mina 7, 28012 Madrid — same street as Dubliners (Maps: O'Connell St).<br />
        Usual Saturday hours: 15:00–03:30.<br />
        <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell's on Google Maps</a>
      </p>

      <h2>Four Corner — Sunday 8 November from 14:00</h2>
      <p>
        Calle de la Victoria 6, 28012 Madrid. Same cluster, different day.
        Advertise from Saturday: <strong>Sunday from 14:00 until late</strong>, with sports screens. No Saturday hours and no match list here.
        <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Four Corner on Google Maps</a>
      </p>

      <p>
        Walk now:
        <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's</a>
        · <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners</a>
        · <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell's</a>
        · <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Four Corner (Sunday 14:00)</a>
      </p>

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>I am at Sol now. Where do I walk?</strong></dt>
        <dd>South-east: O'Reilly's (Pasaje de Matheu 4), Dubliners and O'Connell's (Espoz y Mina 7). Four Corner is Sunday from 14:00.</dd>
        <dt><strong>Is there live NFL on Saturday?</strong></dt>
        <dd>No. Sunday 15:30 is Bengals vs Falcons.</dd>
        <dt><strong>What is confirmed on Dubliners screens tonight?</strong></dt>
        <dd>Valencia vs Real Madrid at 21:00, Dubliners only.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Saturday near Sol',
            items: [
              { href: '/nfl-fans-madrid-this-saturday/', label: 'NFL fans in Madrid this Saturday', note: 'Meetup before Sunday', until: SHOW_UNTIL },
              { href: '/saturday-night-sol-valencia-real-madrid/', label: 'Saturday night: Valencia–Real Madrid', note: '21:00 at Dubliners', until: SHOW_UNTIL },
              { href: '/4-bars-one-fan-weekend/', label: '4 Bars. One Fan Weekend' },
              { href: '/es/sabado-en-sol-hoy/', label: 'Sábado en Sol hoy', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
