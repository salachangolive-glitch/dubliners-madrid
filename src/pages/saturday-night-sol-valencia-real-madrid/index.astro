---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';
import { FIXTURES } from '../../data/fixtures';

// Saturday night capture. Kick-off verified 21:00 Madrid (realmadrid.com 12 Oct + 6 Nov; ESPN 20:00 UK).
const path = '/saturday-night-sol-valencia-real-madrid/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const valencia = FIXTURES.find((f) => f.dateKey === '2026-11-07' && f.teams === 'Valencia vs Real Madrid');
if (!valencia) throw new Error('Saturday night capture: Valencia vs Real Madrid row missing from fixtures');
const kickoff = valencia.madridTime;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: `Saturday night in Sol: Valencia vs Real Madrid at ${kickoff}`,
  inLanguage: 'en',
  datePublished: '2026-11-07T15:00:00+01:00',
  dateModified: '2026-11-07T15:00:00+01:00',
  image: [absUrl('/images/facade.jpg')],
  mainEntityOfPage: absUrl(path),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What time is Valencia vs Real Madrid tonight?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `Saturday 7 November 2026, ${kickoff} Madrid time, at Mestalla. LIVE at Dubliners. Kick-off confirmed by Real Madrid (21:00) and ESPN (20:00 UK / GMT).`,
      },
    },
    {
      '@type': 'Question',
      name: 'Where do I watch it near Sol?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Dubliners, Calle de Espoz y Mina 7, shows it LIVE. The other three sister bars — O'Reilly's, O'Connell St and Four Corner — sit in the same streets if you want to meet first or stay after. We do not promise the match on every screen.",
      },
    },
    {
      '@type': 'Question',
      name: 'How late is Saturday night in this cluster?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: "Dubliners Saturday 12:00–02:30. O'Reilly's usual hours 11:30–01:30. O'Connell St usual Saturday 15:00–03:30. Four Corner is advertised from today for Sunday from 14:00.",
      },
    },
  ],
};
---

<BaseLayout
  title={`Saturday night in Sol: Valencia–Real Madrid ${kickoff} | Dubliners`}
  description={`Valencia vs Real Madrid kicks off at ${kickoff} Madrid time on Saturday 7 Nov. Watch it LIVE at Dubliners, then stay in the four-bar cluster near Sol.`}
  path={path}
  lang="en"
  hreflang={{ en: path, es: '/es/sabado-noche-sol-valencia-real-madrid/' }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Saturday night: Valencia–Real Madrid" schema />
      <h1>Saturday night in Sol: Valencia vs Real Madrid at {kickoff}</h1>
      <p class="lead">
        Kick-off is <strong>{kickoff} in Madrid</strong> tonight, Saturday 7 November 2026.
        Dubliners shows it LIVE. The other three sister bars sit on the same streets if you want to meet first or stay after.
      </p>
      <p class="small">Independent pubs. Not an official NFL event — this is Saturday night football in Sol.</p>
      <p class="small">En español: <a href={withBase('/es/sabado-noche-sol-valencia-real-madrid/')} hreflang="es" lang="es">Sábado noche en Sol: Valencia–Real Madrid a las {kickoff}</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Maps — be here for {kickoff}</a>
        <a class="btn btn-secondary" href={withBase('/whats-on/')}>What's On</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Kick-off, verified</h2>
      <p>
        Valencia vs Real Madrid, LaLiga matchday 12, played at Mestalla.
        Time: <strong>{kickoff} Europe/Madrid</strong>. Real Madrid published 21:00 on 12 October and again on 6 November
        (“Hoy, 21:00 h”; Orange TV and DAZN). ESPN lists 20:00 UK, which is {kickoff} in Madrid on winter time.
      </p>
      <p>
        At Dubliners the match is LIVE. We do not invent a listing for O'Reilly's, O'Connell St or Four Corner —
        meet in the cluster, watch it here.
      </p>

      <h2>The four bars for Saturday night</h2>

      <h3>Dubliners</h3>
      <p>
        Calle de Espoz y Mina 7, 28012 Madrid.<br />
        Saturday 12:00–02:30. Valencia vs Real Madrid LIVE at {kickoff}. Come before kick-off if you want a seat in view of a screen.<br />
        <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Google Maps</a>
      </p>

      <h3>O'Reilly's Restaurant Bar</h3>
      <p>
        Pasaje de Matheu 4, 28012 Madrid.<br />
        One passage over from Espoz y Mina. Usual hours on the live four-bar page: 11:30–01:30. Eat and meet, then walk 60 seconds to Dubliners for the match if you need the screens we have confirmed.<br />
        <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's on Google Maps</a>
      </p>

      <h3>O'Connell St</h3>
      <p>
        Calle de Espoz y Mina 7, 28012 Madrid — same street as Dubliners.<br />
        Usual Saturday hours on the live four-bar page: 15:00–03:30. Another door on the same block for the night.<br />
        <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell St on Google Maps</a>
      </p>

      <h3>Four Corner</h3>
      <p>
        Calle de la Victoria 6, 28012 Madrid.<br />
        Same pocket as the other three. Advertised from today: Sunday 8 November from 14:00 until late.
        No Saturday hours and no match listing for Four Corner on this page.<br />
        <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Four Corner on Google Maps</a>
      </p>

      <h2>After the whistle</h2>
      <p>
        Dubliners stays open until 02:30 tonight. Sunday is a different day: Dubliners from 12:00, Four Corner from 14:00,
        Bengals vs Falcons at 15:30 on the Dubliners big screen. Hour-by-hour Sunday lives on the
        <a href={withBase('/nfl-sunday-madrid-guide/')}>NFL Sunday guide</a> — this page is Saturday night.
      </p>

      <p>
        Open Maps:
        <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners</a>
        · <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">O'Reilly's</a>
        · <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">O'Connell St</a>
        · <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Four Corner</a>
      </p>

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>What time is Valencia vs Real Madrid tonight?</strong></dt>
        <dd>{kickoff} Madrid time, Saturday 7 November. LIVE at Dubliners.</dd>
        <dt><strong>Where do I watch it near Sol?</strong></dt>
        <dd>Dubliners, Espoz y Mina 7. The other three sister bars are in the same streets for meeting and staying after.</dd>
        <dt><strong>How late is Saturday night?</strong></dt>
        <dd>Dubliners until 02:30. Four Corner: Sunday from 14:00.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Saturday in Sol',
            items: [
              { href: '/saturday-in-sol-today/', label: 'Saturday in Sol today', note: 'Find the four bars this afternoon', until: SHOW_UNTIL },
              { href: '/after-saturday-nfl-fan-events-sol/', label: 'After Saturday fan events', note: 'Walk from Plaza de España / San Martín', until: SHOW_UNTIL },
              { href: '/4-bars-one-fan-weekend/', label: '4 Bars. One Fan Weekend' },
              { href: '/whats-on/', label: "What's On" },
              { href: '/es/sabado-noche-sol-valencia-real-madrid/', label: 'Sábado noche: Valencia–Real Madrid', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
