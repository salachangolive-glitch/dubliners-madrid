---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/sol-metro-2100-which-saturday-door/';
const PATH_ES = '/es/metro-sol-2100-que-puerta-sabado/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Stepping off Metro Sol at 21:00: which Saturday door, and how far',
  inLanguage: 'en',
  datePublished: '2026-11-07T21:00:00+01:00',
  dateModified: '2026-11-07T21:00:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'I am coming up the Metro Sol stairs at 21:00. Which of the three Saturday doors?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Use a south-east plaza exit (Carrera de San Jerónimo / Calle de Alcalá side), not Gran Vía. Valencia vs Real Madrid 21:00 is LIVE at Dubliners only, Calle de Espoz y Mina 7, about three minutes on foot. O’Reilly’s (Pasaje de Matheu 4, ~two minutes) and O’Connell’s (same Espoz y Mina 7, ~three minutes) are also open Saturday. Four Corner is not tonight.',
      },
    },
    {
      '@type': 'Question',
      name: 'How far is each Saturday door from Metro Sol?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'O’Reilly’s, Pasaje de Matheu 4: about 2 minutes / 180 m. Dubliners and O’Connell’s, Espoz y Mina 7: about 3 minutes / 250 m. Four Corner, Victoria 6, is the same pocket (~3 minutes) but opens Sunday 8 November from 14:00 with sports screens — do not walk there for 21:00 tonight.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is there a Saturday NFL screen if I arrive from Metro Sol at 21:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. There is no official NFL game on Saturday 7 November. The named 21:00 listing is Valencia vs Real Madrid at Dubliners. The next NFL screen is Sunday 15:30.',
      },
    },
  ],
};
---

<BaseLayout
  title="Off Metro Sol at 21:00: which Saturday door | Dubliners"
  description="Arriving at Metro Sol at 21:00: three Saturday doors, walking minutes, Maps. Valencia–RM LIVE at Dubliners only. Four Corner Sunday 14:00. FIND US / GET DIRECTIONS."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Off Metro Sol at 21:00" schema />
      <h1>Stepping off Metro Sol at 21:00: which Saturday door, and how far</h1>
      <p class="lead">
        Kick-off is now. You are on the plaza, not on Espoz y Mina yet.
        Three Saturday doors sit south-east of Metro Sol (L1, L2, L3) — not Gran Vía.
        <strong>Valencia vs Real Madrid 21:00 is LIVE at Dubliners only.</strong>
        No official NFL tonight. Four Corner stays shut until Sunday 14:00.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Bajas en Metro Sol a las 21:00: qué puerta del sábado</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walk to Dubliners</a>
        <a class="btn btn-secondary" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Maps</a>
        <a class="btn btn-secondary" href={withBase('/4-bars-one-fan-weekend/')}>MEET US NEAR SOL</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>This is a 21:00 station exit, not a plaza tour</h2>
      <p>
        Other pages cover the 18:00–19:00 meetup, the Valencia broadcast itself, and the general Sol-to-bars walk.
        This page is only the minute you leave the Metro Sol ticket hall at 21:00: which of the three Saturday pins,
        how many minutes, which Maps CID. Skip the Gran Vía and Plaza Mayor exits. Come up toward
        Carrera de San Jerónimo or the east side of the square (Calle de Alcalá), then turn into the small streets.
      </p>

      <h2>Three open doors from the stairs — minutes, not a taxi</h2>
      <ol>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4.</strong>
          About <strong>2 minutes / 180 m</strong> from the south-east corner of the plaza.
          Terrace if the Dubliners door is already full and you need a pint first. Saturday until 01:30.
          Not the named Valencia listing.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7.</strong>
          About <strong>3 minutes / 250 m</strong>. Same pocket, next street.
          If you timed the Metro for 21:00, this is the named door: Valencia vs Real Madrid LIVE here only.
          Saturday until 02:30. Come in even if the whistle has gone — screens stay up.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7</strong> (Maps listing: O’Connell St).
          Same three-minute walk, same street number as Dubliners, different door.
          Saturday from 15:00 until 03:30. Meeting point; we do not copy Dubliners’ 21:00 listing onto this pin.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
      </ol>
      <p>
        <strong>Four Corner, Calle de la Victoria 6</strong> is also ~3 minutes from the same exits —
        and it is <strong>not a Saturday door</strong>. Sunday 8 November from 14:00 until late, sports screens.
        Do not spend 21:00 walking there tonight.
        {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Pin it for Sunday</a>
        {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Walking directions (Sunday)</a>.
      </p>
      <p>
        Sevilla (L2) dumps you even closer to Espoz y Mina than the Sol interchange. If your train is L2,
        that stop can be the shorter walk to Dubliners and O’Connell’s.
      </p>

      <OriginalFourBars lang="en" when="tonight" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Coming up the Metro Sol stairs at 21:00. Which door?</strong></dt>
        <dd>South-east exits. Dubliners, Espoz y Mina 7, for Valencia–RM LIVE. O’Reilly’s two minutes, O’Connell’s three. Four Corner not tonight.</dd>
        <dt><strong>How far from Metro Sol?</strong></dt>
        <dd>O’Reilly’s ~2 min / 180 m. Dubliners and O’Connell’s ~3 min / 250 m. Victoria 6 is the same pocket, Sunday 14:00 only.</dd>
        <dt><strong>Saturday NFL from the station?</strong></dt>
        <dd>No. No official NFL Saturday. Named 21:00 is Valencia–RM at Dubliners. Next NFL screen: Sunday 15:30.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'From the station, then Sunday',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'FIND US — Dubliners home' },
              { href: '/visit/', label: 'GET DIRECTIONS — visit / hours' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/saturday-night-sol-valencia-real-madrid/', label: 'Valencia–RM 21:00 at Dubliners' },
              { href: '/english-tourists-saturday-hours-until-premier/', label: 'English fans: Saturday left until 15:00' },
              { href: PATH_ES, label: 'Bajas en Metro Sol a las 21:00', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
