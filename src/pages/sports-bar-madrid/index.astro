---
import MapEmbed from '../../components/MapEmbed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import LinkHub from '../../components/LinkHub.astro';
import { SITE, withBase } from '../../site';

const title = 'Sports Bar Madrid | Football, NFL & Rugby near Sol — Dubliners';
const description =
  'Sports bar near Puerta del Sol: NFL, NBA, rugby, F1 and football LIVE on a big projector and 8 screens. Espoz y Mina 7, open daily from 12:00.';
---

<BaseLayout title={title} description={description} path="/sports-bar-madrid/" ogImage="/images/screens-sports.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Sports bar Madrid" schema />
        <h1>Sports bar Madrid near Sol — NFL, rugby and live sport on screens</h1>
        <p class="lead">
          Looking for a sports bar near Sol? Dubliners is an Irish pub on Espoz y Mina 7 with a big projector and 8 screens.
          NFL, NBA, rugby, F1, Premier League, Champions League and LaLiga — when they’re showing.
        </p>
        <CtaRow />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 45vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/screens-sports.jpg')} alt="TV and projector for live sport at Dubliners" width="1400" height="788" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>Tonight’s fixtures</h3>
          <p>
            Check <a href={withBase('/whats-on/')}>What’s on</a> for the board, or ask at the bar what’s on the screens.
          </p>
        </article>
        <article class="card">
          <h3>Where</h3>
          <p>
            Just off Puerta del Sol. Metro Sol (L1, L2, L3) or Sevilla (L2) —
            <a href={withBase('/visit/')}>visit &amp; directions</a>.
          </p>
        </article>
        <article class="card">
          <h3>How it works</h3>
          <p>Arrive early for big kick-offs.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Live sports</h2>
      <p>
        Dubliners is an Irish pub just off Sol with a big projector and 8 screens facing the main room, so groups can watch together.
        Big games fill early.
      </p>
      <p>
        Schedules change every week, so <a href={withBase('/whats-on/')}>What’s On</a> is our live list.
        We only list what is confirmed; if a slot looks empty, ask at the bar what is actually on.
      </p>

      <h2>Football &amp; rugby</h2>
      <p>
        Football is the core: Premier League, Champions League, LaLiga and more when the rights allow.
        Rugby fills the rest of the weekend.
      </p>
      <ul>
        <li><strong>Rugby:</strong> URC, Premiership Rugby and international Tests, with the Six Nations in spring.</li>
        <li><strong>Formula 1:</strong> qualifying and races when they fall inside our opening hours.</li>
        <li><strong>Tennis:</strong> the big finals and late rounds when they are on.</li>
      </ul>
      <p>
        On the football side, most weeks the screens carry the Premier League, LaLiga, the Champions League, the Europa League and the
        Conference League, plus Copa del Rey ties and the bigger Scottish games. Two matches at the same time go on different screens,
        with the main one on the big projector. Every listed kick-off is in Madrid time.
      </p>

      <h2>NFL &amp; American sports</h2>
      <p>
        NFL Sundays are the big one: the early and late afternoon games (US time) land in the Madrid evening,
        on the projector and screens. We also put NBA and NHL games on when they start before our late cut-off, and MLB at playoff time.
        A game has to start at least an hour before we close (02:00, or 02:30 on Friday and Saturday nights) to be listed.
      </p>

      <h2>Food &amp; drinks</h2>
      <p>
        Pub food and drinks at the bar while the match is on. Prices are on our <a href={withBase('/menu/')}>food menu</a>.
      </p>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Match-night guides',
            items: [
              { href: '/whats-on/', label: 'What’s On', note: 'Tonight’s fixtures and the week ahead' },
              { href: '/premier-league-pub-madrid/', label: 'Premier League nights' },
              { href: '/champions-league-bar-madrid/', label: 'Champions League nights' },
              { href: '/nfl-madrid/', label: 'NFL in Madrid', note: 'The season at Dubliners' },
              { href: '/visit/', label: 'Visit', note: 'Address, Metro Sol walk and map' },
            ],
          },
        ]}
      />

      <h2>Visiting fans and groups</h2>
      <p>
        In Madrid for an away game? We are in the centre, about a two-minute walk from Puerta del Sol, not next to the Bernabéu or the Metropolitano,
        so it works before you head to the stadium or for the other matches of the night. Groups are welcome.
      </p>

      <h2>Match-night tips</h2>
      <ul>
        <li>Big games fill early — arrive 30–45 minutes before kick-off if you want a good seat.</li>
        <li>Groups are welcome.</li>
        <li>After a Bernabéu day, Sol is still a short Metro hop for a centro watch or debrief pint.</li>
      </ul>

      <div class="faq">
        <details>
          <summary>Which leagues do you show?</summary>
          <p>
            Premier League, Champions League, LaLiga and other live sport when it’s on.
            Confirm on <a href={withBase('/whats-on/')}>What’s on</a> or ask at the bar.
          </p>
        </details>
        <details>
          <summary>Where exactly are you?</summary>
          <p>{SITE.address}, {SITE.postal}. Metro Sol (L1, L2, L3) or Sevilla (L2) — a short walk from Puerta del Sol.</p>
        </details>
        <details>
          <summary>Hotel near Sol — can I walk?</summary>
          <p>Yes. Most Sol-area hotels are a short walk to Espoz y Mina 7: from the plaza, head toward Calle de Espoz y Mina.</p>
        </details>
        <details>
          <summary>Can I watch soccer here (US visitors)?</summary>
          <p>Yes — football/soccer on indoor screens near Sol, and NFL Sundays on the projector.</p>
        </details>
        <details>
          <summary>Is there food?</summary>
          <p>Yes — see our <a href={withBase('/menu/')}>food menu</a> with prices.</p>
        </details>
        <details>
          <summary>Is it easy to reach from Sol?</summary>
          <p>
            Yes — Espoz y Mina 7 is a short walk from Puerta del Sol / Metro Sol.
            Come for live football on the screens, then continue around centro.
          </p>
        </details>
      </div>
      <div class="map-frame" style="margin-top:1.5rem">
        <MapEmbed lang="en" title="Map to Dubliners sports bar" />
      </div>
      <p style="margin-top:1rem">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
      </p>
    </div>
  </section>
</BaseLayout>
