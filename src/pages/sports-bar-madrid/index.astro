---
import MapEmbed from '../../components/MapEmbed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, withBase } from '../../site';

const title = 'Sports Bar Madrid | Football, NFL & Rugby near Sol — Dubliners';
const description =
  'Sports bar nearby Puerta del Sol with multiple indoor screens and a projector. Premier League, Champions League, LaLiga and more when on — Espoz y Mina 7, walk in.';
---

<BaseLayout title={title} description={description} path="/sports-bar-madrid/" ogImage="/images/screens-sports.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Sports bar Madrid" schema />
        <h1>Sports bar Madrid near Sol — live football on screens</h1>
        <p class="lead">
          Looking for a sports bar nearby Sol? Dubliners is an indoor Irish pub on Espoz y Mina 7 with multiple TVs and a projector.
          Premier League, Champions League, LaLiga, Six Nations, F1, NFL and NBA — when they’re showing.
        </p>
        <CtaRow />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 45vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/screens-sports.jpg')} alt="TV and projector for live sport at Dubliners" width="1400" height="788" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>Tonight’s fixtures</h3>
          <p>
            Check <a href={withBase('/whats-on/')}>What’s on</a> for the board, or ask at the bar what’s on the screens.
          </p>
        </article>
        <article class="card">
          <h3>Where</h3>
          <p>
            Just off Puerta del Sol. Metro Sol (L1, L2, L3) or Sevilla (L2) —
            <a href={withBase('/visit/')}>visit &amp; directions</a>.
          </p>
        </article>
        <article class="card">
          <h3>How it works</h3>
          <p>Walk in, no table booking. Arrive early for big kick-offs.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Live sport in Madrid centro</h2>
      <p>
        Dubliners is a centro sports bar for people who want football without leaving Sol.
        A big projector and 8 screens — Guinness at the bar while the match runs.
      </p>
      <p>
        Typical coverage when rights allow: Premier League, Champions League / UCL nights,
        LaLiga, Six Nations rugby, F1, NFL and NBA. Schedules change week to week — the
        <a href={withBase('/whats-on/')}>What’s on board</a> is the live list; if a slot looks empty, ask staff what’s actually on.
        We don’t claim every kick-off — only what’s actually listed or confirmed at the bar.
      </p>
      <p>
        Screens face the main room so groups can watch together. Popular fixtures fill early;
        space is first come, first served. From Metro Sol it’s a short walk into Espoz y Mina —
        handy if you’re already in Madrid centro and want a sports bar near Sol tonight.
      </p>

      <h2>Every sport, not just football</h2>
      <p>
        Football is the core, but the screens are busy all week with other sport. We only list what is
        confirmed on <a href={withBase('/whats-on/')}>What’s On</a>; if it is not there, ask at the bar.
      </p>
      <ul>
        <li><strong>Rugby:</strong> URC, Premiership Rugby and international Tests, Six Nations in spring. Next big one: <a href={withBase('/watch-leinster-munster-madrid/')}>Leinster v Munster in Madrid</a> (Saturday 24 October).</li>
        <li><strong>Formula 1:</strong> qualifying and races when they fall inside our opening hours.</li>
        <li><strong>Tennis:</strong> the big finals and late rounds when they are on.</li>
      </ul>
      <h2>American sports in Madrid</h2>
      <p>
        NFL Sundays are the big one: the early and late afternoon games (US time) land in the Madrid evening,
        on the projector and screens. See <a href={withBase('/nfl-madrid/')}>NFL in Madrid</a> for the season.
        We also put NBA and NHL games on when they start before our late cut-off, and MLB at playoff time.
        A game has to start at least an hour before we close (02:00, or 02:30 on Friday and Saturday nights) to be listed.
      </p>

      <h2>Match-night pages</h2>
      <p>Each league has its own angle — use the page that matches your search:</p>
      <ul>
        <li><a href={withBase('/whats-on/')}>Tonight’s fixtures &amp; week agenda</a></li>
        <li><a href={withBase('/premier-league-pub-madrid/')}>English football / Premier League nights</a></li>
        <li><a href={withBase('/champions-league-bar-madrid/')}>UCL screens &amp; post-Bernabéu centro pint</a></li>
        <li><a href={withBase('/visit/')}>Address, Metro Sol walk &amp; map</a></li>
        <li><a href={withBase('/watch-football-madrid/')}>Where to watch football in Madrid</a></li>
        <li><a href={withBase('/football-bar-puerta-del-sol/')}>Football bar near Puerta del Sol</a></li>
      </ul>

      <h2>Match-night tips</h2>
      <ul>
        <li>Big games fill early — arrive 30–45 minutes before kick-off if you want a good seat.</li>
        <li>No reservations; groups are welcome but space is first-come.</li>
        <li>After a Bernabéu day, Sol is still a short Metro hop for a centro watch or debrief pint.</li>
      </ul>

      <div class="faq">
        <details>
          <summary>Do you take reservations for match nights?</summary>
          <p>No — come along when you’re ready. Arrive early for popular fixtures.</p>
        </details>
        <details>
          <summary>Which leagues do you show?</summary>
          <p>
            Premier League, Champions League, LaLiga and other live sport when it’s on.
            Confirm on <a href={withBase('/whats-on/')}>What’s on</a> or ask at the bar.
          </p>
        </details>
        <details>
          <summary>Where exactly are you?</summary>
          <p>{SITE.address}, {SITE.postal}. Metro Sol (L1, L2, L3) or Sevilla (L2) — a short walk from Puerta del Sol.</p>
        </details>
        <details>
          <summary>Is there food?</summary>
          <p>Yes — see our <a href={withBase('/menu/')}>food &amp; drinks menu</a> with prices.</p>
        </details>
        <details>
          <summary>Is this a good sports bar nearby if I’m at Sol?</summary>
          <p>
            Yes — Espoz y Mina 7 is a short walk from Puerta del Sol / Metro Sol.
            Come for live football on the screens, then continue around centro.
          </p>
        </details>
      </div>
      <div class="map-frame" style="margin-top:1.5rem">
        <MapEmbed lang="en" title="Map to Dubliners sports bar" />
      </div>
      <p style="margin-top:1rem">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
      </p>
    </div>
  </section>
  <section class="section"><div class="container"><p class="small">American football fans: <a href={withBase('/nfl-madrid/')}>NFL in Madrid</a></p></div></section>
</BaseLayout>
