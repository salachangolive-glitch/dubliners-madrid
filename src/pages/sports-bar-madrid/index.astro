---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, withBase } from '../../site';

const title = 'Sports Bar Madrid near Sol | Dubliners';
const description =
  'Sports bar near Puerta del Sol. Indoor screens for football and live sport when it’s on. Espoz y Mina 7.';
---

<BaseLayout title={title} description={description} path="/sports-bar-madrid/" ogImage="/images/screens-sports.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Sports bar Madrid" />
        <h1>Sports screens near Sol</h1>
        <p class="lead">
          Indoor Irish pub with multiple screens on Espoz y Mina 7.
          Premier League, Champions League, LaLiga, Six Nations, F1, NFL and NBA — when they’re showing.
        </p>
        <CtaRow />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 45vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/screens-sports.jpg')} alt="TV and projector for live sport at Dubliners" width="1400" height="788" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Live sport in Madrid centro</h2>
      <p>
        Metro Sol or Sevilla. For tonight’s screens, see
        <a href={withBase('/whats-on/')}>What’s on</a> or ask at the bar.
      </p>
      <ul>
        <li><a href={withBase('/watch-football-madrid/')}>Watch football in Madrid</a></li>
        <li><a href={withBase('/premier-league-pub-madrid/')}>Premier League pub Madrid</a></li>
        <li><a href={withBase('/champions-league-bar-madrid/')}>Champions League bar Madrid</a></li>
        <li><a href={withBase('/football-bar-puerta-del-sol/')}>Football bar near Puerta del Sol</a></li>
      </ul>
      <div class="faq">
        <details>
          <summary>Do you take reservations for match nights?</summary>
          <p>No — come along when you’re ready. Arrive early for popular fixtures.</p>
        </details>
        <details>
          <summary>Where exactly are you?</summary>
          <p>{SITE.address}, {SITE.postal}.</p>
        </details>
      </div>
      <div class="map-frame" style="margin-top:1.5rem">
        <iframe title="Map to Dubliners sports bar" loading="lazy" src={SITE.mapsEmbed}></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
