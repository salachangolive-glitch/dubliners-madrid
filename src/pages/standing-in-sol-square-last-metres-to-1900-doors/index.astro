---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../components/OriginalFourBars.astro';
import FanWeekendCtas from '../../components/FanWeekendCtas.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/standing-in-sol-square-last-metres-to-1900-doors/';
const PATH_ES = '/es/en-plaza-sol-ultimos-metros-a-puertas-1900/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Standing in Puerta del Sol square: last metres to Victoria 6, Espoz y Mina 7 and Matheu 4 for the 19:00 window',
  inLanguage: 'en',
  datePublished: '2026-11-08T19:00:00+01:00',
  dateModified: '2026-11-08T19:00:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'I am already standing in Puerta del Sol square for 19:00 NFL. Which way are the last metres?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Face south-east toward Carrera de San Jerónimo / Calle de la Victoria — not Gran Vía. All four sister doors are open NOW. Four Corner, Calle de la Victoria 6 (from 14:00 until late, sports screens) is about 2–3 minutes / 180–220 m from the east side of Sol (already published). Dubliners and O’Connell’s, Calle de Espoz y Mina 7. O’Reilly’s, Pasaje de Matheu 4. Follow live Maps for the last metres. Named 19:00 NFL and Atlético–Barcelona 21:00: Dubliners What’s On only. Ask which game.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is this evening Metro Gran Vía/Sevilla, first Metro, Callao–Preciados, Plaza Mayor arcade, or Tirso?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Evening Metro is inbound from Gran Vía (L1/L5) or Sevilla (L2) stations. First Metro is early Sunday, when Four Corner is not yet open. Callao–Preciados is a shopping-street walk with bags before 14:00. Plaza Mayor east arcade is a tourist street downhill from a different plaza before 14:00. Tirso / Antón Martín is walking north from L1 south of Sol before 14:00. This page is only already on Puerta del Sol square pavement, last metres, four doors already open, for the 19:00 window.',
      },
    },
    {
      '@type': 'Question',
      name: 'Are the four doors open if I am already on the square at 19:00?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. Sunday is four bars. Four Corner is open from 14:00 until late, sports screens. Saturday’s three-bar meetup is over. From the east side of Sol, Victoria 6 is about 2–3 minutes / 180–220 m (already published). Ask which game is on. Premier sits alongside NFL and Atleti; do not substitute.',
      },
    },
  ],
};
---

<BaseLayout
  title="Standing in Sol square: last metres to Victoria 6 / Espoz y Mina 7 | Dubliners"
  description="Sunday 8 Nov: already on Puerta del Sol square. Walk the last metres to Victoria 6, Espoz y Mina 7 and Matheu 4. All four doors open NOW for 19:00 NFL. Maps. FIND US."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Standing in Sol square: last metres to the 19:00 doors" schema />
      <h1>Standing in Puerta del Sol square: last metres to Victoria 6, Espoz y Mina 7 and Matheu 4</h1>
      <p class="lead">
        You are already <strong>on the square</strong> — not on a Gran Vía platform, not shopping Callao with bags, not under Plaza Mayor’s arcade, not walking up from Tirso.
        Face <strong>south-east toward Carrera de San Jerónimo / Calle de la Victoria</strong>.
        <strong>All four sister doors are open NOW</strong> for the 19:00 NFL window, then Atlético–Barcelona 21:00.
        Four Corner, Calle de la Victoria 6, is open (from 14:00 until late, sports screens).
        Saturday’s three-bar meetup is over. Follow live Maps for the last metres. Ask which game.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">En la plaza de Sol: últimos metros a Victoria 6, Espoz y Mina 7 y Matheu 4</a></p>
      <FanWeekendCtas lang="en" findHref="/visit/" />
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>On the square pavement — not evening Metro, not first Metro, not Callao, not Plaza Mayor, not Tirso</h2>
      <p>
        <a href={withBase('/evening-metro-gran-via-sevilla-to-open-sol-doors/')}>Evening Metro Gran Vía or Sevilla</a> is inbound from those stations.
        <a href={withBase('/first-metro-into-sol-sunday-station-to-door/')}>First Sunday Metro</a> is station-to-door when Metro starts, with Four Corner not open yet.
        <a href={withBase('/callao-preciados-shop-south-sol-doors-before-1400/')}>Callao–Preciados</a> is a shopping street south before 14:00.
        <a href={withBase('/plaza-mayor-arcade-downhill-sol-doors-before-1400/')}>Plaza Mayor east arcade</a> is a tourist street downhill from a different plaza before 14:00 — that plaza is not a fan venue.
        <a href={withBase('/tirso-anton-martin-north-sol-doors-before-1400/')}>Tirso / Antón Martín</a> is walking north from L1 south of Sol before 14:00.
        This page is only <strong>already standing in Puerta del Sol square</strong>, last metres to the four open doors, for 19:00.
      </p>

      <h2>South-east off the square — Victoria 6, then Espoz y Mina 7, then Matheu 4</h2>
      <p>
        From the east side of Sol, Calle de la Victoria 6 is about <strong>2–3 minutes / 180–220 m</strong> (already published).
        Face south-east toward Carrera de San Jerónimo / Calle de la Victoria — not Gran Vía, not a night-bus plan.
        Espoz y Mina 7 is the nearest number-7 pair (Dubliners and O’Connell’s, two doors, two CIDs).
        Pasaje de Matheu 4 is the covered cut-through. Follow live Maps for the last metres; we do not invent a new clock from the square.
      </p>
      <ol>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid.</strong>
          Open NOW (from 14:00 until late · sports screens). First Victoria pin off the east side of the square.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          Sunday 12:00–02:00. Named 19:00 NFL and Atleti 21:00 on What’s On. Ask which game is on.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (Maps listing: O’Connell St).
          Same number, different door, different CID. Meeting point; we do not invent its board.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Covered cut-through from Victoria / Espoz y Mina. Usual from 11:30. Meeting point; no invented menu.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
      </ol>

      <h2>What those last metres are for — Premier sits alongside, it does not replace</h2>
      <p>
        Dubliners <a href={withBase('/whats-on/')}>What’s On</a> already lists Sunday 8 November in Madrid time.
        You are walking in for NFL from <strong>19:00</strong> (RedZone from 19:00) then <strong>22:05</strong> / <strong>22:25</strong>, and Atlético vs Barcelona <strong>21:00</strong>.
        Premier 15:00 / 17:30 sits alongside; do not substitute. Named listings: Dubliners only.
        We do not assign those matches to O’Reilly’s, O’Connell’s or Four Corner. Ask which screen.
      </p>
      <p>
        Already at a door and the 19:00 NFL window is live?
        <a href={withBase('/nfl-on-now-1900-then-hop-atleti-2100/')}>NFL is on NOW — sit, then hop at 21:00 for Atleti</a>.
        Still on evening Metro, not yet on the square?
        <a href={withBase('/evening-metro-gran-via-sevilla-to-open-sol-doors/')}>Gran Vía or Sevilla to Victoria 6 and Espoz y Mina 7</a>.
      </p>

      <OriginalFourBars lang="en" when="sunday" findHref="/visit/" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Already on Puerta del Sol square. Which way for 19:00?</strong></dt>
        <dd>South-east toward Carrera de San Jerónimo / Calle de la Victoria. Victoria 6 is 2–3 min / 180–220 m from east Sol. Espoz y Mina 7 twice, Matheu 4 the cut-through. All four doors open NOW. Ask which game.</dd>
        <dt><strong>Is this evening Metro, first Metro, Callao, Plaza Mayor or Tirso?</strong></dt>
        <dd>No. Those are inbound stations, early Sunday, shopping-before-14:00, a different plaza before 14:00, and south-of-Sol before 14:00. This is last metres from the square pavement, four doors already open.</dd>
        <dt><strong>Does walking from the square replace Premier, NFL or Atleti?</strong></dt>
        <dd>No. Coordinate. Named clocks sit alongside on Dubliners What’s On. We do not copy that board onto sister doors.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Last metres off Sol square this Sunday',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'FIND US — Dubliners home' },
              { href: '/visit/', label: 'GET DIRECTIONS — visit / hours' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/nfl-on-now-1900-then-hop-atleti-2100/', label: 'NFL is on NOW from 19:00 — then hop for Atleti 21:00' },
              { href: '/whats-on/', label: 'What’s On — named screens only' },
              { href: PATH_ES, label: 'En la plaza de Sol: últimos metros a Victoria 6, Espoz y Mina 7 y Matheu 4', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
