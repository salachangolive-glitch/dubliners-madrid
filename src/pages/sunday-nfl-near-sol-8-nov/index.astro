---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import LinkHub from '../../components/LinkHub.astro';
import SundayFourVenues from '../../components/SundayFourVenues.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/sunday-nfl-near-sol-8-nov/';
const PATH_ES = '/es/nfl-domingo-cerca-sol-8-nov/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Sunday NFL near Sol: four sister bars, one meeting point on 8 November',
  inLanguage: 'en',
  datePublished: '2026-11-07',
  dateModified: '2026-11-07',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Where is Sunday NFL near Puerta del Sol on 8 November?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The meeting point is four sister bars a short walk from Sol: O’Reilly’s Restaurant Bar (Pasaje de Matheu 4), Dubliners and O’Connell St (Espoz y Mina 7), and Four Corner (Calle de la Victoria 6). Confirmed LIVE NFL screens this Sunday are at Dubliners. Ask which game is on.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is every Sunday NFL game on every screen near Sol?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Kick-offs overlap (15:30, 19:00, 21:00 football, 22:05, 22:25). Ask at Dubliners which game is on. We do not promise every game on every screen, and we do not invent Four Corner broadcasts.',
      },
    },
    {
      '@type': 'Question',
      name: 'When does Four Corner open on Sunday?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Sunday 8 November from 14:00 until late. Not 12:00. Opening is confirmed; broadcasts there are not listed.',
      },
    },
  ],
};
---

<BaseLayout
  title="Sunday NFL near Sol, 8 Nov: four bars | Dubliners"
  description="Sunday 8 Nov NFL near Puerta del Sol: four sister bars, maps and hours. Confirmed screens at Dubliners. Plan it today — not every game on every screen."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Sunday NFL near Sol" schema />
      <h1>Sunday NFL near Sol: four bars, one meeting point (8 November)</h1>
      <p class="lead">
        Sunday 8 November is NFL Madrid day in the city centre, not only at the Bernabéu.
        Use the four sister bars around Puerta del Sol as <strong>one meeting point</strong>.
        Confirmed LIVE screens: Dubliners. Plan it from Saturday.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">NFL domingo cerca de Sol</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Maps</a>
        <a class="btn btn-secondary" href={withBase('/nfl-madrid/')}>NFL at Dubliners</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <div data-show-until={SHOW_UNTIL}>
        <h2>What is confirmed near Sol</h2>
        <p>
          Metro Sol (L1, L2, L3) or Sevilla (L2). The four bars sit south and east of the square: Four Corner on
          Calle de la Victoria, O’Reilly’s on Pasaje de Matheu, Dubliners and O’Connell St on Espoz y Mina.
        </p>
        <p>
          At <strong>Dubliners</strong> this Sunday is confirmed LIVE: Bengals–Falcons at 15:30 (big screen; DAZN and Cuatro in Spain),
          seven NFL games at 19:00, Texans–Chargers at 22:05, three more at 22:25, plus NFL RedZone from 19:00.
          Atlético–Barcelona at 21:00 sits in the same night. We close at 02:00.
        </p>
        <p>
          That is a lot of kick-offs. A pub is not a broadcast centre. <strong>Ask at the bar which game is on.
          Not every game is on every screen.</strong> We do not list Four Corner, O’Reilly’s or O’Connell St match-by-match —
          those are sister meeting points with confirmed hours, not invented TV grids.
        </p>
      </div>

      <SundayFourVenues lang="en" />

      <p class="small">
        Not an official NFL event. Independent of the league and the stadium organisers.
      </p>

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Where is Sunday NFL near Puerta del Sol on 8 November?</strong></dt>
        <dd>Four sister bars a short walk from Sol. Confirmed LIVE NFL screens this Sunday are at Dubliners, Espoz y Mina 7. Ask which game is on.</dd>
        <dt><strong>Is every Sunday NFL game on every screen near Sol?</strong></dt>
        <dd>No. Kick-offs overlap. Ask at Dubliners. We do not invent Four Corner broadcasts.</dd>
        <dt><strong>When does Four Corner open on Sunday?</strong></dt>
        <dd>Sunday 8 November from 14:00 until late. Not 12:00.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Sunday 8 November near Sol',
            until: SHOW_UNTIL,
            items: [
              { href: '/before-after-bengals-falcons-sol/', label: 'Before and after Bengals–Falcons', note: 'Meet, then stadium or screens' },
              { href: '/afternoon-evening-nfl-sol-8-nov/', label: 'Afternoon and evening NFL', note: 'Two Sunday clocks' },
              { href: '/four-corner-opens-sunday-1400/', label: 'Four Corner opens 14:00', note: 'Confirmed Sunday opening' },
              { href: '/atletico-barcelona-sol-8-nov/', label: 'Atlético–Barcelona near Sol', note: '21:00 Sunday' },
              { href: '/where-to-watch-nfl-madrid/', label: 'Where to watch NFL in Madrid', note: 'Dubliners guide' },
              { href: '/4-bars-one-fan-weekend/', label: '4 Bars. One Fan Weekend' },
              { href: PATH_ES, label: 'NFL domingo cerca de Sol', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
