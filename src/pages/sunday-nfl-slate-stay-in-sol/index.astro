---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/sunday-nfl-slate-stay-in-sol/';
const PATH_ES = '/es/parrilla-nfl-domingo-quedarse-sol/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Sunday NFL slate without leaving Sol — 12:00 to late',
  inLanguage: 'en',
  datePublished: '2026-11-07T18:40:00+01:00',
  dateModified: '2026-11-07T18:40:00+01:00',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Can I stay in Sol for the whole Sunday NFL slate?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Yes. O’Reilly’s from 11:30, Dubliners and O’Connell’s from 12:00, Four Corner from 14:00 with sports screens. Confirmed LIVE NFL at Dubliners through 15:30, 19:00, 22:05 and 22:25. Close 02:00.',
      },
    },
    {
      '@type': 'Question',
      name: 'What sits in the middle of the Sunday slate?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Atlético vs Barcelona at 21:00 is LIVE at Dubliners in the same night as evening NFL. Ask which screen is which. Not every game on every screen.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is Four Corner part of the Sunday slate from midday?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Four Corner opens 14:00 until late, with sports screens. It is not a 12:00 door.',
      },
    },
  ],
};
---

<BaseLayout
  title="Sunday NFL slate without leaving Sol | Dubliners"
  description="Stay in Sol for the Sunday 8 Nov slate: Dubliners from 12:00, Four Corner from 14:00 with sports screens, NFL 15:30 / 19:00 / 22:05 / 22:25. Maps for four bars."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Sunday NFL slate in Sol" schema />
      <h1>Sunday NFL slate without leaving Sol — 12:00 to late</h1>
      <p class="lead">
        You can sit the whole Sunday card in one pocket. Dubliners from 12:00, Four Corner from 14:00 (sports screens),
        O’Reilly’s from 11:30, O’Connell’s from 12:00. Kick-offs stack: 15:30, 19:00, 21:00 football, 22:05, 22:25.
        Ask which game is on. Plan it tonight — no NFL Saturday.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Parrilla NFL del domingo sin salir de Sol</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Maps</a>
        <a class="btn btn-secondary" href={withBase('/4-bars-one-fan-weekend/')}>MEET US NEAR SOL</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>The slate, in this pocket only</h2>
      <p>
        This is not an hour-by-hour TV grid of every NFL game. It is the decision to <strong>not leave Sol</strong> once Sunday starts.
        Confirmed LIVE at Dubliners: Bengals–Falcons 15:30 (big screen), seven NFL games from 19:00, Texans–Chargers 22:05, three more at 22:25, NFL RedZone from 19:00, Atlético–Barcelona 21:00.
        We close 02:00.
      </p>
      <p>
        Four Corner is the 14:00 sister door — sports screens, no invented listings — so the pocket has four rooms after lunch, not three.
        Tonight you can already meetup 18:00–19:00 at the Saturday three, then Valencia–RM 21:00 at Dubliners, and walk the same streets Sunday.
      </p>

      <OriginalFourBars lang="en" when="sunday" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Can I stay in Sol for the whole Sunday slate?</strong></dt>
        <dd>Yes. Four doors, staggered opens. Confirmed NFL screens at Dubliners until 02:00.</dd>
        <dt><strong>What sits in the middle of the slate?</strong></dt>
        <dd>Atlético–Barcelona 21:00 at Dubliners, same night as evening NFL. Ask which screen.</dd>
        <dt><strong>Is Four Corner a midday door?</strong></dt>
        <dd>No. Sunday from 14:00 until late, sports screens.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Sunday in this pocket',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'Dubliners home' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/nfl-sunday-madrid-guide/', label: 'Hour-by-hour Sunday guide' },
              { href: '/pick-sunday-nfl-clock-sol/', label: 'Pick a Sunday clock' },
              { href: '/nfl-madrid/', label: 'NFL at Dubliners' },
              { href: PATH_ES, label: 'Parrilla NFL del domingo', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
