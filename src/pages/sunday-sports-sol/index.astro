---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import LinkHub from '../../components/LinkHub.astro';
import { SITE, withBase, absUrl } from '../../site';
import { OPENING_HOURS, hoursSummary } from '../../data/hours';
import { madridToday } from '../../data/fixtures';

// Sunday stacked sports at Dubliners only (DG 6 Nov 2026). Adapted from sunday-football-sol.md.
// Schedule: RADAR-AGENDA.md verified NFL windows + Atlético–Barcelona 21:00 (user/fixtures).
// No TV channel except Bengals–Falcons (DAZN, Cuatro). Late kick-offs: list times only, no closing caveat.
const PATH = '/sunday-sports-sol/';
const PATH_ES = '/es/deportes-domingo-sol/';
const SHOW_UNTIL = '2026-11-08';
const todayKey = madridToday();
const showWeekend = todayKey <= SHOW_UNTIL;
const hoursLine = hoursSummary('en');
const title = 'Sunday sports in Sol: NFL and Atlético–Barça | Dubliners';
const description =
  'Sunday 8 Nov near Puerta del Sol: NFL 15:30, 19:00, 22:05/22:25 and Atlético–Barça 21:00 at Dubliners, Espoz y Mina 7. Ask which game is on.';
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Sunday sports in Sol: NFL 15:30, 19:00, 22:05/22:25 and Atlético–Barcelona 21:00',
  inLanguage: 'en',
  datePublished: '2026-11-06',
  dateModified: '2026-11-06',
  image: absUrl('/images/dubliners-screens-sol-1200.webp'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  about: 'Sunday 8 November 2026 sports at Dubliners near Puerta del Sol: NFL and Atlético de Madrid vs FC Barcelona',
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'What is on at Dubliners on Sunday 8 November?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Bengals–Falcons at 15:30, seven NFL games at 19:00, Atlético de Madrid–FC Barcelona at 21:00, Texans–Chargers at 22:05 and three NFL games at 22:25 (Madrid time). Ask at the bar which game is on.',
      },
    },
    {
      '@type': 'Question',
      name: 'When does Dubliners open on Sunday 8 November?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: `From 12:00. Usual hours: ${hoursLine}.`,
      },
    },
    {
      '@type': 'Question',
      name: 'Is every game on every screen?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. The kick-offs overlap. Ask at the bar which game is on. Not every game is on every screen.',
      },
    },
  ],
};
---

<BaseLayout
  title={title}
  description={description}
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/dubliners-screens-sol-1200.webp"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Sunday sports in Sol" schema />
      <h1>Sunday sports in Sol: NFL 15:30, 19:00, 22:05/22:25 and Atlético–Barcelona 21:00</h1>
      <p class="lead">
        Sunday 8 November 2026 in Madrid is several clocks on one day, not one sports session. Plan it by kick-off
        at <strong>Dubliners</strong>, Calle de Espoz y Mina 7, a short walk from Puerta del Sol. Ask at the bar which
        game is on — not every game is on every screen.
      </p>
      <p class="small">Sunday 8 November 2026 · Madrid time · Open from 12:00 · {hoursLine}</p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
        <a class="btn btn-secondary" href={withBase('/nfl-madrid/')}>NFL in Madrid</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      {showWeekend && (
        <div data-show-until={SHOW_UNTIL}>
          <h2>Sunday 8 November — kick-offs (Madrid time)</h2>
          <table>
            <thead>
              <tr><th>Madrid time</th><th>What</th></tr>
            </thead>
            <tbody>
              <tr><td>15:30</td><td>Bengals–Falcons at the Santiago Bernabéu (DAZN and Cuatro; on the <strong>big screen</strong> at Dubliners)</td></tr>
              <tr><td>19:00</td><td>Seven NFL games (Broncos at Panthers, Cowboys at Colts, Jets at Chiefs, Lions at Dolphins, Browns at Saints, Giants at Eagles, Rams at Commanders)</td></tr>
              <tr><td>21:00</td><td>Atlético de Madrid–FC Barcelona, LaLiga, Riyadh Air Metropolitano</td></tr>
              <tr><td>22:05</td><td>Texans at Chargers</td></tr>
              <tr><td>22:25</td><td>Three NFL games (Raiders at 49ers, Packers at Patriots, Cardinals at Seahawks)</td></tr>
            </tbody>
          </table>
          <p>
            Those layers overlap. A pub is not a broadcast centre. One screen may stay on the Madrid NFL game, another may
            flip to the 19:00 slate, another may already be on 21:00. <strong>Ask at the bar.</strong> Not every game is on
            every screen.
          </p>
          <p class="small">
            NFL times from the <a href="https://www.nfl.com/schedules/2026/REG9/" rel="noopener" target="_blank">NFL.com Week 9 schedule</a>.
            Bengals–Falcons in Spain: DAZN and Cuatro (<a href="https://www.nfl.com/news/donde-ver-el-2026-nfl-madrid-game-en-espana" rel="noopener" target="_blank">nfl.com</a>).
          </p>
        </div>
      )}

      <h2>From midday at Dubliners</h2>
      <p>
        Dubliners opens from <strong>12:00</strong> on Sunday (until 02:00). Indoor Irish pub on Calle de Espoz y Mina 7,
        28012 Madrid — Metro Sol (L1, L2, L3) or Sevilla (L2). A meeting point after a hotel checkout, to hold the group
        until the 15:30 kick-off.
      </p>
      <img
        class="split-photo tall"
        src={withBase('/images/dubliners-screens-sol-1200.webp')}
        srcset={`${withBase('/images/dubliners-screens-sol-800.webp')} 800w, ${withBase('/images/dubliners-screens-sol-1200.webp')} 1200w`}
        sizes="(max-width: 800px) 100vw, 720px"
        width="1200"
        height="1600"
        loading="lazy"
        decoding="async"
        alt="Big screen and other screens at Dubliners near Sol"
      />

      {showWeekend && (
        <div data-show-until={SHOW_UNTIL}>
          <h2>How to spend the stacked night</h2>
          <p>A realistic path, not a promise of programming:</p>
          <ol>
            <li><strong>12:00–15:30</strong> — hold the group at Dubliners; 15:30 Bengals–Falcons on the big screen if you are not at the Bernabéu.</li>
            <li><strong>19:00</strong> — more NFL starts. This is where screens split. Name the team you care about and ask. Seven 19:00 games plus a 21:00 derby do not all play on every screen.</li>
            <li><strong>21:00</strong> — Atlético–Barcelona. Dubliners is open until 02:00, so full time sits inside opening hours. Confirm at the bar before you sit down.</li>
            <li><strong>22:05 / 22:25</strong> — Texans at Chargers, then Raiders at 49ers, Packers at Patriots and Cardinals at Seahawks. Same rule: ask which game is on.</li>
          </ol>
          <p>
            Saturday 7 November, 21:00: Valencia vs Real Madrid (Orange TV and DAZN) is the football night before this Sunday.
          </p>
        </div>
      )}

      <h2>Opening hours</h2>
      <ul>{OPENING_HOURS.map((d) => <li>{d.day}: {d.opens}–{d.closes}</li>)}</ul>
      <p>
        Other pubs on the same block are covered on <a href={withBase('/4-bars-one-fan-weekend/')}>4 Bars. One Fan Weekend</a>.
        Full NFL list: <a href={withBase('/nfl-madrid/')}>NFL in Madrid</a>.
      </p>
      <p class="small">
        Dubliners is an independent Irish pub and a local meeting point for fans. We are not linked to the league’s own
        events or the stadium organisers.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Fútbol desde mediodía el domingo junto a Sol: NFL y luego Atlético–Barça</a></p>

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>What is on at Dubliners on Sunday 8 November?</strong></dt>
        <dd>Bengals–Falcons at 15:30, seven NFL games at 19:00, Atlético de Madrid–FC Barcelona at 21:00, Texans–Chargers at 22:05 and three NFL games at 22:25 (Madrid time). Ask at the bar which game is on.</dd>
        <dt><strong>When does Dubliners open on Sunday 8 November?</strong></dt>
        <dd>From 12:00. Usual hours: {hoursLine}.</dd>
        <dt><strong>Is every game on every screen?</strong></dt>
        <dd>No. The kick-offs overlap. Ask at the bar which game is on. Not every game is on every screen.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'More this weekend',
            items: [
              { href: '/nfl-madrid/', label: 'NFL in Madrid', note: 'Sunday schedule' },
              { href: '/where-to-watch-nfl-madrid/', label: 'Where to watch NFL in Madrid', note: 'Near Puerta del Sol' },
              { href: '/4-bars-one-fan-weekend/', label: '4 Bars. One Fan Weekend', note: 'Near Sol this weekend' },
              { href: '/whats-on/', label: "What's On", note: 'Confirmed fixtures' },
              { href: PATH_ES, label: 'Deportes el domingo en Sol', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
