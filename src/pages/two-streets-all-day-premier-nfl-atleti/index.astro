---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/two-streets-all-day-premier-nfl-atleti/';
const PATH_ES = '/es/dos-calles-todo-el-dia-premier-nfl-atleti/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'One Sunday, two streets: Premier 15:00, NFL later, Atleti 21:00 — stay on Victoria and Espoz y Mina',
  inLanguage: 'en',
  datePublished: '2026-11-08T03:00:00+01:00',
  dateModified: '2026-11-08T03:00:00+01:00',
  image: absUrl('/images/screens-sports.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'We are a mixed group — English football, NFL and Atleti. Do we need three neighbourhoods?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Stay on two streets south-east of Sol: Calle de la Victoria and Calle de Espoz y Mina, joined by Pasaje de Matheu. Four Corner (Victoria 6) from 14:00 with sports screens. O’Reilly’s at Matheu 4. Dubliners and O’Connell’s at Espoz y Mina 7. Premier League 15:00, NFL afternoon/evening and Atlético–Barcelona 21:00 share that grid. Named listings are on Dubliners’ What’s On only. Coordinate; do not substitute one sport for another.',
      },
    },
    {
      '@type': 'Question',
      name: 'What is the all-day order on those two streets?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Four Corner opens 14:00 (not before). English Premier block 15:00: Palace–Liverpool, Sunderland–Chelsea, Brighton–Brentford, Ipswich–Bournemouth; United–Villa 17:30. NFL sits alongside from 15:30 / from 19:00. Atlético vs Barcelona 21:00 is on Dubliners’ What’s On. Hop Victoria 6 ↔ Matheu 4 ↔ Espoz y Mina 7 (90–180 m). Ask which game is on. Not every game on every screen.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does every door show Palace–Liverpool, the NFL Game, or Atleti–Barça?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Named Premier, NFL and Atlético–Barcelona listings are at Dubliners, Espoz y Mina 7. We do not invent O’Reilly’s, O’Connell’s or Four Corner boards. Four Corner has sports screens from 14:00 — ask. Saturday’s meetup and Valencia–RM are finished.',
      },
    },
  ],
};
---

<BaseLayout
  title="Two streets all day: Premier 15:00, NFL, Atleti 21:00 | Dubliners"
  description="Sunday 8 Nov: English Premier 15:00, NFL later, Atleti 21:00. Stay on Victoria and Espoz y Mina (Matheu between). Four doors, Maps. FIND US."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/screens-sports.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Two streets all day: Premier, NFL, Atleti" schema />
      <h1>One Sunday, two streets: Premier 15:00, NFL later, Atleti 21:00 — stay on Victoria and Espoz y Mina</h1>
      <p class="lead">
        You are not picking one sport and leaving Madrid.
        <strong>English Premier at 15:00, NFL in the afternoon and evening, Atlético–Barcelona at 21:00</strong>
        share the same two streets south-east of Sol: Calle de la Victoria and Calle de Espoz y Mina, with Pasaje de Matheu as the cut-through.
        Four sister doors. Coordinate the clocks. Do not substitute one slate for another.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Un domingo, dos calles: Premier 15:00, NFL, Atleti 21:00</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walk Espoz y Mina 7</a>
        <a class="btn btn-secondary" data-track-event="directions_click" href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Walk Victoria 6 (from 14:00)</a>
        <a class="btn btn-secondary" href={withBase('/4-bars-one-fan-weekend/')}>MEET US NEAR SOL</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>This is a shared-grid day, not a which-door Premier pick and not an NFL-only stay</h2>
      <p>
        Other pages already choose a Sunday door for the 15:00 English block, list the Premier games,
        keep NFL visitors in Sol, and gather Atleti fans as their own stream.
        This page is only the <strong>mixed party that will not split across the city</strong>:
        three crowds, one walking grid, all day. Saturday 18:00–19:00 and Valencia–RM 21:00 are finished.
      </p>

      <h2>The two streets (Matheu is the passage)</h2>
      <p>
        Pin <strong>Calle de la Victoria</strong> and <strong>Calle de Espoz y Mina</strong>. Pasaje de Matheu joins them in about a minute.
        You can change door without changing neighbourhood. Metres, not a taxi, not a Metro hop.
      </p>
      <ul>
        <li><strong>Victoria 6</strong> — Four Corner from 14:00, sports screens. ~180–220 m from east Sol. Not open before 14:00.</li>
        <li><strong>Matheu 4</strong> — O’Reilly’s from 11:30. ~120–150 m from Victoria 6; ~90 m from Espoz y Mina 7.</li>
        <li><strong>Espoz y Mina 7</strong> — Dubliners and O’Connell’s (two doors, same number) from 12:00 today. ~150–180 m from Victoria 6.</li>
      </ul>

      <h2>One stack — three clocks on the same grid</h2>
      <ol>
        <li>
          <strong>14:00 — the fourth door joins.</strong> Four Corner opens with sports screens. Ask which game is on. We do not list its board.
          English kick-offs are one hour later; do not treat 14:00 as a Premier claim.
        </li>
        <li>
          <strong>15:00 — English Premier block</strong> (context for the English part of the table):
          Palace–Liverpool, Sunderland–Chelsea, Brighton–Brentford, Ipswich–Bournemouth.
          United–Villa is <strong>17:30</strong>. Named listings: Dubliners <a href={withBase('/whats-on/')}>What’s On</a> only.
          Say the team when you sit down. Not every game on every screen.
        </li>
        <li>
          <strong>NFL alongside, not instead.</strong> Bengals vs Falcons 15:30 LIVE at Dubliners; more NFL from 19:00 / 22:05 / 22:25 on What’s On.
          The English 15:00 block and the NFL Game overlap on the same street — two rooms, two doors, ninety metres, not a new plan.
        </li>
        <li>
          <strong>21:00 — Atlético vs Barcelona</strong> on Dubliners’ What’s On (Espoz y Mina 7).
          NFL evening screens stay in the same pocket. Coordinate; do not send the Atleti half of the table to another district.
        </li>
      </ol>
      <p>
        If the group splits by sport, split by <em>door on these two streets</em>, not by taxi. Victoria 6 ↔ Matheu 4 ↔ Espoz y Mina 7 is the whole day.
      </p>

      <h2>Four doors on the grid — addresses and Maps</h2>
      <ol>
        <li>
          <strong>Four Corner — Calle de la Victoria 6, 28012 Madrid.</strong>
          Sunday from 14:00 until late · sports screens. Ask. Not open before 14:00.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Reilly’s Restaurant Bar — Pasaje de Matheu 4, 28012 Madrid.</strong>
          Terrace / food between kick-offs. Usual from 11:30. Meeting point; we do not invent its board.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>Dubliners — Calle de Espoz y Mina 7, 28012 Madrid.</strong>
          Sunday from 12:00. Named Premier, NFL and Atlético–Barcelona listings sit here — ask which game is on.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>O’Connell’s — Calle de Espoz y Mina 7, 28012 Madrid</strong> (Maps: O’Connell St).
          Same number, other door. Sunday 8 Nov from 12:00 (usual Sunday 14:00). Next-door overflow; we do not copy Dubliners’ board.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
      </ol>

      <OriginalFourBars lang="en" when="sunday" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Mixed group. Three neighbourhoods?</strong></dt>
        <dd>No. Victoria + Espoz y Mina, Matheu as the cut-through. Four doors. Premier 15:00, NFL later, Atleti 21:00 on the same grid.</dd>
        <dt><strong>All-day order?</strong></dt>
        <dd>Four Corner 14:00 (not before). Premier 15:00 then United 17:30. NFL 15:30 / from 19:00 alongside. Atleti–Barça 21:00 at Dubliners What’s On. Ask which screen.</dd>
        <dt><strong>Does every door show every match?</strong></dt>
        <dd>No. Named listings: Dubliners only. Four Corner has sports screens from 14:00 — ask. Saturday is finished.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Stay on the two streets',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'FIND US — Dubliners home' },
              { href: '/visit/', label: 'GET DIRECTIONS — visit / hours' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/barajas-small-hours-into-sol-until-1400/', label: 'Landed Barajas ~03:00: first door 14:00' },
              { href: '/whats-on/', label: 'What’s On — named screens' },
              { href: PATH_ES, label: 'Dos calles todo el día: Premier, NFL, Atleti', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
