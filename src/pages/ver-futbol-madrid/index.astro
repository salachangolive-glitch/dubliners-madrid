---
import { withBase, absUrl } from '../../site';

const targetPath = '/es/ver-futbol-madrid/';
const targetAbs = absUrl(targetPath);
const targetRel = withBase(targetPath);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Redirigiendo… | Ver fútbol Madrid</title>
    <meta name="robots" content="noindex,follow" />
    <link rel="canonical" href={targetAbs} />
    <meta http-equiv="refresh" content={`0;url=${targetRel}`} />
    <script is:inline define:vars={{ targetRel }}>
      location.replace(targetRel);
    </script>
  </head>
  <body style="font-family:system-ui,sans-serif;background:#0f1410;color:#f3efe6;padding:3rem 1.5rem;text-align:center">
    <p>Esta página se ha movido a <a href={targetRel} style="color:#c9a227">/es/ver-futbol-madrid/</a>.</p>
    <p><a href={targetRel} style="color:#c9a227">Continuar →</a></p>
  </body>
</html>
