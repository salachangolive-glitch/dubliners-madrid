---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, withBase } from '../../site';

const title = 'Ver Fútbol en Madrid | Pub cerca de Sol — Dubliners';
const description =
  'Dónde ver fútbol en Madrid cerca de Puerta del Sol. Pub irlandés con pantallas indoor. Premier, Champions y LaLiga. Espoz y Mina 7.';
---

<BaseLayout
  title={title}
  description={description}
  path="/ver-futbol-madrid/"
  lang="es"
  ogImage="/images/photo-01.jpg"
  hreflang={{ en: '/watch-football-madrid/', es: '/ver-futbol-madrid/' }}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Ver fútbol Madrid" />
      <p class="lang-switch">Also in English: <a href={withBase('/watch-football-madrid/')}>Watch football Madrid</a></p>
      <h1>Dónde ver fútbol en Madrid (cerca de Sol)</h1>
      <p class="lead">
        Dubliners es un pub irlandés en el centro: pantallas indoor a dos minutos de Puerta del Sol.
        Entra cuando quieras — walk-in, sin reserva.
      </p>
      <CtaRow />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>Dónde</h3>
          <p>{SITE.address}. Metro Sol o Sevilla.</p>
        </article>
        <article class="card">
          <h3>Cómo llegar</h3>
          <p>A pie desde la plaza o en Metro. Sin reserva de mesa.</p>
        </article>
        <article class="card">
          <h3>Qué echan</h3>
          <p>Mira <a href={withBase('/whats-on/')}>What’s on</a> o pregunta en barra.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Premier League, Champions y LaLiga</h2>
      <p>
        Ponemos Premier League, Champions League y LaLiga cuando están en nuestras pantallas.
        En partidos grandes, llega un poco antes.
      </p>
      <ul>
        <li><a href={withBase('/premier-league-pub-madrid/')}>Premier League pub Madrid</a></li>
        <li><a href={withBase('/champions-league-bar-madrid/')}>Champions League bar Madrid</a></li>
        <li><a href={withBase('/sports-bar-madrid/')}>Sports bar Madrid</a></li>
        <li><a href={withBase('/football-bar-puerta-del-sol/')}>Bar cerca de Sol</a></li>
      </ul>
      <h2>Ubicación</h2>
      <p>{SITE.address}, {SITE.postal}. Teléfono: <a href={SITE.phoneHref}>{SITE.phone}</a>.</p>
      <div class="faq">
        <details>
          <summary>¿Hay terraza?</summary>
          <p>No — solo interior con pantallas.</p>
        </details>
        <details>
          <summary>¿Hay que reservar?</summary>
          <p>No. Es walk-in. En partidos grandes, mejor llegar pronto.</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
