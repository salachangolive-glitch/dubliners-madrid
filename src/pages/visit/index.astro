---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, HOURS, withBase } from '../../site';

const title = 'Visit Dubliners Madrid | Address, Hours & Map';
const description =
  'Visit Dubliners Irish pub: Calle de Espoz y Mina 7, 28012 Madrid. Phone +34 915 32 79 56. Hours Mon–Wed & Sun 12:00–02:00; Fri–Sat 12:30–02:30.';
---

<BaseLayout title={title} description={description} path="/visit/" ogImage="/images/facade.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Visit" />
        <h1>Visit Dubliners</h1>
        <p class="lead">
          Irish pub near Puerta del Sol — walk in for a pint and live sport on indoor screens.
        </p>
        <CtaRow />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/facade-sm.webp')} 800w, ${withBase('/images/facade.webp')} 1280w`}
          sizes="(max-width: 880px) 100vw, 45vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/facade.jpg')} alt="Dubliners storefront with green neon on Espoz y Mina 7" width="1280" height="720" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Address & phone</h2>
      <div class="card">
        <p style="color:var(--text);margin:0">
          <strong>{SITE.name}</strong><br />
          {SITE.address}<br />
          {SITE.postal}<br />
          Spain<br /><br />
          Phone: <a href={SITE.phoneHref}>{SITE.phone}</a><br />
          Instagram: <a href={SITE.instagram} rel="noopener noreferrer" target="_blank">{SITE.instagramHandle}</a>
        </p>
      </div>

      <h2>Opening hours</h2>
      <table class="hours-table">
        <thead>
          <tr><th>Day</th><th>Hours</th></tr>
        </thead>
        <tbody>
          {HOURS.map((h) => (
            <tr>
              <th scope="row">{h.day}</th>
              <td>{h.hours}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <h2>Getting here</h2>
      <ul>
        <li>Metro: Sol or Sevilla</li>
        <li>About a two-minute walk from Puerta del Sol</li>
        <li>Indoor pub — walk-in, no online table booking</li>
      </ul>

      <div class="map-frame">
        <iframe title="Google Map — Dubliners Madrid" loading="lazy" src={SITE.mapsEmbed}></iframe>
      </div>
      <p style="margin-top:1rem">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Open in Google Maps</a>
      </p>

            <h2>Spot us from the street</h2>
      <p>Look for the green Dubliners neon and the vintage window display on Espoz y Mina.</p>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/window-display-sm.webp')} 800w, ${withBase('/images/window-display.webp')} 1600w`}
          sizes="(max-width: 880px) 100vw, 70vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/window-display.jpg')} alt="Vintage curios in the Dubliners window display on Espoz y Mina" width="1600" height="902" loading="lazy" />
      </picture>
      <picture style="margin-top:1rem;display:block">
        <source
          type="image/webp"
          srcset={`${withBase('/images/window-display-2-sm.webp')} 800w, ${withBase('/images/window-display-2.webp')} 1600w`}
          sizes="(max-width: 880px) 100vw, 70vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/window-display-2.jpg')} alt="Jameson crate and antiques in the Dubliners window" width="1600" height="902" loading="lazy" />
      </picture>

      <h2>Useful links</h2>
      <ul>
        <li><a href={withBase('/whats-on/')}>What’s on</a></li>
        <li><a href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday €1 shots</a></li>
        <li><a href={withBase('/sports-bar-madrid/')}>Sports bar Madrid</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
