---
import MapEmbed from '../../components/MapEmbed.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, HOURS, withBase } from '../../site';
import { hoursSummary } from '../../data/hours';

const title = 'Visit Dubliners Madrid | Near Puerta del Sol — Address, Metro & Map';
const description =
  `Espoz y Mina 7, just off Puerta del Sol. Metro Sol (L1, L2, L3) or Sevilla (L2). Hours ${hoursSummary('en', '; ')}. Green neon facade.`;
---

<BaseLayout title={title} description={description} path="/visit/" ogImage="/images/facade.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Visit" />
        <h1>Find us near Puerta del Sol</h1>
        <p class="lead">
          Indoor Irish pub on Espoz y Mina 7 — just off Puerta del Sol.
          Metro Sol (L1, L2, L3) or Sevilla (L2); look for the green Dubliners neon.
        </p>
        <CtaRow />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/facade-sm.webp')} 800w, ${withBase('/images/facade.webp')} 1280w`}
          sizes="(max-width: 880px) 100vw, 45vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/facade.jpg')} alt="Dubliners storefront with green neon on Espoz y Mina 7" width="1280" height="720" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Address</h2>
      <div class="card">
        <p style="color:var(--text);margin:0">
          <strong>{SITE.name}</strong><br />
          {SITE.address}<br />
          {SITE.postal}<br />
          Spain<br /><br />
          Instagram: <a href={SITE.instagram} rel="noopener noreferrer" target="_blank">{SITE.instagramHandle}</a>
        </p>
      </div>

      <h2>Opening hours</h2>
      <table class="hours-table">
        <thead>
          <tr><th>Day</th><th>Hours</th></tr>
        </thead>
        <tbody>
          {HOURS.map((h) => (
            <tr>
              <th scope="row">{h.day}</th>
              <td>{h.hours}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p>{hoursSummary('en')}.</p>

      <h2>Getting here from Sol</h2>
      <ul>
        <li><strong>Landmark:</strong> Puerta del Sol — we’re on Calle de Espoz y Mina, just off the plaza toward Carrera de San Jerónimo / Sevilla</li>
        <li><strong>Walk:</strong> a short walk from Puerta del Sol / kilometre-zero</li>
        <li><strong>Metro:</strong> Sol (L1, L2, L3) or Sevilla (L2) — both a short street-level walk</li>
        <li>Indoor pub — just walk in; no booking</li>
      </ul>
      <p>
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Open Directions in Google Maps</a>
      </p>

      <div class="map-frame">
        <MapEmbed lang="en" title="Google Map — Dubliners Madrid" />
      </div>

      <h2>Spot us from the street</h2>
      <p>Look for the green Dubliners neon and the vintage window display on Espoz y Mina.</p>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/window-display-sm.webp')} 800w, ${withBase('/images/window-display.webp')} 1600w`}
          sizes="(max-width: 880px) 100vw, 70vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/window-display.jpg')} alt="Vintage curios in the Dubliners window on Espoz y Mina" width="1600" height="902" loading="lazy" />
      </picture>
      <picture style="margin-top:1rem;display:block">
        <source
          type="image/webp"
          srcset={`${withBase('/images/window-display-2-sm.webp')} 800w, ${withBase('/images/window-display-2.webp')} 1600w`}
          sizes="(max-width: 880px) 100vw, 70vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/window-display-2.jpg')} alt="Jameson crate and antiques in the Dubliners window" width="1600" height="902" loading="lazy" />
      </picture>

      <h2>Useful links</h2>
      <ul>
        <li><a href={withBase('/whats-on/')}>What’s on — tonight’s fixtures</a></li>
        <li><a href={withBase('/premier-league-pub-madrid/')}>Premier League nights near Sol</a></li>
        <li><a href={withBase('/champions-league-bar-madrid/')}>Champions League screens</a></li>
        <li><a href={withBase('/sports-bar-madrid/')}>Sports bar Madrid hub</a></li>
        <li><a href={withBase('/international-students-pub-madrid/')}>Erasmus &amp; international students</a></li>
        <li><a href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday €1 shots</a></li>
      </ul>
    </div>
  </section>
</BaseLayout>
