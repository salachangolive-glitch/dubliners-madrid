import OriginalFourBars from '../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_DIR, FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/wake-sol-sunday-premier-block-which-door/';
const PATH_ES = '/es/despierta-sol-bloque-premier-que-puerta/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const DIR = FOUR_BARS_DIR;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Woke up in Madrid: first football is the 15:00 Premier block — which of four Sunday doors',
  inLanguage: 'en',
  datePublished: '2026-11-08T01:00:00+01:00',
  dateModified: '2026-11-08T01:00:00+01:00',
  image: absUrl('/images/screens-sports.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'I woke up in Madrid. What is my first football today, and which door should I aim for?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'The first English football today is the 15:00 Premier League block: Crystal Palace vs Liverpool, Sunderland vs Chelsea, Brighton vs Brentford, Ipswich Town vs Bournemouth. United vs Villa is 17:30. Named listings are on Dubliners’ What’s On (Espoz y Mina 7, from 12:00). Four Corner (Victoria 6) opens 14:00 with sports screens — one hour before 15:00; ask which game is on. O’Reilly’s (Matheu 4, from 11:30) is food/terrace first. O’Connell’s (Espoz y Mina 7, from 12:00 today) is the next-door meeting point. Do not aim at Four Corner before 14:00.',
      },
    },
    {
      '@type': 'Question',
      name: 'Does every Sunday door show Palace–Liverpool or United–Villa?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. Named Premier League listings are at Dubliners only. We do not invent O’Reilly’s, O’Connell’s or Four Corner boards. Ask which game is on. Not every game on every screen. NFL at 15:30 / from 19:00 and Atlético–Barcelona at 21:00 sit alongside the same afternoon — they are not replaced by this page.',
      },
    },
    {
      '@type': 'Question',
      name: 'Is Saturday’s leftover night or Valencia–Real Madrid still the plan?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'No. You are waking on Sunday 8 November. The Saturday 18:00–19:00 meetup and Valencia vs Real Madrid 21:00 (Dubliners only) are finished. Today starts with the 15:00 Premier block, then United–Villa 17:30.',
      },
    },
  ],
};
---

<BaseLayout
  title="Woke in Madrid: 15:00 Premier block — which Sunday door | Dubliners"
  description="Sunday 8 Nov: you woke in Madrid. First football is 15:00 Palace–Liverpool, Chelsea, Brighton, Ipswich; United 17:30. Which of four Sol doors. Maps. FIND US."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/screens-sports.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Woke up: 15:00 Premier — which Sunday door" schema />
      <h1>Woke up in Madrid: first football is the 15:00 Premier block — which of four Sunday doors</h1>
      <p class="lead">
        You are not finishing Saturday. You are waking on Sunday 8 November.
        <strong>Your first football today is 15:00:</strong> Palace–Liverpool, Sunderland–Chelsea, Brighton–Brentford, Ipswich–Bournemouth.
        Then United–Villa at 17:30. Four sister doors near Sol. Aim by clock, not by last night.
        Named Premier listings: Dubliners What’s On only. Ask which game is on.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Despiertas en Madrid: el primer fútbol es el bloque Premier 15:00</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walk Espoz y Mina 7</a>
        <a class="btn btn-secondary" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Maps</a>
        <a class="btn btn-secondary" href={withBase('/4-bars-one-fan-weekend/')}>MEET US NEAR SOL</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>This is a wake-up choice, not last night and not a fixture dump</h2>
      <p>
        Other pages already list the five English games, the 15:00 cluster versus the 15:30 NFL Game,
        the 17:30 United–Villa gap, leftover Saturday hours until Premier, and terrace-versus-screens on Sunday.
        This page is only the English or tourist fan <strong>waking in Madrid today</strong>:
        first kick-off you care about is 15:00, then 17:30 — <strong>which of the four Sunday doors to walk to</strong>.
        Saturday 18:00–19:00 and Valencia–RM 21:00 are finished. Do not treat them as still on.
      </p>

      <h2>The clock you woke into</h2>
      <p>
        Madrid time, Sunday 8 November. First English football:
      </p>
      <ul>
        <li><strong>15:00</strong> — Crystal Palace vs Liverpool</li>
        <li><strong>15:00</strong> — Sunderland vs Chelsea</li>
        <li><strong>15:00</strong> — Brighton vs Brentford</li>
        <li><strong>15:00</strong> — Ipswich Town vs Bournemouth</li>
        <li><strong>17:30</strong> — Manchester United vs Aston Villa</li>
      </ul>
      <p>
        Those five already sit on <a href={withBase('/whats-on/')}>What’s On</a> as Dubliners screens.
        Thirty minutes after 15:00, Bengals vs Falcons is 15:30 LIVE on our big screen.
        NFL from 19:00 and Atlético vs Barcelona 21:00 stay on the same streets.
        <strong>Coordinate; do not substitute.</strong> Say the team when you sit down.
      </p>

      <h2>Which of the four Sunday doors — for a 15:00 start, then 17:30</h2>
      <ol>
        <li>
          <strong>Named Premier board → Dubliners, Calle de Espoz y Mina 7.</strong>
          Open from 12:00. That is the door if you want the listings already on What’s On
          (Palace–Liverpool, Chelsea, Brighton, Ipswich at 15:00; United–Villa at 17:30).
          The big screen is already confirmed for Bengals–Falcons 15:30 — ask which other screen carries your team.
          {' '}<a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.dubliners} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>Sports-screens door that opens one hour before 15:00 → Four Corner, Calle de la Victoria 6.</strong>
          Opens <strong>14:00</strong>, not before. Sports screens. We do not list which Premier game it shows.
          Aim here if you want to be in a sports room from 14:00 and ask at the bar.
          Do not walk over at 12:00 expecting a pint.
          {' '}<a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.fourCorner} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>Food / terrace first, then hop → O’Reilly’s Restaurant Bar, Pasaje de Matheu 4.</strong>
          From 11:30. About 1 minute / 90 m from Espoz y Mina 7, about 2 minutes from Victoria 6.
          Meeting point with a terrace if you woke hungry before any 15:00 whistle. We do not invent its Premier board.
          {' '}<a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oreillys} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
        <li>
          <strong>Next-door sports pub → O’Connell’s, Calle de Espoz y Mina 7</strong> (Maps: O’Connell St).
          Sunday 8 Nov from 12:00 (usual Sunday 14:00). Same number as Dubliners, different door.
          Meeting point if Dubliners is full at 15:00; we do not copy Dubliners’ What’s On onto this pin.
          {' '}<a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>
          {' · '}<a href={DIR.oconnell} rel="noopener noreferrer" target="_blank">Walking directions</a>.
        </li>
      </ol>
      <p>
        Practical aim if you care about a named 15:00 team: be on Espoz y Mina 7 by 14:30 (Dubliners from 12:00).
        If you care about sitting in a sports-screens room from the moment it opens: Victoria 6 at 14:00, then stay or hop 2 minutes.
        United–Villa 17:30 does not need a new neighbourhood — same four doors, same Maps CIDs.
      </p>

      <OriginalFourBars lang="en" when="sunday" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Woke in Madrid. First football today, which door?</strong></dt>
        <dd>15:00 Premier block, then United 17:30. Named board: Dubliners from 12:00. Sports screens from 14:00: Four Corner (ask). Food first: O’Reilly’s 11:30. Next door: O’Connell’s from 12:00. Not Four Corner before 14:00.</dd>
        <dt><strong>Does every door show Palace–Liverpool or United–Villa?</strong></dt>
        <dd>No. Named Premier listings: Dubliners What’s On only. Ask. NFL 15:30/19:00 and Atleti–Barça 21:00 sit alongside.</dd>
        <dt><strong>Is Saturday leftover night or Valencia–RM still the plan?</strong></dt>
        <dd>No. Those are finished. Today starts at 15:00 English football.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Sunday wake-up, then the four doors',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'FIND US — Dubliners home' },
