              { href: '/premier-league-sunday-sol-8-nov/', label: 'Premier League Sunday near Sol' },
              { href: PATH_ES, label: 'Despiertas: bloque Premier 15:00 — qué puerta', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
