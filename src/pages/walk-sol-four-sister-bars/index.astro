---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/walk-sol-four-sister-bars/';
const PATH_ES = '/es/andar-sol-cuatro-bares-hermanos/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Walk from Sol to the four sister bars — tonight vs Sunday',
  inLanguage: 'en',
  datePublished: '2026-11-07T18:30:00+01:00',
  dateModified: '2026-11-07T18:30:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Which way do I walk from Puerta del Sol?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'South-east, toward Plaza de Santa Ana, not Gran Vía. Pasaje de Matheu, Espoz y Mina and Calle de la Victoria sit in that pocket. Metro Sol (L1, L2, L3) or Sevilla (L2).',
      },
    },
    {
      '@type': 'Question',
      name: 'Can I walk to Four Corner tonight?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'You can walk past Calle de la Victoria 6, but Four Corner is not open Saturday. It opens Sunday 8 November from 14:00 until late, with sports screens.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which door is first if I come from Metro Sevilla?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'From Sevilla (L2) you are already on the east side of Sol. Espoz y Mina 7 (Dubliners and O’Connell’s) is the nearest pin. Pasaje de Matheu 4 is the next passage. Victoria 6 is Sunday from 14:00.',
      },
    },
  ],
};
---

<BaseLayout
  title="Walk from Sol to the four sister bars | Dubliners"
  description="How to walk from Puerta del Sol to O’Reilly’s, Dubliners, O’Connell’s and Four Corner. Tonight three doors; Sunday add Victoria 6 from 14:00. Maps and CTAs."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Walk from Sol to the four bars" schema />
      <h1>How to walk from Sol to the four sister bars (tonight vs Sunday)</h1>
      <p class="lead">
        The four addresses are a short walk south-east of Puerta del Sol — not a night-bus plan.
        <strong>Tonight:</strong> stop at Pasaje de Matheu 4 and Espoz y Mina 7 (meetup 18:00–19:00).
        <strong>Sunday from 14:00:</strong> add Four Corner at Calle de la Victoria 6 (sports screens).
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Andar desde Sol a los cuatro bares hermanos</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Maps</a>
        <a class="btn btn-secondary" href={withBase('/4-bars-one-fan-weekend/')}>MEET US NEAR SOL</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>From the square, look south-east</h2>
      <p>
        Metro Sol (L1, L2, L3) drops you on the square. Sevilla (L2) is even closer to these streets.
        Walk toward Plaza de Santa Ana, not toward Gran Vía. You want the small streets behind the east side of Sol:
        Pasaje de Matheu, Calle de Espoz y Mina, Calle de la Victoria.
      </p>

      <h2>Tonight — three pins, skip Victoria 6</h2>
      <p>
        Saturday 7 November has <strong>no official NFL game</strong>. The walk is a meetup, then LaLiga at Dubliners.
      </p>
      <ol>
        <li>
          <strong>O’Reilly’s — Pasaje de Matheu 4.</strong> First restaurant-bar with a terrace if you arrive from the square.
          Open 11:30–01:30. <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>.
        </li>
        <li>
          <strong>Dubliners — Espoz y Mina 7.</strong> Next street, same block. Saturday 12:00–02:30.
          Valencia vs Real Madrid 21:00 LIVE here only. <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>.
        </li>
        <li>
          <strong>O’Connell’s — Espoz y Mina 7.</strong> Same street number (Maps: O’Connell St). Saturday from 15:00.
          <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>.
        </li>
      </ol>
      <p>
        You will pass Calle de la Victoria on the way. Four Corner at number 6 is <strong>Sunday from 14:00</strong>, not a Saturday door.
        Pin it for tomorrow: <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Four Corner on Maps</a>.
      </p>

      <h2>Sunday — the fourth door from 14:00</h2>
      <p>
        Same walk, one extra stop. O’Reilly’s from 11:30, Dubliners and O’Connell’s from 12:00, Four Corner from 14:00 until late with sports screens.
        Bengals vs Falcons is 15:30 at the Bernabéu and on Dubliners’ big screen. Ask which game is on — not every game on every screen.
      </p>

      <OriginalFourBars lang="en" when="tonight" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Which way do I walk from Puerta del Sol?</strong></dt>
        <dd>South-east toward Santa Ana. Metro Sol (L1, L2, L3) or Sevilla (L2).</dd>
        <dt><strong>Can I walk to Four Corner tonight?</strong></dt>
        <dd>The street is there; the bar opens Sunday 8 Nov from 14:00, with sports screens.</dd>
        <dt><strong>Which door is first from Metro Sevilla?</strong></dt>
        <dd>Espoz y Mina 7 (Dubliners and O’Connell’s), then Pasaje de Matheu 4. Victoria 6 on Sunday.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Maps and meetup',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'Dubliners home' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/meetup-1800-pasaje-matheu-espoz-mina/', label: 'Meetup 18:00–19:00 walking order' },
              { href: '/saturday-in-sol-today/', label: 'Saturday in Sol today' },
              { href: '/four-corner-opens-sunday-1400/', label: 'Four Corner Sunday 14:00' },
              { href: PATH_ES, label: 'Andar desde Sol', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
