---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, withBase } from '../../site';

const title = 'Watch Football in Madrid | Pub near Sol — Dubliners';
const description =
  'Where to watch football in Madrid near Puerta del Sol. Walk-in Irish pub with indoor screens for PL, CL, LaLiga when on. Espoz y Mina 7.';
---

<BaseLayout
  title={title}
  description={description}
  path="/watch-football-madrid/"
  hreflang={{ en: '/watch-football-madrid/', es: '/ver-futbol-madrid/' }}
>
  <section class="section">
    <div class="container prose">
      <Breadcrumb current="Watch football Madrid" />
      <p class="lang-switch">Also in Spanish: <a href={withBase('/ver-futbol-madrid/')}>Ver fútbol Madrid</a></p>
      <h1>Where to watch football in Madrid (near Sol)</h1>
      <p class="lead">
        Dubliners is a football pub in Madrid centro — indoor screens a short walk from Puerta del Sol.
        Walk in for the match when fixtures are showing. No reservations.
      </p>
      <CtaRow />

      <h2>How match nights work</h2>
      <ul>
        <li>Walk-in Irish pub — no table booking</li>
        <li>Multiple indoor screens</li>
        <li>Arrive early for big kickoffs</li>
        <li>Ask staff or check <a href={withBase('/whats-on/')}>What’s on</a> for tonight</li>
      </ul>

      <h2>Premier League, Champions League & LaLiga</h2>
      <p>
        We show Premier League, Champions League and LaLiga fixtures <strong>when they are on our screens</strong> —
        not a promise of every match. For competition-focused pages:
      </p>
      <ul>
        <li><a href={withBase('/premier-league-pub-madrid/')}>Premier League pub Madrid</a></li>
        <li><a href={withBase('/champions-league-bar-madrid/')}>Champions League bar Madrid</a></li>
        <li><a href={withBase('/sports-bar-madrid/')}>Sports bar Madrid</a></li>
      </ul>
      <p>
        LaLiga nights are popular with locals and visitors alike. Same rule: when it’s scheduled on our screens, you can watch here.
      </p>

      <h2>Already in Madrid or staying near Sol?</h2>
      <p>
        If your hotel is near Puerta del Sol, you’re about a two-minute walk from Calle de Espoz y Mina 7.
        See <a href={withBase('/football-bar-puerta-del-sol/')}>football bar near Puerta del Sol</a> for walking directions.
      </p>
      <p class="note">
        After a Bernabéu match, Metro back to Sol and walk in for a pint or a later fixture when on — we’re centro, not stadium-adjacent.
      </p>

      <h2>FAQ</h2>
      <div class="faq">
        <details>
          <summary>Can I watch soccer here (US visitors)?</summary>
          <p>Yes — football/soccer on indoor screens when fixtures are on. Walk-in near Sol.</p>
        </details>
        <details>
          <summary>Do you show every Premier League or Champions League match?</summary>
          <p>No. We show fixtures when they are on our screens. Ask staff or check What’s on.</p>
        </details>
        <details>
          <summary>Address & phone</summary>
          <p>{SITE.address}, {SITE.postal} · <a href={SITE.phoneHref}>{SITE.phone}</a></p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
