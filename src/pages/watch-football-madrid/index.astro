---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, withBase } from '../../site';
import { hoursSummary } from '../../data/hours';

const title = 'Where to Watch Football in Madrid | Pub near Sol — Dubliners';
const description =
  'Watch football near Puerta del Sol. Indoor screens for Premier League, Champions League and LaLiga when they’re on. Espoz y Mina 7.';
---

<BaseLayout
  title={title}
  description={description}
  path="/watch-football-madrid/"
  canonicalPath="/sports-bar-madrid/"
  ogImage="/images/screens-sports.jpg"
>
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Watch football Madrid" schema />
        <h1>Watch football near Sol</h1>
        <p class="lead">
          Indoor Irish pub on Espoz y Mina 7 — Premier League, Champions League and LaLiga
          when they’re on the screens. Just off the plaza.
        </p>
        <CtaRow />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/screens-sports-sm.webp')} 800w, ${withBase('/images/screens-sports.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 45vw"
        />
        <img class="hero-photo landscape" src={withBase('/images/screens-sports.jpg')} alt="Football on big screens at Dubliners" width="1400" height="788" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>Where</h3>
          <p>{SITE.address} — Metro Sol or Sevilla.</p>
        </article>
        <article class="card">
          <h3>How to get there</h3>
          <p>Walk from the plaza or Metro to Sol, then on to Espoz y Mina 7.</p>
        </article>
        <article class="card">
          <h3>What’s on</h3>
          <p>See <a href={withBase('/whats-on/')}>this week’s fixtures</a>, or ask staff tonight.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Which football we show</h2>
      <p>
        Most weeks the screens carry the Premier League, LaLiga, the Champions League, the Europa League and the
        Conference League, plus Copa del Rey ties and the bigger Scottish games. Two matches at the same time go
        on different screens, with the main one on the big projector. Every listed kick-off is in Madrid time.
      </p>
      <h2>This week</h2>
      <p>
        The live list is <a href={withBase('/whats-on/')}>What’s On</a>: it shows the fixtures for the next days and marks
        what is LIVE on our screens. If a game you want is not listed, ask at the bar before you come.
      </p>
      <h2>Getting here from Sol</h2>
      <p>
        We are at {SITE.address}, a short walk from Puerta del Sol. Metro Sol (lines 1, 2 and 3) or Sevilla (line 2).
        Opening hours: {hoursSummary('en')}. For big matches, arrive a little before kick-off.
      </p>
      <h2>Visiting fans and groups</h2>
      <p>
        In Madrid for an away game? We are in the centre, not next to the Bernabéu or the Metropolitano, so it works
        before you head to the stadium or for the other matches of the night. Groups are welcome. Food and drinks are on our <a href={withBase('/menu/')}>menu</a>.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <p class="small">In Madrid on Sunday 25 October? <a href={withBase('/el-clasico-madrid/')}>Where to watch El Clásico (Barça vs Real Madrid, 21:00)</a></p>
      <p class="small">Brighton fans in Madrid for 5 November? <a href={withBase('/brighton-fans-madrid/')}>Getafe vs Brighton guide</a></p>
      <p class="small">England fans in Madrid for 15 November? <a href={withBase('/england-fans-madrid/')}>Spain vs England guide</a></p>
      <h2>Centro base for match nights</h2>
      <p>
        If you’re already staying near Sol, you’re close. We put fixtures on when they’re showing —
        for big nights, arrive a little early.
      </p>
      <ul>
        <li><a href={withBase('/premier-league-pub-madrid/')}>Premier League pub Madrid</a></li>
        <li><a href={withBase('/champions-league-bar-madrid/')}>Champions League bar Madrid</a></li>
        <li><a href={withBase('/sports-bar-madrid/')}>Sports bar Madrid</a></li>
      </ul>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>After the Bernabéu</h2>
      <p>
        We’re in Sol / centro — not next to the stadium. Metro back to Sol, then come in
        for a pint or a later fixture when it’s showing.
      </p>
      <div class="faq">
        <details>
          <summary>Can I watch soccer here (US visitors)?</summary>
          <p>Yes — football/soccer on indoor screens near Sol.</p>
        </details>
        <details>
          <summary>Do you show every Premier League or Champions League match?</summary>
          <p>We put fixtures on when they’re showing here. Check What’s on or ask the bar.</p>
        </details>
        <details>
          <summary>Address</summary>
          <p>{SITE.address}, {SITE.postal}</p>
        </details>
      </div>
    </div>
  </section>
</BaseLayout>
