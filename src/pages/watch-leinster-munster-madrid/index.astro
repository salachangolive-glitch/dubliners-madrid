---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import { SITE, withBase, absUrl } from '../../site';
import { hoursFor } from '../../data/hours';

// Leinster v Munster, URC, Aviva Stadium (Dublin), Sat 24 Oct 2026, 18:00 Irish time = 19:00 Madrid (CEST).
// Source: munsterrugby.ie fixture 447 (data-start-time 1793466000 = 2026-10-24T17:00Z) + avivastadium.ie event page («Kick Off: 18:00»), 19 Oct 2026.
// Page stays indexed after the match; review on 25 Oct (PENDIENTES.md).
const path = '/watch-leinster-munster-madrid/';
const title = 'Watch Leinster v Munster in Madrid, Sat 24 Oct | Dubliners';
const description =
  'Leinster v Munster (URC), Saturday 24 October, 19:00 Madrid time: Irish fans meeting point at Dubliners, by Puerta del Sol. LIVE on our screens.';
const saturday = hoursFor('Saturday');

const eventLd = {
  '@context': 'https://schema.org',
  '@type': 'SportsEvent',
  name: 'Leinster v Munster — United Rugby Championship (screening at Dubliners Madrid)',
  description:
    'Leinster v Munster (URC, Aviva Stadium, Dublin) shown LIVE on the screens at Dubliners Irish Pub, Espoz y Mina 7, near Puerta del Sol, Madrid.',
  startDate: '2026-10-24T19:00:00+02:00',
  eventStatus: 'https://schema.org/EventScheduled',
  eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
  location: {
    '@type': 'BarOrPub',
    name: 'Dubliners Irish Pub',
    alternateName: 'Dubliners Madrid',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Calle de Espoz y Mina 7',
      addressLocality: 'Madrid',
      postalCode: '28012',
      addressCountry: 'ES',
    },
    geo: { '@type': 'GeoCoordinates', latitude: 40.4158342, longitude: -3.7022626 },
    hasMap: SITE.gbpUrl,
  },
  organizer: { '@type': 'BarOrPub', name: 'Dubliners Irish Pub', url: absUrl('/') },
  homeTeam: { '@type': 'SportsTeam', name: 'Leinster' },
  awayTeam: { '@type': 'SportsTeam', name: 'Munster' },
  url: absUrl(path),
};
---

<BaseLayout title={title} description={description} path={path} lang="en" hreflang={{ en: path }} ogImage="/images/screens-sports.jpg" extraJsonLd={eventLd}>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="Leinster v Munster in Madrid" schema />
      <h1>Watch Leinster v Munster in Madrid</h1>
      <p class="lead">
        Saturday 24 October 2026, kick-off 19:00 Madrid time (18:00 in Ireland). United Rugby Championship, Aviva Stadium, Dublin.
        In Madrid for the weekend? Dubliners is the fans meeting point for Irish rugby fans, just off Puerta del Sol.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.gbpUrl} rel="noopener noreferrer" target="_blank">Directions</a>
        <a class="btn btn-primary" href={withBase('/whats-on/')}>What’s On</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container split">
      <div class="prose">
        <h2>The match</h2>
        <p>
          Leinster host Munster in the URC at the Aviva Stadium. It is the interprovincial derby, and we show it LIVE on the big projector
          and our 8 screens. Times on this page are Madrid time: Madrid is one hour ahead of Dublin.
        </p>
        <h2>Fans meeting point for Irish rugby fans</h2>
        <p>
          Leinster or Munster, living in Madrid or here for a city break: come and watch it with other Irish fans.
          For a derby like this, arrive a little before kick-off.
        </p>
        <h2>Getting here</h2>
        <p>
          {SITE.address}, {SITE.postal}, a short walk from Puerta del Sol. Metro Sol (lines 1, 2 and 3) or Sevilla (line 2).
          Saturday hours: {saturday}.
        </p>
      </div>
      <picture>
        <img class="split-photo tall" src={withBase('/images/dubliners-projector-screens-sol-1200.webp')} srcset={`${withBase('/images/dubliners-projector-screens-sol-800.webp')} 800w, ${withBase('/images/dubliners-projector-screens-sol-1200.webp')} 1200w`} sizes="(max-width: 800px) 100vw, 720px" width="1200" height="1600" loading="lazy" decoding="async" alt="Big projector and screens in the main room at Dubliners, near Sol" />
      </picture>
    </div>
  </section>

  <section class="section band">
    <div class="container split reverse">
      <div class="prose">
        <h2>More Irish rugby on our screens</h2>
        <p>
          The next weeks bring more for Irish fans: Connacht v Leinster (Friday 30 October), Munster v Sharks (Saturday 31 October)
          and Ireland v Argentina in the Nations Championship (Friday 6 November). Times and the full list are on
          <a href={withBase('/whats-on/')}>What’s On</a>, and the other sport we show is on our <a href={withBase('/sports-bar-madrid/')}>sports bar in Madrid</a> page.
        </p>
        <h2>FAQ</h2>
        <dl class="faq">
          <dt><strong>What time is Leinster v Munster in Madrid?</strong></dt>
          <dd>19:00 Madrid time on Saturday 24 October 2026 (18:00 Irish time).</dd>
          <dt><strong>Are you showing it live?</strong></dt>
          <dd>Yes, LIVE on the projector and screens.</dd>
          <dt><strong>Where are you?</strong></dt>
          <dd>{SITE.address}, {SITE.postal}, by Puerta del Sol. Metro Sol or Sevilla.</dd>
        </dl>
      </div>
      <picture>
        <img class="split-photo tall" src={withBase('/images/dubliners-projector-main-room-madrid-v2-1200.webp')} srcset={`${withBase('/images/dubliners-projector-main-room-madrid-v2-800.webp')} 800w, ${withBase('/images/dubliners-projector-main-room-madrid-v2-1200.webp')} 1200w`} sizes="(max-width: 800px) 100vw, 720px" width="1200" height="1600" loading="lazy" decoding="async" alt="Main room with the projector and TVs at Dubliners Madrid" />
      </picture>
    </div>
  </section>
</BaseLayout>
