---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, withBase } from '../../site';

const title = 'Wednesday €1 Shots Madrid | Dubliners near Sol';
const description =
  'Wednesday €1 shots at Dubliners near Sol. Espoz y Mina 7. Four Corner after-party Wednesdays only, Victoria 6 until 05:30.';
---

<BaseLayout title={title} description={description} path="/wednesday-1-euro-shots-madrid/" ogImage="/images/interior-vert.jpg">
  <section class="hero hero-compact">
    <div class="container hero-grid">
      <div>
        <Breadcrumb current="Wednesday €1 shots" />
        <span class="badge">Every Wednesday</span>
        <h1>Wednesday · €1 SHOTS</h1>
        <p class="lead">
          €1 shots at an Irish pub a short walk from Sol.
          Ask at the bar when you arrive.
        </p>
        <CtaRow showWednesday={false} />
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/interior-vert-sm.webp')} 506w, ${withBase('/images/interior-vert.webp')} 900w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img class="hero-photo portrait" src={withBase('/images/interior-vert.jpg')} alt="Interior room at Dubliners on a Wednesday night" width="900" height="1600" loading="eager" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="card-grid cols-3">
        <article class="card">
          <h3>The deal</h3>
          <p>Shots at €1 on Wednesdays. Ask the bar team for details.</p>
        </article>
        <article class="card">
          <h3>Where</h3>
          <p>{SITE.address}, {SITE.postal} — Metro Sol or Sevilla.</p>
        </article>
        <article class="card">
          <h3>Pub hours</h3>
          <p>Wednesday 12:00–02:00. Then Four Corner until 05:30 if you fancy it.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container prose">
      <h2>Four Corner After Party — Wednesday only</h2>
      <p>
        On <strong>Wednesdays only</strong>, the night can continue at Four Corner After Party,
        <strong>Calle Victoria 6</strong>, until <strong>05:30</strong>.
      </p>
      <p>A few minutes from Dubliners — ask on the night if you’re heading over.</p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Make a night of it</h2>
      <p>
        Start at Dubliners, catch whatever’s on the screens, then decide on Four Corner.
        See also <a href={withBase('/international-students-pub-madrid/')}>international students</a>
        or <a href={withBase('/whats-on/')}>What’s on</a>.
      </p>
      <div class="faq">
        <details>
          <summary>Do I need a ticket or guest list?</summary>
          <p>Not for Dubliners. For Four Corner, ask on the night.</p>
        </details>
        <details>
          <summary>Is Four Corner every night?</summary>
          <p>No — Wednesdays only, Calle Victoria 6, until 05:30.</p>
        </details>
        <details>
          <summary>Contact</summary>
          <p><a href={SITE.instagram} rel="noopener noreferrer" target="_blank">{SITE.instagramHandle}</a></p>
        </details>
      </div>
      <div class="map-frame" style="margin-top:1.5rem">
        <iframe title="Map to Dubliners Wednesday shots" loading="lazy" src={SITE.mapsEmbed}></iframe>
      </div>
    </div>
  </section>
</BaseLayout>
