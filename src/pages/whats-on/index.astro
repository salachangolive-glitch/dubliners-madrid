---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import { SITE, withBase } from '../../site';
import { FIXTURES, PREVIEW_TODAY } from '../../data/fixtures';

const title = "What's On at Dubliners Madrid | Live Sport & Nights";
const description =
  "What's on at Dubliners Madrid this week — live sport on screens, Wednesday €1 shots. Walk-in near Puerta del Sol. Call +34 915 32 79 56.";

const today = FIXTURES.filter((f) => f.dateKey === PREVIEW_TODAY);
const week = FIXTURES.filter((f) => f.dateKey >= PREVIEW_TODAY);
---

<BaseLayout title={title} description={description} path="/whats-on/" ogImage="/images/photo-02.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="What's on" />
      <h1>What’s on</h1>
      <p class="lead">
        Live sport on our indoor screens — and Wednesday €1 shots when you’re in for a midweek night.
        Walk in, grab a seat if one’s free, and ask the team what’s showing.
      </p>
      <CtaRow showWhatsOn={false} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="fixture-board">
        <div class="fixture-col">
          <h2>Today</h2>
          {today.length === 0 ? (
            <p class="empty-slot">Nothing listed for today — ask at the bar what’s on the screens.</p>
          ) : (
            <ul class="fixture-list">
              {today.map((f) => (
                <li>
                  <span class="fx-time">{f.madridTime}</span>
                  <span class="fx-body">
                    <strong>{f.teams}</strong>
                    <em>{f.competition}</em>
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
        <div class="fixture-col">
          <h2>This week</h2>
          {week.length === 0 ? (
            <p class="empty-slot">This week’s list will appear here when fixtures are ready.</p>
          ) : (
            <ul class="fixture-list">
              {week.map((f) => (
                <li>
                  <span class="fx-day">{f.whenLabel}</span>
                  <span class="fx-time">{f.madridTime}</span>
                  <span class="fx-body">
                    <strong>{f.teams}</strong>
                    <em>{f.competition}</em>
                  </span>
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>
      <p class="fx-note">
        Times are Madrid (CEST). Screens and coverage can change — call or ask staff on the night.
      </p>
      <div class="cta-row">
        <a class="btn btn-primary" href={SITE.phoneHref}>Call {SITE.phone}</a>
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
      </div>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div>
        <h2>Wednesday highlight</h2>
        <p>
          €1 shots every Wednesday — a favourite with the international crowd.
          Four Corner After Party continues the night on Calle Victoria 6 (Wednesdays only) until 05:30.
        </p>
        <a class="btn btn-secondary" href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday nights →</a>
      </div>
      <picture>
        <source srcset={withBase('/images/photo-04.webp')} type="image/webp" />
        <img src={withBase('/images/photo-04.jpg')} alt="Pint at Dubliners Madrid" class="split-photo" width="500" height="600" loading="lazy" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>More match nights</h2>
      <ul>
        <li><a href={withBase('/sports-bar-madrid/')}>Sports bar Madrid</a></li>
        <li><a href={withBase('/watch-football-madrid/')}>Watch football Madrid</a></li>
        <li><a href={withBase('/premier-league-pub-madrid/')}>Premier League pub</a></li>
        <li><a href={withBase('/champions-league-bar-madrid/')}>Champions League bar</a></li>
      </ul>
      <h2>Visit</h2>
      <p>{SITE.address}, {SITE.postal} · <a href={withBase('/visit/')}>Hours & map</a></p>
    </div>
  </section>
</BaseLayout>
