---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import FixtureBoard from '../../components/FixtureBoard.astro';
import LinkHub from '../../components/LinkHub.astro';
import { SITE, withBase, absUrl } from '../../site';
import { agendaAt, sportsEventsJsonLd } from '../../data/fixtures';

const title =
  'What\'s On: Live Sport This Week | Dubliners Madrid';
const description =
  'Live sport this week at Dubliners, Espoz y Mina 7: football, NFL, rugby, NBA and more in Madrid time, with what is LIVE on our screens.';

// One agenda for EN + ES (same filter, same range, Europe/Madrid).
const { todayKey, today, upcoming } = agendaAt();
const sportsEvents = sportsEventsJsonLd([...today, ...upcoming], {
  pageUrl: absUrl('/whats-on/'),
  lang: 'en',
});
---

<BaseLayout
  title={title}
  description={description}
  path="/whats-on/"
  ogImage="/images/screens-sports.jpg"
  extraJsonLd={sportsEvents}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="What's on" />
      <h1>What’s On at Dubliners — live sport this week</h1>
      <p class="lead">
        See this week’s live sport at Dubliners — football, NFL, NBA, rugby, Formula 1, tennis and more.
        Times are Madrid time. Matches marked LIVE are on our 8 screens.
      </p>
      <CtaRow showWhatsOn={false} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <FixtureBoard lang="en" today={today} upcoming={upcoming} />
      <p class="fx-note">
        Times are Madrid time. LIVE = showing on our screens.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
        <a class="btn btn-primary" href={withBase('/contact/')}>Contact</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Live sports at Dubliners</h2>
      <p>
        Dubliners is an Irish pub just off Puerta del Sol — Espoz y Mina 7, Metro Sol or Sevilla.
        We put major live sport on our indoor screens when it’s confirmed: football, NFL, NBA, rugby,
        Formula 1, tennis and more. Check What’s On above for this week’s schedule, or ask at the bar
        if you’re looking for a specific game.
      </p>
      <p>
        How the screens work and which sports we show: <a href={withBase('/sports-bar-madrid/')}>our sports bar in Madrid</a>.
      </p>
      {todayKey <= '2026-11-01' && (
        <p data-show-until="2026-11-01">
          This week’s live sports (26 Oct–1 Nov, Madrid time): Monday Sevilla–Osasuna 21:00 · Thursday 29 Real Madrid–Fenerbahçe (EuroLeague) 20:45 and the Copa del Rey tie Sporting Hortaleza–Sevilla 21:00 · Friday Villarreal–Espanyol 21:00 · Saturday 31 is Halloween at Dubliners from 19:00, with the day’s games on screen too, Barça–Alavés 21:00 among them · Sunday 1, the night before Monday’s bank holiday: Racing–Real Madrid 16:15, Liverpool–Arsenal 17:30, NFL from 19:00, the F1 Mexico City Grand Prix 21:00 and Athletic–Real Sociedad 21:00. Confirmed on our screens; clashes go on different screens.
        </p>
      )}
      {todayKey <= '2026-10-10' && (
        <p data-show-until="2026-10-10">
          Saturday at Dubliners is packed: Arsenal–Leeds 13:30, Rayo–Athletic 14:00, Alavés–Atlético 16:15, Man Utd–Spurs with Barça–Getafe and Ulster–Munster at 18:30, then Leinster–Cardiff 20:45 and Real Madrid–Villarreal 21:00 — Confirmed on our screens; clashes go on different screens.
        </p>
      )}
    </div>
  </section>

  <section class="section band" id="sport-guides">
    <div class="container">
      <h2>Explore live sport at Dubliners</h2>
      <LinkHub
        heading="h3"
        groups={[
          {
            title: 'Football & rugby',
            id: 'football-rugby',
            items: [
              { href: '/premier-league-pub-madrid/', label: 'Premier League' },
              { href: '/champions-league-bar-madrid/', label: 'Champions League' },
              { href: '/sports-bar-madrid/', label: 'Live football, NFL and rugby near Sol' },
              { href: '/brighton-fans-madrid/', label: 'Brighton fans in Madrid' },
              { href: '/ireland-rugby-madrid/', label: 'Ireland rugby in Madrid', note: '6, 14 & 21 November' },
            ],
          },
          {
            title: 'NFL & American sports',
            id: 'nfl-american-sports',
            items: [
              { href: '/nfl-madrid/', label: 'NFL in Madrid' },
              { href: '/nfl-sunday-madrid-1-november/', label: 'NFL Sunday, 1 November', note: '19:00 · 22:05 · 22:25 · bank holiday Monday', until: '2026-11-01' },
              { href: '/nfl-sunday-madrid-guide/', label: 'NFL Sunday guide', note: 'Hour by hour, Sunday 8 November' },
            ],
          },
          {
            title: 'Food & drinks',
            id: 'food-drinks',
            items: [{ href: '/menu/', label: 'Food menu' }],
          },
        ]}
      />
    </div>
  </section>

  <section class="section" id="whats-new">
    <div class="container">
      <h2>What’s new</h2>
      <LinkHub
        heading="h3"
        groups={[
          {
            title: 'Offers & events',
            items: [
              { href: '/halloween-madrid-2026/', label: 'Halloween in Madrid near Sol: party at Dubliners', note: 'Saturday 31 October · from 19:00', until: '2026-10-31' },
              { href: '/wednesday-1-euro-shots-madrid/', label: 'Wednesday €1 shots', note: 'Every Wednesday · ask at the bar' },
              { href: '/oktoberfest-madrid-2026/', label: 'Oktoberfest season in Madrid', note: '22 Oct–15 Nov', until: '2026-11-15' },
              { href: '/de/oktoberfest-madrid-2026/', label: 'Oktoberfest-Zeit in Madrid', note: 'Auf Deutsch', hreflang: 'de', lang: 'de', until: '2026-11-15' },
            ],
          },
          {
            title: 'Visit',
            items: [
              { href: '/visit/', label: 'Hours & map', note: `${SITE.address}, ${SITE.postal}` },
              { href: '/irish-pub-near-plaza-mayor/', label: 'Irish pub near Plaza Mayor' },
              { href: '/night-out-near-sol-madrid/', label: 'Night out near Sol' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
