---
import GettingHere from '../../components/GettingHere.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import FixtureBoard from '../../components/FixtureBoard.astro';
import HomeRugbyNationsFinalsWeek from '../../components/HomeRugbyNationsFinalsWeek.astro';
import LinkHub from '../../components/LinkHub.astro';
import { SITE, withBase, absUrl } from '../../site';
import { agendaAt, sportsEventsJsonLd } from '../../data/fixtures';
const title =
  'What\'s On: live sport at an Irish pub & sports bar near Sol';
const description =
  'Live sport this week at Dubliners, an Irish pub and sports bar on Espoz y Mina 7: football, NFL, rugby and more in Madrid time. Named listings below — NFL bar Madrid near Puerta del Sol.';

// One agenda for EN + ES (same filter, same range, Europe/Madrid).
const { todayKey, today, upcoming } = agendaAt();
const sportsEvents = sportsEventsJsonLd([...today, ...upcoming], {
  pageUrl: absUrl('/whats-on/'),
  lang: 'en',
});
---

<BaseLayout
  title={title}
  description={description}
  path="/whats-on/"
  ogImage="/images/screens-sports.jpg"
  extraJsonLd={sportsEvents}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="What's on" />
      <h1>What’s On at Dubliners — live sport this week</h1>
      <p class="lead">
        See this week’s live sport at this Irish pub and sports bar near Puerta del Sol — football, NFL, NBA, rugby, Formula 1, tennis and more.
        Times are Madrid time. Matches marked LIVE are on our screens. Named listings are on this page only.
      </p>
      <CtaRow showWhatsOn={false} />
    </div>
  </section>
  <GettingHere lang="en" />

  <section class="section">
    <div class="container">
      <FixtureBoard lang="en" today={today} upcoming={upcoming} />
      <p class="fx-note">
        Times are Madrid time. LIVE = showing on our screens.
      </p>
      <p class="fx-note">
        Later this month after the board window: other confirmed listings stay on this page when their Madrid date arrives.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">GET DIRECTIONS</a>
        <a class="btn btn-primary" href={withBase('/contact/')}>Contact</a>
      </div>
    </div>
  </section>

  <!-- NAT-27-29-RUGBY-UNTIL-2026-11-30 — additional below fixture board -->
  {todayKey >= '2026-11-22' && todayKey <= '2026-11-29' && <HomeRugbyNationsFinalsWeek lang="en" />}

  <section class="section">
    <div class="container prose">
      <h2>Live sports at Dubliners</h2>
      <p>
        Dubliners is an Irish pub and sports bar just off Puerta del Sol — Espoz y Mina 7, Metro Sol or Sevilla.
        An Irish bar in Madrid with football and NFL on the indoor screens when confirmed.
        Check What’s On above for this week’s schedule, or ask at the bar
        if you’re looking for a specific game. Named listings stay here.
      </p>
      <p>
        How the screens work and which sports we show: <a href={withBase('/sports-bar-madrid/')}>our sports bar in Madrid</a>.
      </p>
      {todayKey <= '2026-10-31' && (
        <p data-show-until="2026-10-31"><strong>Halloween at Dubliners: Saturday 31 October, from 19:00.</strong> Costumes, decorations and music. <a href={withBase('/halloween-madrid-2026/')}>Halloween in Madrid near Sol</a></p>
      )}
      {todayKey === '2026-11-22' && (
        <p data-show-until="2026-11-22">
          Sunday 22 November (Madrid time): <a href={withBase('/psv-fans-madrid/')}>Real Madrid–PSV Tuesday 24</a> and <a href={withBase('/viking-fans-madrid/')}>Atlético–Viking Wednesday 25</a> (Champions meeting points) · <a href={withBase('/zalgiris-fans-madrid/')}>Žalgiris Wednesday 25</a>. Sunday football in the table above. Also <a href={withBase('/rugby-nations-finals-weekend-madrid/')}>Nations Championship rugby 27–29</a> on the board. Confirmed on our screens; clashes go on different screens.
        </p>
      )}
      {todayKey === '2026-11-23' && (
        <p data-show-until="2026-11-23">
          Monday 23 November (Madrid time): <strong>Real Madrid–PSV Tuesday 24 at 21:00</strong> — <a href={withBase('/psv-fans-madrid/')}>PSV fan guide</a> (meeting point, first come first served). Tonight in the table above: <strong>Levante–Elche</strong> and <strong>Brentford–Everton</strong> 21:00 · <a href={withBase('/viking-fans-madrid/')}>Atlético–Viking Wednesday 25</a> in Looking ahead. Also <a href={withBase('/rugby-nations-finals-weekend-madrid/')}>Nations Championship rugby 27–29</a> on the band below. Confirmed on our screens; clashes go on different screens.
        </p>
      )}
      {todayKey === '2026-11-24' && (
        <p data-show-until="2026-11-24">
          Tuesday 24 November (Madrid time): <strong>Real Madrid–PSV at 21:00</strong> LIVE on our screens — <a href={withBase('/psv-fans-madrid/')}>meeting point for PSV fans</a> by Sol. <a href={withBase('/viking-fans-madrid/')}>Atlético–Viking Wednesday 25</a> in Looking ahead. Also <a href={withBase('/rugby-nations-finals-weekend-madrid/')}>Nations Championship rugby 27–29</a> on the band below. Confirmed on our screens; clashes go on different screens.
        </p>
      )}
      {todayKey >= '2026-11-25' && todayKey <= '2026-11-29' && (
        <p data-show-until="2026-11-29">
          Live sports (Tue 24–Sun 29 Nov, Madrid time), live on our screens: <strong>Real Madrid–PSV</strong> Tuesday 24 at 21:00 (Champions, meeting point) · <strong>Atlético–Viking</strong> Wednesday 25 at 21:00 (Champions, meeting point) · <strong>Arsenal–Man City</strong> Sunday 29 at 17:30 (Premier). Rugby: <a href={withBase('/rugby-nations-finals-weekend-madrid/')}>six Nations Championship Tests Fri–Sun 27–29</a> on the board below. Confirmed on our screens; clashes go on different screens.
        </p>
      )}
      {todayKey <= '2026-11-01' && (
        <p data-show-until="2026-11-01">
          This week’s live sports (31 Oct–1 Nov, Madrid time): Saturday 31 is Halloween at Dubliners from 19:00, with the day’s games on screen too, Barça–Alavés 21:00 among them · Sunday 1, the night before Monday’s bank holiday: Racing–Real Madrid 16:15, Liverpool–Arsenal 17:30, NFL from 19:00, the F1 Mexico City Grand Prix 21:00 and Athletic–Real Sociedad 21:00. Confirmed on our screens; clashes go on different screens.
        </p>
      )}
      {todayKey <= '2026-10-10' && (
        <p data-show-until="2026-10-10">
          Saturday at Dubliners is packed: Arsenal–Leeds 13:30, Rayo–Athletic 14:00, Alavés–Atlético 16:15, Man Utd–Spurs with Barça–Getafe and Ulster–Munster at 18:30, then Leinster–Cardiff 20:45 and Real Madrid–Villarreal 21:00 — Confirmed on our screens; clashes go on different screens.
        </p>
      )}
    </div>
  </section>

  <section class="section band" id="sport-guides">
    <div class="container">
      <h2>Explore live sport at Dubliners</h2>
      <LinkHub
        heading="h3"
        groups={[
          {
            title: 'Football & rugby',
            id: 'football-rugby',
            items: [
              { href: '/premier-league-pub-madrid/', label: 'Premier League pub Madrid' },
              { href: '/champions-league-bar-madrid/', label: 'Champions League' },
              { href: '/sports-bar-madrid/', label: 'Sports bar Madrid' },
              { href: '/el-clasico-madrid/', label: 'Watch El Clásico near Sol' },
              { href: '/brighton-fans-madrid/', label: 'Brighton fans in Madrid' },
              { href: '/zalgiris-fans-madrid/', label: 'Žalgiris fans in Madrid', note: 'EuroLeague · 25 November, 20:45' },
              { href: '/psv-fans-madrid/', label: 'PSV fans in Madrid', note: 'Champions League · 24 November, 21:00' },
              { href: '/viking-fans-madrid/', label: 'Viking fans in Madrid', note: 'Champions League · 25 November, 21:00' },
              { href: '/ireland-rugby-madrid/', label: 'Ireland rugby in Madrid', note: 'November games (played)' },
            ],
          },
          {
            title: 'NFL & American sports',
            id: 'nfl-american-sports',
            items: [
              { href: '/nfl-madrid/', label: 'Watch NFL Madrid', note: 'NFL bar Madrid near Sol' },
              { href: '/where-to-watch-nfl-madrid/', label: 'Where to watch NFL in Madrid', note: 'Irish pub near Puerta del Sol' },
            ],
          },
          {
            title: 'Food & drinks',
            id: 'food-drinks',
            items: [{ href: '/menu/', label: 'Food menu' }],
          },
        ]}
      />
    </div>
  </section>

  <section class="section" id="whats-new">
    <div class="container">
      <h2>What’s new</h2>
      <LinkHub
        heading="h3"
        groups={[
          {
            title: 'Offers & events',
            items: [
              { href: '/psv-fans-madrid/', label: 'Real Madrid v PSV in Madrid', note: 'Champions League · Tuesday 24 November, 21:00 — meeting point', until: '2026-11-24' },
              { href: '/viking-fans-madrid/', label: 'Atlético v Viking in Madrid', note: 'Champions League · Wednesday 25 November, 21:00 — meeting point', until: '2026-11-25' },
              { href: '/rugby-nations-finals-weekend-madrid/', label: 'Nations Championship finals weekend', note: 'Fri–Sun 27–29 Nov · six Tests LIVE on our screens', until: '2026-11-29' },
              { href: '/zalgiris-fans-madrid/', label: 'Žalgiris fans in Madrid: EuroLeague near Sol', note: 'Real Madrid v Žalgiris · Wednesday 25 November, 20:45', until: '2026-11-25' },
              { href: '/wednesday-1-euro-shots-madrid/', label: 'Wednesday €1 shots', note: 'Every Wednesday · ask at the bar' },
            ],
          },
          {
            title: 'Visit',
            items: [
              { href: '/visit/', label: 'Hours & map', note: `${SITE.address}, ${SITE.postal}` },
              { href: '/irish-pub-near-plaza-mayor/', label: 'Irish pub near Plaza Mayor' },
              {
                href: '/plaza-mayor-december-christmas-market-pint-near-sol/',
                label: 'Plaza Mayor Christmas market, pint near Sol',
                note: 'December tourist loop — not Sol lights walk',
              },
              {
                href: '/sol-christmas-lights-evening-walk/',
                label: 'Sol Christmas lights evening walk',
                note: 'From Sat 21 Nov — loop near Puerta del Sol, indoor pint',
              },
              { href: '/night-out-near-sol-madrid/', label: 'Night out near Sol' },
            ],
          },
        ]}
      />
    </div>
  </section>
</BaseLayout>
