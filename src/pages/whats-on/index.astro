---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import FixtureBoard from '../../components/FixtureBoard.astro';
import { SITE, withBase, absUrl } from '../../site';
import { agendaAt, sportsEventsJsonLd } from '../../data/fixtures';

const title =
  'What\'s On: Live Sport This Week | Dubliners Madrid';
const description =
  'Live sport this week at Dubliners, Espoz y Mina 7: football, NFL, rugby, NBA and more in Madrid time, with what is LIVE on our screens. Walk in.';

// One agenda for EN + ES (same filter, same range, Europe/Madrid).
const { todayKey, today, upcoming } = agendaAt();
const sportsEvents = sportsEventsJsonLd([...today, ...upcoming], {
  pageUrl: absUrl('/whats-on/'),
  lang: 'en',
});
---

<BaseLayout
  title={title}
  description={description}
  path="/whats-on/"
  ogImage="/images/screens-sports.jpg"
  extraJsonLd={sportsEvents}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="What's on" />
      <h1>What’s On at Dubliners — live sport this week</h1>
      <p class="lead">
        See this week’s live sport at Dubliners — football, NFL, NBA, rugby, Formula 1, tennis and more.
        Times are Madrid time. Matches marked LIVE are on our screens — a big projector and 8 screens.
      </p>
      <CtaRow showWhatsOn={false} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <p class="small"><strong>News:</strong> <a href={withBase('/news/champions-league-tonight-20-oct/')}>Champions League tonight, Tue 20 Oct</a> · <a href={withBase('/news/champions-league-tomorrow-21-oct/')}>Champions League Wed 21 Oct: Real Madrid vs RB Leipzig</a></p>
      <FixtureBoard lang="en" today={today} upcoming={upcoming} />
      <p class="fx-note">
        Times are Madrid time. LIVE = showing on our screens.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
        <a class="btn btn-primary" href={withBase('/contact/')}>Contact</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Live sports at Dubliners</h2>
      <p>
        Dubliners is an Irish pub just off Puerta del Sol — Espoz y Mina 7, Metro Sol or Sevilla.
        We put major live sport on our indoor screens when it’s confirmed: football, NFL, NBA, rugby,
        Formula 1, tennis and more. Check What’s On above for this week’s schedule, or ask at the bar
        if you’re looking for a specific game.
      </p>
      <p>
        How the screens work and which sports we show: <a href={withBase('/sports-bar-madrid/')}>our sports bar in Madrid</a>.
      </p>
      {todayKey <= '2026-10-10' && (
        <p data-show-until="2026-10-10">
          Saturday at Dubliners is packed: Arsenal–Leeds 13:30, Rayo–Athletic 14:00, Alavés–Atlético 16:15, Man Utd–Spurs with Barça–Getafe and Ulster–Munster at 18:30, then Leinster–Cardiff 20:45 and Real Madrid–Villarreal 21:00 — Confirmed on our screens; clashes go on different screens. Walk in near Sol.
        </p>
      )}
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Explore live sport at Dubliners</h2>
      <p>
        Looking for a particular competition? See more about the
        <a href={withBase('/premier-league-pub-madrid/')}>Premier League</a>,
        <a href={withBase('/champions-league-bar-madrid/')}>Champions League</a>
        and watching <a href={withBase('/watch-football-madrid/')}>live football in Madrid</a>,
        or check <a href={withBase('/whats-on/')}>What’s On</a> for this week’s confirmed screenings.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div>
        <h2>Wednesday · €1 shots</h2>
        <p>
          Midweek at Dubliners: €1 shots. Ask at the bar for details.
        </p>
        <a class="btn btn-secondary" href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday €1 shots →</a>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/bar-interior-sm.webp')} 800w, ${withBase('/images/bar-interior.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img
          src={withBase('/images/bar-interior.jpg')}
          alt="Irish pub near Sol — Dubliners Madrid screens for Premier League and Champions League"
          class="split-photo landscape"
          width="1400"
          height="788"
          loading="lazy"
        />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Visit</h2>
      <p>{SITE.address}, {SITE.postal} · <a href={withBase('/visit/')}>Hours & map</a></p>
    </div>
  </section>
  <section class="section">
    <div class="container prose">
      <p class="small">New in town? <a href={withBase('/irish-pub-near-plaza-mayor/')}>Irish pub near Plaza Mayor</a> · <a href={withBase('/ireland-rugby-madrid/')}>Ireland rugby in Madrid (6, 14 &amp; 21 Nov)</a> · <a href={withBase('/oktoberfest-madrid-2026/')}>Oktoberfest season in Madrid (22 Oct–15 Nov)</a> · <a href={withBase('/de/oktoberfest-madrid-2026/')} hreflang="de" lang="de">Oktoberfest-Zeit in Madrid</a> · <a href={withBase('/night-out-near-sol-madrid/')}>Night out near Sol</a> · <a href={withBase('/brighton-fans-madrid/')}>Brighton fans</a> · <a href={withBase('/el-clasico-madrid/')}>El Clásico in Madrid (25 Oct)</a> · <a href={withBase('/nfl-sunday-madrid-guide/')}>NFL Sunday guide</a> · <a href={withBase('/champions-league-irish-pub-sol/')}>Champions League in an Irish pub</a> · <a href={withBase('/nfl-madrid/')}>NFL in Madrid</a></p>
    </div>
  </section>
</BaseLayout>
