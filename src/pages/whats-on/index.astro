---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import { SITE, withBase } from '../../site';
import { fixturesForToday, fixturesForWeek } from '../../data/fixtures';

const title = "Watch Football near Sol | What's On — Dubliners Sports Bar";
const description =
  "Where to watch football in Madrid centro: live sport on Irish pub screens near Puerta del Sol. Verified fixtures below — sports bar Espoz y Mina 7, Wednesday €1 shots.";

const today = fixturesForToday();
const week = fixturesForWeek();
---

<BaseLayout title={title} description={description} path="/whats-on/" ogImage="/images/screens-sports.jpg">
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="What's on" />
      <h1>Watch football near Sol — what’s on</h1>
      <p class="lead">
        Sports bar near Sol with live football on indoor screens — plus Wednesday €1 shots midweek.
        The board lists verified fixtures only; ask the team what’s showing tonight.
      </p>
      <CtaRow showWhatsOn={false} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="fixture-board" data-fixture-board>
        <div class="fixture-col" data-fixture-slot="today">
          <h2>Today</h2>
          <p class="empty-slot" data-fixture-empty hidden={today.length > 0}>
            Nothing listed for today — ask at the bar what’s on the screens.
          </p>
          <ul class="fixture-list" hidden={today.length === 0}>
            {today.map((f) => (
              <li
                data-date-key={f.dateKey}
                data-madrid-time={f.madridTime}
                data-duration-min={String(f.approxDurationMin ?? 180)}
              >
                <span class="fx-time">{f.madridTime}</span>
                <span class="fx-body">
                  <strong>{f.teams}</strong>
                  <em>{f.competition}</em>
                </span>
              </li>
            ))}
          </ul>
        </div>
        <div class="fixture-col" data-fixture-slot="week">
          <h2>This week</h2>
          <p class="empty-slot" data-fixture-empty hidden={week.length > 0}>
            This week’s list will appear here when fixtures are ready.
          </p>
          <ul class="fixture-list" hidden={week.length === 0}>
            {week.map((f) => (
              <li
                data-date-key={f.dateKey}
                data-madrid-time={f.madridTime}
                data-duration-min={String(f.approxDurationMin ?? 180)}
              >
                <span class="fx-day">{f.whenLabel}</span>
                <span class="fx-time">{f.madridTime}</span>
                <span class="fx-body">
                  <strong>{f.teams}</strong>
                  <em>{f.competition}</em>
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <FixtureAntiStale />
      <p class="fx-note">
        Times are Madrid (CEST). Screens and coverage can change — ask staff on the night.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
        <a class="btn btn-primary" href={withBase('/contact/')}>Contact</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Where to watch football in Madrid (near Sol)</h2>
      <p>
        Dubliners is an Irish sports bar just off Puerta del Sol — Espoz y Mina 7, Metro Sol or Sevilla.
        We put live football and other sport on indoor screens when it’s on. Use the board above for
        tonight and this week; if a game isn’t listed, we are not claiming it — ask at the bar.
      </p>
      <p>
        More context:
        <a href={withBase('/sports-bar-madrid/')}>sports bar Madrid near Sol</a> ·
        <a href={withBase('/champions-league-bar-madrid/')}>Champions League screens</a> ·
        <a href={withBase('/premier-league-pub-madrid/')}>Premier League nights</a>.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div>
        <h2>Wednesday · €1 SHOTS</h2>
        <p>
          Dubliners’ Wednesday promo: €1 shots at the pub. Ask at the bar for details.
        </p>
        <a class="btn btn-secondary" href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday €1 shots →</a>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/bar-interior-sm.webp')} 800w, ${withBase('/images/bar-interior.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img src={withBase('/images/bar-interior.jpg')} alt="Bar interior at Dubliners" class="split-photo landscape" width="1400" height="788" loading="lazy" />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>More match nights</h2>
      <ul>
        <li><a href={withBase('/sports-bar-madrid/')}>Sports bar Madrid</a></li>
        <li><a href={withBase('/watch-football-madrid/')}>Watch football Madrid</a></li>
        <li><a href={withBase('/premier-league-pub-madrid/')}>Premier League pub</a></li>
        <li><a href={withBase('/champions-league-bar-madrid/')}>Champions League bar</a></li>
      </ul>
      <h2>Visit</h2>
      <p>{SITE.address}, {SITE.postal} · <a href={withBase('/visit/')}>Hours & map</a></p>
    </div>
  </section>
</BaseLayout>
