---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import CtaRow from '../../components/CtaRow.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import { SITE, withBase, absUrl } from '../../site';
import {
  fixturesForToday,
  fixturesForWeek,
  madridToday,
  sportLabel,
  sportsEventsJsonLd,
} from '../../data/fixtures';

const title =
  'Premier League Pub near Sol | What\'s On — Dubliners Irish Pub Madrid';
const description =
  'Irish pub near Sol for Premier League and Champions League nights. Confirmed fixtures on screens at Dubliners, Espoz y Mina 7 — sports bar Madrid centro.';

const todayKey = madridToday();
const today = fixturesForToday();
const week = fixturesForWeek();
const upcoming = week.filter((f) => f.dateKey > todayKey);
const sportsEvents = sportsEventsJsonLd(week, {
  pageUrl: absUrl('/whats-on/'),
  lang: 'en',
});
---

<BaseLayout
  title={title}
  description={description}
  path="/whats-on/"
  ogImage="/images/screens-sports.jpg"
  extraJsonLd={sportsEvents}
>
  <section class="hero hero-compact">
    <div class="container">
      <Breadcrumb current="What's on" />
      <h1>What’s On at Dubliners — Irish Pub near Sol for Premier League & Champions</h1>
      <p class="lead">
        See this week’s live sport at Dubliners — football, NFL, NBA, rugby, Formula 1, tennis and more.
        Times are Madrid time. Only screenings marked Confirmed are confirmed to show on our screens.
      </p>
      <CtaRow showWhatsOn={false} />
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="fixture-board" data-fixture-board>
        <div class="fixture-col" data-fixture-slot="today">
          <h2>Today near Sol</h2>
          <p class="empty-slot" data-fixture-empty hidden={today.length > 0}>
            Nothing listed for today — ask at the bar what’s on the screens.
          </p>
          <ul class="fixture-list" hidden={today.length === 0}>
            {today.map((f) => (
              <li
                data-date-key={f.dateKey}
                data-madrid-time={f.madridTime}
                data-duration-min={String(f.approxDurationMin ?? 180)}
              >
                <span class="fx-time">{f.madridTime}</span>
                <span class="fx-body">
                  <strong>{f.teams}</strong>
                  <em>{sportLabel(f.competition)} · {f.competition}</em>
                  {f.confirmedOnScreens && <span class="fx-status fx-status-confirmed">Confirmed</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>
        <div class="fixture-col" data-fixture-slot="week">
          <h2>Upcoming this week near Sol</h2>
          <p class="empty-slot" data-fixture-empty hidden={upcoming.length > 0}>
            This week’s upcoming list will appear here when fixtures are ready.
          </p>
          <ul class="fixture-list" hidden={upcoming.length === 0}>
            {upcoming.map((f) => (
              <li
                data-date-key={f.dateKey}
                data-madrid-time={f.madridTime}
                data-duration-min={String(f.approxDurationMin ?? 180)}
              >
                <span class="fx-day">{f.whenLabel}</span>
                <span class="fx-time">{f.madridTime}</span>
                <span class="fx-body">
                  <strong>{f.teams}</strong>
                  <em>{sportLabel(f.competition)} · {f.competition}</em>
                  {f.confirmedOnScreens && <span class="fx-status fx-status-confirmed">Confirmed</span>}
                </span>
              </li>
            ))}
          </ul>
        </div>
      </div>
      <FixtureAntiStale />
      <p class="fx-note">
        Times are Madrid time. Confirmed = showing on our screens.
      </p>
      <div class="cta-row">
        <a class="btn btn-gold" href={SITE.mapsUrl} rel="noopener noreferrer" target="_blank">Directions</a>
        <a class="btn btn-primary" href={withBase('/contact/')}>Contact</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Live sports at Dubliners</h2>
      <p>
        Dubliners is an Irish pub just off Puerta del Sol — Espoz y Mina 7, Metro Sol or Sevilla.
        We put major live sport on our indoor screens when it’s confirmed: football, NFL, NBA, rugby,
        Formula 1, tennis and more. Check What’s On above for this week’s schedule, or ask at the bar
        if you’re looking for a specific game.
      </p>
      {todayKey <= '2026-10-10' && (
        <p>
          Saturday at Dubliners is packed: Arsenal–Leeds 13:30, Rayo–Athletic 14:00, Alavés–Atlético 16:15, Man Utd–Spurs 18:30 and Real Madrid–Villarreal 21:00 — Confirmed on our screens; when kick-offs clash, we put them on different screens. Walk in near Sol.
        </p>
      )}
      <p>
        Travelling for Atlético vs Manchester United on Tue 13 Oct? Kick-off is 21:00 at the Metropolitano —
        Confirmed on our screens. Pre-match pints near Sol for the build-up, or stay centro and watch the UCL night here. Walk in; ask at the bar.
      </p>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Explore live sport at Dubliners</h2>
      <p>
        Looking for a particular competition? See more about the
        <a href={withBase('/premier-league-pub-madrid/')}>Premier League</a>,
        <a href={withBase('/champions-league-bar-madrid/')}>Champions League</a>
        and watching <a href={withBase('/watch-football-madrid/')}>live football in Madrid</a>,
        or check <a href={withBase('/whats-on/')}>What’s On</a> for this week’s confirmed screenings.
      </p>
    </div>
  </section>

  <section class="section band">
    <div class="container split">
      <div>
        <h2>Wednesday · €1 shots</h2>
        <p>
          Midweek at Dubliners: €1 shots. Ask at the bar for details.
        </p>
        <a class="btn btn-secondary" href={withBase('/wednesday-1-euro-shots-madrid/')}>Wednesday €1 shots →</a>
      </div>
      <picture>
        <source
          type="image/webp"
          srcset={`${withBase('/images/bar-interior-sm.webp')} 800w, ${withBase('/images/bar-interior.webp')} 1400w`}
          sizes="(max-width: 880px) 100vw, 40vw"
        />
        <img
          src={withBase('/images/bar-interior.jpg')}
          alt="Irish pub near Sol — Dubliners Madrid screens for Premier League and Champions League"
          class="split-photo landscape"
          width="1400"
          height="788"
          loading="lazy"
        />
      </picture>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Visit</h2>
      <p>{SITE.address}, {SITE.postal} · <a href={withBase('/visit/')}>Hours & map</a></p>
    </div>
  </section>
</BaseLayout>
