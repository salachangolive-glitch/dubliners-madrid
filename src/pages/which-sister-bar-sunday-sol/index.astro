---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumb from '../../components/Breadcrumb.astro';
import LinkHub from '../../components/LinkHub.astro';
import FixtureAntiStale from '../../components/FixtureAntiStale.astro';
import OriginalFourBars from '../../components/OriginalFourBars.astro';
import { withBase, absUrl } from '../../site';
import { FOUR_BARS_MAPS, SHOW_UNTIL_FAN_WEEKEND } from '../../data/fourBars';

const PATH = '/which-sister-bar-sunday-sol/';
const PATH_ES = '/es/que-bar-hermano-domingo-sol/';
const SHOW_UNTIL = SHOW_UNTIL_FAN_WEEKEND;
const MAPS = FOUR_BARS_MAPS;
const articleLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: 'Which sister bar on Sunday 8 Nov — terrace, screens, or sports pub',
  inLanguage: 'en',
  datePublished: '2026-11-07T18:40:00+01:00',
  dateModified: '2026-11-07T18:40:00+01:00',
  image: absUrl('/images/facade.jpg'),
  mainEntityOfPage: absUrl(PATH),
  author: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
  publisher: { '@type': 'Organization', name: 'Dubliners Irish Pub', url: absUrl('/') },
};
const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    {
      '@type': 'Question',
      name: 'Which sister bar has confirmed Sunday NFL screens?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Dubliners, Espoz y Mina 7, from 12:00. Bengals–Falcons 15:30, NFL from 19:00 / 22:05 / 22:25, Atlético–Barcelona 21:00. Ask which game is on.',
      },
    },
    {
      '@type': 'Question',
      name: 'Which bar is for food and a terrace on Sunday?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'O’Reilly’s Restaurant Bar, Pasaje de Matheu 4, daily 11:30–01:30. A meeting point before Four Corner opens at 14:00.',
      },
    },
    {
      '@type': 'Question',
      name: 'When does the fourth door join?',
      acceptedAnswer: {
        '@type': 'Answer',
        text: 'Four Corner, Calle de la Victoria 6, Sunday from 14:00 until late. Has sports screens. We do not list which games it shows.',
      },
    },
  ],
};
---

<BaseLayout
  title="Which sister bar on Sunday near Sol | Dubliners"
  description="Sunday 8 Nov near Sol: O’Reilly’s terrace, Dubliners confirmed NFL screens, O’Connell’s next door, Four Corner from 14:00 with sports screens. Maps."
  path={PATH}
  lang="en"
  hreflang={{ en: PATH, es: PATH_ES }}
  ogImage="/images/facade.jpg"
  extraJsonLd={[articleLd, faqLd]}
>
  <section class="hero hero-compact" data-show-until={SHOW_UNTIL}>
    <div class="container">
      <Breadcrumb current="Which sister bar on Sunday" schema />
      <h1>Which sister bar on Sunday 8 Nov — terrace, screens, or sports pub</h1>
      <p class="lead">
        Four doors in the same streets. They are not the same job.
        Pick the terrace, the confirmed NFL board, the next-door sports pub, or the Sunday 14:00 room with sports screens.
        Tonight the choice is three doors (18:00–19:00). Sunday the fourth joins.
      </p>
      <p class="small">En español: <a href={withBase(PATH_ES)} hreflang="es" lang="es">Qué bar hermano el domingo junto a Sol</a></p>
      <div class="cta-row">
        <a class="btn btn-gold" data-track-event="directions_click" href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Dubliners on Maps</a>
        <a class="btn btn-secondary" href={withBase('/4-bars-one-fan-weekend/')}>MEET US NEAR SOL</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container prose">
      <h2>Match the door to the job</h2>
      <ul>
        <li>
          <strong>Eat / terrace / late-morning meetup → O’Reilly’s.</strong>
          Pasaje de Matheu 4. Daily 11:30–01:30. First door if the group is hungry before 15:30.
          <a href={MAPS.oreillys} rel="noopener noreferrer" target="_blank">Maps</a>.
        </li>
        <li>
          <strong>Confirmed NFL and Atlético–Barcelona screens → Dubliners.</strong>
          Espoz y Mina 7. Sunday 12:00–02:00. Big screen for Bengals–Falcons 15:30. Ask which game is on.
          <a href={MAPS.dubliners} rel="noopener noreferrer" target="_blank">Maps</a>.
        </li>
        <li>
          <strong>Another Irish sports pub on the same street → O’Connell’s.</strong>
          Espoz y Mina 7 (Maps: O’Connell St). Exception Sunday 8 Nov: from 12:00. Meeting point; we do not list its board.
          <a href={MAPS.oconnell} rel="noopener noreferrer" target="_blank">Maps</a>.
        </li>
        <li>
          <strong>Fourth door after lunch → Four Corner.</strong>
          Calle de la Victoria 6. Sunday from 14:00 until late. Has sports screens. No game list here.
          <a href={MAPS.fourCorner} rel="noopener noreferrer" target="_blank">Maps</a>.
        </li>
      </ul>
      <p>
        Tonight (Saturday) skip the fourth door. Meetup 18:00–19:00 at the first three. No live NFL Saturday.
        Valencia vs Real Madrid 21:00 is LIVE at Dubliners only.
      </p>

      <OriginalFourBars lang="en" when="sunday" />

      <h2>FAQ</h2>
      <dl class="faq">
        <dt><strong>Which bar has confirmed Sunday NFL screens?</strong></dt>
        <dd>Dubliners, Espoz y Mina 7, from 12:00. Ask which game is on.</dd>
        <dt><strong>Which bar is the terrace / food stop?</strong></dt>
        <dd>O’Reilly’s, Pasaje de Matheu 4, from 11:30.</dd>
        <dt><strong>When does the fourth door join?</strong></dt>
        <dd>Four Corner, Victoria 6, Sunday 14:00 until late, sports screens.</dd>
      </dl>

      <LinkHub
        heading="h2"
        groups={[
          {
            title: 'Pick a door',
            until: SHOW_UNTIL,
            items: [
              { href: '/', label: 'Dubliners home' },
              { href: '/4-bars-one-fan-weekend/', label: 'MEET US NEAR SOL' },
              { href: '/four-corner-opens-sunday-1400/', label: 'Four Corner opens 14:00' },
              { href: '/sunday-nfl-near-sol-8-nov/', label: 'Sunday NFL near Sol' },
              { href: '/pick-sunday-nfl-clock-sol/', label: 'Which Sunday clock at which door' },
              { href: PATH_ES, label: 'Qué bar hermano el domingo', note: 'En español', hreflang: 'es', lang: 'es' },
            ],
          },
        ]}
      />
    </div>
  </section>
  <FixtureAntiStale />
</BaseLayout>
